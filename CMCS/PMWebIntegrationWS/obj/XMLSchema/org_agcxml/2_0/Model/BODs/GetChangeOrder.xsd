    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="platform:BusinessObjectDocumentType">
        <xs:sequence>
          <xs:element name="DataArea" type="GetChangeOrderDataAreaType">
            <xs:annotation>
              <xs:documentation>Holds the business information for the GetChangeOrder BOD message.  There is a single Get verb instance and one or more ChangeOrder instances.</xs:documentation>
              <xs:documentation>The Get verb instance indicates the action to perform and carries parameters that apply to all ChangeOrder instances.</xs:documentation>
              <xs:documentation>Each ChangeOrder instance carries just enough information to support the Get action.  As a general rule, noun instances in a BOD can be partial; the full form is typically not needed.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
