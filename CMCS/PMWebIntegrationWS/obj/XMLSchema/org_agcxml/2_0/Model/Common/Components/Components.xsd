    <xs:documentation>
      Name: Components.xsd
      Release: 2.0 Alpha 4(pre)
      Release Date: 2014-Feb-04
      Full Name: /org_agcxml/2_0/Model/Common/Components/Components.xsd
    </xs:documentation>
