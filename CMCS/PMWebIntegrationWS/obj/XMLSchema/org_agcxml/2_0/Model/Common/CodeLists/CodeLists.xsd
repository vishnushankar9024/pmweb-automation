  <!--
      ImpactCodeContentType: union of ImpactCodeEnumType, xs:normalizedString
      ImpactCodeEnumType:
          Cost, Schedule, Drawing, PlanOrSpecification, Environmental
  -->
  <xs:simpleType name="ImpactCodeContentType">
    <xs:annotation>
      <xs:documentation>Type of impact on a construction project.  Used to assess a change in a workflow such as RFI.</xs:documentation>
      <xs:documentation>Enumerated values are:  Cost, Schedule, Drawing, PlanOrSpecification, Environmental.  This is an open code list in agcXML.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="ImpactCodeEnumType xs:normalizedString"></xs:union>
  </xs:simpleType>
  <xs:simpleType name="ImpactCodeEnumType">
    <xs:annotation>
      <xs:documentation>Type of impact on a construction project.  Used to assess a change in a workflow such as RFI.</xs:documentation>
      <xs:documentation>Enumerated values are:  Cost, Schedule, Drawing, PlanOrSpecification, Environmental.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:normalizedString">
      <xs:enumeration value="Cost">
        <xs:annotation>
          <xs:documentation>Impact on cost such as an amount of money</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Schedule">
        <xs:annotation>
          <xs:documentation>Impact on schedule such as amount of time or a new completion date.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Drawing">
        <xs:annotation>
          <xs:documentation>Impact on drawings such as a new diagram or annotation to existing drawing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PlanOrSpecification">
        <xs:annotation>
          <xs:documentation>Impact on the plan or specification such as new/revised sections of the specification.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Environmental">
        <xs:annotation>
          <xs:documentation>Impact on the environment such as a LEED impact.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

