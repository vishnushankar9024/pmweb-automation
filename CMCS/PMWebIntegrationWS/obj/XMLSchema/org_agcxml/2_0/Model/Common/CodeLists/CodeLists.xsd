  <!--
      WorkflowStageCodeContentType: union of WorkflowStageCodeEnumType, xs:normalizedString
      WorkflowStageCodeEnumType:
          Suggested, NotStarted, Started, Paused, Canceled, Error, Complete
  -->
  <xs:simpleType name="WorkflowStageCodeContentType">
    <xs:annotation>
      <xs:documentation>Current stage of a work item such as composing a response to an RFI line item.</xs:documentation>
      <xs:documentation>Enumerated values are:  Suggested, NotStarted, Started, Paused, Canceled, Error, Complete.  This is an open code list in agcXML.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="WorkflowStageCodeEnumType xs:normalizedString"></xs:union>
  </xs:simpleType>
  <xs:simpleType name="WorkflowStageCodeEnumType">
    <xs:annotation>
      <xs:documentation>Current stage of a work item such as composing a response to an RFI line item.</xs:documentation>
      <xs:documentation>Enumerated values are:  Suggested, NotStarted, Started, Paused, Canceled, Error, Complete.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:normalizedString">
      <xs:enumeration value="Suggested">
        <xs:annotation>
          <xs:documentation>The item is suggested and not yet scheduled for work.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NotStarted">
        <xs:annotation>
          <xs:documentation>The item's description is being composed.  No workers have been assigned.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Started">
        <xs:annotation>
          <xs:documentation>The work item is in progress.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Paused">
        <xs:annotation>
          <xs:documentation>The work item has paused progress.  There is no active work but it has not yet been canceled</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Canceled">
        <xs:annotation>
          <xs:documentation>The work item was canceled.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Error">
        <xs:annotation>
          <xs:documentation>The work item stopped due to an error.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Complete">
        <xs:annotation>
          <xs:documentation>The work item has completed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
