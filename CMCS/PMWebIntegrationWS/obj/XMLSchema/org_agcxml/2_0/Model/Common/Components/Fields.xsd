  <xs:element name="DateTime" type="DateTimeType">
    <xs:annotation>
      <xs:documentation>Fields.DateTimeType</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="DateTimeType">
    <xs:annotation>
      <xs:documentation>A flexible representation of a date and time including date and time truncation.  May include an explicit format code and a timezone when the format code excludes timezone information.</xs:documentation>
      <xs:documentation>Format codes are ISO 8601 and have a date code followed by an optional time code.  The time code has an optional timezone suffix.</xs:documentation>
      <xs:documentation>Date codes (8):  YYYY-MM-DD | --MM-DD | ---DD | YYYY-DDD | -DDD | YYYY-Www-D | -Www-D | -W-D</xs:documentation>
      <xs:documentation>Time codes (3):  Thh:mm:ss | Thh:mm | Thh</xs:documentation>
      <xs:documentation>Timezone codes (2):  Z | +hh:mm</xs:documentation>
      <xs:documentation>Examples:  YYYY-MM-DD | YYYY-MM-DDThh:mm:ss | YYYY-MM-DDThh:mm:ssZ | YYYY-MM-DDThh:mm:ss+hh:mm | YYYY-MM-DDThh:mm | YYYY-MM-DDThh:mmZ | YYYY-MM-DDThh:mm+hh:mm | YYYY-MM-DDThh | YYYY-MM-DDThhZ | YYYY-MM-DDThh:mm+hh</xs:documentation>
      <xs:documentation>Values for @timeZoneCode attribute for a minus hour offset:  "M0100", "M0100EU", "M0200", "M0300", "M0300BR", "M0300GL", "M0300US", "M0330US", "M0400", "M0400BR", "M0400CL", "M0400GL", "M0400PY", "M0400US", "M0500", "M0500BR", "M0500CU", "M0500US", "M0600", "M0600CL", "M0600US", "M0700", "M0700US", "M0800", "M0800US", "M0830", "M0900", "M0900US", "M1000", "M1000US", "M1100", "M1200".</xs:documentation>
      <xs:documentation>Values for @timeZoneCode attribute for a plus hour offset:  "P0000", "P0000EU", "P0100", "P0100EU", "P0100NA", "P0200", "P0200EG", "P0200EU", "P0200IL", "P0200JO", "P0200SY", "P0300", "P0300EU", "P0300IQ", "P0330IR", "P0400", "P0400EU", "P0430", "P0500", "P0500EU", "P0530", "P0545", "P0600", "P0600EU", "P0630", "P0700", "P0700EU", "P0800", "P0800EU", "P0900", "P0900EU", "P0930", "P0930AUS", "P1000", "P1000AUS", "P1030AUS", "P1000EU", "P1100", "P1100EU", "P1200", "P1200EU", "P1200NZ", "P1245NZ", "P1300", "P1300EU", "P1400".</xs:documentation>
      <xs:documentation>Implementation note:  This type is the same as platform:DateTimeType except optional formatCode and timeZoneCode attributes are added.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="DateTimeType_C6A6DE_AlternateType">
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="Date" type="DateType">
    <xs:annotation>
      <xs:documentation>Fields.DateType</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="DateType">
    <xs:annotation>
      <xs:documentation>A flexible representation of a date including date truncation.  May include an explicit ISO 8601 format code.</xs:documentation>
      <xs:documentation>Values for the formatCode attribute:  "YYYY-MM-DD", "YYYY-MM", "YYYY", "YY", "--MM-DD", "--MM--", "---DD", "YYYY-DDD", "-DDD", "YYYY-Www-D", "-Www-D", "YYYY-Www", "-Www", "-W-D".</xs:documentation>
      <xs:documentation>Implementation note:  This type is the same as platform:DateType except an optional formatCode attribute is added.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="platform:DateType_WER432">
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="Time" type="TimeType">
    <xs:annotation>
      <xs:documentation>Fields.TimeType</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="TimeType">
    <xs:annotation>
      <xs:documentation>A flexible representation for time of day including time truncation.  May include an explicit ISO 8601 format code.</xs:documentation>
      <xs:documentation>Values for the formatCode attribute:  "hh:mm:ss", "hh:mm:ss+hh:mm", "hh:mm:ssZ", "hh:mm", "hh:mmZ", "hh:mm+hh:mm", "hh", "hhZ", "hh+hh:mm", "-mm:ss", "-mm", "--ss".</xs:documentation>
      <xs:documentation>Implementation note:  This type is the same as platform:TimeType except an optional formatCode attribute is added.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="platform:TimeType_P09C33">
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="Duration" type="DurationType">
    <xs:annotation>
      <xs:documentation>Fields.DurationType</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:simpleType name="DurationType">
    <xs:annotation>
      <xs:documentation>A flexible representation for time duration.  May be the standard XML Schema duration type or a number of weeks using the additional ISO 8601 format of "nW".</xs:documentation>
      <xs:documentation>Implementation note:  This type is an alias for platform:DurationType.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="platform:DurationType">
    </xs:restriction>
  </xs:simpleType>



