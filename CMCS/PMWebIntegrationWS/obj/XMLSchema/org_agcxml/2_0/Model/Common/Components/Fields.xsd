  <!--
    ParticipantID : ParticipantIDType : platform:IDType

    ParticipantIDType : platform:IDType                                                 | ParticipantID Usage
    ....................................................................................|..............................................

    platform:IDType                                                                     | ParticipantID Usage
    ....................................................................................|..............................................
        @schemeID       : xs:normalizedString                                    [0..1] | scheme used to interpret the id value
        @schemeVersionID: xs:normalizedString                                    [0..1] | version of the identifier scheme
        @schemeAgencyID : platform:clm63055D08B_AgencyIdentificationContentType  [0..1] | agency, or authority, defining the id scheme
  -->
  <xs:element name="ParticipantID" type="ParticipantIDType" nillable="true">
    <xs:annotation>
      <xs:documentation>An id for a &lt;Participant&gt; for reference by other elements or attributes within the same BOD instance.  As such, id need only be unique among other &lt;Participant&gt; items within the same BOD instance.  The id need not have meaning outside the BOD instance in which it appears.</xs:documentation>
      <xs:documentation>The value of the id, not counting any attributes, must be usable as a key by the &lt;xs:key&gt; facility in XML Schema.  In agcXML, all &lt;xs:key&gt; and &lt;xs:keyref&gt; declarations appear in the Noun's &lt;xs:element&gt; due to restrictions in XML Schema.  These restrictions require declarations only in an &lt;xs:element&gt;, and the &lt;xs:key&gt; has to be at or above any key references.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="ParticipantIDType">
    <xs:annotation>
      <xs:documentation>An id for a &lt;Participant&gt; for reference by other elements or attributes within the same BOD instance.  As such, id need only be unique among other &lt;Participant&gt; items within the same BOD instance.  The id need not have meaning outside the BOD instance in which it appears.</xs:documentation>
      <xs:documentation>The value of the id, not counting any attributes, must be usable as a key by the &lt;xs:key&gt; facility in XML Schema.  In agcXML, all &lt;xs:key&gt; and &lt;xs:keyref&gt; declarations appear in the Noun's &lt;xs:element&gt; due to restrictions in XML Schema.  These restrictions require declarations only in an &lt;xs:element&gt;, and the &lt;xs:key&gt; has to be at or above any key references.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="platform:IDType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    ParticipantRef : ParticipantRefType : ParticipantIDType

    ParticipantRefType : ParticipantIDType | ParticipantRef Usage
    .......................................|......................
  -->
  <xs:element name="ParticipantRef" type="ParticipantRefType" nillable="true">
    <xs:annotation>
      <xs:documentation>An id of a &lt;Participant&gt; defined elsewhere within the same BOD instance.</xs:documentation>
      <xs:documentation>The value of the id, not counting any attributes, must be usable as a keyref by the &lt;xs:keyref&gt; facility in XML Schema.  In agcXML, all &lt;xs:key&gt; and &lt;xs:keyref&gt; declarations appear in the Noun's &lt;xs:element&gt; due to restrictions in XML Schema.  These restrictions require declarations only in an &lt;xs:element&gt;, and the &lt;xs:key&gt; has to be at or above any key references.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="ParticipantRefType">
    <xs:annotation>
      <xs:documentation>An id of a &lt;Participant&gt; defined elsewhere within the same BOD instance.</xs:documentation>
      <xs:documentation>The value of the id, not counting any attributes, must be usable as a keyref by the &lt;xs:keyref&gt; facility in XML Schema.  In agcXML, all &lt;xs:key&gt; and &lt;xs:keyref&gt; declarations appear in the Noun's &lt;xs:element&gt; due to restrictions in XML Schema.  These restrictions require declarations only in an &lt;xs:element&gt;, and the &lt;xs:key&gt; has to be at or above any key references.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ParticipantIDType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    SchemeAgencyUse : SchemeAgencyUseType : platform:TokenType

    SchemeAgencyUseType : platform:TokenType        | SchemeAgencyUse Usage
    ................................................|.............................
        @rootPrefix: platform:IndicatorType  [0..1] | whether this id is a prefix

    platform:TokenType                              | SchemeAgencyUse Usage
    ................................................|.............................
  -->
  <xs:element name="SchemeAgencyUse" type="SchemeAgencyUseType" nillable="true">
    <xs:annotation>
      <xs:documentation>A declaration that scheme agency identifier is used.  For example, a Participant can declare its scheme agency ids. Optionally, this can be a root prefix of schema agency ids used.</xs:documentation>
      <xs:documentation>The intent is to be able to associate an ID that appears elsewhere in the BOD with the usage, such as by a Participant.  When this is a root prefix, then any ID that begins with this prefix is associated with this usage.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="SchemeAgencyUseType">
    <xs:annotation>
      <xs:documentation>A declaration that scheme agency identifier is used.  For example, a Participant can declare its scheme agency ids. Optionally, this can be a root prefix of schema agency ids used.</xs:documentation>
      <xs:documentation>The intent is to be able to associate an ID that appears elsewhere in the BOD with the usage, such as by a Participant.  When this is a root prefix, then any ID that begins with this prefix is associated with this usage.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="platform:TokenType">
        <xs:attribute name="rootPrefix" type="platform:IndicatorType">
          <xs:annotation>
            <xs:documentation>Whether the value here is a prefix for scheme agency ids.  If omitted, defaults to false.  If true, then any ID whose scheme agency begins with this prefix is associated with this usage.</xs:documentation>
            <xs:documentation>Consider ending a prefix with the delimiter used in ids such as a colon or slash to ensure unambiguous prefix matching.  Prefix matching does not append any delimiter implicitly.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!--
    RFILineRef : RFILineRefType : platform:OpenIDType

    RFILineRefType : platform:OpenIDType                                                | RFILineRef Usage
    ....................................................................................|..............................................

    platform:OpenIDType                                                                 | RFILineRef Usage
    ....................................................................................|..............................................
        @schemeID       : xs:normalizedString                                    [0..1] | scheme used to interpret the id value
        @schemeVersionID: xs:normalizedString                                    [0..1] | version of the identifier scheme
        @schemeAgencyID : platform:clm63055D08B_AgencyIdentificationContentType  [0..1] | agency, or authority, defining the id scheme
        @typeCode       : xs:token                                               [0..1] | 
  -->
  <xs:element name="RFILineRef" type="RFILineRefType" nillable="true">
    <xs:annotation>
      <xs:documentation>An id of an &lt;RFIIssue&gt;, &lt;RFISubIssue&gt; or &lt;RFIReply&gt; defined elsewhere within the same BOD instance.  This field must match (RFIIssue|RFISubIssue|RFIReply)/platform:LineNumberID.</xs:documentation>
      <xs:documentation>The value of the id, not counting any attributes, must be usable as a keyref by the &lt;xs:keyref&gt; facility in XML Schema.  In agcXML, all &lt;xs:key&gt; and &lt;xs:keyref&gt; declarations appear in the Noun's &lt;xs:element&gt; due to restrictions in XML Schema.  These restrictions require declarations only in an &lt;xs:element&gt;, and the &lt;xs:key&gt; has to be at or above any key references.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="RFILineRefType">
    <xs:annotation>
      <xs:documentation>An id of an &lt;RFIIssue&gt;, &lt;RFISubIssue&gt; or &lt;RFIReply&gt; defined elsewhere within the same BOD instance.  This field must match (RFIIssue|RFISubIssue|RFIReply)/platform:LineNumberID.</xs:documentation>
      <xs:documentation>The value of the id, not counting any attributes, must be usable as a keyref by the &lt;xs:keyref&gt; facility in XML Schema.  In agcXML, all &lt;xs:key&gt; and &lt;xs:keyref&gt; declarations appear in the Noun's &lt;xs:element&gt; due to restrictions in XML Schema.  These restrictions require declarations only in an &lt;xs:element&gt;, and the &lt;xs:key&gt; has to be at or above any key references.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="platform:OpenIDType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>



