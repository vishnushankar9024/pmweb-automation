  <!--
      OpenCodeListAttributeGroup
          Formed from common attributes used in OAGIS for open code lists.
  -->
  <xs:attributeGroup name="OpenCodeListAttributeGroup">
    <xs:attribute name="listID" type="xs:normalizedString" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="en">
          <ccts:Cardinality>0..1</ccts:Cardinality>
          <ccts:DictionaryEntryName>Code. List. Identifier</ccts:DictionaryEntryName>
          <ccts:Definition>The identification of a list of codes</ccts:Definition>
          <ccts:PropertyTermName>List</ccts:PropertyTermName>
          <ccts:RepresentationTermName>Identifier</ccts:RepresentationTermName>
          <ccts:DataTypeTermName>Identifier</ccts:DataTypeTermName>
          <ccts:SupplementaryComponentValueDomain>
            <ccts:DefaultIndicator>False</ccts:DefaultIndicator>
            <ccts:PrimitiveTypeName>Normalized String</ccts:PrimitiveTypeName>
          </ccts:SupplementaryComponentValueDomain>
        </xs:documentation>
