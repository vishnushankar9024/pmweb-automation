--><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.openapplications.org/oagis/10" xmlns:ccts="urn:un:unece:uncefact:documentation:1.1" targetNamespace="http://www.openapplications.org/oagis/10" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1">
	<xsd:simpleType name="clm6TimeFormatCode1_TimeFormatCodeContentType" id="oagis-id-98f48609a5154608bd5673aea57784da">
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="hh:mm:ss">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Local Time</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh:mm:ss with optional fraction of second allowed (hh:mm:ss,ss)</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hh:mm:ss+hh:mm">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Time with UTC Offset</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh:mm:ss+hh:mm with optional fraction of second allowed (hh:mm:ss,ss+hh:mm)</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hh:mm:ssZ">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>UTC Time</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh:mm:ssZ with optional fraction of second allowed (hh:mm:ss,ssZ)</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hh:mm">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Local Hour and Minute</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh:mm</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hh:mmZ">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>UTC Hour and Minute</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh:mmZ</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hh:mm+hh:mm">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Hour and Minute with UTC offset</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh:mm+hh:mm</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hh">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Local Hour</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hhZ">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>UTC Hour</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hhZ</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="hh+hh:mm">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Hour with UTC offset</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: hh+hh:mm</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="-mm:ss">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Minute and Second</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: -mm:ss</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="-mm">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Minute</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: -mm</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="--ss">
				<xsd:annotation>
					<xsd:documentation>
						<ccts:Name>Second</ccts:Name>
						<ccts:Description>ISO 8601 Time extended format: --ss</ccts:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
