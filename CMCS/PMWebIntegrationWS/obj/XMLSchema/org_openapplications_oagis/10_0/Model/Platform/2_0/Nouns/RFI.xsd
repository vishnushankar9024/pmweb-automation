  <xs:include schemaLocation="../Common/Components/Components.xsd">
    <xs:annotation>
      <xs:documentation>XML elements and structured types shared across agcXML schemas such as a project participant and a cost impact.</xs:documentation>
      <xs:documentation>Also includes more general purpose declarations such as reference, attachment and dialog.</xs:documentation>
    </xs:annotation>
  </xs:include>
  <xs:import namespace="http://www.openapplications.org/oagis/10" schemaLocation="../../../../org_openapplications_oagis/10_0/Model/Platform/2_0/Common/Components/Components.xsd">
    <xs:annotation>
      <xs:documentation>XML elements and structured types shared across OAGIS schemas such as a business party or a currency exchange rate.</xs:documentation>
    </xs:annotation>
  </xs:import>

  <xs:element name="RFI" type="RFIType">
    <xs:annotation>
      <xs:documentation>A request for information (RFI) is a workflow where one or more issues or questions can be answered by different project participants.</xs:documentation>
      <xs:documentation>An RFI is a line item based document.  That is, it has a header for the RFI workflow and a flat list of line items.</xs:documentation>
      <xs:documentation>Each line item represents either an issue or a reply to an issue.  Issues and replies can be related to each other, but line items within an RFI are layed out linearly rather than nesting them.</xs:documentation>
      <xs:documentation>In its simplest form, an RFI has 2 line items:  one reply to one issue.  More generally, though, an issue can split into sub-issues, and strictly speaking, there is no restriction for a single top level issue.</xs:documentation>
      <xs:documentation>In addition, a line item is not limited to a single reply.  Rather, collaborative workflows could multiple participants contribute separate replies that then, optionally, feed into a final reply.</xs:documentation>
    </xs:annotation>
    <xs:unique name="ParticipantID_Key">
      <xs:annotation>
        <xs:documentation>Participant IDs form a key</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFIHeader/gc:Participants/gc:Participant"></xs:selector>
      <xs:field xpath="gc:ID"></xs:field>
    </xs:unique>
    <xs:unique name="SubIssue_LineNumberID_Key">
      <xs:annotation>
        <xs:documentation>Sub-issue line numbers form a key</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFISubIssue"></xs:selector>
      <xs:field xpath="platform:LineNumberID"></xs:field>
    </xs:unique>
    <xs:unique name="Reply_LineNumberID_Key">
      <xs:annotation>
        <xs:documentation>Reply line numbers form a key</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFIIssue/gc:RFIReply | gc:RFISubIssue/gc:RFIReply"></xs:selector>
      <xs:field xpath="platform:LineNumberID"></xs:field>
    </xs:unique>
    <xs:keyref name="Line_AssignedTo_IsKeyRef_ToParticipant" refer="gc:ParticipantID_Key">
      <xs:annotation>
        <xs:documentation>AssignedTo field of an RFI line item is a reference to a participant.</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFIIssue/gc:AssignedTo | gc:RFISubIssue/gc:AssignedTo | gc:RFIIssue/gc:RFIReply/gc:AssignedTo | gc:RFISubIssue/gc:RFIReply/gc:AssignedTo"></xs:selector>
      <xs:field xpath="."></xs:field>
    </xs:keyref>
    <xs:keyref name="CreatedBy_IsKeyRef_ToParticipant" refer="gc:ParticipantID_Key">
      <xs:annotation>
        <xs:documentation>CreatedBy field is a reference to a participant.</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFIHeader/gc:CreatedBy | gc:RFIIssue/gc:CreatedBy | gc:RFISubIssue/gc:CreatedBy | gc:RFIIssue/gc:RFIReply/gc:CreatedBy | gc:RFISubIssue/gc:RFIReply/gc:CreatedBy"></xs:selector>
      <xs:field xpath="."></xs:field>
    </xs:keyref>
    <xs:keyref name="IssuedBy_IsKeyRef_ToParticipant" refer="gc:ParticipantID_Key">
      <xs:annotation>
        <xs:documentation>IssuedBy field is a reference to a participant.</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFIHeader/gc:IssuedBy | gc:RFIIssue/gc:IssuedBy | gc:RFISubIssue/gc:IssuedBy | gc:RFIIssue/gc:RFIReply/gc:IssuedBy | gc:RFISubIssue/gc:RFIReply/gc:IssuedBy"></xs:selector>
      <xs:field xpath="."></xs:field>
    </xs:keyref>
    <xs:keyref name="Issue_DependsOn_IsKeyRef_ToSubIssueOnly" refer="gc:SubIssue_LineNumberID_Key">
      <xs:annotation>
        <xs:documentation>DependsOn field of an issue is a reference to a sub-issue only.</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFIIssue/gc:DependsOn | gc:RFISubIssue/gc:DependsOn"></xs:selector>
      <xs:field xpath="."></xs:field>
    </xs:keyref>
    <xs:keyref name="Reply_DependsOn_IsKeyRef_ToReplyOnly" refer="gc:Reply_LineNumberID_Key">
      <xs:annotation>
        <xs:documentation>DependsOn field of a reply is a reference to another reply only.</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="gc:RFIIssue/gc:RFIReply/gc:DependsOn | gc:RFISubIssue/gc:RFIReply/gc:DependsOn"></xs:selector>
      <xs:field xpath="."></xs:field>
    </xs:keyref>
  </xs:element>
  <xs:complexType name="RFIType">
    <xs:annotation>
      <xs:documentation>A request for information (RFI) is a workflow where one or more issues or questions can be answered by different project participants.</xs:documentation>
      <xs:documentation>An RFI is a line item based document.  That is, it has a header for the RFI workflow and a flat list of line items.</xs:documentation>
      <xs:documentation>Each line item represents either an issue or a reply to an issue.  Issues and replies can be related to each other, but line items within an RFI are layed out linearly rather than nesting them.</xs:documentation>
      <xs:documentation>In its simplest form, an RFI has 2 line items:  one reply to one issue.  More generally, though, an issue can split into sub-issues, and strictly speaking, there is no restriction for a single top level issue.</xs:documentation>
      <xs:documentation>In addition, a line item is not limited to a single reply.  Rather, collaborative workflows could multiple participants contribute separate replies that then, optionally, feed into a final reply.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="RFIHeader" minOccurs="0">
        <xs:annotation>
          <xs:documentation>The header area has all content for the RFI except the list of questions to be answered and their replies.</xs:documentation>
          <xs:documentation>Includes metadata to manage the RFI as an electronic record and time constraints to mange the RFI process.</xs:documentation>
          <xs:documentation>Includes RFI properties such as a subject and classification codes, list of participants, receipts for delivered RFI content, and any failure information.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element ref="RFIIssue" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>An issue in an RFI.  Issues and replies have identical fields except that an issue has the field RFIReply.  See RFILineBaseType for details.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element ref="RFISubIssue" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>A sub-issue in an RFI.  Issues and replies have identical fields except that an issue has the field RFIReply.  See RFILineBaseType for details.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!--
    RFIHeader : RFIHeaderType : RFIHeaderBaseType : platform:StatusHeaderBaseType

    RFIHeaderType : RFIHeaderBaseType                                             | RFIHeader Usage
    ..............................................................................|...............................................
        Extension: RFIHeaderExtensionType  [0..*]                                 | for data not specified in agcXML

    RFIHeaderBaseType : platform:StatusHeaderBaseType                             | RFIHeader Usage
    ..............................................................................|...............................................
        Title       : platform:DescriptionType  [0..1]                            | title for reporting
        Official    : platform:IndicatorType    [0..1]                            | whether the RFI is official
        Project     : ProjectType               [0..1]                            | basic construction project info
        Participants: ParticipantsType          [0..1]                            | who is participating in the workflow
        Receipt     : ReceiptType               [0..*]                            | evidence that a published RFI was received
        IssuedBy    : ParticipantRefType        [0..*]                            | who issued the RFI
        IssuedOn    : DateTimeType              [0..1]                            | when the RFI was issued
        CreatedBy   : ParticipantRefType        [0..*]                            | who created the RFI
        CreatedOn   : DateTimeType              [0..1]                            | when the RFI was created
        Failure     : platform:FailureType      [0..*]                            | errors logged during the RFI workflow

    platform:StatusHeaderBaseType                                                 | RFIHeader Usage
    ..............................................................................|...............................................
        platform:ID                      : platform:OpenIDType             [0..1] | RFI number
        platform:RevisionID              : platform:IDType                 [0..1] | 
        platform:VariationID             : platform:IDType                 [0..1] | 
        platform:DocumentIDSet           : platform:IDSetType              [0..*] | for composite RFI number, if needed
        platform:LastModificationDateTime: platform:DateTimeType           [0..1] | 
        platform:DocumentDateTime        : platform:DateTimeType           [0..1] | 
        platform:Description             : platform:DescriptionType        [0..*] | RFI subject
        platform:Note                    : platform:NoteType               [0..*] | general discussion among RFI participants
        platform:DocumentReference       : platform:DocumentReferenceType  [0..*] | references to external documents for this RFI
        platform:Attachment              : platform:AttachmentType         [0..*] | inline attachment of documents for this RFI
        platform:Status                  : platform:StatusType             [0..*] | 
  -->
  <xs:element name="RFIHeader" type="RFIHeaderType">
    <xs:annotation>
      <xs:documentation>The header area has all content for the RFI except the list of questions to be answered and their replies.</xs:documentation>
      <xs:documentation>Includes metadata to manage the RFI as an electronic record and time constraints to mange the RFI process.</xs:documentation>
      <xs:documentation>Includes RFI properties such as a subject and classification codes, list of participants, receipts for delivered RFI content, and any failure information.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="RFIHeaderType">
    <xs:annotation>
      <xs:documentation>The header area has all content for the RFI except the list of questions to be answered and their replies.</xs:documentation>
      <xs:documentation>Includes metadata to manage the RFI as an electronic record and time constraints to mange the RFI process.</xs:documentation>
      <xs:documentation>Includes RFI properties such as a subject and classification codes, list of participants, receipts for delivered RFI content, and any failure information.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="RFIHeaderBaseType">
        <xs:sequence>
          <xs:element name="Extension" type="RFIHeaderExtensionType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Allows additional information not captured in the agcXML specification.</xs:documentation>
              <xs:documentation>To build an extension, define a new XML schema in a separate XML namespace.</xs:documentation>
              <xs:documentation>To use an extension, import your new  schema into the XML instance for a BOD and add fields to an Extension field. Extension fields can be found in many nouns, headers, components and fields.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="RFIHeaderBaseType">
    <xs:annotation>
      <xs:documentation>A base type used to define RFIHeaderType.  All content for RFIHeaderType is defined here except for RFIHeaderType.Extension.</xs:documentation>
      <xs:documentation>Many of the fields </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="platform:StatusHeaderBaseType">
        <xs:sequence>
          <xs:element name="Title" type="platform:DescriptionType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Brief title of the RFI.  For an RFI with a single top level issue, that issue's title can suffice.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Official" type="platform:IndicatorType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Whether the RFI is offical</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element ref="Project" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Reference to the construction project.  A project number is probably sufficient.</xs:documentation>
              <xs:documentation>Details of the project definition are defined elsewhere.  It is expected that any party that needs project details can use this project number to retrieve them.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element ref="Participants" minOccurs="0">
            <xs:annotation>
              <xs:documentation>A reference list for the potentially many participants in a workflow process such as RFI.  Each is a business party that has a specific role in a construction project as as GC or Architect.  However, an outside authority with oversight such as a governmental highway authority can also be a participant.</xs:documentation>
              <xs:documentation>Each participant also has a contribution to the workflow such as responding to assigned work, marking remarks, adding attachments and issuing receipts for documents received.  Contributions are indicated elsewhere in a BOD by making a simple reference to the Participant/ID field.</xs:documentation>
              <xs:documentation>Each participant can also declare scheme agency ids or root prefixes for scheme agency ids.  This facility enables the pairing an id used elsewhere in the BOD with a specific participant.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element ref="Receipt" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>A workflow, such as  RFI, can include confirmed tracking for recipients, such as a governmental highway authority, that legally must receive copies of the final documents.</xs:documentation>
              <xs:documentation>Much like a CC list on an email in concept, the list of receipts show who has received these final copies.</xs:documentation>
              <xs:documentation>Unlike the CC list on an email, though, the evidence supports non-repudiation needed in a legal setting when years later after a road construction project completes, a lawyer investigates the history of work done (RFIs) to see who is responsible for a law suit.</xs:documentation>
              <xs:documentation>A receipt here is not a suggested or best effort list like a CC on an email is.  Rather, a receipt is a document reference or attachment such as a signed PDF from the recipient affirming appropriate procedures.  A reference to a non-electronic document can also be used.</xs:documentation>
              <xs:documentation>This approach allows whatever mechanism is needed to sustain a legal investigation to be part of the electronic record.</xs:documentation>
              <xs:documentation>The receipt also serves as a placeholder while a workflow (RFI) is in progress for an "intended receipt."  Here, the analogy is closer to a CC list while the work is still in progress.  The intended receipt also has value after the work completes if the intent could not be fulfilled.  The intended receipt documents completion but that a receipt could not be obtained; while not obtaining a receipt has legal issues, the emphasis here is that the state of receipt collection can be part of the record.</xs:documentation>
              <xs:documentation>It is possible that the receipt is just a type of attachment or reference rather than a distinguished field.  Other types of authorization are needed in other parts of agcXML such as signatories on a change order.  These signatories also have to withstand legal evidence scruitiny.  It is unlikely that the mere existence of an electronic transaction will be used as the evidence.</xs:documentation>
              <xs:documentation>The value of having such a reference here is that it gives party B the electronic opportunity to download and examine the evidence.  Otherwise, an out-of-band communication is required that would slow down the business process unnecessarily.</xs:documentation>
              <xs:documentation>While it is not required that a referenced document be downloadable through automation, it is allowed.  This means that the business parties can streamline the buiness process to the level of their comfort.</xs:documentation>
              <xs:documentation>To be more specific, party A might not be willing to make all of its legally binding documents downloadable.</xs:documentation>
              <xs:documentation>TODO:  Receipts are currently being modeled while agcXML is an Alpha.  For now, an open content model is used.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="IssuedBy" type="ParticipantRefType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Reference to the participant (person and organization) that is submitting the RFI and requesting a reply.</xs:documentation>
              <xs:documentation>For example, this can be a general contractor, a construction manager or a prime designer such as an architect.</xs:documentation>
              <xs:documentation>In general, though, any role within a construction project can issue an RFI.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="IssuedOn" type="DateTimeType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Timestamp for when the RFI was issued.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="CreatedBy" type="ParticipantRefType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>An identifier for a Participant in this RFI given credit for creating this RFI.  Who actually creates the RFI record is not prescribed by agcXML.</xs:documentation>
              <xs:documentation>This participant is different than a respondent.  It is generally set to a managing participant of an RFI (such as the prime contractor, the prime designer, or the construction manager) who actually delegates work to respondents.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="CreatedOn" type="DateTimeType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The timestamp for when the RFI record was created.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Failure" type="platform:FailureType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Information about a problem, possible symptoms that may lead to the problem, and the cause and remedy for the problem.</xs:documentation>
              <xs:documentation>Causes and remedies can be part of multi-level reporting. For example, a failure A can have causes P and Q as factors, and remedies X, Y and Z are to be taken.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    RFIIssue    : RFIIssueType : RFIIssueBaseType : RFILineBaseType : platform:StatusLineBaseType
    RFISubIssue : RFIIssueType : RFIIssueBaseType : RFILineBaseType : platform:StatusLineBaseType

    RFIIssueType : RFIIssueBaseType                                        | RFIIssue Usage
    .......................................................................|......................................................................
        Extension: RFIIssueExtensionType  [0..*]                           | for data not specified in agcXML

    RFIIssueBaseType : RFILineBaseType                                     | RFIIssue Usage
