        platform:LineNumberID     : platform:OpenIDType             [0..1] | line number of this RFI issue or reply
        platform:LineIDSet        : platform:IDSetType              [0..*] | composite line number, if needed
        platform:Description      : platform:DescriptionType        [0..*] | issue or reply in plain text
        platform:Note             : platform:NoteType               [0..*] | discussion among RFI participants on this issue or reply
        platform:DocumentReference: platform:DocumentReferenceType  [0..*] | references to external documents for this issue or reply
        platform:Attachment       : platform:AttachmentType         [0..*] | inline attachment of documents for this issue or reply
        platform:Status           : platform:StatusType             [0..*] | 
  -->
  <xs:element name="RFIIssue" type="RFIIssueType">
    <xs:annotation>
      <xs:documentation>An issue in an RFI.  Issues and replies have identical fields except that an issue has the field RFIReply.  See RFILineBaseType for details.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="RFISubIssue" type="RFIIssueType">
    <xs:annotation>
      <xs:documentation>A sub-issue in an RFI.  Issues and replies have identical fields except that an issue has the field RFIReply.  See RFILineBaseType for details.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="RFIIssueType">
    <xs:annotation>
      <xs:documentation>An issue in an RFI.  Issues and replies have identical fields except that an issue has the field RFIReply.  See RFILineBaseType for details.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="RFIIssueBaseType">
        <xs:sequence>
          <xs:element name="Extension" type="RFIIssueExtensionType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Allows additional information not captured in the agcXML specification.</xs:documentation>
              <xs:documentation>To build an extension, define a new XML schema in a separate XML namespace.</xs:documentation>
              <xs:documentation>To use an extension, import your new  schema into the XML instance for a BOD and add fields to an Extension field. Extension fields can be found in many nouns, headers, components and fields.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="RFIIssueBaseType">
    <xs:annotation>
      <xs:documentation>A base type used to define RFIIssueType.  All content for RFIIssueType is defined here except for RFIIssueType.Extension.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="RFILineBaseType">
        <xs:sequence>
          <xs:element ref="RFIReply" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>A reply to this issue</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

