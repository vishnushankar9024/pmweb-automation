  <!--
      WSDL messages
          One message for each of the noun's BODs
  -->
  <ws:message name="AcknowledgeRFI">
    <ws:part name="Message" element="gc:AcknowledgeRFI"></ws:part>
  </ws:message>
  <ws:message name="CancelRFI">
    <ws:part name="Message" element="gc:CancelRFI"></ws:part>
  </ws:message>
  <ws:message name="CancelAcknowledgeRFI">
    <ws:part name="Message" element="gc:CancelAcknowledgeRFI"></ws:part>
  </ws:message>
  <ws:message name="ChangeRFI">
