  <!--
      One WSDL portType for the noun
          There is one operation for each of the noun's action verb BODs such as Process RFI.
          The input message is the BOD.  The output message message is the response BOD such as AcknowledgeRFI.
          The fault message is the generic ConfirmBOD.
  -->
  <ws:portType name="RFI_PortType">
    <ws:operation name="CancelRFI">
      <ws:input message="tns:CancelRFI"></ws:input>
      <ws:output message="tns:CancelAcknowledgeRFI"></ws:output>
      <ws:fault message="tns:ConfirmBOD" name="CancelRFIFault"></ws:fault>
    </ws:operation>
    <ws:operation name="ChangeRFI">
      <ws:input message="tns:ChangeRFI"></ws:input>
      <ws:output message="tns:ChangeAcknowledgeRFI"></ws:output>
      <ws:fault message="tns:ConfirmBOD" name="ChangeRFIFault"></ws:fault>
    </ws:operation>
    <ws:operation name="GetRFI">
      <ws:input message="tns:GetRFI"></ws:input>
      <ws:output message="tns:ShowRFI"></ws:output>
      <ws:fault message="tns:ConfirmBOD" name="GetRFIFault"></ws:fault>
    </ws:operation>
    <ws:operation name="ProcessRFI">
      <ws:input message="tns:ProcessRFI"></ws:input>
      <ws:output message="tns:AcknowledgeRFI"></ws:output>
      <ws:fault message="tns:ConfirmBOD" name="ProcessRFIFault"></ws:fault>
    </ws:operation>
    <ws:operation name="NotifyRFI">
      <ws:input message="tns:NotifyRFI"></ws:input>
      <ws:output message="tns:ConfirmBODRFI"></ws:output>
      <ws:fault message="tns:ConfirmBOD" name="NotifyRFIFault"></ws:fault>
    </ws:operation>
    <ws:operation name="ShowRFI">
      <ws:input message="tns:ShowRFI"></ws:input>
      <ws:output message="tns:ConfirmBODRFI"></ws:output>
      <ws:fault message="tns:ConfirmBOD" name="ShowRFIFault"></ws:fault>
    </ws:operation>
    <ws:operation name="SyncRFI">
      <ws:input message="tns:SyncRFI"></ws:input>
      <ws:output message="tns:SyncResponseRFI"></ws:output>
      <ws:fault message="tns:ConfirmBOD" name="SyncRFIFault"></ws:fault>
    </ws:operation>
  </ws:portType>
