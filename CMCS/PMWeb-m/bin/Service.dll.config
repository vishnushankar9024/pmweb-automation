<?xml version="1.0"?>
<configuration>
    <system.web>
        <compilation debug="true" strict="false" explicit="true" targetFramework="4.5" />
        <httpRuntime targetFramework="4.5" maxRequestLength="2147483647"  />
      <!--<httpModules>
        <add name="WcfReadEntityBodyModeWorkaroundModule"   type="Service.WcfReadEntityBodyModeWorkaroundModule, Service"/>
      </httpModules>-->
    </system.web>
  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true"/>
    <add key="wcf:serviceHostingEnvironment:useClassicReadEntityBodyMode" value="true" />
    <add key="SQLBinaryChunkSize" value="512000"/>
    <add key="SupportedAppVersions" value="6.0.02;6.0.03;7"/>
    <add key="ResponseBinaryChunkSize" value="10000"/>
   <add key="SendExp" value="True"/>
    <add key="SendExpEmail" value="nem@pssgroup.com"/>
     <add key="PasswordMigration" value="true"/>
  <add key="ceTe.LicenseKey" value="RST20NXDCLBNIFIF/psFxLVaXOtG6CvBVnny1RuKfMWOeFxuVXeSLMenl0edAIDRwg00qnL2KuiHZ60sezAmctmuICgdEJOzqPeA"/>
  </appSettings>
    <system.serviceModel>
      <protocolMapping>
        <add scheme="http" binding ="webHttpBinding"/>
        <add scheme="https" binding ="webHttpBinding"/>
      </protocolMapping>
      <extensions>
        <behaviorExtensions>
          <add name="ErrorLogging" type="Service.ErrorHandlerBehavior, Service" />
        </behaviorExtensions>
      </extensions>
      <bindings>
      <webHttpBinding>
        <binding transferMode="Streamed" name="httpBinding"></binding>
        <binding transferMode="Streamed" name="httpsBinding">
          <security mode="Transport"></security>
        </binding>
      </webHttpBinding>
    <customBinding>
      <binding name="BinaryCompressionBinding">
        <binaryMessageEncoding compressionFormat="GZip"></binaryMessageEncoding>
      <httpTransport/>
      </binding>
    </customBinding>
    </bindings>
        <serviceHostingEnvironment aspNetCompatibilityEnabled="true"
            minFreeMemoryPercentageToActivateService="0" multipleSiteBindingsEnabled="true" />
        <services>
            <service behaviorConfiguration="Default" name="Service.Login">
                <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.ILogin" bindingConfiguration="httpBinding"/>
                <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.ILogin" bindingConfiguration="httpsBinding"/>-->
            </service>
            <service behaviorConfiguration="Default" name="Service.RFI">
                <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IRFI" bindingConfiguration="httpBinding"/>
                <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IRFI" bindingConfiguration="httpsBinding"/>-->
            </service>
            <service behaviorConfiguration="Default" name="Service.PunchLists">
                <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IPunchLists" bindingConfiguration="httpBinding"/>
                <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IPunchLists" bindingConfiguration="httpsBinding"/>-->
            </service>
            <service behaviorConfiguration="Default" name="Service.DailyReports">
                <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IDailyReports" bindingConfiguration="httpBinding"/>
                <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IDailyReports" bindingConfiguration="httpsBinding"/>-->
            </service>
            <service behaviorConfiguration="Default" name="Service.Common">
                <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.ICommon" bindingConfiguration="httpBinding"/>
                <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.ICommon" bindingConfiguration="httpsBinding"/>-->
            </service>
            <service behaviorConfiguration="Default" name="Service.PMWebViewer">
                <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IPMWebViewer" bindingConfiguration="httpBinding"/>
                <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IPMWebViewer" bindingConfiguration="httpsBinding"/>-->
            </service>
            <service behaviorConfiguration="Default" name="Service.Upload">
                <endpoint address="" behaviorConfiguration="webBehavior"  binding="webHttpBinding" bindingConfiguration="httpBinding" contract="Service.IUpload" />
                <!--<endpoint address="" behaviorConfiguration="webBehavior"  binding="webHttpBinding" bindingConfiguration="httpsBinding" contract="Service.IUpload" />-->
            </service>
            <service behaviorConfiguration="Default" name="Service.SafetyForms">
                <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.ISafetyForms" bindingConfiguration="httpBinding"/>
                <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.ISafetyForms" bindingConfiguration="httpsBinding"/>-->
            </service>
          <service behaviorConfiguration="Default" name="Service.WorkRequests">
            <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IWorkRequests" bindingConfiguration="httpBinding"/>
            <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IWorkRequests" bindingConfiguration="httpsBinding"/>-->
          </service>
          <service behaviorConfiguration="Default" name="Service.WorkOrders">
            <endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IWorkOrders" bindingConfiguration="httpBinding" />
            <!--<endpoint address="" behaviorConfiguration="webBehavior" binding="webHttpBinding" contract="Service.IWorkOrders" bindingConfiguration="httpsBinding" />-->
          </service>
        </services>
       
        <behaviors>
            <endpointBehaviors>
                <behavior name="webBehavior">
                    <webHttp helpEnabled="true"  />
                </behavior>
                <behavior name="Service.RFIAspNetAjaxBehavior">
                    <enableWebScript />
                </behavior>
                <behavior name="Service.PMWebViewerAspNetAjaxBehavior">
                    <enableWebScript />
                </behavior>
            </endpointBehaviors>
            <serviceBehaviors>
                <behavior name="Default">
                    <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
                    <ErrorLogging />
                </behavior>
                <behavior name="">
                    <serviceMetadata httpGetEnabled="true"  httpsGetEnabled="true"/>
                    <serviceDebug includeExceptionDetailInFaults="false" />
                </behavior>
            </serviceBehaviors>
        </behaviors>
    </system.serviceModel>
  <!--<system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483647"></requestLimits>
      </requestFiltering>
    </security>
  </system.webServer>-->
</configuration>



        