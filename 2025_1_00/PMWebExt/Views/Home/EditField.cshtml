@model PMWebExtLib.Models.EditField
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PMWeb</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <script type="text/javascript" src="~/Scripts/jquery-3.4.1.min.js"></script>
    <style>
        body{
            padding:10px;
        }
    </style>
</head>
<body>
    <div>
        @using (Html.BeginForm("EditField", "Home", FormMethod.Post))
        {
            @Html.HiddenFor(model => model.EditTypeId)
            @Html.HiddenFor(model => model.RecordId)
            @Html.HiddenFor(model => model.LabelString)
            <div class="form-group">
                <label for="Content">@Model.LabelString</label>
                @Html.TextAreaFor(model => model.Content, new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        }
    </div>
</body>
</html>
