                          const url = `Requisitions.aspx?Id=${id}&ModuleId=3&PageId=173`;
                            window.location.href = generateIframeUrl(url);
                              break;
                              }
                    case "GenerateTimesheet": {
                        const url = `TimeSheets.aspx`;
                        window.location.href = generateIframeUrl(url);
                        break;
                    }
                    case "GenerateProduction": {
                        const url = `CostManagementProductions.aspx`;
                        window.location.href = generateIframeUrl(url);
                        break; 
                    } 
                    case "GenerateChangeEvent": {
                        const id = event.data.id;
                        const url = `ChangeEvents.aspx?Id=${id}&ModuleId=3&PageId=109`;
                        window.location.href = generateIframeUrl(url);
                        break;
                    }
                    case "GenerateWorkRequest": {
                        const id = event.data.id;
                        const url = `TenantRequests.aspx?Id=${id}&ModuleId=7&PageId=71`;
                        window.location.href = generateIframeUrl(url);
                        break;
                    }
                    case "GenerateWorkOrder": {
                        const id = event.data.id;
                        const url = `WorkOrders.aspx?Id=${id}&ModuleId=5&PageId=70`;
                        window.location.href = generateIframeUrl(url);
                        break;
                    }
                    case "GenerateInitiative": {
                        const id = event.data.id;
                        const url = `InitiativesBudget.aspx?Id=${id}&ModuleId=1&PageId=190`;
                        window.location.href = generateIframeUrl(url);
                        break;
                    }
                    case "GenerateProject": {
                        const PageId = event.data.pageId || 0;
                        const Source = event.data.source || "";
                        return OpenPOPUpToRedirect(`AddInitiativeFromTemplatePopup.aspx?PageId=${PageId}&Source=${Source}`, 1020, 520);
                        break;
                    }
                    case "GenerateMultipleRevisions":
                        OpenPOPUp('MultipleRivisionPopup.aspx', 1300, 500, true);
                        break;
                    case "OpenviewAttachmentPopup": {
                        const objectType = event.data.objectType;
                        const lineId = event.data.lineId;
                        const recordId = event.data.recordId
                        const entityTypeId = event.data.entityTypeId;
                        const entityId = event.data.entityId;
                        const isLastRevision = event.data.isLastRevision;
                        const gridKeyName = event.data.gridkeyName;
                        const CanEdit = event.data.canEdit;
                        OpenviewAttachmentPopupFromPWA(objectType, lineId, recordId, entityTypeId, entityId, isLastRevision, gridKeyName, CanEdit);
                        break;
                    }
                    case "OpenInspectionSelectAsset": {
                        const projectId = event.data.projectId;
                        const gridkeyName = event.data.gridkeyName;
                        const inspectionId = event.data.inspectionId;
                        OpenSelectInspectionAssetPopupFromPWA(projectId, gridkeyName, inspectionId)
                        break;
                    }
                    case "OpenCostWorksheetPopup": {
                        const projectId = event.data.projectId;
                        const costCodeId = event.data.costCodeId;
                        const gridkeyName = event.data.gridkeyName;
                        OpenCostWorksheetPopupFromPWA(projectId, costCodeId, gridkeyName);
                        break;
                    }
                    case "GoToPMWebURL":
                        window.location = generateIframeUrl(event.data.url);
                        break;
                    case "OpenUrlInNewTab":
                        window.open(event.data.url, "_blank");
                        break;
                    case "OpenUrlInNewWindow":
                        var left = (screen.width - 600) / 2;
                        var top = (screen.height - 400) / 2;
                        window.open(event.data.url, "_blank", "location=0,status=0,menubar=1,addressbar=0,resizable=1,scrollbars=1,width=700,height=400,top=" + top + ",left=" + left);
                        break;
                    case "OpenNotificationPopup": {
                        const objectType = event.data.objectType;
                        const recordId = event.data.recordId
                        const recordDescription = event.data.recordDescription
                        const entityTypeId = event.data.entityTypeId;
                        const entityId = event.data.entityId;
                        const customFormTypeId = event.data.customFormTypeId;
                        const attachmentId = event.data.attachmentId ?? 0;
                        const gridKeyName = "NOTIFICATIONLOG_VIEW";
                        OpenNotificationPopupForPWA(objectType, recordId, recordDescription, entityId, entityTypeId, customFormTypeId, attachmentId, gridKeyName);
                        break;
                    }
                    case "OpenNotificationLogPopup": {
                        const logId = event.data.logId;
                        const objectType = event.data.objectType;
                        const recordId = event.data.recordId
                        const recordDescription = event.data.recordDescription
                        const entityTypeId = event.data.entityTypeId;
                        const entityId = event.data.entityId;
                        const customFormTypeId = event.data.customFormTypeId;
                        const canEdit = event.data.canEdit ?? 1;
                        const gridKeyName = "NOTIFICATIONLOG_VIEW"
                        OpenNotificationLogPopupForPWA(logId, recordDescription, objectType, recordId, customFormTypeId, canEdit, entityId, entityTypeId, gridKeyName)
                        break;
                    }
                    case "OpenAttributesPopup": {
                        const FolderId = event.data.folderId;
                        const AllowVersioning = event.data.allowVersioning;
                        const UploadedFiles = event.data.uploadedFiles;
                        const paramJson = JSON.stringify({ 'FileNames': UploadedFiles, 'FolderId': FolderId });
                        $.ajax({
                            type: "POST",
                            url: "AjaxService.aspx/FillAttributeFiles",
                            contentType: "application/json; charset=utf-8",
                            data: paramJson,
                            dataType: "json",
                            async: false,
                            success: function (data) {
                                OpenAttributesPopup(FolderId, AllowVersioning)
                            },
                            error: function (data) {
                                console.log('The action could not be taken, please refresh the page and try again.');
                            }
                        });
                        break;
                    }
                    case "DownloadSharepoint": {
                        const paramJson = JSON.stringify({ 'Url': event.data.url });
                        $.ajax({
                            type: "POST",
                            url: "AjaxService.aspx/DownloadSharepoint",
                            contentType: "application/json; charset=utf-8",
                            data: paramJson,
                            dataType: "json",
                            async: false,
                            success: function (data) {
                                const result = data.d;
                                window.open('Downloader.aspx?ParentFolder=Temp&Rand=' + result.Rand.toString() + '&FullFileName=' + result.FullFileName + '&FileName=' + result.FileName);
                            },
                            error: function (data) {
                                console.log('The action could not be taken, please refresh the page and try again.');
                            }
                        });
                        break;
                    }
                    case "OpenGoogleAddressesPicker": {
                        const Id = event.data.id;
                        const browserWidth = $telerik.$(window).width();
                        const browserHeight = $telerik.$(window).height();
                        if (Id > 0) {
                            const wnd = window.radopen("GoogleAddressesPicker.aspx?RecordType=ATTACHMENTS&ObjectId=" + Id + "&PickerSender=RecordAddress&Source=ngEditAttachments");
                            wnd.set_visibleTitlebar(false);
                            wnd._topResizer.parentElement.className = "";
                            const divWindow = wnd._popupElement;
                            divWindow.classList.add("rwFolderManager");

                            if (isMobileScreen()) {
                                wnd.setSize(browserWidth - 10, browserHeight - 10);
                                wnd.moveTo(8, 0);
                            }
                            else {
                                wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                                wnd.Center();
                            }
                        }
                        break;
                    }
                    case "SendToStudio": {
                        const Id = event.data.id;
                        const recordId = event.data.recordId;
                        const recordType = event.data.recordType;
                        const entityId = event.data.entityId;
                        const entityTypeId = event.data.entityTypeId;
                        return OpenWindowPOPUp('CompaniesFilterPopup.aspx?txtContact=NOTExist&txtEmail=NOTExist&Type=Contacts&txtIds=NotExist&ddlType=Multiple&Source=BLUEBEAMMARKUPS&ProjectId=0&ProjectRequired=0&FileIds=' + Id.toString() + '&FilesSource=UPLOAD&RecordId=' + recordId.toString() + '&RecordType=' + recordType.toString() + '&EntityId=' + entityId.toString() + '&EntityTypeId=' + entityTypeId.toString(), 900, 420);
                        break;
                    }
                    case "Open3dViewer": {
                        const paramJson = JSON.stringify({ 'AutodeskForgeFileURN': event.data.AutodeskForgeFileURN });
                        $.ajax({
                            type: "POST",
                            url: "AjaxService.aspx/SetAutodeskForgeFileURN",
                            contentType: "application/json; charset=utf-8",
                            data: paramJson,
                            dataType: "json",
                            async: false,
                            success: function (data) {
                                const Guid = event.data.Guid;
                                const ObjectId = event.data.ObjectId;
                                const ObjectType = event.data.ObjectType;
                                Open3DViewer(ObjectType, ObjectId, Guid)
                            },
                            error: function (data) {
                                console.log('The action could not be taken, please refresh the page and try again.');
                            }
                        });
                        break;
                    }
                    case "Add3dViewer": {
                        const FullFileName = event.data.FullFileName;
                        OpenUploadandViewAutodeskForgeFile('ngAttachments', FullFileName, 'rdgDocumentAttachments')
                        break;
                    }
                    case "OpenEsignAttachmentsPopup": {
                        const objectType = event.data.objectType;
                        const recordId = event.data.recordId;
                        const workflowStepId = event.data.workflowStepId;
                        const workflowDocumentId = event.data.workflowDocumentId;
                        const workflowDocumentNumber = event.data.workflowDocumentNumber;
                        const workflowDocumentDescription = event.data.workflowDocumentDescription;
                        const customFormTypeId = event.data.customFormTypeId || 0;
                        const isDocuSignStep = event.data.isDocuSignStep;
                        const isAdobeSignStep = event.data.isAdobeSignStep;

                        const url = `ESignAttachmentPopup.aspx?stepId=${workflowStepId}&objectType=${encodeURIComponent(objectType)}&recordId=${encodeURIComponent(recordId)}&workflowDocumentId=${encodeURIComponent(workflowDocumentId)}&workflowDocumentNumber=${encodeURIComponent(workflowDocumentNumber)}&workflowDocumentDescription=${encodeURIComponent(workflowDocumentDescription)}&customFormTypeId=${encodeURIComponent(customFormTypeId)}&isDocuSignStep=${encodeURIComponent(isDocuSignStep)}&isAdobeSignStep=${encodeURIComponent(isAdobeSignStep)}&isFromPWA=true`;

                        OpenPopupAttachToEmail(url, 900, 600);
                        break;
                    } case "RedirectToUrl": {
                        window.location = generateIframeUrl(event.data.url);
                        break;
                    } case "globalPMWebShortcuts":{
                        if (!event.data.currEvent.preventDefault)
                            event.data.currEvent.preventDefault = () => {};
                        globalPMWebShortcuts(event.data.currEvent);
                    	break;
                    } case "CloseSegmants": {
  			            CloseSegment();
                        break;
                    } case "GoToRecord": {
                        if (CheckDirt2() === false) {
                            return;
                        }
  			            window.location = generateIframeUrl(event.data.recordurl);
	                    break;	
                    } case "GoToPage": {
                        if (CheckDirt2() === false) {
                            return;
                        }
  			            window.location = generateIframeUrl(event.data.pageUrl);
	                    break;	
                    } case "GoToManagerPage": { 
                        if (CheckDirt2() === false) {
                            return;
                        }
  			            window.location = generateIframeUrl(event.data.managerPageUrl);
	                    break;	
                    }
                    case "GoToUniversity": {
                        window.open("TrainingAuthService.aspx", '_blank');
                        break;
                    }
                    case "resize": {
                            const width = event.data.width;
                            const iframe = document.querySelector('.ProjectExplorerngFrame');
                            const flyout = document.querySelector('.flyoutPopup');

                            if (!iframe || !flyout) return;

                           
                            iframe.style.width = width + 'px';
                            iframe.style.visibility = 'visible'; 


                            flyout.style.width = width + 'px';
                            //flyout.classList.add('open');
                            flyout.style.top = '75px';
                           
                         
                            //    flyout.style.zIndex = 7003;
                           
                        break;
                    }
                    case "showHideRail": {
                        ShowHideRail();

                        break;
                    }
                    case "NavigateToProfile": {
                        if (CheckDirt2() === false) {
                            return;
                        }
                          const url = `Profile.aspx`;
                          window.location.href = url;
                          break; 
                      } 
                    case "ProjectExplorerNodeClicked": {
                        const flyout = document.querySelector('.flyoutPopup');
                        if (flyout) {
                            flyout.classList.remove('open');
                            flyout.style.display = "none";
                        }
                        $("[id$=btnSaveLoginId]")[0].click();
                        
                        break;
                        
                    }
                    case "PrintLienWaiver": {
                              openPrintLienWaiverReport(event.data.invoiceTypeId,event.data.projectId,event.data.commitmentId,event.data.progressInvoiceId);
                           break; 
                       } 

                }
            });

            function openPrintLienWaiverReport(InvoiceTypeId,ProjectId,CommitmentId,ProgressInvoiceId) {
                    var browserWidth = $telerik.$(window).width();
                    var browserHeight = $telerik.$(window).height();
                    var left = (screen.width - 900) / 2;
                    var top = (screen.height - 500) / 2;
                    var wnd = window.radopen('PrintPreview.aspx?InvoiceTypeId=' + InvoiceTypeId + '&ProjectId=' + ProjectId+ '&CommitmentId=' + CommitmentId+ '&ProgressInvoiceId=' + ProgressInvoiceId, "");
                    if (isMobileScreen()) {
                        wnd.setSize(browserWidth - 10, browserHeight - 10);
                        wnd.moveTo(8, 0);
                    }
                    else {
                        wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                        wnd.Center();
                    }
            }
            

            function OpenUploadandViewAutodeskForgeFile(source, fileName, gridId) {
                //OpenPOPUp('UploadAndViewAutodeskForgefilePopup.aspx?Source=' + source + '&FileGuid=' + strguid, 300, 200, true, gridId);
                var browserWidth = $telerik.$(window).width();
                var browserHeight = $telerik.$(window).height();
                var wnd = window.radopen('UploadAndViewAutodeskForgefilePopup.aspx?Source=' + source + '&FileName=' + fileName);
                    var divWindow = wnd._popupElement;
                wnd.set_visibleTitlebar(false);
                wnd._topResizer.parentElement.className = "";
                divWindow.classList.add("rwFolderManager");
                if (isMobileScreen()) {
                    if (URL.indexOf("Notification.aspx") > -1 || URL.indexOf("NotificationLog.aspx") > -1)
                        wnd.setSize(browserWidth, browserHeight);
                    else
                        wnd.setSize(browserWidth - 10, browserHeight);
                    wnd.moveTo(0, 0);
                }
                else {
                    wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                    wnd.Center();
                }
   
                    wnd.add_close(WindowClosed);
                    if (gridId) { GridToRebind = gridId; }
    

                return false;
            }

            function OpenAttributesPopup(FolderId, AllowVersioning) {
                var browserWidth = $telerik.$(window).width();
                var browserHeight = $telerik.$(window).height();
                var wnd = window.parent.radopen('FolderManagerAddFiles.aspx?FolderID=' + FolderId + '&ClearTable=0&AllowVersioning=' + AllowVersioning + '&IsCopyAction=0&IsMoveAction=0&IsFilesLookUp=1&Source=ngFilesLookup');
                var divWindow = wnd._popupElement;
                divWindow.classList.add("rwReminder");
                wnd.set_visibleTitlebar(false);
                wnd._topResizer.parentElement.className = "";
                divWindow.classList.add("rwFolderManager");
                if (isMobileScreen()) {
                    if (URL.indexOf("Notification.aspx") > -1 || URL.indexOf("NotificationLog.aspx") > -1)
                        wnd.setSize(browserWidth, browserHeight);
                    else
                        wnd.setSize(browserWidth - 10, browserHeight);
                    wnd.moveTo(0, 0);
                }
                else {
                    wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                    wnd.Center();
                }
            }
            function SaveExplorerSettings(){
                 const targetWindow = document.getElementById('ctl00_ProjectExplorer1_ProjectExplorerngFrame');
                 if (targetWindow)
                 {
                     const messageData = {
                         event_id: 'SaveSettings'
                     };
                  targetWindow.contentWindow.postMessage(messageData, '*');
                 }
            }
            function TriggerBtnPortfoliobtn() {

                if ($('.flyoutPopup').length == 1 && $('.flyoutPopup').hasClass('open')) {
                    var flyout = document.querySelector(".flyoutPopup");
                    SaveExplorerSettings();
                    flyout.classList.remove('open');
                    flyout.classList.add('Hide');
                    FlyoutIsOpen = false;
                    return;
                }
                else {
                    var flyout = document.querySelector(".flyoutPopup");
                    var element = document.querySelector(".BreadCrumb-custom-dropdown");

                    if (!flyout || !element) return;


                    const x = element.getClientRects()[0].x;
                    flyout.style.left = x + "px";

                   
                    flyout.classList.remove("Hide");
                
                    flyout.style.display = "unset";
                    flyout.classList.add('open');
                    flyout.style.top = '75px';
                    FlyoutIsOpen = true;
                   
                }
                <%--var btnPortfolio = document.getElementById('<%= btnPortfolio.ClientID%>');
                btnPortfolio.click();--%>

            }
   
       function UpdateTabCount(tbName, newcount) {
                const container = document.querySelector("div[id$='tbsDocument']");
                if (!container) return;
                const selectedTab = container.querySelector("a.rtsLink.rtsSelected");
                if (!selectedTab) return;
                const textSpan = selectedTab.querySelector("span.rtsTxt");
                if (!textSpan) return;
 
                const originalText = textSpan.textContent;
                let displayCount;
                if (tbName == 'Workflow' && newcount.includes('$$')) {
                    const parts = newcount.split('$$');
                    displayCount = ` (${parts[0]}/${parts[1]})`;
                    window.location.href = window.location.href.replace(/&?Workflow=O/, '') + '&Workflow=O';
                    return;
                } else if ((tbName == 'Workflow' && !newcount.includes('$$'))) {
                    displayCount = '';
                    window.location.href = window.location.href.replace(/&?Workflow=O/, '') + '&Workflow=O';
                    return;
                }
                 else if ( newcount == '0') {
                       displayCount = '';
                }
				else {
                    displayCount = ` (${newcount})`;
 
                }
                const updatedText = originalText.replace(/\s*\(\d+\/?\d*\)$/, '').replace(/\s*\(\d+\)$/, '') + displayCount;
                textSpan.textContent = updatedText;
 
                PageMethods.UpdateTabCount(tbName, newcount);
                return false;
            }

        </script>
        <asp:ScriptManager ID="PMScriptManager" runat="server" EnableScriptGlobalization="True" EnablePageMethods="true"
