        <%-- Comment out to put the footer in the flex layout instead of fixed position --%>
        <%--<div class="flex-column">--%>

        <div class="main-layout">

            <div class="drawer">
                <div class="drawer-modules">

                    <div class="logo-container">
                        <asp:ImageButton runat="server" ImageUrl="~/CSS/Images/largemenuicon.png" ID="imgDrawerLogo" CssClass="imgDrawerLogo" OnClientClick="return CheckDirtOnLogo();" />

                        <asp:Image ID="ImageRail" runat="server" CssClass="imgRailClosed" ImageUrl="~/CSS/Images/smallmenuicon.png" onmouseover="this.style.cursor='pointer'" onclick="return CheckDirtOnLogo();" />

                        <asp:Image ID="imgLogo" runat="server" CssClass="imgPhoneLogo" ImageUrl="~/CSS/Images/largemenuicon.png" onmouseover="this.style.cursor='pointer'" onclick="return CheckDirtOnLogo();" />
                    </div>


                    <div class="Module">
                        <div class="nav">
                            <asp:Repeater ID="rptModules" runat="server">
                                <ItemTemplate>
                                    <asp:LinkButton runat="server" CssClass="nav-link tooltip-link" ID="btnModule"
                                        OnClientClick="return OpenFlyoutMenu(this)"
                                        CommandArgument='<%# Container.DataItem("Id") %>'
                                        data-CommandArgument='<%# Container.DataItem("Id") %>'>
                                              <table>
                                                 <tr>
                                                    <td>
                                                      <div class="<%# Eval("Icon") %>">&nbsp;</div>
                                                    </td>
                                                     <td class="text">
                                                         <span><%# Eval("Text") %></span>
                                                     </td>
                                                   </tr>
                                                </table>
                                    </asp:LinkButton>
                                </ItemTemplate>
                            </asp:Repeater>
                        </div>
                    </div>
                </div>

                <div class="border"></div>

                <div class="Module Utility" style="margin-right: 16px;">
                    <div class="menuBottomSection">

                        <asp:LinkButton runat="server" CssClass="nav-link tooltip-link" ID="btnMenuRecent" OnClientClick="return OpenRecentDocuments();" Visible="true">
                   <table>
                       <tr>
