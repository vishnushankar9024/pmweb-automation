    <script type="text/javascript">

        //window.addEventListener('load', function () {
        //    const iframe = document.getElementById('ctl00_CPH1_ngFrame');
        //    if (iframe != null) {
        //        iframe.addEventListener('load', function () {
        //            iframe.contentWindow.document.addEventListener('keydown', (event) => {
        //            globalPMWebShortcuts();
        //            });
        //        });
        //    }
        //});

          window.addEventListener('keydown', (event) => {
             globalPMWebShortcuts(event);
           });

        function globalPMWebShortcuts(event) {
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "R") {
                event.preventDefault();
                CloseAiAssistant();
                OpenRecentDocuments();
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "E") {
                event.preventDefault();
                OpenReminderPopup();
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "O") {
                event.preventDefault();
                helpClick();
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "U") {
                event.preventDefault();
                OpenPopUp('PMWebUniversity')
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "S") {
                event.preventDefault();
                OpenPopUp('AdvancedSearch');
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "P") {
                event.preventDefault();
                GoToUserProfilePage();
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "H") {
                event.preventDefault();
                RedirectToHomePage();
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "X") {
                event.preventDefault();
                ExitPMWeb();
            }
            if (event.ctrlKey && event.altKey && event.key.toUpperCase() == "M") {
                event.preventDefault();
                goToManagerPageHdn();
            }

        }

        function goToManagerPageShortcut() {
            var Url = window.location.href;
            var PageId = CInt(getPageIdFromUrl(Url));
            var result;
            if (PageId == 0 || PageId == null || PageId == undefined) {
                return;
            }
            $.ajax({
                type: "POST",
                url: "AjaxService.aspx/getManagerPageByShortcut",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ PageId: PageId }),
                dataType: "json",
                async: true,
                success: function (data) {
                    result = data.d;
                    if (result !== "" && result !== null) {
                        window.location = result;
                    }
                },
                error: function (data) {
                    console.log('The action could not be taken, please refresh the page and try again.');
                }
            });
            return result;
        }


        function displaySessionTimeOutPopUp() {
            $.ajax({
                type: "POST",
                url: "AjaxService.aspx/GetSessionState",
                contentType: "application/json; charset=utf-8",
                data: "{}",
                dataType: "json",
                success: function (data) {
                    if (data.d === true) {
                        wndSession = window.radopen('SessionTimeOutPopUp.aspx');
                        $(".rwBodyLeft").remove();
                        $(".rwBodyRight").remove();
                        $(".rwFooterRow").remove();
                        $(".rwTitleRow").remove();
                        $(".rwWindowContent").css("width", "100%");
                        $(".rwWindowContent").css("border-radius", "10px");
                        $(".rwWindowContent").css("overflow", "hidden");
                        $('iframe').css("border-radius", "20px");
                        $(".rwWindowContent").css("box-shadow", "10px 10px 15px rgba(0, 0, 0, 0.5)");
                        $('.TelerikModalOverlay').css({
                            'background-color': 'rgba(0, 0, 0, 0.4)',  
                            'opacity': '1'                              
                        });
                        wndSession.setSize(370, 192);
                        wndSession.center();
                    }
                    setTimeout(displaySessionTimeOutPopUp, EventServiceElapsedTime);

                },
                error: function (data) {
                },
                async: true
            });
        }

        function OpenAiAssistantPopup() {
            if (typeof HideFlyoutMenu == "function")
                HideFlyoutMenu();
            if (wndAiAssistant == null) {
                wndAiAssistant = window.radopen('AiAssistantPopup.aspx');
                wndAiAssistant.add_close(AiAssistantClosed);
            }
            if (wndAiAssistant == null) return;
            $(".rwBodyLeft").remove()
            $(".rwBodyRight").remove()
            $(".rwFooterRow").remove();
            $(".rwTitleRow").remove();
            $(".rwWindowContent").css("width", "100%");
            wndAiAssistant.GetTitlebar().parentElement.hidden = true
            wndAiAssistant.set_modal(false);
            var browserWidth = $telerik.$(window).width();
            var browserHeight = 790;
            var top = 0;
            var botmargin = 0;
            if ($(".bottomtoolbar").length == 1 && $(".bottomtoolbar").css("display") != "none")
                botmargin = $(".bottomtoolbar")[0].offsetHeight;
            else if ($(".MobileFixedMenu").length == 1 && $(".MobileFixedMenu").css("display") != "none") {
                botmargin = 36;
            }
            if (isMobileScreen() && window.innerWidth < 704) {
                wndAiAssistant.setSize(browserWidth, browserHeight);
                wndAiAssistant.moveTo(0, 0);
            }
            else {
                var popupWidth = Math.min(browserWidth * 0.5, 420);
                var XOffset = (browserWidth - popupWidth) / 2;
                wndAiAssistant.setSize(popupWidth, browserHeight * 0.7);
                wndAiAssistant.moveTo(XOffset, browserHeight * 0.15);
            }
            $(".RadWindow")[0].classList.add("aiAssistant");
            $(".RadWindow.aiAssistant").css("position", "fixed");
            if (window.innerWidth >= 704) {
                $(".RadWindow.aiAssistant").css("top", browserHeight * 0.15);
                $(".RadWindow.aiAssistant").addClass("RadRoundedWindow");
                var iframe = wndAiAssistant._iframe;
                iframe.style.borderRadius = "20px";
            }
            $(".TelerikModalOverlay").remove();
            wndAiAssistant.set_behaviors(0);
            return false;
        }

        function OpenReminderPopup() {
            CloseAiAssistant();
            if (document.activeElement.id.toString().includes("_dateInput")) {
                elementIdParts = document.activeElement.id.toString().split('_');
                elementId = elementIdParts[elementIdParts.length - 2];
                rmdElementId = 'rmd_' + elementId;
                rmdSpanElement = $(window.parent.document).find("span[id$=" + rmdElementId + "]")[0];
                if (rmdSpanElement) {
                    OpenReminderPropupFromAiAssistant(rmdSpanElement);
                } else {
                    // Check if it is a specification date field
                    rdpElementId = elementId;
                    rdpSpanElement = $(window.parent.document).find("div[id*=" + rdpElementId + "]")[0];
                    if (rdpSpanElement) {
                        OpenReminderPropupFromAiAssistant(rdpSpanElement);
                    } else {
                        OpenNonLinkedReminderPopup();
                    }
                }
            } else {
                OpenNonLinkedReminderPopup();
            }
        }

        function OpenNonLinkedReminderPopup() {
            var browserWidth = $telerik.$(window.parent).width();
            var browserHeight = $telerik.$(window.parent).height();
            var wnd = window.parent.radopen("DefineReminderPopup.aspx?IsRadMenuItem=1");
            if (isMobileScreenSize()) {
                wnd.setSize(browserWidth - 10, browserHeight);
                wnd.moveTo(0, 0);
            }
            else {
                wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                wnd.Center();
            }
        }

        function OpenPopUp(popupName) {
            CloseAiAssistant();
            if (wndRecentRecords != undefined && wndRecentRecords != null) {
                wndRecentRecords.Close();
                wndRecentRecords = null;
            }
            if (popupName == "PMWebUniversity") {
                window.open("TrainingAuthService.aspx", '_blank');
            } else if (popupName == "AdvancedSearch") {
                window.parent.open("Search.aspx?ModuleId=7&PageId=223", '_self');
            }
        }

        function OpenUserProfilePopup(URL) {
            CloseAiAssistant();
            var browserWidth = $telerik.$(window.parent).width();
            var browserHeight = $telerik.$(window.parent).height();
            var wnd = window.parent.radopen(URL, browserWidth, browserHeight);
            wnd.set_visibleTitlebar(false);
            wnd._topResizer.parentElement.className = "";
            if (isMobileScreenSize()) {
                wnd.setSize(browserWidth - 10, browserHeight);
                wnd.moveTo(0, 0);
            }
            else {
                wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                wnd.Center();
            }
            wnd.get_popupElement().className = wnd.get_popupElement().className + " UserProfilePopup"
            return false;
        }

        function GoToUserProfilePage() {
            window.location.href = 'profile.aspx';
            return false;
        }

        function RedirectToHomePage() {
            CloseAiAssistant();
            window.parent.location.href = 'home.aspx';
        }

        function ExitPMWeb() {
            CloseAiAssistant();
            let btnLogOut = window.parent.$('[id$=btnExit]')[0];
            btnLogOut.click();
        }

        function RedirectToDefault() {
            window.parent.location.href = 'default.aspx';
        }


        function CloseAiAssistant() {
            if (wndAiAssistant && !wndAiAssistant.closed) {
                wndAiAssistant.close();
            }
        }

        var MobileScreenWidth = 1024;
        function isMobileScreenSize() {
            var browserWidth = $telerik.$(window.parent).width();
            if (browserWidth <= MobileScreenWidth)
                return true;
            return false;
        }

        function UpdateAttachmentsTab() {
            let tbsDocument = $find($("[id$=tbsDocument]")[0].id);
            let selectedTab = tbsDocument.get_selectedTab()
            let tab;

            if (selectedTab.get_value() == "Attachments") {
                window.refreshPage();
                window.postMessage('performPostBack', '*'); 
            }
            else {
                let tabs = tbsDocument.get_tabs();
                for (let i = 0; i < tabs.get_count(); i++) {
                    tab = tabs.getTab(i);
                    if (tab.get_value() == "Attachments") {
                        break;
                    }
                }

                let tabText = tab.get_text();
                let match = tabText.match(/\((\d+)\)/);
                let newText;
                if (match && match[1]) {
                    let currentNumber = parseInt(match[1], 10);
                    let newNumber = ++currentNumber;
                    newText = tabText.replace(/\((\d+)\)/, `(${newNumber})`);
                }
                else {
                    newText = `${tabText} (1)`;
                }

                tab.set_text(newText);

            }
        }

        function confirmLogout() {
            var Promt = '<%=PM.UserInfo.LogoutCookieType%>';
            var IsSAMLAuthenticated = '<%=PM.UserInfo.IsSAMLAuthenticated%>';
            var IsLoginCookieSaved = '<%=PM.UserInfo.IsLoginCookieSaved%>';
            var browserWidth = $telerik.$(window).width();
            var browserHeight = $telerik.$(window).height();
            if (Promt == 'Prompt' && IsSAMLAuthenticated == 'False') {
                if (IsLoginCookieSaved == 'True') {
                    var wnd = window.radopen("LogOutPopup.aspx", 'welcome')
                    if (isMobileScreen()) {
                        wnd.setSize(browserWidth - 10, browserHeight);
                        wnd.moveTo(0, 0);
                    }
                    else {
                        wnd.setSize((browserWidth * 0.3) + 20, browserHeight * 0.3);
                        wnd.Center();
                    }

                    return false;
                }
            }
            return true;
        }
        function PMSetFocus(Module) {
            setTimeout(function () {
                if (Module == "Portfolio") {
                    Module = "treePMWebManagement";
                } else {
                    Module = "tree" + Module;
                }
                var tree = $find($("[id$='" + Module + "']")[0].id);
                if (tree != null) {
                    var Node = tree.get_selectedNode();
                    if (Node != null) {
                        Node.scrollIntoView(false);
                    }
                }
            }, 1)

        }
        function SaveSelectedNodes(sender, eventArgs) {
            var i;
            var CollapsedNodes = "";
            var node = eventArgs.get_node();
            var tree = node.get_parent();

            for (var i = 0; i < tree.get_nodes().get_count(); i++) {
                var currNode = tree.get_nodes().getNode(i);
                if (!currNode.get_expanded()) {
                    CollapsedNodes += currNode.get_value() + "*";
                }
            }
            while (tree._parent != null) {
                tree = tree._parent
            }
            setCookie(tree._uniqueId, CollapsedNodes, 60);
        }
        function OpenReceiveEmailPopup(url, Width, Height) {
            var left = (screen.width - Width) / 2;
            var top = (screen.height - Height) / 2;
            window.open(url, 'welcome', 'location=0,status=0,menubar=0,addressbar=0,resizable=1,scrollbars=1,width=' + Width + ',height=' + Height + ',top=' + top + ',left=' + left);
            return false;
        }
        function OpenMenuMasterPageContext(e) {
            var ContextMenu = $find("<%= cmMasterPage.ClientID %>");
            var position = $("#dvMasterPageMenu").position();
            ContextMenu.showAt(position.left + 30, position.top + 22);
            $telerik.cancelRawEvent(e);
        }
        function showToolTip(element, argValue) {
            if (argValue == '') return;
            var tooltipManager = $find("<%= RadToolTipManager1.ClientID %>");
            if (!tooltipManager) return;
            var tooltip = tooltipManager.getToolTipByElement(element);
            if (!tooltip) {
                tooltip = tooltipManager.createToolTip(element);
            }
            tooltip.set_value(argValue);
            element.onmouseover = null;
            tooltip.show();
            element.onmouseover = null;
        }
        function parseDate(arg1, arg2) {

        }
        function OpenEventPopup() {
            var wnd = window.radopen("ViewEventsPopup.aspx");
            wnd.setSize(1100, 465);
            wnd.add_close(ViewPopupColsed);
            wnd.Center();
            return false;

        }
        function ViewPopupColsed(Opener) {
            var btnRefreshId;
            btnRefreshId = $("a[id*=rdgHomeEvents][id$=btnRefresh]");
            if (btnRefreshId.length > 0) { eval(btnRefreshId[0].href.split(":")[1]); }
        }
        function MasterPageContextMenuClicked(sender, args) {
            var menuItem = args.get_item();
            if (menuItem.get_value() == "CreateReminder") {
                ContextCreateReminder();
            }
            else
                if (menuItem.get_value() == "ReceiveEmails") {
                    var ProjectId = '<%=PM.SearchDocumentController.ProjectLoginId%>';
                    if (ProjectId > 0) {
                        var url = 'EmailReceive_Popup.aspx?ProjectId=' + ProjectId;
                        OpenReceiveEmailPopup(url, 430, 240);
                    }
                }
        }
        function ContextCreateReminder() {

            var browserWidth = $telerik.$(window).width();
            var browserHeight = $telerik.$(window).height();
            var wnd = window.radopen("DefineReminderPopup.aspx?IsRadMenuItem=1");
            if (isMobileScreen()) {
                wnd.setSize(browserWidth - 10, browserHeight);
                wnd.moveTo(0, 0);
            }
            else {
                wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                wnd.Center();
            }
            wnd.add_close(RefereshReminderGrid);
            return false;
        }
        function RefereshReminderGrid(Opener) {
            var btnRefreshId;
            btnRefreshId = $("a[id*=rdgReminders][id$=btnRefresh]");
            if (btnRefreshId.length > 0) { eval(btnRefreshId[0].href.split(":")[1]); }
        }

        function CloseSegment() {
            var ParentDiv = document.querySelector(".ModulesParentDiv");
            var HasConditionalSecurityDiv = document.querySelector(".HasConditionalSecurityDiv");
            var flyout = document.querySelector(".flyoutPopup");
            var Id = GetIdFromURL(window.location.href);
            var btnrecords = null;
            if ($("[id$=lnkBtnRecords]").length > 0) {
                btnrecords = document.getElementById($("[id$=lnkBtnRecords]")[0].id);
            }
            
            //var LastSelectedHomeTabId = '<%=  PM.HomeController.LastSelectedHomeTabId%>';
            //if ((window.location.href.includes('home.aspx') || window.location.href.includes('Home.aspx')) && Id == 0) {
            //    Id = LastSelectedHomeTabId
            //}
            if (SegmentOneIsOpen == true || SegmentTwoIsOpen == true || SegmentThreeIsOpen == true) {
                ParentDiv.classList.remove('open');
                ParentDiv.style.display = "none";
                ParentDiv.style.top = '0px';
                SegmentOneIsOpen = false;
                SegmentTwoIsOpen = false;
                SegmentThreeIsOpen = false;
            } else if (hasConditionalSecurityOpen == true) {
                HasConditionalSecurityDiv.classList.remove('open');
                HasConditionalSecurityDiv.style.display = "none";
                HasConditionalSecurityDiv.style.top = '0px';
                hasConditionalSecurityOpen = false;

            }
            else if (FlyoutIsOpen == true) {

                flyout.classList.remove('open');
                flyout.classList.add('Hide');
                SaveExplorerSettings();
                flyout.style.top = '0px';
                FlyoutIsOpen = false;
            }
            if (Id == 0 && btnrecords && btnrecords.text == "Records") {
                btnrecords.text = "";
                var SvgRecords = document.querySelector(".RecordsSvg")
                SvgRecords.style.display = "none";
            }
        }
        function ClickOutside(event) {
            var element = event.target;
            var found = false;
            if (event.target.parentElement == null && !event.target.parentElement == undefined) {
                found = false;
            }

            while (element) {
                if (element.classList != null && element.classList != undefined && element.classList.length > 0 && (element.classList[0].indexOf('ModulesParentDiv') >= 0 || element.classList[0].indexOf('ModulesTabletd') >= 0 || element.classList[0].indexOf('flyoutPopup') >= 0 || element.classList[0].indexOf('rcbSlide') >= 0 || element.classList[0].indexOf('BreadCrumb-custom-dropdown') >= 0 || element.classList[0].indexOf('BreadCrumb-custom-Arrow')) >= 0) {
                    found = true;
                    break;
                }
                element = element.parentElement;
            }
            return found;
        }
        function OpenBreadCrumbSegment(event) {
            var ParentDiv = document.querySelector(".ModulesParentDiv");
            var HasConditionalSecurityDiv = document.querySelector(".HasConditionalSecurityDiv");
            var flyout = document.querySelector(".flyoutPopup");
            const Segments = document.querySelectorAll('.BreadCrumbSegment');
            var BtnRecords = document.getElementById($("[id$=lnkBtnRecords]")[0].id)
            if (event.target.id === Segments[0].id) {
                if ($("[id$=ClearSearchRecordTypes]")[0] != null) {
                    $("[id$=ClearSearchRecordTypes]")[0].style.display = "none";
                }
                if ($("[id$=ClearSearchRecords]")[0] != null) {
                    $("[id$=ClearSearchRecords]")[0].style.display = "none";
                }
            }
            if (event.target.id === Segments[1].id) {
                if ($("[id$=ClearSearchModules]")[0] != null) {
                    $("[id$=ClearSearchModules]")[0].style.display = "none";
                }
                if ($("[id$=ClearSearchRecords]")[0] != null) {
                    $("[id$=ClearSearchRecords]")[0].style.display = "none";
                }
            }
            if (event.target.id === BtnRecords.id) {
                if ($("[id$=ClearSearchRecordTypes]")[0] != null) {
                    $("[id$=ClearSearchRecordTypes]")[0].style.display = "none";
                }
                if ($("[id$=ClearSearchModules]")[0] != null) {
                    $("[id$=ClearSearchModules]")[0].style.display = "none";
                }
            }

            var Id = GetIdFromURL(window.location.href);
            if ((ParentDiv.classList.contains('open') && event.target.id !== $("[id$=btnPortfolio]")[0].id)) {
                if (event.target.id === Segments[0].id) {
                    if (SegmentOneIsOpen == true) {
                        ParentDiv.classList.remove('open');
                        ParentDiv.style.display = "none";
                        ParentDiv.style.top = '0px';
                        SegmentOneIsOpen = false;
                    } else if (SegmentTwoIsOpen == true) {
                        SegmentTwoIsOpen = false;
                        SegmentOneIsOpen = true;
                        ParentDiv.style.display = "none";
                        GenerateModules(event);
                    } else if (SegmentThreeIsOpen == true) {
                        SegmentThreeIsOpen = false;
                        SegmentOneIsOpen = true;
                        ParentDiv.style.display = "none";
                        HasConditionalSecurityDiv.style.display = "none";
                        GenerateModules(event);
                    }

                } else if (event.target.id === Segments[1].id) {

                    if (SegmentTwoIsOpen == true) {
                        ParentDiv.classList.remove('open');
                        ParentDiv.style.display = "none";
                        ParentDiv.style.top = '0px';
                        SegmentTwoIsOpen = false;
                    } else if (SegmentOneIsOpen == true) {
                        SegmentOneIsOpen = false;
                        SegmentTwoIsOpen = true;
                        ParentDiv.style.display = "none";
                        ParentDiv.classList.add('open');
                        ParentDiv.style.top = '108px';
                        GenerateRecordTypes('CurrentModule');
                    } else if (SegmentThreeIsOpen == true) {
                        SegmentThreeIsOpen = false;
                        SegmentTwoIsOpen = true;
                        ParentDiv.style.display = "none";
                        ParentDiv.classList.add('open');
                        ParentDiv.style.top = '108px';
                        HasConditionalSecurityDiv.style.display = "none";
                        GenerateRecordTypes('CurrentModule');
                    }

                } else if (event.target.id === BtnRecords.id) {
                    if (SegmentThreeIsOpen == true && hasConditionalSecurity == false) {

                      //  var LastSelectedHomeTabId = '<%=  PM.HomeController.LastSelectedHomeTabId%>';
                        //if ((window.location.href.includes('home.aspx') || window.location.href.includes('Home.aspx')) && Id == 0) {
                        //    Id = LastSelectedHomeTabId
                        //}

                        ParentDiv.classList.remove('open');
                        ParentDiv.style.display = "none";
                        ParentDiv.style.top = '0px';
                        HasConditionalSecurityDiv.classList.remove('open');
                        HasConditionalSecurityDiv.style.display = "none";
                        HasConditionalSecurityDiv.style.top = '0px';
                        SegmentThreeIsOpen = false;
                        SegmentThreeJustClosed = true;
                        if (Id == 0 && BtnRecords.text == "Records") {
                            BtnRecords.text = "";
                            var SvgRecords = document.querySelector(".RecordsSvg")
                            SvgRecords.style.display = "none";
                        }
                    } else if (SegmentOneIsOpen == true && hasConditionalSecurity == false) {
                        SegmentOneIsOpen = false;
                        SegmentThreeIsOpen = true;
                        ParentDiv.style.display = "none";
                        GetRecords($("[id$=lnkBtnRecords]")[0])
                    } else if (SegmentTwoIsOpen == true && hasConditionalSecurity == false) {
                        SegmentTwoIsOpen = false;
                        SegmentThreeIsOpen = true;
                        ParentDiv.style.display = "none";
                        GetRecords($("[id$=lnkBtnRecords]")[0])
                    }
                }
            } else if (event.target.id === $("[id$=btnPortfolio]")[0].id) {
                if (FlyoutIsOpen == false && (SegmentOneIsOpen == true || SegmentTwoIsOpen == true || SegmentThreeIsOpen == true || hasConditionalSecurityOpen == true)) {
                    ParentDiv.style.display = "none";
                    ParentDiv.classList.remove('open');
                    HasConditionalSecurityDiv.style.display = "none";
                    SegmentOneIsOpen = false;
                    SegmentTwoIsOpen = false;
                    SegmentThreeIsOpen = false;
                    hasConditionalSecurityOpen = false;
                }
                if (FlyoutIsOpen == true) {
                    SaveExplorerSettings();
                    flyout.classList.remove('open');
                    flyout.style.display = "none";
                    flyout.style.top = '0px';
                    FlyoutIsOpen = false;

                } else {
                    //flyout.style.display = "unset";
                    //flyout.classList.add('open');
                    //flyout.style.top = '71px';
                    //setTimeout(function () {
                    //    flyout.style.zIndex = 7003;
                    //}, 500)
                    FlyoutIsOpen = true;
                    if (Id == 0 && BtnRecords.text == "Records") {
                        BtnRecords.text = "";
                        var SvgRecords = document.querySelector(".RecordsSvg")
                        SvgRecords.style.display = "none";
                    }
                }
            } else {
                if (event.target.id === Segments[0].id) {
                    if (HasConditionalSecurityDiv.classList.contains('open') && hasConditionalSecurityOpen == true) {
                        HasConditionalSecurityDiv.style.display = "none";
                        hasConditionalSecurityOpen = false;
                    }
                    if (flyout.classList.contains('open') && FlyoutIsOpen == true) {
                        SaveExplorerSettings();
                        flyout.style.display = "none";
                        FlyoutIsOpen = false;
                    }
                    GenerateModules(event);

                } else if (event.target.id === Segments[1].id) {
                    if (HasConditionalSecurityDiv.classList.contains('open') && hasConditionalSecurityOpen == true) {
                        HasConditionalSecurityDiv.style.display = "none";
                        hasConditionalSecurityOpen = false;
                    }
                    if (flyout.classList.contains('open') && FlyoutIsOpen == true) {
                        SaveExplorerSettings();
                        flyout.style.display = "none";
                        FlyoutIsOpen = false;
                    }
                    GenerateRecordTypes('CurrentModule');
                } else if (event.target.id === BtnRecords.id) {
                    if (flyout.classList.contains('open') && FlyoutIsOpen == true) {
                        SaveExplorerSettings();
                        flyout.style.display = "none";
                        FlyoutIsOpen = false;
                    }
                    if (HasConditionalSecurityDiv.classList.contains('open') && hasConditionalSecurityOpen == true) {
                        HasConditionalSecurityDiv.classList.remove('open');
                        HasConditionalSecurityDiv.style.display = "none";
                        HasConditionalSecurityDiv.style.top = '0px';
                        if (Id == 0 && BtnRecords.text == "Records") {
                            BtnRecords.text = "";
                            var SvgRecords = document.querySelector(".RecordsSvg")
                            SvgRecords.style.display = "none";
                        }

                    } else {
                        GetRecords($("[id$=lnkBtnRecords]")[0])
                    }
                }
            }
        }
        var hasConditionalSecurityOpen = false;
        var SegmentOneIsOpen = false;
        var SegmentTwoIsOpen = false;
        var SegmentThreeIsOpen = false;
        var FlyoutIsOpen = false;
        var DisableLoadMore = false;
        window.onload = function () {
            var divs = document.querySelectorAll('.divBox');
            var divBox = Array.prototype.slice.call(divs);
            divBox.forEach(function (curr) {
                if (curr.innerHTML.trim() === "") {
                    curr.style.display = 'none';
                }
            })
            if ($("[id$=hplCurrency]").length == 0 && $("[id$=lblCurrency]").length == 0) {
                if ($("[id$=trCurrency]").length > 0)
                    $("[id$=trCurrency]")[0].style.display = 'none';
            }
            else {
                if ($("[id$=hplCurrency]").length > 0 && $("[id$=lblCurrency]").length == 0)
                    if ($("[id$=hplCurrency]")[0].className == "SearchButton")
                        if ($("[id$=trCurrency]").length > 0)
                            $("[id$=trCurrency]")[0].style.display = 'none';
            }

            document.addEventListener("click", function (event) {

                if (!event.target.classList.contains("arrow") && !event.target.classList.contains("js_searchFolders") && !(event.target.classList.contains("DocumentMoreResultsBox") || $(event.target).parents('.DocumentMoreResultsBox').length > 0)) {
                    var div = document.querySelector(".FoldersParentDiv");
                    div.style.display = "none";
                }
                const Segments = document.querySelectorAll('.BreadCrumbSegment');
                if (Segments[0] != undefined && (event.target.id === Segments[0].id || event.target.id === Segments[1].id || event.target.id === $("[id$=lnkBtnRecords]")[0].id || event.target.id === $("[id$=btnPortfolio]")[0].id)) {
                    OpenBreadCrumbSegment(event);

                } else if (!ClickOutside(event)) {
                    CloseSegment();

                }

            });

            document.querySelector(".FoldersDiv").addEventListener('scroll', function (event) {
                var FolElem = event.target;
                if (FolElem.scrollHeight - FolElem.scrollTop <= FolElem.clientHeight + 20)
                    DocumentLoadMoreResults();
            });
            document.querySelector(".ModulesDiv").addEventListener('scroll', function (event) {
                var SegmentElement = event.target;
                if (SegmentElement.scrollTop + SegmentElement.clientHeight >= SegmentElement.scrollHeight - 8)
                    if (event.target.classList.contains("RecordsDiv")) {
                        if ($("[id$=txtsearchRecords]")[0] !== undefined) {
                            if ($("[id$=txtsearchRecords]")[0].value == '') {
                                DocumentLoadMoreRecords();
                            }
                        }

                    } else {
                        DocumentLoadMoreRecordTypes();
                    }
            });
            const ua = navigator.userAgent.toLowerCase();

            if (ua.includes("firefox") || (ua.includes("safari") && !ua.includes("chrome") && !ua.includes("chromium"))) {
                $(".divMenuPages .row").each(function () {
                    var lastChild = $(this).children().last();
                    var newWidth = lastChild.position().left - $(this).position().left + lastChild.outerWidth(true);
                    $(this).width(newWidth);
                });
            }

        }

        async function showFolders(event) {
            var div = document.querySelector(".FoldersParentDiv");
            if (!div)
                return;
            div.style.zIndex = 9999;
            div.style.top = "154px";
            var parent;
            if (event.target.tagName == 'path') {
                parent = event.target.parentElement.parentElement.previousElementSibling;
            }
            else {
                parent = event.target.parentElement.previousElementSibling;
            }

            var id = parent.getAttribute("btnid");
            id == -5 ? id = 58 : id = id;
            await getFolders(id);
            //var leftPosition = parent.getClientRects()[0].x - (div.clientWidth - parent.offsetWidth) / 2
            div.style.left = (parent.getClientRects()[0].x) + "px";
        }

        var FolderData = [];
        var FilteredFolders = [];
        var FolderIndex = 0;
        var ResultLength = 100;

        function DocumentLoadMoreResults() {
            var div = $(".FoldersDiv tbody");
            if (FolderIndex == FilteredFolders.length) return;
            var length = FilteredFolders.length;
            if (length > FolderIndex + ResultLength) length = FolderIndex + ResultLength;
            for (i = FolderIndex; i < length; i++) {
                if (window.location.toString().toLowerCase().indexOf("foldermanager") > 0)
                    div.append(`<tr><td><a class="FoldersTable" onclick="FillFolder(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
                else if (window.location.toString().toLowerCase().indexOf("pmwebrecord") > 0)
                    div.append(`<tr><td><a class="FoldersTable" onclick="goToFolder(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
                else
                    div.append(`<tr><td><a class="FoldersTable" onclick="changeCurrentWorkingFolderId(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
            }
            FolderIndex = length;
            $('.DocumentMoreResultsText')[0].innerHTML = (FilteredFolders.length ? '1-' : '0-') + FolderIndex.toString() + ' out of ' + FilteredFolders.length.toString();
        }

        function getFolders(id) {
            return new Promise((resolve, reject) => {
                var div = $(".FoldersDiv tbody");
                var container = $(".FoldersParentDiv");
                FolderData = [];
                FilteredFolders = [];
                $.ajax({
                    type: "POST",
                    url: "AjaxService.aspx/GetFoldersByFolder",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ id: id }),
                    dataType: "json",
                    async: true,
                    success: function (data) {
                        div.empty();
                        $('.js_searchFolders').remove();
                        $('#DocumentMoreResultsBox').remove();
                        container.prepend(`<input type="text" class="js_searchFolders" style="padding-left:24px !Important;" oninput="searchFolders(this)"/>`);
                        if (data.d.length > 0) {
                            FolderData = data.d;
                            FilteredFolders = FolderData;
                            var length = FilteredFolders.length;
                            if (length > ResultLength) length = ResultLength;
                            for (i = 0; i < length; i++) {
                                if (window.location.toString().toLowerCase().indexOf("foldermanager") > 0)
                                    div.append(`<tr><td><a class="FoldersTable" onclick="FillFolder(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
                                else if (window.location.toString().toLowerCase().indexOf("pmwebrecord") > 0)
                                    div.append(`<tr><td><a class="FoldersTable" onclick="goToFolder(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
                                else
                                    div.append(`<tr><td><a class="FoldersTable" onclick="changeCurrentWorkingFolderId(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
                            }
                            FolderIndex = length;
                            container.append('<div class="DocumentMoreResultsBox" id="DocumentMoreResultsBox" onclick="DocumentLoadMoreResults();"><a id="DocumentMoreResultsBoxImage" title="Show more results"><span class="p-icon p-i-arrow-60-down"></span></a><span class="DocumentMoreResultsText">' + (FilteredFolders.length ? '1-' : '0-') + FolderIndex.toString() + ' out of ' + FilteredFolders.length.toString() + '</span></div>');
                            container.css("display", "block");
                            $(".js_searchFolders").focus();
                        }
                        else {
                            container.css("display", "none");
                        }
                        resolve(1);
                    },
                    error: function (err) {
                        alert(err);
                    }
                });
            });
        }

        function goToFolder(sender) {
            var folderId = sender.getAttribute("btnId");
            window.location = "foldermanager.aspx?FolderId=" + folderId + "&Id=0&ModuleId=8&PageId=92";
            return false;
        }

        function searchFolders(sender) {
            var div = $(".FoldersDiv tbody");
            div.empty();
            FilteredFolders = FolderData.filter(function (CurrFolder) {
                return CurrFolder.Name.toLowerCase().indexOf(sender.value.toLowerCase()) >= 0;
            });
            var length = FilteredFolders.length;
            if (length > ResultLength) length = ResultLength;
            for (i = 0; i < length; i++) {
                if (window.location.toString().toLowerCase().indexOf("foldermanager") > 0)
                    div.append(`<tr><td><a class="FoldersTable" onclick="FillFolder(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
                else if (window.location.toString().toLowerCase().indexOf("pmwebrecord") > 0)
                    div.append(`<tr><td><a class="FoldersTable" onclick="goToFolder(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
                else
                    div.append(`<tr><td><a class="FoldersTable" onclick="changeCurrentWorkingFolderId(this)" btnId="${FilteredFolders[i].Id}">${FilteredFolders[i].Name}</a></td></tr>`)
            }
            FolderIndex = length;
            $('.DocumentMoreResultsText')[0].innerHTML = $('.DocumentMoreResultsText')[0].innerHTML = (FilteredFolders.length ? '1-' : '0-') + FolderIndex.toString() + ' out of ' + FilteredFolders.length.toString();
            //$('.FoldersTable').each(function(){
            //    $(this)[0].innerText.toLowerCase().indexOf(sender.value.toLowerCase()) == -1 ? $(this).hide(): $(this).show();
            //})
        }

        var RecordIndex = 0;
        var RecordResultLength = 100;

        function DocumentLoadMoreRecords() {
            var div = $(".ModulesDiv tbody");
            var length = FilteredRecords.length;
            if (DisableLoadMore) {
                RecordIndex = length;
                return;
            }
            $.ajax({
                type: "POST",
                url: "AjaxService.aspx/GetRecordsByObjectType",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ PageId: RecordsInfo.PageId, RecordIndex: length, Search: '' }),
                dataType: "json",
                async: true,
                success: function (data) {
                    if (data.d !== null && data.d !== undefined) {
                        RecordsData = data.d.Records;
                        FilteredRecords = FilteredRecords.concat(RecordsData)
                        RecordsInfo = data.d;
                        var Id = GetIdFromURL(window.location.href);
                        for (i = RecordIndex; i < FilteredRecords.length; i++) {
                            div.append(`<tr><td style="display:none;position: relative;position: relative;padding: 2px 10px;
      top: 9px;left:30px;"><span class="Icon"></span></td><td class="ModulesTabletd"><a class="ModulesTable" onclick="handleClick(this)"  Id="${FilteredRecords[i].Id}" PostBackUrl="${RecordsInfo.PostBackUrl}" ModuleId="${RecordsInfo.ModuleId}" PageId="${RecordsInfo.PageId}" Desc="${FilteredRecords[i].Description}" objectId="${FilteredRecords[i].ObjectId}" ParentId="${FilteredRecords[i].ParentId}" ObjectTypeId="${FilteredRecords[i].ObjectTypeId}">${FilteredRecords[i].Description}</a></td></tr>`)
                            if (RecordsInfo.PageId == 77) {
                                document.querySelector(".ModulesTable").classList.add("ModulesTableWorkflow")
                                document.querySelector(".ModulesTable").classList.remove("ModulesTable")
                                var IdSelected = $(FilteredRecords[i])[0];
                                var divElement = document.getElementById(IdSelected.Id);
                                divElement.parentElement.previousElementSibling.style.display = "block";
                                if (divElement.attributes[7].nodeValue == '-1') {
                                    divElement.parentElement.previousElementSibling.classList.add("globe");
                                }
                                else {
                                    if (divElement.attributes[8].nodeValue == '0') {
                                        divElement.parentElement.classList.add("ComboBoxItemBoldIndent");
                                        divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemBoldIndent");
                                        divElement.style.fontWeight = 'bold';
                                    }
                                    else if (CInt(divElement.attributes[8].nodeValue) > 3) {
                                        divElement.parentElement.classList.add("ComboBoxItemIndent40px");
                                        divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent40px");
                                        divElement.parentElement.previousElementSibling.style.left = '50px';
                                    }
                                    else if (divElement.attributes[8].nodeValue == '3') {
                                        divElement.parentElement.classList.add("ComboBoxItemIndent");
                                        divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent");
                                    }
                                    switch (divElement.attributes[9].nodeValue) {
                                        case "1":  //Project
                                            divElement.parentElement.previousElementSibling.classList.add("project");
                                            break;
                                        case "2":  //Property
                                            divElement.parentElement.previousElementSibling.classList.add("locationMarker");
                                            break;
                                        case "7":  //Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                        case "8":  //Location Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                    };
                                }
                            } else if (RecordsInfo.PageId == 333) {
                                document.querySelector(".ModulesTable").classList.add("ModulesTableWorkflow")
                                document.querySelector(".ModulesTable").classList.remove("ModulesTable")
                                var IdSelected = $(FilteredRecords[i])[0];
                                var divElement = document.getElementById(IdSelected.Id);
                                divElement.parentElement.previousElementSibling.style.display = "block";
                                if (divElement.attributes[8].nodeValue == '0' && divElement.attributes[7].nodeValue !== '-1') {
                                    divElement.parentElement.classList.add("ComboBoxItemBoldIndent");
                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemBoldIndent");
                                    divElement.style.fontWeight = 'bold';
                                } else if (CInt(divElement.attributes[8].nodeValue) > 3) {
                                    divElement.parentElement.classList.add("ComboBoxItemIndent40px");
                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent40px");
                                    divElement.parentElement.previousElementSibling.style.left = '50px';
                                } else if (CInt(divElement.attributes[8].nodeValue) == '3') {
                                    divElement.parentElement.classList.add("ComboBoxItemIndent");
                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent");
                                }
                                if (divElement.attributes[7].nodeValue !== '-1') {
                                    switch (divElement.attributes[9].nodeValue) {
                                        case "1":  //Project
                                            divElement.parentElement.previousElementSibling.classList.add("project");
                                            break;
                                        case "2":  //Property
                                            divElement.parentElement.previousElementSibling.classList.add("locationMarker");
                                            break;
                                        case "7":  //Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                        case "8":  //Location Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                    };
                                }
                                if (divElement.attributes[7].nodeValue == '-1') {

                                    divElement.parentElement.previousElementSibling.classList.add("globe");
                                }
                                if (divElement.attributes[7].nodeValue == '0') {

                                    divElement.parentElement.previousElementSibling.classList.add("ALLButton");
                                }
                            } else if (RecordsInfo.PageId == 248 || RecordsInfo.PageId == 239) {
                                if (divElement.attributes[8].nodeValue == "0") {
                                    divElement.classList.add("Bold");
                                } else {
                                    divElement.classList.add("ComboBoxItemIndent");
                                }
                            }
                            if (Id == FilteredRecords[i].Id) {
                                var IdSelected = $(FilteredRecords[i])[0];
                                var divElement = document.getElementById(IdSelected.Id);
                                if (RecordsInfo.PageId == 77 || RecordsInfo.PageId == 333) {
                                    document.querySelectorAll(".ModulesTableWorkflow")[i].parentNode.classList.add('ModulesTableHilightRecord');
                                    document.querySelectorAll(".ModulesTableWorkflow")[i].parentNode.previousElementSibling.parentElement.classList.add("ModulesTableHilightRecord")
                                } else {
                                    divElement.classList.add('ModulesTableHilightRecord');
                                }
                            }
                        }
                    }
                    RecordIndex = FilteredRecords.length;
                },
                error: function (err) {
                    err.responseJSON.Message == 'SessionTimeOut';
                    location.reload();
                }
            });
        }

        var RecordTypeIndex = 0;
        var RecordTypeResultLength = 100;
        function DocumentLoadMoreRecordTypes() {
            var div = $(".ModulesDiv tbody");
            if (RecordTypeIndex == FilteredRecordTypes.length) return;
            var length = FilteredRecords.length;
            if (length > RecordTypeIndex + RecordTypeResultLength) length = RecordTypeIndex + RecordTypeResultLength;
            for (i = RecordTypeIndex; i < length; i++) {
                div.append(`<tr><td><asp:Image runat="server" ManagerPageId="${FilteredRecordTypes[i].PageId}" Style="padding-left: 11px !important;width:16px;height:16px;display:none;" ImageUrl="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' height='16' viewBox='0 0 56 56' width='16'><path d='M 14 16 A 1 1 0 0 0 17 16 A 1 1 0 0 0 14 16 M 14 28 A 1 1 0 0 0 17 28 A 1 1 0 0 0 14 28 M 14 40 A 1 1 0 0 0 17 40 A 1 1 0 0 0 14 40 M 25 16 L 43 16 M 25 28 L 43 28 M 25 40 L 43 40 M 4 4 V 52 H 52 V 4 Z' stroke='rgba(66,66,66,1)' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>" class="ModulesTable" title="Go to Manager Page" OnClick="goToManagerPage(this)" SearchUrl="${FilteredRecordTypes[i].SearchUrl}" PostBackUrl="${FilteredRecordTypes[i].PostBackUrl}"/></td><td class="ModulesTabletd" style="width: 231px;"><a class="ModulesTable" onclick="GetRecords(this)" btnpageId="${FilteredRecordTypes[i].PageId}">${FilteredRecordTypes[i].PageName}</a></td></tr>`)
                if (FilteredRecordTypes[i].HasManagerPage == true) {
                    var btnManagerPage = document.querySelector('img[managerpageid="' + FilteredRecordTypes[i].PageId + '"]');
                    btnManagerPage.style.display = "block";
                }
            }
            RecordTypeIndex = length;
        }

        function GenerateModules(event) {
            var div = $(".ModulesDiv tbody");
            var container = $(".ModulesParentDiv");
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            var SegmentDiv = $(".ModulesDiv")[0];
            SegmentDiv.classList.remove("RecordsDiv");
            SegmentDiv.classList.remove("RecordTypesDiv");
            SegmentDiv.classList.add("PagesDiv");
            Parentdiv.style.height = "";
            Parentdiv.style.width = "";
            SegmentDiv.style.overflow = "";
            if ($("[id$=ClearSearchModules]")[0] != null) {
                $("[id$=ClearSearchModules]")[0].style.display = "none";
            }
            if (Parentdiv.style.display === "unset" && (SegmentTwoIsOpen == true || SegmentThreeIsOpen == true)) {

                Parentdiv.style.display = "none";

            }
            var element = event.target;
            Parentdiv.style.left = (element.getClientRects()[0].x) + 20 + "px";
            ModuleData = [];
            FilteredModule = [];
            var Record = null;
            if ($("[id$=lnkBtnRecords]").length > 0) {
                Record = document.getElementById($("[id$=lnkBtnRecords]")[0].id);
            }

            var Id = GetIdFromURL(window.location.href);
            var HasConditionalSecurityDiv = document.querySelector(".HasConditionalSecurityDiv");
            if (Record && (Parentdiv.classList.contains("open") || HasConditionalSecurityDiv.classList.contains("open")) && Id == 0 && Record.text == "Records") {
                Record.text = "";
                var SvgRecords = document.querySelector(".RecordsSvg")
                SvgRecords.style.display = "none";
            }
            $.ajax({
                type: "POST",
                url: "AjaxService.aspx/GetModules",
                contentType: "application/json; charset=utf-8",

                dataType: "json",
                async: true,
                success: function (data) {
                    div.empty();
                    $('.searchSegment').remove();
                    $('#DocumentMoreResultsBox').remove();

                    if ($("[id$=ClearSearchModules]")[0] == null) {
                        container.prepend(`<asp:Image  class="ClearSearchImg" ImageUrl="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' height='16' viewBox='0 0 24 24' width='16'><path d='M15 9L9 15M9 9L15 15M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z' stroke='rgba(66,66,66,1)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' fill='none' /></svg>" style="display:none;" runat="server"  id="ClearSearchModules" onClick="ClearSearchModules(this)"/>`)
                    }
                    container.prepend(`<input id="txtsearchModules" type="text" class="searchSegment"  placeholder="Filter..." oninput="searchModules(this)" onclick="return false;"/>`);
                    if (data.d.length > 0) {
                        ModuleData = data.d;
                        FilteredModule = ModuleData;
                        var length = FilteredModule.length;
                        if (length > ResultLength) length = ResultLength;
                        for (i = 0; i < length; i++) {
                            div.append(`<tr><td class="ModulesTabletd" style="width:231px;"><a class="ModulesTable"  onclick="GenerateRecordTypes(this)" btnModuleId="${FilteredModule[i].Id}">${FilteredModule[i].Name}</a></td></tr>`)
                        }
                        Parentdiv.style.display = "unset";
                        Parentdiv.classList.add('open');
                        Parentdiv.style.top = '108px';
                        Parentdiv.style.width = "260px";
                        Parentdiv.style.zIndex = 7001;
                        SegmentOneIsOpen = true;
                        $(".searchSegment").focus();
                    }
                    else {

                        container.css("display", "none");
                    }
                },
                error: function (err) {
                    err.responseJSON.Message == 'SessionTimeOut';
                    location.reload();
                }

            });

        }

        function GenerateRecordTypes(Module) {
            var div = $(".ModulesDiv tbody");
            var container = $(".ModulesParentDiv");
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            var SegmentDiv = $(".ModulesDiv")[0];
            SegmentDiv.classList.remove("RecordsDiv");
            SegmentDiv.classList.add("RecordTypesDiv");
            SegmentDiv.classList.remove("PagesDiv");
            if (Parentdiv.style.display === "unset" && Module != 'CurrentModule') {
                Parentdiv.style.display = "none";
                SegmentOneIsOpen = false;
            }

            Parentdiv.style.height = "";
            Parentdiv.style.width = "";
            SegmentDiv.style.overflow = "";
            var ModuleId = 0
            if (Module == 'CurrentModule') {
                ModuleId = '<%= PM.intCurrModuleId%>'
            }
            else {
                div.empty();
                ModuleId = CInt(Module.getAttribute("btnmoduleid"))

            }
            if ($("[id$=ClearSearchRecordTypes]")[0] != null) {
                $("[id$=ClearSearchRecordTypes]")[0].style.display = "none";
            }
            if ($("[id$=ClearSearchModules]")[0] != null) {
                $("[id$=ClearSearchModules]")[0].style.display = "none";
            }
            if ($("[id$=ClearSearchRecords]")[0] != null) {
                $("[id$=ClearSearchRecords]")[0].style.display = "none";
            }

            var element = document.getElementById($("[id$=lnkBtnRecordType]")[0].id);
            Parentdiv.style.left = (element.getClientRects()[0].x) + 20 + "px";
            var Record = null;
            if ($("[id$=lnkBtnRecords]").length > 0) {
                Record = document.getElementById($("[id$=lnkBtnRecords]")[0].id);
            }
            var Id = GetIdFromURL(window.location.href);
            var HasConditionalSecurityDiv = document.querySelector(".HasConditionalSecurityDiv");
            if (Record && (Parentdiv.classList.contains("open") || HasConditionalSecurityDiv.classList.contains("open")) && Id == 0 && Record.text == "Records") {
                Record.text = "";
                var SvgRecords = document.querySelector(".RecordsSvg")
                SvgRecords.style.display = "none";
            }
            RecordTypesData = [];
            FilteredRecordTypes = [];
            $.ajax({
                type: "POST",
                url: "AjaxService.aspx/GetRecordTypes",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ ModuleId: ModuleId }),
                dataType: "json",
                async: true,
                success: function (data) {
                    div.empty();
                    $('.searchSegment').remove();
                    $('#DocumentMoreResultsBox').remove();
                    if ($("[id$=ClearSearchRecordTypes]")[0] == null) {
                        container.prepend(`<asp:Image class="ClearSearchImg" style="display:none;" runat="server" ImageUrl="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' height='16' viewBox='0 0 24 24' width='16'><path d='M15 9L9 15M9 9L15 15M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z' stroke='rgba(66,66,66,1)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' fill='none' /></svg>"  id="ClearSearchRecordTypes" onClick="ClearSearchRecordTypes(this)" />`)
                    }
                    container.prepend(`<input id="txtsearchRecordTypes" type="text" placeholder="Filter..." class="searchSegment" oninput="searchRecordTypes(this)"/>`);
                    if (data.d.length > 0) {
                        RecordTypesData = data.d;
                        FilteredRecordTypes = RecordTypesData;
                        var length = FilteredRecordTypes.length;
                        if (length > ResultLength) length = ResultLength;
                        for (i = 0; i < length; i++) {
                            div.append(`<tr><td class="RecordTypesTable"><asp:Image runat="server" ManagerPageId="${FilteredRecordTypes[i].PageId}" Style="padding-left: 27px !important;width:14px;height:14px;display:none;" ImageUrl="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' height='16' viewBox='0 0 56 56' width='16'><path d='M 14 16 A 1 1 0 0 0 17 16 A 1 1 0 0 0 14 16 M 14 28 A 1 1 0 0 0 17 28 A 1 1 0 0 0 14 28 M 14 40 A 1 1 0 0 0 17 40 A 1 1 0 0 0 14 40 M 25 16 L 43 16 M 25 28 L 43 28 M 25 40 L 43 40 M 4 4 V 52 H 52 V 4 Z' stroke='rgba(66,66,66,1)' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>"  title="Go to Manager Page" OnClick="goToManagerPage(this)" SearchUrl="${FilteredRecordTypes[i].SearchUrl}" PostBackUrl="${FilteredRecordTypes[i].PostBackUrl}"/></td><td class="RecordTypesTable"  style="width: 231px;"><a style="padding-left:0px !important; font-size:14px !important;"  onclick="GetRecords(this)" btnpageId="${FilteredRecordTypes[i].PageId}">${FilteredRecordTypes[i].PageName}</a></td></tr>`)
                            if (FilteredRecordTypes[i].HasManagerPage == true) {
                                var btnManagerPage = document.querySelector('img[managerpageid="' + FilteredRecordTypes[i].PageId + '"]');
                                btnManagerPage.style.display = "block";
                            }
                        }

                        RecordTypeIndex = length;
                        container.append('<div id="DocumentMoreResultsBox" onclick="DocumentLoadMoreRecordTypes();"></div>');
                        Parentdiv.style.display = "unset";
                        Parentdiv.classList.add('open');
                        Parentdiv.style.top = '108px';
                        Parentdiv.style.zIndex = 7000;
                        SegmentTwoIsOpen = true;
                        $(".searchSegment").focus();
                        $(".ModulesDiv")[0].scrollTop = 0;
                    }
                    else {
                        container.css("display", "none");
                    }

                },
                error: function (err) {
                    err.responseJSON.Message == 'SessionTimeOut';
                    location.reload();
                }

            });
        }
        var hasConditionalSecurity = false;
        var SegmentThreeJustClosed = false;
        var PageId = 0;
        function GetRecords(PageInfo) {
            return new Promise((resolve, reject) => {
                var div = $(".ModulesDiv tbody");
                var container = $(".ModulesParentDiv");
                var Parentdiv = document.querySelector(".ModulesParentDiv");
                var SegmentDiv = $(".ModulesDiv")[0];
                SegmentDiv.classList.add("RecordsDiv");
                SegmentDiv.classList.remove("RecordTypesDiv");
                SegmentDiv.classList.remove("PagesDiv");
                if (Parentdiv.style.display === "unset" && PageInfo.id != '') {
                    Parentdiv.style.display = "none";
                }
                Parentdiv.style.height = "";
                Parentdiv.style.width = "";
                SegmentDiv.style.overflow = "";

                var element = null;
                if ($("[id$=lnkBtnRecords]").length > 0) {
                    element = document.getElementById($("[id$=lnkBtnRecords]")[0].id);
                }
                if (!element) return;

                if (PageInfo.id != '') {
                    PageId = '<%= PM.intCurrPageId%>'
                    ModuleId = '<%= PM.intCurrModuleId%>'
                    Parentdiv.style.left = (element.getClientRects()[0].x) + 20 + "px";
                }
                else {
                    PageId = CInt(PageInfo.getAttribute("btnpageId"));
                    Parentdiv.style.left = (element.getClientRects()[0].x) + 20 + "px";
                }

                if ($("[id$=ClearSearchRecords]")[0] != null) {
                    $("[id$=ClearSearchRecords]")[0].style.display = "none";
                }
                if ($("[id$=ClearSearchModules]")[0] != null) {
                    $("[id$=ClearSearchModules]")[0].style.display = "none";
                }
                if ($("[id$=ClearSearchRecordTypes]")[0] != null) {
                    $("[id$=ClearSearchRecordTypes]")[0].style.display = "none";
                }
                if (Parentdiv.style.display === "unset" && PageInfo.id == '') {
                    Parentdiv.style.display = "none";
                    SegmentThreeIsOpen = true;
                    SegmentTwoIsOpen = false;
                }
             //<%--   var LastSelectedHomeTabId = '<%=  PM.HomeController.LastSelectedHomeTabId%>';--%>
                var Id = GetIdFromURL(window.location.href);
                //if ((window.location.href.includes('home.aspx') || window.location.href.includes('Home.aspx')) && Id == 0) {
                //    Id = LastSelectedHomeTabId
                //}

                RecordsData = [];
                FilteredRecords = [];
                RecordsInfo = [];
                var HasConditionalSecurityDiv = document.querySelector(".HasConditionalSecurityDiv");
                div.empty();
                $.ajax({
                    type: "POST",
                    url: "AjaxService.aspx/GetRecordsByObjectType",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ PageId: PageId, RecordIndex: 0, Search: '' }),
                    dataType: "json",
                    async: true,
                    success: function (data) {
                        div.empty();
                        $('.searchSegment').remove();
                        $('#DocumentMoreResultsBox').remove();
                        if (data.d !== null && data.d !== undefined) {
                            RecordsData = data.d.Records;
                            FilteredRecords = RecordsData;
                            RecordsInfo = data.d;
                            if (RecordsInfo.PageId === 221 || RecordsInfo.PageId === 117) DisableLoadMore = true;
                            var length = FilteredRecords.length;

                            if (FilteredRecords.length > 0 && RecordsInfo.PostBackUrl.toLowerCase().includes("foldermanager") == false && RecordsInfo.PostBackUrl.toLowerCase().includes("pmwebrecord") == false && ((FilteredRecords[0].Id >= 0 && RecordsInfo.PageId == 221) || (FilteredRecords[0].Id > 0) || (FilteredRecords[0].Id == -1))) {

                                if ((Id == 0 || RecordsInfo.PageId == 221) && element.text == "") {
                                    element.text = "Records";
                                    var SvgRecords = document.querySelector(".RecordsSvg")
                                    SvgRecords.style.display = "unset";
                                }
                                var SkeletonDiv = $(".SkeletonDiv tbody");
                                if (RecordsInfo.HasConditionalSecurity == true) {
                                    Parentdiv.style.display = "none";
                                    Parentdiv.classList.remove('open');
                                    Parentdiv.style.display = "none";
                                    if (SegmentThreeJustClosed == true) {
                                        SegmentThreeIsOpen = true;
                                        SegmentThreeJustClosed = false;
                                    }
                                    SegmentOneIsOpen = false;
                                    SegmentTwoIsOpen = false;
                                    SegmentThreeIsOpen = false;
                                    RecordsInfo.hasConditionalSecurity = true;
                                    SkeletonDiv.empty();
                                    var txtConditionalSecurity = `<%= GetLocalResourceObject("ConditionalSecurityPopupText") %>`;
                                    SkeletonDiv.append(`<tr><td class="SkeletonText">${txtConditionalSecurity}</td></tr><tr><td style="padding-top:10px;height:20px;"><a class="ManagerPageSkeletonText" onclick="goToManagerPage(this)" SearchUrl="${RecordsInfo.SearchUrl}" PostBackUrl="${RecordsInfo.PostBackUrl}"> Manager Page </a></td></tr>`)
                                    HasConditionalSecurityDiv.style.left = (element.getClientRects()[0].x)  + 20 + "px";
                                    HasConditionalSecurityDiv.style.display = "unset";
                                    HasConditionalSecurityDiv.classList.add('open');
                                    HasConditionalSecurityDiv.style.top = '120px';
                                    HasConditionalSecurityDiv.style.zIndex = 7000;
                                    hasConditionalSecurityOpen = true;


                                } else {
                                    RecordsInfo.hasConditionalSecurity = false;
                                    if ($("[id$=ClearSearchRecords]")[0] == null) {
                                        container.prepend(`<asp:Image class="ClearSearchImg" ImageUrl="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' height='16' viewBox='0 0 24 24' width='16'><path d='M15 9L9 15M9 9L15 15M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z' stroke='rgba(66,66,66,1)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' fill='none' /></svg>" style="display:none;" runat="server"  id="ClearSearchRecords" onClick="ClearSearchRecords(this)" />`)
                                    }

                                    if (Parentdiv.style.display === "none" && PageInfo.Id != '') {
                                        Parentdiv.style.display = "unset";
                                    }
                                    if (Parentdiv.style.display === "unset" && PageInfo.id == '') {
                                        Parentdiv.style.display = "unset";
                                    }

                                    container.prepend(`<input id="txtsearchRecords" type="text" placeholder="Filter..." class="searchSegment"  oninput = "SearchRecordsTimer()" onKeydown="ClearTimeout(this)"/>`);
                                    if (hasConditionalSecurityOpen == true) {
                                        HasConditionalSecurityDiv.classList.remove('open');
                                        HasConditionalSecurityDiv.style.top = '0px';
                                        HasConditionalSecurityDiv.style.display = "none";
                                        Parentdiv.style.display = "none";
                                        hasConditionalSecurityOpen = false;

                                    }
                                    if (!(RecordsInfo.PageId === 221 || RecordsInfo.PageId === 117) && length > ResultLength) length = ResultLength;
                                    for (i = 0; i < length; i++) {

                                        div.append(`<tr><td style="display:none;position: relative;padding: 2px 10px;
                                             top: 9px;left:30px;"><span class="Icon"></span></td><td class="ModulesTabletd"><a class="ModulesTable" onclick="handleClick(this)"  Id="${FilteredRecords[i].Id}" PostBackUrl="${RecordsInfo.PostBackUrl}" ModuleId="${RecordsInfo.ModuleId}" PageId="${RecordsInfo.PageId}" Desc="${FilteredRecords[i].Description}" objectId="${FilteredRecords[i].ObjectId}" ParentId="${FilteredRecords[i].ParentId}" ObjectTypeId="${FilteredRecords[i].ObjectTypeId}">${FilteredRecords[i].Description}</a></td></tr>`)
                                        if (RecordsInfo.PageId == 77) {
                                            document.querySelector(".ModulesTable").classList.add("ModulesTableWorkflow")
                                            document.querySelector(".ModulesTable").classList.remove("ModulesTable")
                                            var IdSelected = $(FilteredRecords[i])[0];
                                            var divElement = document.getElementById(IdSelected.Id);
                                            divElement.parentElement.previousElementSibling.style.display = "block";
                                            if (divElement.attributes[7].nodeValue == '-1') {
                                                divElement.parentElement.previousElementSibling.classList.add("globe");
                                            }
                                            else {
                                                if (divElement.attributes[8].nodeValue == '0') {
                                                    divElement.parentElement.classList.add("ComboBoxItemBoldIndent");
                                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemBoldIndent");
                                                    divElement.style.fontWeight = 'bold';
                                                }
                                                else if (CInt(divElement.attributes[8].nodeValue) > 3) {
                                                    divElement.parentElement.classList.add("ComboBoxItemIndent40px");
                                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent40px");
                                                    divElement.parentElement.previousElementSibling.style.left = '50px';
                                                }
                                                else if (divElement.attributes[8].nodeValue == '3') {
                                                    divElement.parentElement.classList.add("ComboBoxItemIndent");
                                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent");
                                                }
                                                switch (divElement.attributes[9].nodeValue) {
                                                    case "1":  //Project
                                                        divElement.parentElement.previousElementSibling.classList.add("project");
                                                        break;
                                                    case "2":  //Property
                                                        divElement.parentElement.previousElementSibling.classList.add("locationMarker");
                                                        break;
                                                    case "7":  //Program
                                                        divElement.parentElement.previousElementSibling.classList.add("folder");
                                                        break;
                                                    case "8":  //Location Program
                                                        divElement.parentElement.previousElementSibling.classList.add("folder");
                                                        break;
                                                };
                                            }
                                        } else if (RecordsInfo.PageId == 333) {
                                            document.querySelector(".ModulesTable").classList.add("ModulesTableWorkflow")
                                            document.querySelector(".ModulesTable").classList.remove("ModulesTable")
                                            var IdSelected = $(FilteredRecords[i])[0];
                                            var divElement = document.getElementById(IdSelected.Id);
                                            divElement.parentElement.previousElementSibling.style.display = "block";
                                            if (divElement.attributes[8].nodeValue == '0' && divElement.attributes[7].nodeValue !== '-1') {
                                                divElement.parentElement.classList.add("ComboBoxItemBoldIndent");
                                                divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemBoldIndent");
                                                divElement.style.fontWeight = 'bold';
                                            } else if (CInt(divElement.attributes[8].nodeValue) > 3) {
                                                divElement.parentElement.classList.add("ComboBoxItemIndent40px");
                                                divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent40px");
                                                divElement.parentElement.previousElementSibling.style.left = '50px';
                                            } else if (CInt(divElement.attributes[8].nodeValue) == '3') {
                                                divElement.parentElement.classList.add("ComboBoxItemIndent");
                                                divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent");
                                            }
                                            if (divElement.attributes[7].nodeValue !== '-1') {
                                                switch (divElement.attributes[9].nodeValue) {
                                                    case "1":  //Project
                                                        divElement.parentElement.previousElementSibling.classList.add("project");
                                                        break;
                                                    case "2":  //Property
                                                        divElement.parentElement.previousElementSibling.classList.add("locationMarker");
                                                        break;
                                                    case "7":  //Program
                                                        divElement.parentElement.previousElementSibling.classList.add("folder");
                                                        break;
                                                    case "8":  //Location Program
                                                        divElement.parentElement.previousElementSibling.classList.add("folder");
                                                        break;
                                                };
                                            }
                                            if (divElement.attributes[7].nodeValue == '-1') {
                                                
                                                divElement.parentElement.previousElementSibling.classList.add("globe");
                                            }
                                            if (divElement.attributes[7].nodeValue == '0') {

                                                divElement.parentElement.previousElementSibling.classList.add("ALLButton");
                                            }
                                        } else if (RecordsInfo.PageId == 248 || RecordsInfo.PageId == 239) {
                                            var IdSelected = $(FilteredRecords[i])[0];
                                            var divElement = document.getElementById(IdSelected.Id);
                                            if (divElement.attributes[8].nodeValue == "0") {
                                                divElement.classList.add("Bold");
                                            } else {
                                                divElement.classList.add("ComboBoxItemIndent");
                                            }
                                        }
                                        if (PageInfo.id != '') {
                                            if (Id == FilteredRecords[i].Id) {
                                                var IdSelected = $(FilteredRecords[i])[0];
                                                var divElement = document.getElementById(IdSelected.Id);
                                                if (RecordsInfo.PageId == 77 || RecordsInfo.PageId == 333) {
                                                    document.querySelectorAll(".ModulesTableWorkflow")[i].parentNode.classList.add('ModulesTableHilightRecord');
                                                    document.querySelectorAll(".ModulesTableWorkflow")[i].parentNode.previousElementSibling.parentElement.classList.add("ModulesTableHilightRecord")
                                                } else {
                                                    divElement.classList.add('ModulesTableHilightRecord');
                                                }
                                            }
                                        }

                                    }
                                    RecordIndex = length;
                                    if (!DisableLoadMore)
                                    container.append('<div id="DocumentMoreResultsBox" onclick="DocumentLoadMoreRecords();"></div>');
                                    $(".searchSegment").focus();
                                    $(".ModulesDiv")[0].scrollTop = 0;
                                }
                                if (hasConditionalSecurityOpen == false) {
                                    Parentdiv.style.display = "unset";
                                    Parentdiv.classList.add('open');
                                    Parentdiv.style.top = '108px';
                                    Parentdiv.style.zIndex = 7000;
                                    SegmentThreeIsOpen = true;
                                }
                            }
                            else {
                                if ((RecordsInfo.PostBackUrl.toLowerCase().includes("foldermanager") == true) || (RecordsInfo.PostBackUrl.toLowerCase().includes("pmwebrecord") == true)) {
                                    Parentdiv.style.display = "none";

                                    goToManagerPage(RecordsInfo);
                                }
                                else {
                                    if (Id == 0 && element.text == "" && RecordsInfo.HasManagerPage == true) {
                                        element.text = "Records";
                                        var SvgRecords = document.querySelector(".RecordsSvg")
                                        SvgRecords.style.display = "unset";
                                    }
                                    if (RecordsInfo.HasManagerPage == true) {
                                        var txtNoRecords = `<%= GetLocalResourceObject("NoRecordsPopup") %>`;
                                        div.append(`<tr><td class="NoRecordsTable " style="text-align:center; position:relative;right:7px;padding:0 !important">${txtNoRecords}</td></tr>`)
                                        Parentdiv.style.display = "unset";
                                        Parentdiv.classList.add('open');
                                        Parentdiv.style.top = '108px';
                                        Parentdiv.style.zIndex = 7000;
                                        SegmentThreeIsOpen = true;
                                        Parentdiv.style.width = '256px';
                                        Parentdiv.style.height = '65px';
                                        SegmentDiv.style.overflow = 'hidden';
                                    } else {
                                        Parentdiv.style.display = "none";
                                        goToPage(RecordsInfo);
                                    }
                                }

                            }

                        }
                        else {
                            container.css("display", "none");
                        }
                        resolve(1);
                    },
                    error: function (err) {
                        err.responseJSON.Message == 'SessionTimeOut';
                        location.reload();
                    }

                });
            });
        }

        function searchModules(sender) {
            var div = $(".ModulesDiv tbody");
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            div.empty();
            var SearchModules = document.getElementById("txtsearchModules");
            var SearchModulesValue = SearchModules.value.toLowerCase();
            if (sender.classList.contains('ClearSearchImg')) {
                FilteredModule = ModuleData.filter(function (CurrModule) {
                    return CurrModule.Name.toLowerCase();
                });
            }
            else {
                FilteredModule = ModuleData.filter(function (CurrModule) {
                    return CurrModule.Name.toLowerCase().indexOf(SearchModulesValue) >= 0;
                });
            }
            var length = FilteredModule.length;
            if (length > ResultLength) length = ResultLength;
            for (i = 0; i < length; i++) {
                div.append(`<tr><td class="ModulesTabletd" style="width:231px;"><a class="ModulesTable" onclick="GenerateRecordTypes(this)" btnModuleId="${FilteredModule[i].Id}">${FilteredModule[i].Name}</a></td></tr>`)
            }
            if (length == 0) {
                Parentdiv.style.height = "401px";
            } else {
                Parentdiv.style.position = "Fixed";
                Parentdiv.style.height = "";
            }
            var ClearSearchModule = $("[id$=ClearSearchModules]")[0];
            if (SearchModulesValue.length > 0) {
                ClearSearchModule.classList.add('ClearSearchImg');
                ClearSearchModule.style.display = "block";

            } else {
                ClearSearchModule.classList.remove('ClearSearchImg');
                ClearSearchModule.style.display = "none";
            }
        }

        function searchRecordTypes(sender) {
            var div = $(".ModulesDiv tbody");
            div.empty();
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            var SearchRecordTypes = document.getElementById("txtsearchRecordTypes");
            var SearchRecordTypesValue = SearchRecordTypes.value.toLowerCase();
            if (sender.classList.contains('ClearSearchImg')) {
                FilteredRecordTypes = RecordTypesData.filter(function (CurrRecordType) {
                    return CurrRecordType.PageName.toLowerCase();
                });
            }
            else {
                FilteredRecordTypes = RecordTypesData.filter(function (CurrRecordType) {
                    return CurrRecordType.PageName.toLowerCase().indexOf(SearchRecordTypesValue) >= 0;
                });
            }
            var length = FilteredRecordTypes.length;
            if (length > ResultLength) length = ResultLength;

            for (i = 0; i < length; i++) {
                div.append(`<tr><td><asp:Image runat="server" ManagerPageId="${FilteredRecordTypes[i].PageId}" Style="padding-left: 27px !important;width:14px;height:14px;display:none;" ImageUrl="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' height='16' viewBox='0 0 56 56' width='16'><path d='M 14 16 A 1 1 0 0 0 17 16 A 1 1 0 0 0 14 16 M 14 28 A 1 1 0 0 0 17 28 A 1 1 0 0 0 14 28 M 14 40 A 1 1 0 0 0 17 40 A 1 1 0 0 0 14 40 M 25 16 L 43 16 M 25 28 L 43 28 M 25 40 L 43 40 M 4 4 V 52 H 52 V 4 Z' stroke='rgba(66,66,66,1)' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>"  class="ModulesTable" title="Go to Manager Page" OnClick="goToManagerPage(this)" SearchUrl="${FilteredRecordTypes[i].SearchUrl}" PostBackUrl="${FilteredRecordTypes[i].PostBackUrl}"/></td><td class="ModulesTabletd" style="width: 231px;"><a class="ModulesTable" onclick="GetRecords(this)" btnpageId="${FilteredRecordTypes[i].PageId}">${FilteredRecordTypes[i].PageName}</a></td></tr>`)
                if (FilteredRecordTypes[i].HasManagerPage == true) {
                    var btnManagerPage = document.querySelector('img[managerpageid="' + FilteredRecordTypes[i].PageId + '"]');
                    btnManagerPage.style.display = "block";
                }
            }
            if (length == 0) {
                Parentdiv.style.height = "495px";
            } else {
                Parentdiv.style.position = "Fixed";
                Parentdiv.style.height = "";
            }
            var ClearSearchRecordTypes = $("[id$=ClearSearchRecordTypes]")[0];
            if (SearchRecordTypesValue.length > 0) {
                ClearSearchRecordTypes.classList.add('ClearSearchImg');
                ClearSearchRecordTypes.style.display = "block";
            } else {
                ClearSearchRecordTypes.classList.remove('ClearSearchImg');
                ClearSearchRecordTypes.style.display = "none";
            }
        }

        var typingTimer;
        var doneTypingInterval = 1000;
        function SearchRecordsTimer() {

            clearTimeout(typingTimer);

            if ($("[id$=txtsearchRecords]")[0].value == '') {
                searchRecords();
            } else {
                typingTimer = setTimeout(searchRecords, doneTypingInterval);
            }

        }

        function ClearTimeout() {
            clearTimeout(typingTimer);
        }

        function searchRecords() {
            var div = $(".ModulesDiv tbody");
            div.empty();
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            var SearchRecords = document.getElementById("txtsearchRecords");
            var SearchRecordsValue = SearchRecords.value.toLowerCase();
            SearchRecordsValue = SearchRecordsValue.replace("/'/g", "\\'");
            const jsondata = JSON.stringify({ PageId: PageId, RecordIndex: 0, Search: SearchRecordsValue });
            $.ajax({
                type: "POST",
                url: "AjaxService.aspx/GetRecordsByObjectType",
                contentType: "application/json; charset=utf-8",
                data: jsondata,
                dataType: "json",
                async: true,
                success: function (data) {
                    if (data.d !== null && data.d !== undefined) {
                        FilteredRecords = [];
                        RecordsData = data.d.Records;
                        FilteredRecords = FilteredRecords.concat(RecordsData)
                        RecordsInfo = data.d;
                        if ($("[id$=txtsearchRecords]")[0].classList.contains('ClearSearchImg')) {
                            FilteredRecords = RecordsData.filter(function (CurrRecord) {
                                return CurrRecord.Description;
                            });
                        }
                        else {
                            FilteredRecords = RecordsData.filter(function (CurrRecord) {
                                return CurrRecord.Description.toLowerCase().indexOf(SearchRecordsValue) >= 0 || CurrRecord.Id.toString().toLowerCase().indexOf(SearchRecordsValue) >= 0;
                            });
                        }

                        var length = FilteredRecords.length;
                        var Id = GetIdFromURL(window.location.href);
                        for (i = 0; i < length; i++) {
                            div.append(`<tr><td style="display:none;position: relative;position: relative;padding: 2px 10px;
      top: 9px;left:30px;"><span class="Icon"></span></td><td class="ModulesTabletd"><a class="ModulesTable" onclick="handleClick(this)"  Id="${FilteredRecords[i].Id}" PostBackUrl="${RecordsInfo.PostBackUrl}" ModuleId="${RecordsInfo.ModuleId}" PageId="${RecordsInfo.PageId}" Desc="${FilteredRecords[i].Description}" objectId="${FilteredRecords[i].ObjectId}" ParentId="${FilteredRecords[i].ParentId}" ObjectTypeId="${FilteredRecords[i].ObjectTypeId}">${FilteredRecords[i].Description}</a></td></tr>`)
                            var IdSelected = $(FilteredRecords[i])[0];
                            var divElement = document.getElementById(IdSelected.Id);
                            if (RecordsInfo.PageId == 77) {
                                document.querySelector(".ModulesTable").classList.add("ModulesTableWorkflow")
                                document.querySelector(".ModulesTable").classList.remove("ModulesTable")
                                var IdSelected = $(FilteredRecords[i])[0];
                                var divElement = document.getElementById(IdSelected.Id);
                                divElement.parentElement.previousElementSibling.style.display = "block";
                                if (divElement.attributes[7].nodeValue == '-1') {
                                    divElement.parentElement.previousElementSibling.classList.add("globe");
                                }
                                else {
                                    if (divElement.attributes[8].nodeValue == '0') {
                                        divElement.parentElement.classList.add("ComboBoxItemBoldIndent");
                                        divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemBoldIndent");
                                        divElement.style.fontWeight = 'bold';
                                    }
                                    else if (CInt(divElement.attributes[8].nodeValue) > 3) {
                                        divElement.parentElement.classList.add("ComboBoxItemIndent40px");
                                        divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent40px");
                                        divElement.parentElement.previousElementSibling.style.left = '50px';
                                    }
                                    else if (divElement.attributes[8].nodeValue == '3') {
                                        divElement.parentElement.classList.add("ComboBoxItemIndent");
                                        divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent");
                                    }
                                    switch (divElement.attributes[9].nodeValue) {
                                        case "1":  //Project
                                            divElement.parentElement.previousElementSibling.classList.add("project");
                                            break;
                                        case "2":  //Property
                                            divElement.parentElement.previousElementSibling.classList.add("locationMarker");
                                            break;
                                        case "7":  //Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                        case "8":  //Location Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                    };
                                }
                            } else if (RecordsInfo.PageId == 333) {
                                document.querySelector(".ModulesTable").classList.add("ModulesTableWorkflow")
                                document.querySelector(".ModulesTable").classList.remove("ModulesTable")
                                var IdSelected = $(FilteredRecords[i])[0];
                                var divElement = document.getElementById(IdSelected.Id);
                                divElement.parentElement.previousElementSibling.style.display = "block";
                                if (divElement.attributes[8].nodeValue == '0' && divElement.attributes[7].nodeValue !== '-1') {
                                    divElement.parentElement.classList.add("ComboBoxItemBoldIndent");
                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemBoldIndent");
                                    divElement.style.fontWeight = 'bold';
                                } else if (CInt(divElement.attributes[8].nodeValue) > 3) {
                                    divElement.parentElement.classList.add("ComboBoxItemIndent40px");
                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent40px");
                                    divElement.parentElement.previousElementSibling.style.left = '50px';
                                } else if (CInt(divElement.attributes[8].nodeValue) == '3') {
                                    divElement.parentElement.classList.add("ComboBoxItemIndent");
                                    divElement.parentElement.previousElementSibling.classList.add("ComboBoxItemIndent");
                                }
                                if (divElement.attributes[7].nodeValue !== '-1') {
                                    switch (divElement.attributes[9].nodeValue) {
                                        case "1":  //Project
                                            divElement.parentElement.previousElementSibling.classList.add("project");
                                            break;
                                        case "2":  //Property
                                            divElement.parentElement.previousElementSibling.classList.add("locationMarker");
                                            break;
                                        case "7":  //Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                        case "8":  //Location Program
                                            divElement.parentElement.previousElementSibling.classList.add("folder");
                                            break;
                                    };
                                }
                                if (divElement.attributes[7].nodeValue == '-1') {

                                    divElement.parentElement.previousElementSibling.classList.add("globe");
                                }
                                if (divElement.attributes[7].nodeValue == '0') {

                                    divElement.parentElement.previousElementSibling.classList.add("ALLButton");
                                }
                            } else if (RecordsInfo.PageId == 248 || RecordsInfo.PageId == 239) {

                                if (divElement.attributes[8].nodeValue == "0") {
                                    divElement.classList.add("Bold");
                                } else {
                                    divElement.classList.add("ComboBoxItemIndent");
                                }
                            }
                            //var LastSelectedHomeTabId = '<%=  PM.HomeController.LastSelectedHomeTabId%>';
                            //if ((window.location.href.includes('home.aspx') || window.location.href.includes('Home.aspx')) && Id == 0) {
                            //    Id = LastSelectedHomeTabId
                            //}
                            if (Id == FilteredRecords[i].Id) {
                                if (RecordsInfo.PageId == 77 || RecordsInfo.PageId == 333) {
                                    document.querySelectorAll(".ModulesTableWorkflow")[i].parentNode.classList.add('ModulesTableHilightRecord');
                                    document.querySelectorAll(".ModulesTableWorkflow")[i].parentNode.previousElementSibling.parentElement.classList.add("ModulesTableHilightRecord")
                                } else {
                                    divElement.classList.add('ModulesTableHilightRecord');
                                }
                            }
                        }
                        if (length == 0) {
                            Parentdiv.style.height = "286px";
                        } else {
                            Parentdiv.style.position = "Fixed";
                            Parentdiv.style.height = "";
                        }
                        var ClearSearchRecords = $("[id$=ClearSearchRecords]")[0];
                        if (SearchRecordsValue.length > 0) {
                            ClearSearchRecords.classList.add('ClearSearchImg');
                            ClearSearchRecords.style.display = "block";
                        } else {
                            ClearSearchRecords.classList.remove('ClearSearchImg');
                            ClearSearchRecords.style.display = "none";
                        }
                    }
                },
                error: function (err) {
                    err.responseJSON.Message == 'SessionTimeOut';
                    location.reload();
                }
            });
        }

        function handleClick(sender) {
            if (CheckDirt2() === false) {
                return; 
            }
            goToRecord(sender);
        }
        function goToRecord(sender) {
            var PostBackUrl = sender.getAttribute("PostBackUrl");
            var Url = PostBackUrl.replace('~/', '');
            var RecordId = sender.getAttribute("Id");
            var ModuleId = sender.getAttribute("ModuleId");
            var PageId = sender.getAttribute("PageId");
            var Desc = sender.getAttribute("Desc");
            var hfRecordDesc = $("[id$=hfRecordDesc]")[0];
            hfRecordDesc.value = Desc;
            var hfUrl = $("[id$=hfUrl]")[0];
            var btnSaveRecordDesc = $("[id$=btnSaveRecordDesc]");
            if (Url === 'ItemsSearch.aspx') {
                Url = Url.replace("ItemsSearch.aspx", "Items.aspx");
            }
            if (Url.includes('AssembliesSearch.aspx')) {
                Url = Url.replace("AssembliesSearch.aspx", "Assemblies.aspx");
            }
            if (Url === 'PortfolioItemsSearch.aspx') {
                Url = Url.replace("PortfolioItemsSearch.aspx", "Items.aspx");
            }
            if (Url.match("TypeId") == 'TypeId') {
                PageId = 80;

                hfUrl.value = Url + "&Id=" + RecordId + "&ModuleId=" + ModuleId + "&PageId=" + PageId;
                btnSaveRecordDesc.click();
            } else if (Url.includes('AdaptiveForms.aspx')) {
                hfUrl.value = Url + "&Id=" + RecordId + "&ModuleId=" + ModuleId + "&PageId=" + PageId;
                btnSaveRecordDesc.click();
            } else if (Url.includes('CostWorksheet.aspx')) {
                hfUrl.value = Url + '?' + "ProjectId=" + RecordId;
                btnSaveRecordDesc.click();
            } else if (Url === 'Tasks.aspx') {
                var NewDesc = RemoveLeadingZeros(hfRecordDesc.value);
                hfRecordDesc.value = NewDesc;
                hfUrl.value = Url + '?' + "Id=" + RecordId + "&ModuleId=" + ModuleId + "&PageId=" + PageId;
                btnSaveRecordDesc.click();
            } else {

                hfUrl.value = Url + '?' + "Id=" + RecordId + "&ModuleId=" + ModuleId + "&PageId=" + PageId;
                btnSaveRecordDesc.click();
            }

        }

        function goToManagerPageHdn() {
            if (CheckDirt2() === false) {
                return;
            }
            let hdnLink = $("[id$=MPShortcut]")[0];
            hdnLink.click();
        }

        function goToManagerPage(sender) {
            if (CheckDirt2() === false) {
                return;
            }
            var SearchUrl;
            var PostBackUrl;
            if (sender.__type != undefined && sender.__type == "Website.AjaxService+RecordsInfoResult") {
                SearchUrl = sender.SearchUrl;
                PostBackUrl = sender.PostBackUrl;
            }
            else {
                SearchUrl = sender.getAttribute("SearchUrl");
                PostBackUrl = sender.getAttribute("PostBackUrl");
            }

            var SearchDocumentUrl = SearchUrl.replace('~/', '');
            var Url = PostBackUrl.replace('~/', '');
            if (SearchDocumentUrl == 'QueryViewer.aspx') {
                SearchDocumentUrl = 'SearchDocument.aspx?O=173';
            }
            if (SearchDocumentUrl == 'PMWebRecord.aspx') {
                SearchDocumentUrl = 'SearchDocument.aspx?O=59';
            }
            if (SearchDocumentUrl == '') {
                window.location = Url;
            }
            else {
                window.location = SearchDocumentUrl;
            }
            return false;
        }

        function goToPage(RecordsInfo) {
            var PostBackUrl = RecordsInfo.PostBackUrl;
            var PageUrl = PostBackUrl.replace('~/', '');
            if (PageUrl.match("CustomForms") == 'CustomForms' || PageUrl.match("AdaptiveForms") == 'AdaptiveForms') {
                var SearchUrl = RecordsInfo.SearchUrl;
                var SearchDocumentUrl = SearchUrl.replace('~/', '');
                window.location = SearchDocumentUrl;
            } else if (PageUrl.includes("MySettings")) {
                var ModuleId = RecordsInfo.ModuleId;
                window.location = PageUrl + '&' + "ModuleId=" + ModuleId;
            } else {
                var ModuleId = RecordsInfo.ModuleId;
                window.location = PageUrl + '?' + "ModuleId=" + ModuleId;
            }
            return false;
        }
        function ClearSearchModules(sender) {
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            Parentdiv.style.position = "Fixed";
            Parentdiv.style.height = "";
            document.getElementById('txtsearchModules').value = '';
            searchModules(sender);
        }
        function ClearSearchRecordTypes(sender) {
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            Parentdiv.style.position = "Fixed";
            Parentdiv.style.height = "";
            document.getElementById('txtsearchRecordTypes').value = '';
            searchRecordTypes(sender);
        }
        function ClearSearchRecords(sender) {
            var Parentdiv = document.querySelector(".ModulesParentDiv");
            Parentdiv.style.position = "Fixed";
            Parentdiv.style.height = "";
            document.getElementById('txtsearchRecords').value = '';
            searchRecords();
        }
        function GetIdFromURL(Url) {

            var queryStart = Url.indexOf('?');
            var Id = 0;
            if (queryStart !== -1) {
                var DecodedURl = decodeURIComponent(Url)
                var queryString = DecodedURl.substring(queryStart + 1);
                var params = queryString.split('&');
                for (var i = 0; i < params.length; i++) {
                    var param = params[i].split('=');
                    var key = param[0];
                    var value = param[1];
                    if (value === undefined) {
                        Id = 0;
                    } else {
                        if (value.includes("#")) {
                            value = value.replace("#", "");
                        }
                        if (DecodedURl.includes('CostWorksheet.aspx')) {
                            if (key === 'ProjectId') {
                                Id = value;
                                break;
                            }
                        }
                        if (key.toLowerCase() === 'id') {
                            Id = value;
                            break;
                        }
                    }
                }
            }
            return Id;
        }

        function getPageIdFromUrl(Url) {
            var queryStart = Url.indexOf('?');
            var PageId = 0;
            if (queryStart !== -1) {
                var DecodedURl = decodeURIComponent(Url)
                var queryString = DecodedURl.substring(queryStart + 1);
                var params = queryString.split('&');
                var TempTemplateId = 0;
                var hasTemplateId = false;
                for (i = 0; i < params.length; i++) {

                    if (params[i].includes("TemplateId=")) {
                        TempTemplateId = params[i].replace("TemplateId=", "");
                        hasTemplateId = true;
                    }
                }

                if (TempTemplateId !== undefined && TempTemplateId !== 0 && TempTemplateId != null) {
                    PageId = TempTemplateId;
                }
                return PageId;
            }
        }

      function truncatetext(textTotrancate) {
      setTimeout(function () {
          if ($("[id$=tblRowBreadCrumb]").length<1){
                return;
                  }
          var browserWidth = $telerik.$(window).width();
          var btnRecordsRect = $("[id$=lnkBtnRecords]")[0].getBoundingClientRect();
          var breadCrumbRect = $("[id$=tblRowBreadCrumb]")[0].getBoundingClientRect();
          var menuRect = document.getElementsByClassName('drawer')[0].getBoundingClientRect();
          var breadCrumbWidth =breadCrumbRect.width;
          var btnRecordsPosition = btnRecordsRect.left;
          var menuWidth = menuRect.width - 72;
          var AvailableWidth = breadCrumbWidth - btnRecordsPosition + menuWidth;
          if (browserWidth < 854) {
              AvailableWidth = AvailableWidth - 20;
          }
          var TextWidth = GetTextWidth(textTotrancate);
          if (btnRecordsPosition == 0) {
              return ""
          }
          if (breadCrumbWidth < 600) {
              AvailableWidth = AvailableWidth - 10;
          }
          if (TextWidth <= AvailableWidth) {
              if (textTotrancate == undefined) {
                  $("[id$=lnkBtnRecords]")[0].text = "";
                  return ""
              }
              else {
                  $("[id$=lnkBtnRecords]")[0].text = textTotrancate;
                  return textTotrancate;
              }


          }
          else {
              var TruncatedText = textTotrancate;

              while (GetTextWidth(TruncatedText + "...") > AvailableWidth) {
                  TruncatedText = TruncatedText.slice(0, -1);
              }
              var BreadCrumbText = TruncatedText + "...";
              /* $("[id$=hdnTruncatedRecordDesc]")[0].value = "hasdasdg....";*/
              if (BreadCrumbText == undefined) {
                  $("[id$=lnkBtnRecords]")[0].text = "";
                  return "";
              }
              else {
                  $("[id$=lnkBtnRecords]")[0].text = BreadCrumbText;
                  return BreadCrumbText;
              }

          }
      }, 100)

  }

        function GetTextWidth(Text) {
            var Canvas = document.createElement("canvas");
            var Context = Canvas.getContext("2d");
            Context.font = window.getComputedStyle($("[id$=lnkBtnRecords]")[0]).font;
            return Context.measureText(Text).width;

        }
        function RemoveLeadingZeros(str) {
            return str.replace(/^0{1,3}/, '');
        }
    </script>

</telerik:RadCodeBlock>

<body id="body1" runat="server" tabindex="0">
    <form id="form1" runat="server" onsubmit="javascript:return PMFormSubmit(this,event);">
        <div style="z-index: 89999; width: 100%; height: 100%; position: fixed; zoom: 1; color: black;" class="Hide RadAjax RadAjax_Default DisableAllPage" id="DisableAllControlsOnPostback">
            <div class="raDiv"></div>
            <div id="PMLoadingIcon" class="raColor raTransp"></div>
        </div>
        <script type="text/javascript">

            var MasterRtime;
            var MasterRTimeout = false;
            var MasterRDelta = 100;

            function MasterWindowResizeEnd() {
                if (new Date() - MasterRtime < MasterRDelta) {
                    setTimeout(MasterWindowResizeEnd, MasterRDelta);
                } else {
                    MasterRTimeout = false;
                    setCookie('ScreenWidth', document.documentElement.clientWidth, null);
                    setCookie('ScreenHeight', document.documentElement.clientHeight, null);
                    resizeProjectCenterIframe();
                    ManageMenuState();
                }
            }

            function resizeProjectCenterIframe() {
                var iframe = document.getElementById("ctl00_CPH1_projectCenterFrame")
                if (iframe) {
                    var iframeWin = iframe.contentWindow || iframe.contentDocument.parentWindow;
                    if (iframeWin.document.body) {
                        var height = (iframeWin.document.documentElement.scrollHeight || iframeWin.document.body.scrollHeight);
                        $("#ctl00_CPH1_projectCenterFrame").css("cssText", "height: " + height + 'px !important;');
                    }


                }
            }
            function setCookie(c_name, value, expiredays) {
                var exdate = new Date();
                exdate.setDate(exdate.getDate() + expiredays);
                document.cookie = c_name + "=" + escape(value) +
                    ((expiredays == null) ? "" : ";expires=" + exdate.toGMTString()) + "; path=/";
            }
            var OriginalRecordDesc;
            $(document).ready(function () {
                var img = new Image();
                img.src = "CSS/Images/loading.gif";
                $("[id$='hlPage']").click(function (e) {
                     const hasInlineClick = $(this).attr("onclick");
                    if (hasInlineClick) return;
                    if (dirty && (dirtyEnabled == 'true')) {
                        if (confirm(Msg_PromptToSave) == false) {
                            e.preventDefault();
                            return false;
                        } else {
                            return true;
                        }
                    }
                    $("[id=DisableAllControlsOnPostback]").removeClass("Hide");
                });
                setCookie('ScreenWidth', document.documentElement.clientWidth, null);
                setCookie('ScreenHeight', document.documentElement.clientHeight, null);
                $("#ctl00_CPH1_projectCenterFrame").on('load', function () { resizeProjectCenterIframe(); });
                ManageMenuState();
                $(window).resize(function () {
                    MasterRtime = new Date();
                    if (MasterRTimeout == false) {
                        MasterRTimeout = true;
                        setTimeout(MasterWindowResizeEnd, MasterRDelta);
                    }
                    truncatetext(OriginalRecordDesc);
                    var browserWidth = $telerik.$(window).width();
                    var div = document.querySelector(".ModulesParentDiv");
                    var HasConditionalSecurityDiv = document.querySelector(".HasConditionalSecurityDiv");
                    var flyout = document.querySelector(".flyoutPopup");
                    var BtnRecords = null;
                    if ($("[id$=lnkBtnRecords]").length > 0) {
                        BtnRecords = document.getElementById($("[id$=lnkBtnRecords]")[0].id);
                    }
                    if (!BtnRecords) return;
                    if (browserWidth < 768) {
                        if (flyout.classList.contains('open') && FlyoutIsOpen == true) {
                            SaveExplorerSettings();
                            flyout.style.display = "none";
                            FlyoutIsOpen = false;
                        } else if (div.classList.contains('open') && div.firstChild.id == 'txtsearchModules') {
                            div.style.display = "none";
                        } else if (div.classList.contains('open') && div.firstChild.id == 'txtsearchRecordTypes') {
                            div.style.display = "none";
                        } else if (div.classList.contains('open') && div.firstChild.id == 'txtsearchRecords') {
                            div.style.left = (BtnRecords.getClientRects()[0].x) + 20 + "px";
                        } else if (HasConditionalSecurityDiv.classList.contains('open') && HasConditionalSecurityDiv.childNodes[1].id == 'SkeletonDiv') {
                            HasConditionalSecurityDiv.style.left = (BtnRecords.getClientRects()[0].x) + 20 + "px";
                        }
                    } else {
                        if (div.classList.contains('open') && div.firstChild.id == 'txtsearchRecords') {
                            div.style.left = (BtnRecords.getClientRects()[0].x) + 20 + "px";
                        } else if (HasConditionalSecurityDiv.classList.contains('open') && HasConditionalSecurityDiv.childNodes[1].id == 'SkeletonDiv') {
                            HasConditionalSecurityDiv.style.left = (BtnRecords.getClientRects()[0].x) + 20 + "px";
                        }
                    }
                });

                if (EventServiceElapsedTime > 0) {
                    setTimeout(displaySessionTimeOutPopUp, EventServiceElapsedTime);
                }



                <%--var CanEditMySettings = '<%=PM.HomeInfo.AllowEditMySettings%>';
                if (CanEditMySettings == 'True') {
                    $('.ChangeHomeName > span').html('<%= GetGlobalResourceObject("PMWeb", "MainMenu_Profile")%>');
                    $('.MobileHome').addClass('MobileProfile');
                    $('.ChangeHomeNameMobile > span').html('<%= GetGlobalResourceObject("PMWeb", "MainMenu_Profile")%>');
                    $('.Module.Utility > a:first-of-type').removeClass('active');
                    $('.ChangeHomeHighlightMobile > span').html('');
                    $('.ChangeHomeHighlightMobile > a:first-of-type').removeClass('active');
                }
                else {
                    $('.ChangeHomeName > span').html('<%= GetGlobalResourceObject("PMWeb", "MainMenu_Home")%>');
                    if (window.location.href.includes("Home.aspx") == true) {
                        $('.Module.Utility > a:first-of-type').addClass('active');
                        $('.ChangeHomeHighlightMobile > a:first-of-type').addClass('active');
                    }
                }--%>

            });

            function OpenUserProfilePopup(URL) {
                var browserWidth = $telerik.$(window).width();
                var browserHeight = $telerik.$(window).height();
                var wnd = window.radopen(URL, browserWidth, browserHeight);
                wnd.set_visibleTitlebar(false);
                wnd._topResizer.parentElement.className = "";
                if (isMobileScreen()) {
                    wnd.setSize(browserWidth - 10, browserHeight);
                    wnd.moveTo(0, 0);
                }
                else {
                    wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                    wnd.Center();
                }
                wnd.get_popupElement().className = wnd.get_popupElement().className + " UserProfilePopup"
                $("#DisableAllControlsOnPostback").remove();
                return false;
            }

        <%--    function UserEditSettings(sender) {
                var browserWidth = $telerik.$(window).width();
                var browserHeight = $telerik.$(window).height();

                var CanEditMySettings = '<%=PM.HomeInfo.AllowEditMySettings%>';
                if (CanEditMySettings == 'True') {
                    return OpenUserProfilePopup('UserProfilePopup.aspx');
                }
                else {
                    return GoToHomePage(sender);
                }
            }--%>

            $(document).keypress(function (e) {
                var code = null;
                code = (e.keyCode ? e.keyCode : e.which);
                var elementType = e.target.nodeName.toLowerCase();
                if (elementType != 'textarea') {
                    if (code == 13) {
                        e.preventDefault();
                        return false;

                    }
                }

            });

            function GetValueToReturn(combobox, eventArgs) {
                var SelectedValue;
                var hdn = combobox.get_id().substring(combobox.get_id().lastIndexOf('_'), combobox.get_id().lenght - 1) + '_hddnIds';
                var hdnField = $("[id$=" + hdn + "]")[0];
                var context = eventArgs.get_context();
                context["Ids"] = hdnField.value;
            }
            function generateIframeUrl(url){
                if(window.location.href.toLowerCase().includes('isiframe')){
                    url+=url.includes('?') ? '&isIframe=1' : '?isIframe=1';
                    return url;
                }
                return url;
            }

            function sendPendoPayload() {
                var PendoPayload = {
                    visitor: {
                        id: '<%= PM.UserInfo.UserName %>'
                    },
                    account: {
                        id: '<%= PM.LicenseInfo.ClientNumber %>',
                        pmwebversion: '<%= PM.PMWebAssemblyVersion.Split("."c)(0) & "." & PM.PMWebAssemblyVersion.Split("."c)(1) %>'
                    }
                };
                return PendoPayload;
            }


            window.addEventListener("message", event => {
                switch (event.data.event_id) {
                    case "PendoInit":
                        const targetWindow = $("[id$=ngFrame]")[0];
                        if (targetWindow) {
                            const messageData = {
                                event_id: 'PendoPayload',
                                data: this.sendPendoPayload()
                            };
                            targetWindow.contentWindow.postMessage(messageData, '*');

                        }
                        break;
                    case "ProfileSettingsSaved":
                        $("[id$=btnUpdateUserInfo]")[0].click();
                        break;
                    case "updateTabsCount":
                        this.UpdateTabCount(event.data.tbName,event.data.value);
                        break;
                    case "GoToPreviousPage":
                        window.history.back();
                        break;
                    case "GoToNewRecord":
                        if (window.location.href.toLowerCase().includes('adaptiveforms.aspx')) {
                            const params = new URL(window.location.href.toLowerCase()).searchParams;
                            const templateId = params.get("templateid");
                            window.location = generateIframeUrl(window.location.pathname + '?TemplateId=' + templateId + '&Id=0');
                            break;
                        }
                        window.location = generateIframeUrl(window.location.pathname);
                        break;
                    case "DeleteRecord":
                        if (window.location.href.toLowerCase().includes('adaptiveforms.aspx')) {
                            const params = new URL(window.location.href.toLowerCase()).searchParams;
                            const templateId = params.get("templateid");
                            window.location = generateIframeUrl(window.location.pathname + '?TemplateId=' + templateId + '&Id=0');
                            break;
                        }
                        window.history.replaceState({}, '', generateIframeUrl(window.location.pathname))
                        window.location = generateIframeUrl(window.location.pathname);
                    break;
                    case "GoToNewlyCreatedRecord": {
                        if (window.location.href.toLowerCase().includes('adaptiveforms.aspx')) {
                            break;
                        }
                        const recordId = event.data.recordId;
                        const url = new URL(window.location.href);
                        const params = new URLSearchParams(url.search);
                        let existingKey = 'Id';

                        for (const [key] of params.entries()) {
                            if (key.toLowerCase() === 'id') {
                                existingKey = key;
                                break;
                            }
                        }
                        params.set(existingKey, recordId);
                        url.search = params.toString();
                        window.location.href = generateIframeUrl(url.toString());
                        break;
                    }
                    case "OpenDocTeamAttachment": {
                        const actionId = event.data.actionId
                        OpenPOPUp('DocumentTeamAttachmentsPopup.aspx?ActionId=' + actionId, 825, 300, false);
                        break;
                    }
                    case "GoToBiReports":
                        // TODO: Global_CurrentModuleId works? or should it be changed?
                        window.location = generateIframeUrl("ReportManager.aspx?ModuleId=" + Global_CurrentModuleId);
                        break;
                    case "ShowBiReports": {
                        const objectType = event.data.objectType;
                        const recordId = event.data.recordId
                        const description = event.data.description;
                        const recordDescription = event.data.recordDescription
                        const entityId = event.data.entityId;
                        const entityType = event.data.entityType || 0
                        OpenPOPUp(`ReportsPreviewPopup.aspx?ObjectType=${objectType}&Id=${recordId}&Description=${description}&RecordDescription=${recordDescription}&EntityId=${entityId}&EntityType=${entityType}`,
                            890, 430, false);
                        break;
                    }
                    case "ShowPmReports": {
                        const objectType = event.data.objectType;
                        const recordId = event.data.recordId
                        const entityId = event.data.entityId
                        const entityType = event.data.entityType || 0

                        const left = (screen.width - 900) / 2;
                        const top = (screen.height - 500) / 2;
                        OpenPOPUp(`PMWebReports.aspx?ObjectType=${objectType}&Id=${recordId}&EntityId=${entityId}&EntityType=${entityType}`,
                            'welcome', 'location=0,status=0,menubar=1,addressbar=0,resizable=1,scrollbars=1,width=890,height=430,top=' + top + ',left=' + left);
                        break;
                    }
                    case "ShowMergeTemplates": {
                        const objectType = event.data.objectType;
                        const recordId = event.data.recordId
                        const description = event.data.description;
                        const recordDescription = event.data.recordDescription
                        const entityId = event.data.entityId
                        const entityType = event.data.entityType || 0
                        const left = (screen.width - 1045) / 2;
                        const top = (screen.height - 515) / 2;
                        OpenPOPUp(`MergeTemplatePopup.aspx?ObjectType=${objectType}&Id=${recordId}&Description=${description}&RecordDescription=${recordDescription}&EntityId=${entityId}&EntityType=${entityType}`,
                            'welcome', 'location=0,status=0,menubar=0,addressbar=0,resizable=1,scrollbars=1,width=1045,height=515,top=' + top + ',left=' + left);

                        break;
                    }
                    case "GenerateTransmittal": {
                        const id = event.data.id;
                        const url = `Transmittals.aspx?Id=${id}&ModuleId=2&PageId=144`;
                        window.location.href = generateIframeUrl(url);
                        break;
                    }
                    case "GenerateContractCO": {
