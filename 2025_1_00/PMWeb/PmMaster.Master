<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="PmMaster.master.vb"
    Inherits="Website.PmMaster" %>

<%@ Register Assembly="Telerik.Web.UI" Namespace="Telerik.Web.UI" TagPrefix="telerik" %>
<%@ Register Src="ProjectExplorer.ascx" TagName="ProjectExplorer" TagPrefix="uc1" %>


<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>PMWEB</title>
    <telerik:RadCodeBlock ID="RadCodeBlock2" runat="server">
        <link href="CSS/MainCss.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" type="text/css" />

        <link href="CSS/ControlsCSS/Button.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Combobox.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Editor.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Grid.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Menu.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Scheduler.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/TabMultipage.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Toolbar.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Tree.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Calendar.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Rotator.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/RadDock.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Input.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Upload.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Window.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Slider.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/ColorPicker.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Splitter.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/Rating.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/AjaxLoadingPanel.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/CountDown.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/ListBox.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/ControlsCSS/OrgChart.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/MaterialIcons/material-icons.css" rel="stylesheet" />
        <link href="CSS/ControlsCSS/RadMultiSelect.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
        <link href="CSS/FolderManager.css?rnd=<%= PM.cssRnd  %>" rel="stylesheet" />
    </telerik:RadCodeBlock>
    <link rel="SHORTCUT ICON" href="Images/Global/favicon.ico" type="image/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <style type="text/css">
        .DocumentMoreResultsBox {
            margin: 1px 0 0 0;
            padding: 2px 5px;
            border-width: 1px 0 0 0;
            border-style: solid;
            text-align: center;
            cursor: pointer;
            border-color: /*2*/ #7396AA /*2*/;
            color: #fff;
            background: /*2*/ #7396AA /*2*/
        }


        #DocumentMoreResultsBoxImage {
            color: #fff;
            margin: 0 2px;
            width: 0;
            height: 0;
            border-width: 4px;
            border-style: solid;
            border-left-color: transparent;
            border-right-color: transparent;
            border-bottom-color: transparent;
            display: inline-block;
            overflow: hidden;
            vertical-align: middle;
            cursor: pointer;
        }

        @keyframes animationPanelToggleHide {
            from {
                opacity: 1;
                transform: scale(1);
                height: 350px;
            }

            to {
                opacity: 0;
                transform: scale(0);
                height: 0;
            }
        }

        @keyframes animationPanelToggleShow {
            from {
                opacity: 0;
                transform: scale(0);
                height: 0;
            }

            to {
                opacity: 1;
                transform: scale(1);
                height: calc(70vh);
            }
        }

        .closeanimation {
            height: 0;
            transition-property: all;
            transition-duration: .5s;
            transition-timing-function: cubic-bezier(0,1,0.5,1);
        }

        .openanimation {
            height: 70vh;
            transition-property: all;
            transition-duration: .5s;
            transition-timing-function: cubic-bezier(0,1,0.5,1);
        }

        .MobileMenuItems {
            background-color: #fff;
            z-index: 999999999999;
        }

            .MobileMenuItems.hiddenMobileMenuItems {
                height: 0px;
            }

            .MobileMenuItems i {
                color: rgb(102,102,102);
            }

        .mobilemodules {
            width: 100%;
        }

            .mobilemodules td {
                text-align: center;
                width: 33.33%;
            }

        .MobileMenuItems a {
            text-transform: uppercase;
            text-decoration: none;
            color: rgb(153,153,153);
            position: relative;
        }

        .Masterfader .rrButton.rrButtonLeft {
            left: 0 !important;
            top: 50%;
            width: 24px;
            background: none !important;
            display: block;
            position: absolute;
            height: 24px;
        }

        .Masterfader .rrButton.rrButtonRight {
            left: calc(100% - 24px) !important;
            top: 50%;
            height: 24px;
            width: 24px;
            background: none !important;
            display: block;
            position: absolute;
        }

        .RotatorPopup {
            position: fixed;
            top: calc(50%);
            background-color: #fff;
            width: auto;
            left: calc(50%);
            z-index: 9999;
            height: auto;
            padding: 10px 10px 10px 10px;
            transform: translate(-50%, -50%);
        }

        .Masterfader .rrButton.rrButtonRight {
            background-image: url(CSS/Images/ResponsiveIcons/24White.png) !important;
            background-position: -288px 0 !important;
            cursor: pointer;
        }

        .Masterfader .rrButton.rrButtonLeft {
            background-image: url(CSS/Images/ResponsiveIcons/24White.png) !important;
            background-position: -264px 0 !important;
            cursor: pointer;
        }

        .RadAjax.RadAjax_Default.DisableAllPage {
            width: 100% !important;
            height: 100% !important;
            position: fixed !important;
            zoom: 1 !important;
            color: black !important;
            left: 0 !important;
            top: 0 !important;
        }


        .FooterPadding {
            margin-left: 24px;
            margin-right: 24px;
            position: relative;
            top: 50%;
            transform: translateY(-50%);
        }

        .FoldersParentDiv {
            position: absolute;
            background-color: white;
            border: 1px solid black;
            z-index: 9999;
        }

        .FoldersDiv {
            max-height: calc(100vh - 204px);
            /*width: 250px;*/
            background-color: white;
            overflow: auto;
        }

        .FoldersTable {
            padding: 5px 24px !important;
            cursor: pointer;
            display: block;
        }

            .FoldersTable:hover {
                background-color: #ededed;
            }

        @media (max-width: 768px) {
            #MPShrtct {
                display: none;
            }
        }

        .UserProfilePopup .rwWindowContent > iframe {
            border-radius: 10px;
        }

        .UserProfilePopup .rwWindowContent {
            background-color: #ffffff00 !important;
        }

        a.ArrowDown {
            width: 12px;
            height: 12px;
            background-image: url(Css/Images/ResponsiveIcons/16White.png);
            margin-left: 5px;
            margin-right: 15px;
            display: inline-block;
            background-position: -193px,0;
            transform: rotate(90deg);
        }

        .Arrow svg {
            width: 24px;
            height: 24px;
            transform: rotate(-90deg);
            top: 46px;
        }

        .Arrow {
            position: relative;
            top: 5px
        }

        .ShowFalse {
            visibility: hidden
        }

        .SkeletonDiv {
            background-color: white;
            overflow: hidden;
            width: 219px;
            height: 65px;
            text-align: center;
            display: flex;
        }

        .HasConditionalSecurityDiv {
            left: 0px;
            top: 0px;
            position: absolute;
            background-color: rgba(255,255,255,1);
            border-color: #e5e5e5;
            border-radius: 8px;
            border-style: solid;
            box-sizing: border-box;
            border-width: 1px;
            padding-left: 5px;
            padding-right: 5px;
            padding-top: 5px;
            z-index: 7000;
            display: none;
            margin-bottom: 20px;
            height: 202px;
            width: 256px;
            box-shadow: 0px 4px 4px rgba(0,0,0,0.34901960784313724);
        }

            .HasConditionalSecurityDiv.open {
                animation: slideDown 500ms linear;
            }


        .SkeletonText {
            align-self: flex-start;
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 14px;
            font-style: normal;
            color: #424242;
            padding-top: 2px !important;
            white-space: pre-line;
            text-align: left;
            position: absolute;
            top: 24px;
            left: 24px;
            cursor: pointer;
        }

        .ManagerPageSkeletonText {
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 14px !important;
            font-style: normal;
            height: 36px;
            bottom: 20px;
            color: #424242;
            border-width: 1px;
            border-radius: 6px;
            border-color: #e5e5e5;
            border-style: solid;
            box-sizing: border-box;
            background-color: rgba(255, 255, 255, 1);
        }

        a.ManagerPageSkeletonText {
            position: absolute;
            width: 118px !important;
            left: 65px;
            display: flex;
            align-self: center;
            top: 100px;
            align-items: center;
            padding-left: 12px;
        }

        .ModulesDiv {
            background-color: white;
            overflow-x: hidden;
            max-width: 600px;
            max-height: calc(100vh - 233px);
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .ModulesParentDiv {
            left: 0px;
            top: 0px;
            position: fixed;
            background-color: rgba(255,255,255,1);
            border-color: #e5e5e5;
            border-radius: 8px;
            border-style: solid;
            box-sizing: border-box;
            border-width: 1px;
            padding-left: 5px;
            padding-right: 5px;
            padding-top: 5px;
            margin-top: 11px;
            z-index: 7001;
            display: none;
            margin-bottom: 20px;
            max-height: calc(100vh - 164px);
            box-shadow: 0px 8px 10px 0 rgba(0, 0, 0, .12), 0px 4px 16px 0 rgba(0, 0, 0, .12);
        }

        @keyframes slideDown {
            from {
                transform: translateY(-100% );
                z-index: 7000;
            }

            to {
                transform: translateY(0);
                z-index: 7000;
            }
        }


        .ModulesParentDiv.open {
            animation: slideDown 500ms linear;
        }


        .NoRecordsTable {
            display: block;
            border-color: #e5e5e5;
            padding-top: 10px !important;
            padding-right: 24px;
            padding-bottom: 10px !important;
            font-family: 'Inter',sans-serif;
            font-style: normal;
            font-size: 14px;
        }

        .RecordTypesTable {
            cursor: pointer;
            border-color: #e5e5e5;
            padding-top: 10px !important;
            padding-right: 17px;
            padding-bottom: 10px !important;
            font-family: 'Inter',sans-serif;
            font-style: normal;
            font-size: 14px;
            letter-spacing: normal;
            width: 35px;
            height: 10px;
            color: #424242;
        }

        tr:hover td.RecordTypesTable {
            background-color: #fafafa !important;
            background: inherit;
            border-radius: 4px;
        }

        .ModulesTable {
            cursor: pointer;
            display: block;
            border-color: #e5e5e5;
            padding-top: 6px !important;
         /*   padding-right: 24px;*/
            padding-bottom: 8px !important;
        }


            .ModulesTabletd:hover{
                 font-family: 'Inter',sans-serif;
                 font-style: normal;
                 background-color: #fafafa !important;
                 background: inherit;
                 border-radius: 4px;
            }

        a.ModulesTable {
            font-family: 'Inter', sans-serif;
            color: #424242;
            font-style: normal;
            font-weight: 400;
            padding-left: 13px !important;
            font-size: 14px;
            letter-spacing: normal;
            text-align: left;
            line-height: 1.428;
        }

        .ModulesTableWorkflow {
            font-family: 'Inter', sans-serif;
            color: #424242;
            font-style: normal;
            font-weight: 400;
            padding-left: 0px !important;
            font-size: 14px;
            letter-spacing: normal;
            line-height: 1.428;
            word-break: break-all;
        }

            .ModulesTableWorkflow:hover {
                font-family: 'Inter',sans-serif;
                font-style: normal;
                  background-color: #fafafa !important;
            }

        .ModulesTableHilightRecord {
            background-color: #f5f5f5 !important;
        }

        .ModulesTabletd {
            border-width: 0px;
            height: 36px;
            padding: 0px 16px;
            background: inherit;
            background-color: rgba(255,255,255,1);
            border: none;
            border-radius: 0px;
            box-shadow: none;
            word-break: break-all;
        }

        .searchSegment {
            font-family: 'Inter', sans-serif !important;
            font-weight: 400;
            font-style: normal;
            letter-spacing: normal;
            color: #000000;
            text-transform: none;
        }

        #txtsearchModules {
            position: relative;
            left: 8px;
            top: 5px;
            width: 231px;
            height: 36px;
            background: inherit;
            background-color: rgba(255,255,255,1);
            box-sizing: border-box;
            border-width: 1px;
            border-style: solid;
            border-color: #d6d6d6 !important;
            border-radius: 4px !Important;
            font-size: 14px;
            font-family: InterVariable, sans-serif;
            font-style: normal;
            line-height: 1.42;
            color: #424242;
            text-align: left;
            padding-left: 13px !important;
        }

            #txtsearchModules:focus {
              outline: none !important;
              border-color: /*2*/#30788A/*2*/ !important;
              box-shadow: 0 0 0 2px rgba(66, 66, 66, 0.08);
            }

            #txtsearchModules::placeholder {
                position: relative;
                left: 0px;
                top: 0px;
                width: 176px;
                height: 40px;
                padding: 2px 2px 2px 20px;
                font-family: InterVariable, sans-serif;
                font-weight: 450;
                font-style: normal;
                font-size: 14px;
                line-height: 1.42;
                letter-spacing: normal;
                color: #424242;
                text-transform: none;
                text-align: left;
                background-color: transparent;
                border-color: transparent;
                padding-left: 0px !important;
            }

            #txtsearchModules::-webkit-input-placeholder {
                color: #7F7F7F;
            }

        #txtsearchRecordTypes {
            position: relative;
            left: 6px;
            top: 5px;
            width: calc(100% - 12px);
            height: 36px;
            background: inherit;
            background-color: rgba(255,255,255,1);
            box-sizing: border-box;
            border-width: 1px;
            border-style: solid;
            border-color: rgba(208,213,221,1) !important;
            border-radius: 4px !Important;
            font-size: 14px;
            font-family: InterVariable, sans-serif;
            font-style: normal;
            line-height: 1.42;
            color: #424242;
            text-align: left;
            padding-left: 13px !important;
        }

            #txtsearchRecordTypes:focus  {
                outline: none !important;
                border-color: /*2*/#30788A/*2*/ !important;
                box-shadow: 0 0 0 2px rgba(66, 66, 66, 0.08);
            }

            #txtsearchRecordTypes::placeholder {
                position: relative;
                left: 0px;
                top: 0px;
                width: 176px;
                height: 40px;
                padding: 2px 2px 2px 20px;
                font-family: InterVariable, sans-serif;
                font-weight: 450;
                font-style: normal;
                font-size: 14px;
                line-height: 1.42;
                letter-spacing: normal;
                color: #424242;
                text-transform: none;
                text-align: left;
                background-color: transparent;
                border-color: transparent;
                padding-left: 0px !important;
            }

            #txtsearchRecordTypes::-webkit-input-placeholder {
                color: #7F7F7F;
            }

        #txtsearchRecords {
            position: relative;
            left: 6px;
            top: 5px;
            width: calc(100% - 12px);
            height: 36px;
            background: inherit;
            background-color: rgba(255,255,255,1);
            box-sizing: border-box;
            border-width: 1px;
            border-style: solid;
            border-color: #d6d6d6 !important;
            border-radius: 4px !Important;
            font-size: 14px;
            font-family: InterVariable, sans-serif;
            font-style: normal;
            line-height: 1.42;
            color: #424242;
            text-align: left;
            padding-left: 13px !important;
        }

            #txtsearchRecords:focus {
                border-color: /*2*/#30788A/*2*/ !important;
                box-shadow: 0 0 0 2px rgba(66, 66, 66, 0.08);
                outline: none;
            }

            #txtsearchRecords::placeholder {
                position: relative;
                left: 0px;
                top: 0px;
                width: 176px;
                height: 40px;
                padding: 2px 2px 2px 20px;
                font-family: InterVariable, sans-serif;
                font-weight: 450;
                font-style: normal;
                font-size: 14px;
                line-height: 1.42;
                letter-spacing: normal;
                color: #424242;
                text-transform: none;
                text-align: left;
                background-color: transparent;
                border-color: transparent;
                padding-left: 0px !important;
            }

            #txtsearchRecords::-webkit-input-placeholder {
                color: #7F7F7F;
            }

        .SegmentTable {
            left: 0px;
            top: 0px;
            background-color: rgba(255,255,255,1);
            background-image: none;
            box-sizing: border-box;
            border-width: 0px;
            border-style: none;
            border-color: rgba(170,170,170,1);
            border-radius: 1px;
            box-shadow: 0px 8px 10px 0 rgba(0, 0, 0, .12), 0px 4px 16px 0 rgba(0, 0, 0, .12);
            text-indent: initial;
        }


        .WhiteDarkBlueBackHover:hover {
            font-family: 'Inter',sans-serif;
            font-style: normal;
            text-shadow: 1px 0 0 rgb(225,225,225);
        }

        .ClearSearchImg {
            background-repeat: no-repeat;
            position: absolute;
            top: 20px;
            width: 16px;
            height: 16px;
            right: 24px;
            cursor: pointer;
        }

        .flyoutPopup {
            
            border-radius: 4px;
            top: 71px;
            bottom: 20px;
            background-color: #fff;
            position: fixed;
            z-index: 7003;
            max-height: calc(100vh - 120px);
        }

            .flyoutPopup.open {
                animation: slideDownFlyout 500ms linear;
            }


        @keyframes slideDownFlyout {
            from {
                transform: translateY(-100% );
                z-index: 7002;
            }

            to {
                transform: translateY(0);
                z-index: 7002;
            }
        }

        @keyframes slideUpFlyout {
            from {
                transform: translateY(0);
                z-index: 7002;
            }

            to {
                transform: translateY(-100% );
                display: none;
                z-index: 7002;
            }
        }

        .btnAiAssistant {
            display: inline-block;
            position: fixed;
            right: 100px;
        }

        .svgAiAssistant {
            fill: /*5*/ #69B932 /*5*/;
        }

        .svgAiAssistant-container:hover > .svgAiAssistant {
            fill: transparent;
            stroke: white;
            stroke-width: 2;
        }

        .svgAiAssistant-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 45px;
            height: 45px;
            cursor: pointer;
        }

            .svgAiAssistant-container:hover {
                position: relative;
                overflow: hidden;
                border-radius: 50%;
                background-color: rgb(52,152,219);
            }

        .flex-column {
            display: flex;
            flex-direction: column;
            height: 100dvh;
        }

        .main-layout {
            display: flex;
            flex: 1;    
            height: calc(100dvh - 30px);
        }

        @media screen and (min-width:320px) and (max-width:843px) {
            .main-layout {
                height: 100dvh;
                overflow-y: hidden;
            }
        }

        .sidebar {
            background-color: #002266;
            color: white;
            flex: 1;
            width: 224px;
            transition: width 0.5s;
            box-sizing: border-box;
        }

            .sidebar a {
                text-decoration: none;
                color: #fff;
            }

                .sidebar a:visited, .drawer a:active {
                    color: #fff;
                }

            .sidebar .Utility a:visited,
            .sidebar .Utility a:active {
                color: /*2*/ #3498DB /*2*/ !important;
            }

        .footer {
            height: 30px;
            color: #666;
            background-color: #ededed;
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #999;
            font-size: 8pt;
            padding-left: 24px;
            word-break: break-word;
            align-content: center;
            flex-shrink: 0;
        }
        .footer div {
            display: inline-block;

        }

      

        .rail .logo-container {
             height: 60px; 
        }
       


    </style>
</head>
<telerik:RadCodeBlock ID="RadCodeBlock1" runat="server">
    	<script type="text/javascript">
            (function (apiKey) {
                (function (p, e, n, d, o) {
                    var v, w, x, y, z;
                    o = p[d] = p[d] || {};
                    o._q = [];
                    v = ['initialize', 'identify', 'updateOptions', 'pageLoad', 'track'];
                    for (w = 0, x = v.length; w < x; ++w)(function (m) {
                        o[m] = o[m] || function () {
                            o._q[m === "initialize" ? "unshift" : "push"]([m].concat([].slice.call(arguments, 0)));
                        };
                    })(v[w]);
                    y = e.createElement(n); y.async = !0; y.src = `https://cdn.pendo.io/agent/static/${apiKey}/pendo.js`;
                    z = e.getElementsByTagName(n)[0]; z.parentNode.insertBefore(y, z);
                })(window, document, 'script', 'pendo');
            })('80f2e605-9a4f-4352-5d51-ab2d7417d8dd');

            // Optional: Identify your user
            pendo.initialize({
                visitor: {
                    id: '<%= PM.UserInfo.UserName %>'
			},
			account: {
                id: '<%= PM.LicenseInfo.ClientNumber %>',
                pmwebversion: '<%= PM.PMWebAssemblyVersion.Split("."c)(0) & "." & PM.PMWebAssemblyVersion.Split("."c)(1) %>'
                    }
                });
        </script>
