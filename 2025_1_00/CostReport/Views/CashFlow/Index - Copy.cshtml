@model Payment
@{
    ViewBag.Title = "Cash Flow";
    string[] defaultColumns = new string[] { "Id", "PackageNo", "Vendor", "Lpo", "Activity", "Budget", "OriginalContract", "ApprovedVo", "Forecast", "PaidCumulative", "RemainingValue" };

    string budgetMonth = "Revised Approved<br />Project Budget in<br />" + DateTime.Now.ToString("MMM yyyy");
}

<h2>Cash Flow Report</h2>

@(Html.Kendo().Grid<dynamic>()
    .Name("grid_Cashflow")
    .ColumnMenu(c => c.Enabled(true).Columns(false))
    .Columns(col => {
        col.Bound(typeof(String), "PackageNo").Title("Package No. &<br /> Description").Width(200).Locked(true).Lockable(false);
        col.Bound(typeof(String), "Vendor").Title("Vendor Name").Width(200).Locked(true).Lockable(false);
        col.Bound(typeof(String), "Lpo").Title("LPO / Cobtract Reference").Width(200).Locked(true).Lockable(false);
        col.Bound(typeof(String), "Activity").Title("Activity Name").Width(200).Locked(true).Lockable(false);
        col.Bound(typeof(double), "Budget").Title(budgetMonth).Format("{0:0,0.00}").Width(200).Lockable(false);
        col.Bound(typeof(double), "OriginalContract").Title("Original Contract<br /> Value").Format("{0:0,0.00}").Width(200).Lockable(false);
        col.Bound(typeof(double), "ApprovedVo").Title("Approved VO /<br /> Pending VO &<br /> Forecast Liability<br /> (incl. Early Warning)").Format("{0:0,0.00}").Width(200).Lockable(false);
        col.Bound(typeof(double), "Forecast").Title("Forecast Total<br /> Liability").Format("{0:0,0.00}").Width(200).Lockable(false);
        col.Bound(typeof(double), "PaidCumulative").Title("Cumulative <br />Payment").Format("{0:0,0.00}").Width(200).Lockable(false);
        col.Bound(typeof(double), "RemainingValue").Title("Remaining<br /> Value").Format("{0:0,0.00}").Width(200).Lockable(false);
        foreach (System.Data.DataColumn column in Model.Columns)
        {
            if(!defaultColumns.Any(w => w == column.ColumnName))
                col.Bound(column.DataType, column.ColumnName).Title(column.ColumnName.Replace("_", " ")).Format("{0:0,0.00}").Width(150).Lockable(false);
        }
    })
    .DataSource(dataSource => dataSource
        .Ajax() 
        .Read(read => read.Action("GetPayments", "CashFlow"))
                        .PageSize(100)
        .Model(model =>
        {
            var id = Model.Columns[0].ColumnName;
            model.Id(id);
            foreach (System.Data.DataColumn column in Model.Columns)
            {
                if (column.ColumnName.ToLower() != "id")
                    model.Field(column.ColumnName, column.DataType);
            }
        })
        .Batch(true)
        .ServerOperation(false)
    )
    .Scrollable(scrollable => scrollable.Height(540))
    .Pageable()
    .Filterable()
    .Sortable()
    .Editable(edt => edt.Mode(GridEditMode.InLine))
    .ToolBar(toolbar =>
    {
        toolbar.Save();
    })
)
@section scripts {
    <script type="text/javascript">
        function getDistributionValue(data, month) {
            return $.grep(data.distributionMonths, function (d) {
                return d.MonthName == month
            })[0].Value.toFixed(2);
        }
    </script>
}