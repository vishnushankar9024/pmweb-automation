<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Website.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections> 
  <appSettings>
    <add key="aspnet:MaxHttpCollectionKeys" value="30000" />  
    <add key="Domain" value="Development.PMWeb.com" />
    <add key="ADPAth" value="LDAP://Development.PMWeb.com" />
    <add key="ADUser" value="Administrator" />
    <add key="ADPassword" value="PMWeb" />  
    <add key="ADUsersPath" value="OU=PMWebOU," /> 
    <add key="SendExp" value="True" />
    <add key="SendExpEmail" value="nem@pssgroup.com" /> 
    <add key="SQLBinaryChunkSize" value="512000" />
    <add key="CookieLifeTime" value="216000" />    
    <add key="EventServiceElapsedMilliseconds" value="600000" /> 
    <add key="BrowserEventServiceElapsedMilliseconds" value="200000" />
    <add key="APIServiceElapsedMilliseconds" value="15000" /> 
    <add key="WeatherServiceElapsedMilliseconds" value="300000" /> 
    <add key="BrowserNotesServiceElapsedMilliseconds" value="10000" />
    <add key="RegenerateSessionId" value="false" />
    <add key="EnableMultipleDownload" value="true" />
    <add key="defaultPageUrl" value="Default.aspx?reason=ST"/>
    <add key="WeatherApiUrl" value="http://api.openweathermap.org/data/2.5/forecast?q=[REGION_NAME]&amp;mode=xml&amp;units=metric&amp;APPID=[WEATHER_API_KEY]" />
    <!-- 0.5 MB-->
    <add key="ResponseBinaryChunkSize" value="10000" />
    <add key="TokenGenExcludeList" value="Tasks.aspx?Req=Data;Tasks.aspx?Req=Save;Utilities/TreeGrid/Export.aspx" />
    <add key="ceTe.LicenseKey" value="RST20NXDCLBNIFIF/psFxLVaXOtG6CvBVnny1RuKfMWOeFxuVXeSLMenl0edAIDRwg00qnL2KuiHZ60sezAmctmuICgdEJOzqPeA" />
    <add key="Telerik.EnableEmbeddedSkins" value="false" />
    <add key="Telerik.EnableEmbeddedBaseStylesheet" value="false" />
    <add key="samlEnableLog" value="false" />
    <add key="TrainingConsumerServiceUrl" value="https://pmweb.myabsorb.com/account/saml" />
    <add key="TrainingServiceProviderUrl" value="https://training.pmweb.com/Account/SAML" />
    <add key="PasswordMigration" value="true"/>
    <add key="Telerik.Web.DisableAsyncUploadHandler" value="false"/>  
  	<add key="Telerik.AsyncUpload.ConfigurationEncryptionKey" value="psFxLVaXOtG6CvBVnny1RuKfMWOeFxuVXeSLMenl0edAIDRwg00qnL2KuiHZ60sezAmctmuICgdEJOzqPeAnemNEM" />
    <add key="Telerik.Upload.ConfigurationHashKey" value="nemMEMpsFxLVaXOtG6CvBVnny1RuKfMWOeFxuVXeSLMenl0edAIDRwg00qnL2KuiHZ60sezAmctmuICgdEJOzqPeA" />
    <add key="Telerik.Upload.AllowedCustomMetaDataTypes" value="Telerik.Web.UI.AsyncUploadConfiguration" />
  </appSettings>
  <!--
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web> 
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <!--<sessionState mode="SQLServer" sqlConnectionString="Data Source=10.0.20.100\R2;Integrated Security=False;uid=PMWebUser;pwd=PMWeb;" cookieless="false" timeout="300"></sessionState>-->
    <!--<sessionState mode="StateServer" stateConnectionString="tcpip=localhost:42424" cookieless="false" timeout="300"></sessionState>-->
    <sessionState mode="InProc" timeout="300" />
    <machineKey validationKey="1392A0BD1C4EC3FE826938CA11A66DB92E2D99AE9A418C8B45F4D61AC94B878E96823F2BEEF8391392DC1DBDBEEBB63CC0ADC4E871E725D236A1A596844D97B2" decryptionKey="46CC3919AB031156BEB1835D90D626DF41F1C889DE58485CFEBD73611DFFA3CF" validation="HMACSHA256" decryption="AES" />
    <trace enabled="false " localOnly="true" mostRecent="false" traceMode="SortByTime" />
    <customErrors mode="RemoteOnly" defaultRedirect="PMWebMaintenancePage.html">
      <error statusCode="403" redirect="NoAccess.htm" /> 
      <error statusCode="404" redirect="FileNotFound.htm" />
    </customErrors>
    <!-- maxRequestLength in KB(2.09 GB) executionTimeout in Secs (3 minutes) -->
    <httpRuntime maxRequestLength="2097902097" maxQueryStringLength="2097151" executionTimeout="1000" requestValidationMode="4.5" 
                 requestValidationType="HttpModule.Exceptions.PMWebRequestValidation" enableVersionHeader="false" enableHeaderChecking="true"/>
    <!-- 
            Set compilation debug="true" to insert debugging 
            symbols into the compiled page. Because this 
            affects performance, set this value to true only 
            during development.

            Visual Basic options:
            Set strict="true" to disallow all data type conversions 
            where data loss can occur. 
            Set explicit="true" to force declaration of all variables.
        -->
    <compilation debug="false" strict="false" explicit="true" targetFramework="4.5">
      <assemblies>
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Drawing.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="Microsoft.ReportViewer.WebForms, Version=12.0.0.0, Culture=neutral, PublicKeyToken=89845DCD8080CC91" />
        <add assembly="Microsoft.ReportViewer.Common, Version=12.0.0.0, Culture=neutral, PublicKeyToken=89845DCD8080CC91" />
        <add assembly="Microsoft.Build.Framework, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
      <buildProviders>
        <add extension=".rdlc" type="Microsoft.Reporting.RdlBuildProvider, Microsoft.ReportViewer.Common, Version=12.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" />
      </buildProviders>
    </compilation>
    <pages enableViewStateMac="true" viewStateEncryptionMode="Always"  enableEventValidation="false" enableSessionState="true" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
      <namespaces>
        <clear />
        <add namespace="System" />
        <add namespace="System.Collections" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Collections.Specialized" />
        <add namespace="System.Configuration" />
        <add namespace="System.Text" />
        <add namespace="System.Text.RegularExpressions" />
        <add namespace="System.Linq" />
        <add namespace="System.Xml.Linq" />
        <add namespace="System.Web" />
        <add namespace="System.Web.Caching" />
        <add namespace="System.Web.SessionState" />
        <add namespace="System.Web.Security" />
        <add namespace="System.Web.Profile" />
        <add namespace="System.Web.UI" />
        <add namespace="Telerik.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="System.Web.UI.WebControls.WebParts" />
        <add namespace="System.Web.UI.HtmlControls" />
        <add namespace="Microsoft.Security.Application" />
      </namespaces>
      <controls>
        <add assembly="Telerik.Web.UI" namespace="Telerik.Web.UI" tagPrefix="telerik" />
      </controls>
    </pages>
    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 
        -->
    <authentication mode="Windows">
      <forms loginUrl="default.aspx" name="PMCookie" path="/" slidingExpiration="true" />
    </authentication>
    <!--
            The <customErrors> section enables configuration 
            of what to do if/when an unhandled error occurs 
            during the execution of a request. Specifically, 
            it enables developers to configure html error pages 
            to be displayed in place of a error stack trace.

        
        -->
    <httpHandlers>
      <add path="Telerik.Web.UI.DialogHandler.aspx" verb="*" type="Telerik.Web.UI.DialogHandler, Telerik.Web.UI, Culture=neutral, PublicKeyToken=121fae78165ba3d4" />
      <add path="Telerik.Web.UI.WebResource.axd" verb="*" type="Telerik.Web.UI.WebResource" validate="false" />
      <add path="ChartImage.axd" verb="*" type="Telerik.Web.UI.ChartHttpHandler" validate="false" />
      <add path="Telerik.Web.UI.SpellCheckHandler.axd" verb="*" type="Telerik.Web.UI.SpellCheckHandler" validate="false" />
      <add path="Telerik.RadUploadProgressHandler.ashx" verb="*" type="Telerik.Web.UI.RadUploadProgressHandler" validate="false" />
      <add path="Reserved.ReportViewerWebControl.axd" verb="*" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=12.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" validate="false" />
    </httpHandlers>
    <httpModules>
      <add name="Exception" type="HttpModule.Exceptions.ExceptionsHandler" />
      <add name="RadUploadModule" type="Telerik.Web.UI.RadUploadHttpModule" />
    </httpModules>
  </system.web>
  <!-- 
        The system.webServer section is required for running ASP.NET AJAX under Internet
        Information Services 7.0.  It is not necessary for previous version of IIS.
    -->
  <system.webServer>
    <!-- rewrite section giving error on IIS server 2016 
    <rewrite>
      <rules>
        <rule name="WordBypass" enabled="true" stopProcessing="true">
              <match url=".*" />
              <conditions>
                  <add input="{HTTP_USER_AGENT}" pattern="Word|Excel|PowerPoint|ms-office" />
              </conditions>
              <action type="CustomResponse" statusCode="200" statusReason="Refresh" statusDescription="Refresh" />
          </rule>
      </rules>
    </rewrite>
   -->
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <add name="RadUploadModule" preCondition="integratedMode" type="Telerik.Web.UI.RadUploadHttpModule" />
      <add name="Exception" type="HttpModule.Exceptions.ExceptionsHandler" preCondition="integratedMode" />
    </modules>
    <handlers>
      <add name="Telerik_Web_UI_WebResource_axd" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource" />
      <add name="ChartImage_axd" verb="*" preCondition="integratedMode" path="ChartImage.axd" type="Telerik.Web.UI.ChartHttpHandler" />
      <add name="Telerik_Web_UI_SpellCheckHandler_axd" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler" />
      <add name="Telerik_RadUploadProgressHandler_ashx" verb="*" preCondition="integratedMode" path="Telerik.RadUploadProgressHandler.ashx" type="Telerik.Web.UI.RadUploadProgressHandler" />
      <add name="Telerik_Web_UI_DialogHandler_aspx" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.DialogHandler.aspx" type="Telerik.Web.UI.DialogHandler" />
      <add name="ReportViewerWebControl" path="Reserved.ReportViewerWebControl.axd" preCondition="integratedMode" verb="*" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=12.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" />
      <add name="ReportViewerWebControlHandler" preCondition="integratedMode" verb="*" path="Reserved.ReportViewerWebControl.axd" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=12.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" />
    </handlers>
    <httpProtocol>
      	<customHeaders>
          <remove name="X-Powered-By" />
          <!--<remove name="Content-Security-Policy" />
					<add name="Strict-Transport-Security" value="max-age=31536000" />
					<add name="Referrer-Policy" value="no-referrer" /> 
          <add name="Content-Security-Policy" value="default-src https: data: 'unsafe-inline' 'unsafe-eval'" />
          <add name="x-frame-options" value="SAMEORIGIN" />-->
				</customHeaders>
    </httpProtocol>
    <security>
        <requestFiltering>
           <hiddenSegments>
          <remove segment="PMWebDatabases.xml"/>
          <add segment="PMWebDatabases.xml" />
        </hiddenSegments>
       <requestLimits maxAllowedContentLength="2097902097" maxUrl="10999" maxQueryString="2097151" />
      </requestFiltering>
    </security>
  <staticContent>
    <remove fileExtension=".woff2" />
    <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
  </staticContent>
  </system.webServer>
  <location path="Telerik.Web.UI.WebResource.axd">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <applicationSettings>
    <Website.My.MySettings>
      <setting name="Website_RSWS_ReportingService2005" serializeAs="String">
        <value>http://newsrv02/ReportServer/ReportService2005.asmx</value>
      </setting>
      <setting name="Website_RSEXWS_ReportExecutionService" serializeAs="String">
        <value>http://newsrv02/ReportServer/ReportExecution2005.asmx</value>
      </setting>
      <setting name="Website_IntegrationWS_Integration" serializeAs="String">
        <value>http://localhost:33213/Integration.asmx</value>
      </setting>
      <setting name="Website_WSSAuthentication_Authentication" serializeAs="String">
        <value>http://newsrv02:443/_vti_bin/Authentication.asmx</value>
      </setting>
      <setting name="Website_WSPSV_WS1" serializeAs="String">
        <value>http://localhost/pmwebservervalidator/WS1.asmx</value>
      </setting>
      <setting name="Website_P6WS_P6WS" serializeAs="String">
        <value>http://localhost:8846/P6WS.asmx</value>
      </setting>
    </Website.My.MySettings>
  </applicationSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
   <dependentAssembly>
        <assemblyIdentity name="RestSharp"
                          publicKeyToken="598062e77f915f75"
                          culture="neutral" />
       <bindingRedirect oldVersion="0.0.0.0-100.0.0.0" newVersion="100.0.0.0" />
       <bindingRedirect oldVersion="100.0.0.1-105.2.3.0" newVersion="105.2.3.0" />
       <codeBase version="105.2.3.0" href="bin\RestSharp.dll" />
       <codeBase version="100.0.0.0" href="Utilities\RestSharp100.dll" />
      </dependentAssembly>
     
    </assemblyBinding>
  </runtime>
</configuration>