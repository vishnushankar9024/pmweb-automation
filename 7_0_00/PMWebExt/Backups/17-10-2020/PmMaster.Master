                            </asp:LinkButton>
                        </td>
                        <td style="text-align: center; width: 33.33%">
                            <asp:LinkButton runat="server" ID="btnMobileAdvanceSearch" OnClientClick="return OpenMobileFlyoutMenu(this)">
                                                                               <table style="margin:0 auto;">
                                                                                   <tr>
                                                                                       <td>
                                                                                           
                                                                                           <div class="mobilMenuIcon">
                                                                              <div class="Search">
                                                                                    &nbsp;
                                                                            </div>
                                                                                               </div></td></tr><tr>
                                                                                       <td>
                                                                                <span><asp:Literal runat="server" Text="<%$ Resources:PMWeb, MainMenu_Search %>" /></span>
                                                                                       </td>
                                                                                   </tr>
                                                                               </table>
                            </asp:LinkButton>
                        </td>
                    </tr>
                </table>
                <asp:DataList ID="dlMenuModules" runat="server" RepeatColumns="3" RepeatLayout="Table" CssClass="mobilemodules" RepeatDirection="Horizontal">
                    <ItemTemplate>
                        <asp:LinkButton runat="server" ID="btnMobileModules" OnClientClick="return OpenMobileFlyoutMenu(this)" data-CommandArgument='<%# Container.DataItem("Id") %>'>
                                                                               <table style="margin:0 auto;">
                                                                                   <tr>
                                                                                       <td>

                                                                                         
                                                                                                <div class="mobilMenuIcon"> 
                                                                                                     <div class="<%# Eval("Icon") %>">
                                                                               &nbsp;
                                                                            </div></div></td></tr><tr>
                                                                                       <td>
                                                                                <span><%# Eval("Text") %></span>
                                                                                       </td>
                                                                                   </tr>
                                                                               </table>
                        </asp:LinkButton>
                    </ItemTemplate>
                </asp:DataList>

            </div>
        </div>
        <telerik:RadCodeBlock runat="server" ID="rdblockprojectexplorer">
            <div class="flyoutPopup Hide">
                <asp:LinkButton runat="server" ID="lnkCloseFlyout" CssClass="lnkCloseFlyout" OnClientClick="return CloseFlyout();">
                            <div class="CloseFlyout">&nbsp;</div>
                </asp:LinkButton>
                <telerik:RadAjaxLoadingPanel ID="ldpFlyout" runat="server" BackgroundTransparency="100" />
                <div id="tblProjectExplorer" class="ProjectExplorerContainer" runat="server">
                    <uc1:ProjectExplorer ID="ProjectExplorer1" runat="server" visible="False" />
                </div>
            </div>
            <div class="RotatorPopup Hide">

                <div id="PmMasterFader" class="Masterfader" style="position: relative;">

                    <div class="rrButton rrButtonRight" id="popupnext">&nbsp;</div>
                    <div class="rrButton rrButtonLeft" id="popupprev">&nbsp;</div>
                </div>


            </div>
            <div id="flyoutBackdrop" onclick="javascript:return CloseMasterfader();" class="Hide" style="position: fixed; top: 0; right: 0; left: 0; bottom: 0; z-index: 7002; background-color: rgba(0,0,0,0.7);"></div>
        </telerik:RadCodeBlock>
    </form>
</body>
</html>

