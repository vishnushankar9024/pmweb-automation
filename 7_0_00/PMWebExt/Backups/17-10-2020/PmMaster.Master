    <link rel="SHORTCUT ICON" href="Images/Global/favicon.ico" type="image/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <style type="text/css">
        @keyframes animationPanelToggleHide {
            from {
                opacity: 1;
                transform: scale(1);
                height: 350px;
            }

            to {
                opacity: 0;
                transform: scale(0);
                height: 0;
            }
        }

        @keyframes animationPanelToggleShow {
            from {
                opacity: 0;
                transform: scale(0);
                height: 0;
            }

            to {
                opacity: 1;
                transform: scale(1);
                height: calc(70vh);
            }
        }

        .closeanimation {
            height: 0;
            transition-property: all;
            transition-duration: .5s;
            transition-timing-function: cubic-bezier(0,1,0.5,1);
        }

        .openanimation {
            height: 70vh;
            transition-property: all;
            transition-duration: .5s;
            transition-timing-function: cubic-bezier(0,1,0.5,1);
        }

        .MobileMenuItems {
            background-color: #fff;
            z-index: 999999999999;
        }

            .MobileMenuItems.hiddenMobileMenuItems {
                height: 0px;
            }

            .MobileMenuItems i {
                color: rgb(102,102,102);
            }

        .mobilemodules {
            width: 100%;
        }

            .mobilemodules td {
                text-align: center;
                width: 33.33%;
            }

        .MobileMenuItems a {
            text-transform: uppercase;
            text-decoration: none;
            color: rgb(153,153,153);
            position: relative;
        }

        .Masterfader .rrButton.rrButtonLeft {
            left: 0 !important;
            top: 50%;
            width: 24px;
            background: none !important;
            display: block;
            position: absolute;
            height: 24px;
        }

        .Masterfader .rrButton.rrButtonRight {
            left: calc(100% - 24px) !important;
            top: 50%;
            height: 24px;
            width: 24px;
            background: none !important;
            display: block;
            position: absolute;
        }

        .RotatorPopup {
            position: fixed;
            top: calc(50% - 170px);
            background-color: #fff;
            width: 370px;
            left: calc(50% - 195px);
            z-index: 9999;
            height: 320px;
            padding: 10px 10px 10px 10px;
        }

        .Masterfader .rrButton.rrButtonRight {
            background-image: url(CSS/Images/ResponsiveIcons/24White.png) !important;
            background-position: -288px 0 !important;
            cursor: pointer;
        }

        .Masterfader .rrButton.rrButtonLeft {
            background-image: url(CSS/Images/ResponsiveIcons/24White.png) !important;
            background-position: -264px 0 !important;
            cursor: pointer;
        }

        .RadAjax.RadAjax_Default {
            width: 100% !important;
            height: 100% !important;
            position: fixed !important;
            zoom: 1 !important;
            color: black !important;
            left: 0 !important;
            top: 0 !important;
        }

        .Openrail {
            margin-left: 20px;
            margin-top: 5px;
        }
    </style>
</head>
<telerik:RadCodeBlock ID="RadCodeBlock1" runat="server">
    <script src="JS/Workflow/Document.js?version=<%= PM.Security.LicenseInfo.PMWebVersion %>" type="text/javascript"></script>
    <script src="JS/Costs/DocumentAdjustment.js?version=<%= PM.Security.LicenseInfo.PMWebVersion %>" type="text/javascript"></script>
    <script src="JS/ProjectExplorer.js?version=<%= PM.Security.LicenseInfo.PMWebVersion %>" type="text/javascript"></script>
    <script src="JS/PmMaster/PmMaster.js?version=<%= PM.Security.LicenseInfo.PMWebVersion %>" type="text/javascript"></script>
    <script type="text/javascript">
        function confirmLogout() {
            var Promt = '<%=PM.UserInfo.LogoutCookieType%>';
            var IsSAMLAuthenticated = '<%=PM.UserInfo.IsSAMLAuthenticated%>';
            var IsLoginCookieSaved = '<%=PM.UserInfo.IsLoginCookieSaved%>';
            var browserWidth = $telerik.$(window).width();
            var browserHeight = $telerik.$(window).height();
            if (Promt == 'Prompt' && IsSAMLAuthenticated == 'False') {
                if (IsLoginCookieSaved == 'True') {
                    var wnd = window.radopen("LogOutPopup.aspx", 'welcome')
                    if (isMobileScreen()) {
                        wnd.setSize(browserWidth - 10, browserHeight);
                        wnd.moveTo(0, 0);
                    }
                    else {
                        wnd.setSize((browserWidth * 0.3) + 20, browserHeight * 0.3);
                        wnd.Center();
                    }

                    return false;
                }
            }
            return true;
        }
        function PMSetFocus(Module) {
            setTimeout(function () {
                if (Module == "Portfolio") {
                    Module = "treePMWebManagement";
                } else {
                    Module = "tree" + Module;
                }
                var tree = $find($("[id$='" + Module + "']")[0].id);
                if (tree != null) {
                    var Node = tree.get_selectedNode();
                    if (Node != null) {
                        Node.scrollIntoView(false);
                    }
                }
            }, 1)

        }
        function SaveSelectedNodes(sender, eventArgs) {
            var i;
            var CollapsedNodes = "";
            var node = eventArgs.get_node();
            var tree = node.get_parent();

            for (var i = 0; i < tree.get_nodes().get_count() ; i++) {
                var currNode = tree.get_nodes().getNode(i);
                if (!currNode.get_expanded()) {
                    CollapsedNodes += currNode.get_value() + "*";
                }
            }
            while (tree._parent != null) {
                tree = tree._parent
            }
            setCookie(tree._uniqueId, CollapsedNodes, 60);
        }
        function OpenReceiveEmailPopup(url, Width, Height) {
            var left = (screen.width - Width) / 2;
            var top = (screen.height - Height) / 2;
            window.open(url, 'welcome', 'location=0,status=0,menubar=0,addressbar=0,resizable=1,scrollbars=1,width=' + Width + ',height=' + Height + ',top=' + top + ',left=' + left);
            return false;
        }
        function OpenMenuMasterPageContext(e) {
            var ContextMenu = $find("<%= cmMasterPage.ClientID %>");
            var position = $("#dvMasterPageMenu").position();
            ContextMenu.showAt(position.left + 30, position.top + 22);
            $telerik.cancelRawEvent(e);
        }
        function showToolTip(element, argValue) {
            if (argValue == '') return;
            var tooltipManager = $find("<%= RadToolTipManager1.ClientID %>");
            if (!tooltipManager) return;
            var tooltip = tooltipManager.getToolTipByElement(element);
            if (!tooltip) {
                tooltip = tooltipManager.createToolTip(element);
            }
            tooltip.set_value(argValue);
            element.onmouseover = null;
            tooltip.show();
            element.onmouseover = null;
        }
        function parseDate(arg1, arg2) {

        }
        function OpenEventPopup() {
            var wnd = window.radopen("ViewEventsPopup.aspx");
            wnd.setSize(1100, 465);
            wnd.add_close(ViewPopupColsed);
            wnd.Center();
            return false;

        }
        function ViewPopupColsed(Opener) {
            var btnRefreshId;
            btnRefreshId = $("a[id*=rdgHomeEvents][id$=btnRefresh]");
            if (btnRefreshId.length > 0) { eval(btnRefreshId[0].href.split(":")[1]); }
        }
        function MasterPageContextMenuClicked(sender, args) {
            var menuItem = args.get_item();
            if (menuItem.get_value() == "CreateReminder") {
                ContextCreateReminder();
            }
            else
                if (menuItem.get_value() == "ReceiveEmails") {
                    var ProjectId = '<%=PM.SearchDocumentController.ProjectLoginId%>';
                    if (ProjectId > 0) {
                        var url = 'EmailReceive_Popup.aspx?ProjectId=' + ProjectId;
                        OpenReceiveEmailPopup(url, 430, 240);
                    }
                }
        }
        function ContextCreateReminder() {

            var browserWidth = $telerik.$(window).width();
            var browserHeight = $telerik.$(window).height();
            var wnd = window.radopen("DefineReminderPopup.aspx?IsRadMenuItem=1");
            if (isMobileScreen()) {
                wnd.setSize(browserWidth - 10, browserHeight);
                wnd.moveTo(0, 0);
            }
            else {
                wnd.setSize(browserWidth * 0.9, browserHeight * 0.9);
                wnd.Center();
            }
            wnd.add_close(RefereshReminderGrid);
            return false;
        }
        function RefereshReminderGrid(Opener) {
            var btnRefreshId;
            btnRefreshId = $("a[id*=rdgReminders][id$=btnRefresh]");
            if (btnRefreshId.length > 0) { eval(btnRefreshId[0].href.split(":")[1]); }
        }
        window.onload = function () {
            var divs = document.querySelectorAll('.divBox');
            var divBox = Array.prototype.slice.call(divs);
            divBox.forEach(function (curr) {
                if (curr.innerHTML.trim() === "") {
                    curr.style.display = 'none';
                }
            })
            if ($("[id$=hplCurrency]").length == 0 && $("[id$=lblCurrency]").length == 0) {
                if ($("[id$=trCurrency]").length > 0)
                    $("[id$=trCurrency]")[0].style.display = 'none';
            }
            else {
                if ($("[id$=hplCurrency]").length > 0 && $("[id$=lblCurrency]").length == 0)
                    if ($("[id$=hplCurrency]")[0].className == "SearchButton")
                        if ($("[id$=trCurrency]").length > 0)
                            $("[id$=trCurrency]")[0].style.display = 'none';
            }
        }
    </script>

</telerik:RadCodeBlock>

<body>
    <form id="form1" runat="server" onsubmit="javascript:return PMFormSubmit(this,event);">
        <div style="z-index: 89999; width: 100%; height: 100%; position: fixed; zoom: 1; color: black;" class="Hide RadAjax RadAjax_Default" id="DisableAllControlsOnPostback">
            <div class="raDiv"></div>
            <div id="PMLoadingIcon" class="raColor raTransp"></div>
        </div>
        <script type="text/javascript">

            var MasterRtime;
            var MasterRTimeout = false;
            var MasterRDelta = 100;

            function MasterWindowResizeEnd() {
                if (new Date() - MasterRtime < MasterRDelta) {
                    setTimeout(MasterWindowResizeEnd, MasterRDelta);
                } else {
                    MasterRTimeout = false;
                    setCookie('ScreenWidth', document.documentElement.clientWidth, null);
                    setCookie('ScreenHeight', document.documentElement.clientHeight, null);
                    resizeProjectCenterIframe();
                    ManageMenuState();
                }
            }

            function resizeProjectCenterIframe() {
                var iframe = document.getElementById("ctl00_CPH1_projectCenterFrame")
                if (iframe) {
                    var iframeWin = iframe.contentWindow || iframe.contentDocument.parentWindow;
                    if (iframeWin.document.body) {
                        var height = (iframeWin.document.documentElement.scrollHeight || iframeWin.document.body.scrollHeight);
                        $("#ctl00_CPH1_projectCenterFrame").css("cssText", "height: " + height + 'px !important;');
                    }


                }
            }
            function setCookie(c_name, value, expiredays) {
                var exdate = new Date();
                exdate.setDate(exdate.getDate() + expiredays);
                document.cookie = c_name + "=" + escape(value) +
                ((expiredays == null) ? "" : ";expires=" + exdate.toGMTString()) + "; path=/";
            }

            $(document).ready(function () {
                setCookie('ScreenWidth', document.documentElement.clientWidth, null);
                setCookie('ScreenHeight', document.documentElement.clientHeight, null);
                $("#ctl00_CPH1_projectCenterFrame").load(function () { resizeProjectCenterIframe(); });
                ManageMenuState();
                $(window).resize(function () {
                    MasterRtime = new Date();
                    if (MasterRTimeout == false) {
                        MasterRTimeout = true;
                        setTimeout(MasterWindowResizeEnd, MasterRDelta);
                    }
                });

                if (EventServiceElapsedTime > 0) {
                    setTimeout(EventAjax, EventServiceElapsedTime);
                }

            });
            $(document).keypress(function (e) {
                var code = null;
                code = (e.keyCode ? e.keyCode : e.which);
                var elementType = e.target.nodeName.toLowerCase();
                if (elementType != 'textarea') {
                    if (code == 13) {
                        e.preventDefault();
                        return false;

                    }
                }

            });

            function EventAjax() {
                $.ajax({
                    type: "POST",
                    url: "AjaxService.aspx/GetTotalNumberOfEvents",
                    contentType: "application/json; charset=utf-8",
                    data: "{}",
                    dataType: "json",
                    success: function (data) {
                        if (data.d[0] != -1) {
                            $("span[id$='lblEventCount']").html(data.d[0]);
                            if (data.d[1] == 'true') {
                                $("span[id$='lblEventCount']").css('font-weight', 'bold');
                            }
                            else {
                                $("span[id$='lblEventCount']").css('font-weight', 'normal');
                            }
                            setTimeout(EventAjax, EventServiceElapsedTime);
                        }

                    },
                    error: function (data) {
                    },
                    async: true
                });
            }
            function GetValueToReturn(combobox, eventArgs) {
                var SelectedValue;
                var hdn = combobox.get_id().substring(combobox.get_id().lastIndexOf('_'), combobox.get_id().lenght - 1) + '_hddnIds';
                var hdnField = $("[id$=" + hdn + "]")[0];
                var context = eventArgs.get_context();
                context["Ids"] = hdnField.value;
            }
        </script>
        <asp:ScriptManager ID="PMScriptManager" runat="server" EnableScriptGlobalization="True" EnablePageMethods="true"
            EnableTheming="True" ScriptMode="Release" AsyncPostBackTimeout="180">
            <Scripts>
                <asp:ScriptReference Path="JS/Telerik/Core.js" />
                <asp:ScriptReference Path="JS/Telerik/RadTreeListScripts.js" />
                <asp:ScriptReference Path="JS/Telerik/TreeListItemDragScript.js" />
            </Scripts>
        </asp:ScriptManager>
        <telerik:RadAjaxManager ID="PMAjaxManager" runat="server">
            <ClientEvents OnRequestStart="RequestStart"  onResponseEnd="RequestEnd"/>
            <AjaxSettings>
                <telerik:AjaxSetting AjaxControlID="btnPortfolio">
                    <UpdatedControls>
                        <telerik:AjaxUpdatedControl ControlID="btnPortfolio" />
                        <telerik:AjaxUpdatedControl ControlID="tblProjectExplorer" />
                    </UpdatedControls>
                </telerik:AjaxSetting>
            </AjaxSettings>
        </telerik:RadAjaxManager>

        <telerik:RadAjaxLoadingPanel ID="ldpPM" runat="server" />
        <asp:Button ID="btnLogoutSave" CausesValidation="false" CssClass="Hide" runat="server" />
        <asp:Button ID="btnLogoutDelete" CausesValidation="false" CssClass="Hide" runat="server" />
        <telerik:RadContextMenu ID="cmMasterPage" runat="server" OnClientItemClicked="MasterPageContextMenuClicked" Style="z-index: 9000 !important;">
            <Items>
                <telerik:RadMenuItem meta:resourcekey="MenuItem_CreateReminder"
                    PostBack="false" Value="CreateReminder" />
                <telerik:RadMenuItem meta:resourcekey="MenuItem_ReceiveEmails"
                    PostBack="false" Value="ReceiveEmails" />
                <telerik:RadMenuItem IsSeparator="true" />
                <telerik:RadMenuItem meta:resourcekey="MenuItem_EventCenter"
                    PostBack="false" Value="EventCenter" NavigateUrl="EventCenter.aspx" />
                <telerik:RadMenuItem meta:resourcekey="MenuItem_Home"
                    PostBack="false" Value="Home" NavigateUrl="Home.aspx" />
                <telerik:RadMenuItem meta:resourcekey="MenuItem_MySettings"
                    PostBack="false" Value="MySettings" NavigateUrl="UserProfile.aspx" />
            </Items>
        </telerik:RadContextMenu>
        <div class="MenuContainer" style="overflow: hidden; float: left">
            <div class="drawer">
                <div class="drawer-header" style="z-index: 9999; position: relative">
                    <table>
                        <tr>
                            <td>
                                <div>
                                    <asp:LinkButton runat="server" ID="btnclose" Style="float: left; margin-top: 18px;" CssClass="showrail" OnClientClick="return ShowRail()"><div class="Closerail">&nbsp; </div></asp:LinkButton>
                                    <asp:ImageButton runat="server" Style="float: right" ImageUrl="~/CSS/Images/PMWebLogo.png" ID="imgDrawerLogo" CssClass="imgDrawerLogo" OnClientClick="return CheckDirtOnLogo();" />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table>
                                    <tr>
                                        <td>
                                            <asp:ImageButton runat="server" ImageUrl="~/CSS/Images/PMWebLogoSmall.png" Style="display: none;" ID="imgRailLogo" CssClass="imgRailLogo" OnClientClick="return CheckDirtOnLogo();" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <asp:LinkButton runat="server" ID="btnOpen" Style="display: none; top: 32px;" CssClass="hiderail" OnClientClick="return HideRail()"><div class="Openrail">&nbsp; </div></asp:LinkButton>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="drawer-modules">
                    <div class="Module">
                        <div class="nav">
                            <asp:Repeater ID="rptModules" runat="server">
                                <ItemTemplate>
                                    <asp:LinkButton runat="server" CssClass="nav-link" ID="btnModule" OnClientClick="return OpenFlyoutMenu(this)" CommandArgument='<%# Container.DataItem("Id") %>' data-CommandArgument='<%# Container.DataItem("Id") %>'>
<table><tr><td><div class="<%# Eval("Icon") %>">&nbsp;</div></td><td class="text"><span><%# Eval("Text") %></span></td></tr></table>
                                    </asp:LinkButton>
                                </ItemTemplate>
                            </asp:Repeater>
                        </div>
                    </div>
                </div>
                <div class="Module Utility">
                    <asp:LinkButton runat="server" CssClass="nav-link" ID="btnHome" OnClientClick="return GoToHomePage(this);">
                        <table runat="server">
                            <tr>
                                <td style="max-width: 24px;">
                                    <asp:Image ID="ImgUser" runat="server" CssClass="ImgUser" onclick="javascript:return CheckDirtOnProfilePic();" onmouseover="this.style.cursor='hand'" /><div class="Home" runat="server" id="dvHomeIcon">&nbsp;</div>
                                </td>
                                <td><span>
                                    <asp:Literal runat="server" Text="<%$ Resources:PMWeb, MainMenu_Home %>" /></span></td>
                            </tr>
                        </table>
                    </asp:LinkButton>
                    <asp:LinkButton runat="server" CssClass="nav-link" ID="btnAdvanceSearch" OnClientClick="return OpenFlyoutMenu(this)">
<table runat="server"><tr><td><div class="Search">&nbsp;</div></td><td><span><asp:Literal runat="server" Text="<%$ Resources:PMWeb, MainMenu_Search %>" /></span></td></tr></table></asp:LinkButton>
                    <asp:LinkButton runat="server" CssClass="nav-link" ID="btnMenuRecent" OnClientClick="return OpenRecentDocumentsPopup('AllRecordTypes')">
<table><tr><td><div class="Recent">&nbsp;</div></td><td><span><asp:Literal runat="server" Text="<%$ Resources:PMWeb, MainMenu_Recent %>" /></span></td></tr></table>
                    </asp:LinkButton>
                    <asp:LinkButton runat="server" CssClass="nav-link" ID="btnUniversity" OnClientClick="return OpenFlyoutMenu(this)">
<table><tr><td><div class="University">&nbsp;</div></td><td><span><asp:Literal  runat="server" Text="<%$ Resources:PMWeb, MainMenu_University %>" /></span></td></tr></table></asp:LinkButton>
                </div>
                <div class="Module drawer-Exit" style="border-bottom: 0px">
                    <asp:LinkButton runat="server" CssClass="nav-link" ID="btnExit" OnClientClick="return CheckDirtLogout();"><table><tr><td><div class="Exit">&nbsp;</div></td><td><span><asp:Literal runat="server" Text="<%$ Resources:PMWeb, MainMenu_Exit %>" /></span></td></tr></table></asp:LinkButton>
                </div>
            </div>
        </div>
        <div class="ContentPane">
            <div id="toolbartop" runat="server" class="WhiteDarkBlueBack Top toolbartop" style="height: 30px !important; z-index: 999; width: 100%; padding: 0px">
                <table class="Top" border="0" cellspacing="0" cellpadding="0" style="height: 24px; width: 100%; padding: 0px">
                    <tr>
                        <td style="width: 24px; height: 30px;" valign="middle" class="NoWrap">
                            <asp:LinkButton ID="imgToggleDisplayMenu2" Visible="false" runat="server">
                            </asp:LinkButton>
                            <asp:Image ID="imgLogo" runat="server" CssClass="imgIpadLogo" Style="margin-left: 15px;" Width="95px" ImageUrl="~/CSS/Images/PMWebLogoSmall.png" onclick="OpenIpadMenu()" onmouseover="this.style.cursor='hand'" />
                            <asp:LinkButton ID="imgToggleAssetMenu" runat="server" OnClientClick="return ToggleAssetMenu();">
                            </asp:LinkButton>
                            <asp:HyperLink ID="hplHelp" class="HeaderMenuHelp" Style="margin-left: 15px; margin-bottom: 1px;" runat="server" Target="_blank" Visible="true">
                            </asp:HyperLink>
                        </td>
                        <td valign="middle" style="height: 30px; padding-left: 15px; white-space: nowrap" class="breadcumb">
                            <telerik:RadCodeBlock runat="server" ID="rdPortfolio">
                                <table>
                                    <tr>
                                        <td>
                                            <asp:LinkButton ID="btnPortfolio" runat="server" OnClientClick="return OpenFlyout();" Text="Portfolio" Font-Underline="true" CssClass="WhiteDarkBlueBack" Style="font-size: 16px;" CausesValidation="false"></asp:LinkButton></td>
                                        <td>
                                            <asp:Label ID="lblBreadcrumb" class="BreadCrumbLabel" runat="server"></asp:Label></td>
                                    </tr>
                                </table>
                            </telerik:RadCodeBlock>
                        </td>
                        <td style="text-align: right; padding-right: 10px;">
