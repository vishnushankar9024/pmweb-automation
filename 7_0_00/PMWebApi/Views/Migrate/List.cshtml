@model IEnumerable<SqlLib.Models.ScriptFile>
@{
    ViewBag.Title = "Migrate";
}

<div class="row">
    <div class="col-md-4">
        <h2>Procedures</h2>
    </div>
</div>
@foreach (SqlLib.Models.ScriptFile scriptFile in Model)
{
<div class="row">
    <div class="col-md-8">@scriptFile.Name</div>
    <div class="col-md-4"><a href="@Url.Action("Do", new { fName = scriptFile.FileName, sType  = scriptFile.ScriptType})" class="btn btn-primary btnExecute">Execute</a></div>
</div>
}

@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('.btnExecute').each(function (i) {
                $(this).click(function (e) {
                    e.preventDefault();
                    var url = $(this).attr('href');
                    $.get(url, function (res) {
                        if (res == 0 || res == 1) {
                            alert('Failed to execute!');
                        } else {
                            alert("Executed!.");
                        }
                    });
                });
            });
        });
    </script>
} 