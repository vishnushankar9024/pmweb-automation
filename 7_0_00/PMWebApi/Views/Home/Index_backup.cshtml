

<style type="text/css">
    body.modal-open {
        overflow: visible !important;
    }

    .pdfobject-container {
        height: 30rem;
        border: 1rem solid rgba(0,0,0,.1);
    }

    .close {
        font-size: 45px;
        font-weight: 600;
    }

    #cboUsers {
        height: 50px !important;
        overflow-y: scroll;
        padding-top: 5px;
    }

    #dropdownlistWrappercboUsers {
        height: 40px !important;
    }

    .floating_select_label {
        position: absolute;
        transition: all 0.2s;
        pointer-events: none;
        top: 0;
        font-size: 12px;
        color: #000;
        z-index: 999;
    }

        .floating_label.hasValue,
        .floating_select_label.hasValue {
            top: -17px;
            left: 0;
            color: #c1c1c1;
        }

    #popupWindow_Precheck .modal-body {
        max-height: 80vh;
        overflow-y: scroll;
    }
</style>
