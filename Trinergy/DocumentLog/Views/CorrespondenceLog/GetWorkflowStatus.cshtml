@model IEnumerable<Trinergy.Model.WorkflowStatus>
@{
    Layout = null;
}

@(Html.Kendo().Grid(Model)
            .Name("grid_workflow") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(w => w.StepNumber).HeaderTemplate("Step #");
                columns.Bound(w => w.RoleName).HeaderTemplate("Role Name");
                columns.Bound(w => w.sActionDate).HeaderTemplate("Action Date");
                columns.Bound(w => w.sActionTime).HeaderTemplate("Action Time");
                columns.Bound(w => w.ActionBy).HeaderTemplate("Action By");
                columns.Bound(w => w.ActionType).HeaderTemplate("Action Type");
                columns.Bound(w => w.TeamInputNames).HeaderTemplate("Team Input Names");
                columns.Bound(w => w.Comments).HeaderTemplate("Comments");
                columns.Bound(w => w.TeamInputPending).HeaderTemplate("Pending Team Input From");
            })
            .Pageable(p => p.Enabled(false))
            .Sortable(s => s.Enabled(false))
)
