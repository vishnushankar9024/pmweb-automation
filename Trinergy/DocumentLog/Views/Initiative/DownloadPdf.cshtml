@model WorkOrderForm.Models.IntermediateModels.WorkOrderModel
@using WorkOrderForm.Constants;
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Initiative - Initiative</title>
    <link href="pmwebhelper/Content/bootstrap.css" rel="stylesheet" />
    <link href="pmwebhelper/Content/site.css" rel="stylesheet" />


    <link href="pmwebhelper/Content/formstyles.css" rel="stylesheet" />

    <link href="pmwebhelper/Content/bootstrap.css" rel="stylesheet" />

    <style>
        body {
            margin: 20px;
        }

        h3, h4 {
            color: #4566ac;
        }
    </style>
</head>
<body>

    @using (Html.BeginForm())
    {
        <div class="form-horizontal">
            <table cellpadding="5" cellspacing="5" border="0" width="100%">
                <tr>
                    <td colspan="2">
                        <img src="pmwebhelper/images/HFD_302.png" />
                    </td>
                </tr>
                <tr>
                    <td colspan="2"><h3>Initiative Details</h3></td>
                </tr>
                <tr>
                    <td>
                        <h4>@Html.LabelFor(model => model.ReferenceID)</h4>
                        @Model.ReferenceID.NumberFormat()
                    </td>
                </tr>
                <tr>
                    <td>
                        <h4>@Html.LabelFor(model => model.Campus)</h4>
                        @Html.DisplayFor(model => model.Campus) - @Html.DisplayFor(model => model.OtherCampus)
                    </td>
                    <td>
                        <h4>@Html.LabelFor(model => model.Building)</h4>
                        @Html.DisplayFor(model => model.Building)
                    </td>
                </tr>
                <tr>
                    <td>
                        <h4>@Html.LabelFor(model => model.Department)</h4>
                        @Html.DisplayFor(model => model.Department)
                    </td>
                    <td>
                        <h4>@Html.LabelFor(model => model.Floor)</h4>
                        @Html.DisplayFor(model => model.Floor)
                    </td>
                </tr>
                <tr>
                    <td>
                        <h4><label>Chief (SRO)</label></h4>
                        @Html.DisplayFor(model => model.SROUserName)
                    </td>
                    <td>
                        <h4><label>Status</label></h4>
                        @Html.DisplayFor(model => model.Status)
                        <br /><small>(@Html.DisplayFor(model => model.PendingWith))</small>
                    </td>
                </tr>
                @if (Model.StatusID == Common.Rejected)
                {
                    <tr>
                        <td>
                            <h4>@Html.LabelFor(model => model.RejectReason)</h4>
                            @Html.DisplayFor(model => model.RejectReason)
                        </td>
                        <td>
                            <h4>@Html.LabelFor(model => model.RejectedBy)</h4>
                            @Html.DisplayFor(model => model.RejectedByName)
                        </td>
                    </tr>
                }
                @if (Model.StatusID == Common.Approved)
                {
                    <tr>
                        <td colspan="2">
                            <h4>@Html.LabelFor(model => model.ApprovedByName)</h4>
                            @Html.DisplayFor(model => model.ApprovedByName)
                        </td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(Model.FocalPoint))
                {
                    <tr>
                        <td colspan="2">
                            <h4>@Html.LabelFor(model => model.FocalPoint)</h4>
                            @Html.DisplayFor(model => model.FocalPoint)
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="2">
                        <h4>@Html.LabelFor(model => model.Title)</h4>
                        @Html.DisplayFor(model => model.Title)
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <h4>@Html.LabelFor(model => model.Description)</h4>
                        @Html.DisplayFor(model => model.Description)
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <h4>@Html.LabelFor(model => model.Objectives)</h4>
                        @Html.DisplayFor(model => model.Objectives)
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <h4>@Html.LabelFor(model => model.FRequirements)</h4>
                        @Html.DisplayFor(model => model.FRequirements)
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <h4>@Html.LabelFor(model => model.Comments)</h4>
                        @Html.DisplayFor(model => model.Comments)
                    </td>
                </tr>
                @if (Model.fileNames?.Count() > 0)
                {
                    <tr>
                        <td colspan="2">
                            <h4>Attachments</h4>
                            @if (Model.fileNames != null)
                    {
                        foreach (var fileName in Model.fileNames.Select((value, i) => new { i, value }))
                        {
                                    @Html.ActionLink("File" + Convert.ToInt32(fileName.i + 1), "Preview", "Approver", new { @fileName = fileName.value }, new { @target = "_blank" })<span>&nbsp&nbsp&nbsp</span><span class="glyphicon glyphicon-file" style="color:#337ab7"></span><br />
                                }
                            }
                        </td>
                    </tr>
                }
                @*@if (Model.StatusID == 2 || Model.StatusID == 3 || Model.StatusID == 4)*@
                @{
                    <tr>
                        <td colspan="2">
                            <h4>Is Funding Available?</h4>
                            @if (String.IsNullOrEmpty(Model.CostCenter))
                            {
                                <span class="display-name-pen">No, Requires Support in Principal</span>
                            }
                            else
                            {
                                <span class="display-name-app">Yes</span><br />
                                <h4>@Html.LabelFor(model => model.CostCenter)</h4>
                                @Html.DisplayFor(model => model.CostCenter)
                            }
                        </td>
                    </tr>
                    if (!string.IsNullOrEmpty(Model.SROComments))
                    {
                        <tr>
                            <td colspan="2">
                                <h4>@Html.LabelFor(model => model.SROComments)</h4>
                                @Html.DisplayFor(model => model.SROComments)
                            </td>
                        </tr>
                    }
                }
                <tr>
                    <td colspan="2">&nbsp;</td>
                </tr>
            </table>
            <div style="page-break-before: always;">
                <div style="padding-top:20px;">
                    <div style="margin-bottom:20px;">
                        <h3>WorkFlow Information</h3>
                        @Html.Action("GetWorkflowStatusPDF", "Initiative", new { WorkOrderId = Model.WorkOrder_ID})
                    </div>
                    <div>
                        @Html.Partial("ChatBox_pdf", Model)
                    </div>
                </div>
            </div>
        </div>
                    }
</body>
</html>