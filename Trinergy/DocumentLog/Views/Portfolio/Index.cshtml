@model IEnumerable<Trinergy.Model.Projects>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Portfolio</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.10/css/all.css" integrity="sha384-+d0P83n9kaQMCwj8F4RJB66tzIwOKmrdb46+porD/OvrJ+37WqIM7UoBtwHO6Nlg" crossorigin="anonymous">

    <style>
        /* Always set the map height explicitly to define the size of the div
        * element that contains the map. */
        #map {
            height: 100%;
        }
        /* Optional: Makes the sample page fill the window. */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        td.highlight {
            background-color: #B2DE66 !important;
        }

        #tableProjects > tbody > tr {
        }

        td.details-control {
            background: url('/Content/Images/details_open.png') no-repeat center center;
            cursor: pointer;
        }

        tr.shown td.details-control {
            background: url('/Content/Images/details_close.png') no-repeat center center;
        }

        .messagepop {
            background-color: #FFFFFF;
            border: 1px solid #999999;
            cursor: default;
            display: none;
            margin-top: 150px;
            margin-left: 150px;
            position: absolute;
            text-align: left;
            width: 394px;
            z-index: 50;
            padding: 25px 25px 20px;
            -webkit-box-shadow: 10px 10px 5px 0px rgba(0,0,0,0.5);
            -moz-box-shadow: 10px 10px 5px 0px rgba(0,0,0,0.5);
            box-shadow: 10px 10px 5px 0px rgba(0,0,0,0.5);
        }

        .det-close {
            cursor: pointer;
        }

        .panel-title {
            padding-left: 20px !important;
            font-weight: bold !important;
        }

        th {
            vertical-align: middle !important;
        }

        .group td {
            background-color: #54AAD7 !important;
            color: #fff;
            font-weight: bold;
        }

        .green {
            color: mediumseagreen;
            font-size: 25px;
        }

        .red {
            color: red;
            font-size: 25px;
        }
    </style>
    <script src="~/Scripts/jquery-1.10.2.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/v/dt/dt-1.10.16/datatables.min.css" />
    <script type="text/javascript" src="https://cdn.datatables.net/v/dt/dt-1.10.16/datatables.min.js"></script>
</head>
<body>
    <div style="margin-left:auto;margin-right:auto;width:90%">
        <div class="row">
            <div class="col-md-6"><h1 style="margin-top: 35px;">Portfolio</h1></div>
            <div class="col-md-6 text-right"><img src="~/Content/Images/PMWebLogo.gif" style="width:350px;" /></div>

        </div>
        <div class="row">
            <div class="col-md-6" style="height:500px;">
                <div id="map"></div>
            </div>
            <div class="col-md-6">
                <div class="panel panel-primary panel-table">
                    <div class="panel-heading">
                        <div class="row">
                            <h3 class="panel-title">Corporate Overview</h3>
                        </div>
                    </div>
                    <div class="panel-body">
                        <table class="table table-bordered table-striped">
                            <tr>
                                <th>Work Under Contract:</th>
                                <td>$123456</td>
                            </tr>
                            <tr>
                                <th>Work in Progress (WIP):</th>
                                <td>$123456</td>
                            </tr>
                            <tr>
                                <th>Unstarted Contracts (Backlog):</th>
                                <td>$123456</td>
                            </tr>
                            <tr>
                                <th>Contract Design:</th>
                                <td>$123456</td>
                            </tr>
                            <tr>
                                <th>Project Cost:</th>
                                <td>$123456</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="panel panel-primary panel-table">
                <div class="panel-heading">
                    <div class="row">
                        <h3 class="panel-title">Projects</h3>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="messagepop pop">
                        <div class="panel panel-primary panel-table">
                            <div class="panel-heading">
                                <div class="row">
                                    <div class="col-md-8"><h3 class="panel-title">Project Details</h3></div>
                                    <div class="col-md-4"><div class="text-right"><span class="glyphicon glyphicon-remove det-close" onclick="ClosePop()"></span></div></div>
                                </div>
                            </div>
                            <div class="panel-body" id="pop-body">
                            </div>
                        </div>
                    </div>
                    <table class="table table-striped table-bordered table-list" id="tableProjects">
                        <thead>
                            <tr>
                                @*<th></th>*@
                                <th rowspan="2">Id</th>
                                <th rowspan="2">Program</th>
                                <th rowspan="2">Project Name</th>
                                <th rowspan="2">Address</th>
                                <th rowspan="2">Approved Budget</th>
                                <th rowspan="2">Forecast Cost</th>
                                <th rowspan="2">Final Cost</th>
                                <th rowspan="2">KPI</th>
                                <th rowspan="2"></th>
                                <th rowspan="2">Baseline Finish Date</th>
                                <th rowspan="2">Forecast Date</th>
                                <th colspan="2" class="text-center">Documents</th>
                            </tr>
                            <tr>
                                <th>Oustanding</th>
                                <th>Overdue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = 0; }
                            @foreach (var project in Model)
                            {
                                <tr class="table-primary" id="tr_@project.Id" project-id="@project.Id">
                                    @*<td class="details-control"></td>*@
                                    <td>@project.Id</td>
                                    <td>@project.Program</td>
                                    <td>@project.Name</td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td>
                                        @if (i % 2 == 0)
                                        {
                                            <div class="green"><i class="fas fa-check-circle"></i></div>
                                        }
                                        else
                                        {
                                            <div class="red"><i class="fas fa-exclamation-circle"></i></div>

                                        }
                                    </td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
    <script>
        var infoWindows = [];
        var markers = [];
        var map = "";
        var table = "";

        function initMap() {
            var myLatLng = { lat: 25.2841478, lng: 51.441957 };
            map = new google.maps.Map(document.getElementById('map'), {
                zoom: 9,
                center: myLatLng
            });

            @foreach (var project in Model)
          {
              if (project.Lat != "" && project.Lng != "")
              {
                  <text>
            var pos = {lat:@project.Lat, lng:@project.Lng};

            markers["@("marker_"+project.Id)"] = new google.maps.Marker({
                position: pos,
                map: map,
                title: '@project.Name'
            });

            var contentString = '<div>@project.Name<br/>@project.Program<br/>@project.Gateway</div>';

            infoWindows["@("infowindow_"+project.Id)"] = new google.maps.InfoWindow({
                content: contentString
            });

            markers["@("marker_"+project.Id)"].addListener('click', function() {
                for(var window in infoWindows){
                    infoWindows[window].close();
                }

                var pageLen = table.page.len();
                var page = table.page.info();
                var rowIdx = 0;
                var isNotFound = true;
                for(var i = 0; i < page.pages; i++)
                {
                    table.page(i).draw(false);
                    $("#tableProjects tbody td").removeClass('highlight');
                }
                $("#tableProjects tbody td").removeClass('highlight');
                table.page(0).draw(false);

                while(isNotFound == true)
                {
                    $("#tableProjects tbody td").removeClass('highlight');
                    $('#tableProjects tbody tr').each( function () {
                        var self = $(this);
                        if(self.attr("id") && !self.hasClass( "group" ))
                        {
                            var rowId = self.attr("id");
                            if(rowId == "tr_@project.Id")
                            {
                                var tr = $("#tr_@project.Id");
                                $("td", tr).addClass('highlight');
                                isNotFound = false;
                            }
                            rowIdx++;
                        }
                    });

                    if(isNotFound == true){
                        table.page('next').draw(false);
                    }
                }
                @*if(map.getZoom() <= 16)
                {
                    map.setZoom(17);
                    map.panTo(markers["marker_@project.Id"].getPosition());
                }*@

                infoWindows["@("infowindow_"+project.Id)"].open(map,  markers["@("marker_"+project.Id)"]);

            });
            @*markers["@("marker_"+project.Id)"].addListener('mouseout', function() {
                //infoWindows["@("infowindow_"+project.Id)"].close();
                //$("#tableProjects tbody td").removeClass('highlight');
            });*@
            @*var data= {
                "Project_Number" : "@project.ProjectNumber",
                "Project_Name" : "@project.Name",
                "Program" : "@project.Program",
                "Gateway": "@project.Gateway"
            };

            $("#tr_@project.Id").data("project", data);*@
            </text>
                  }
              }
        }
        $(document).ready(function() {
            function Reduce(){
                $(".red").each(function(){
                    $(this).fadeOut(500, function(){
                        $(this).fadeIn(500);
                    });
                });
            }
            setInterval(Reduce,500);
            table = $('#tableProjects').DataTable({
                "columnDefs": [
                    { "visible": false, "targets": [0,1] }
                ],
                //"scrollY":"500px",
                //"scrollCollapse": false,
                "order": [[ 1, 'asc' ]],
                "displayLength": 10,
                "drawCallback": function ( settings ) {
                    var api = this.api();
                    var rows = api.rows( {page:'current'} ).nodes();
                    var last=null;

                    api.column(1, {page:'current'} ).data().each( function ( group, i ) {
                        if ( last !== group ) {
                            $(rows).eq( i ).before(
                                '<tr class="group"><td colspan="11">'+group+'</td></tr>'
                            );
                            last = group;
                        }
                    } );
                }
            } );

            $('#tableProjects tbody').on( 'click', 'tr', function () {
                if($(this).attr("project-id"))
                {
                    var pid = $(this).attr("project-id");
                    //map.setCenter(markers["marker_"+pid].getPosition());
                    map.setZoom(9);
                    map.panTo(markers["marker_"+pid].getPosition());
                    map.setZoom(17);
                    for(var window in infoWindows){
                        infoWindows[window].close();
                    }
                    infoWindows["infowindow_"+pid].open(map,  markers["marker_"+pid]);

                    $("#tableProjects tbody td").removeClass('highlight');
                    $("td", $(this)).addClass('highlight');

                    var body = $("html, body");
                    body.stop().animate({scrollTop:0}, 500, 'swing', function() {
                    });

                    //if($('.pop').css("display") == "block")
                    //{
                    //    $('.pop').slideFadeToggle();
                    //}

                    //var data = $(this).data("project");
                    //var html = format(data);
                    //$('#pop-body').html(html);
                    //$('.pop').slideFadeToggle();

                    //var tr = $(this).closest('tr');
                    //var row = table.row( tr );

                    //if ( row.child.isShown() ) {
                    //    // This row is already open - close it
                    //    row.child.hide();
                    //    tr.removeClass('shown');
                    //}
                    //else {
                    //    // Open this row
                    //    row.child( format(row.data()) ).show();
                    //    tr.addClass('shown');
                    //}
                }
            });

            //$('#tableProjects tbody').on( 'mouseout', 'tr', function () {
            //    if($(this).attr("project-id"))
            //    {
            //        var pid = $(this).attr("project-id");
            //        infoWindows["infowindow_"+pid].close();
            //    }
            //});

        });

        function format ( d ) {
            // `d` is the original data object for the row
            return '<table cellpadding="5" cellspacing="0" border="0" style="padding-left:50px;">'+
                '<tr>'+
                    '<td>Project Number:</td>'+
                    '<td>'+d.Project_Number+'</td>'+
                '</tr>'+
                '<tr>'+
                    '<td>Project Name:</td>'+
                    '<td>'+d.Project_Name+'</td>'+
                '</tr>'+
                '<tr>'+
                    '<td>Program:</td>'+
                    '<td>' + d.Program + '</td>'+
                '</tr>'+
                '<tr>'+
                    '<td>Gateway:</td>'+
                    '<td>' + d.Gateway + '</td>'+
                '</tr>'+
            '</table>';
        }
        function ClosePop()
        {
            $('.pop').slideFadeToggle();
        }
        $.fn.slideFadeToggle = function(easing, callback) {
            return this.animate({ opacity: 'toggle', height: 'toggle' }, 'fast', easing, callback);
        };
    </script>
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA7tmyt19teo5g7yxeCLKL-8_AtcPjfyEE&callback=initMap">
    </script>
</body>
</html>
