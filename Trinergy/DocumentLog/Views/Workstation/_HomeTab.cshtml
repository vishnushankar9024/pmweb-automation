@model IEnumerable<Trinergy.Model.TabMenu>
@{
    Layout = null;
}
<div class="admintab-wrap mg-b-40">
    <ul class="nav nav-tabs custom-menu-wrap custon-tab-menu-style1">
        <li class="active">
            <a data-toggle="tab" href="#tabActionCenter"><span class="adminpro-icon adminpro-analytics-arrow tab-custon-ic"></span>Action Center</a>
        </li>
        <li>
            <a data-toggle="tab" href="#tabDocumentLog"><span class="adminpro-icon adminpro-analytics-arrow tab-custon-ic"></span>Document Log</a>
        </li>
        <li>
            <a data-toggle="tab" href="#tabExecDash"><span class="adminpro-icon adminpro-analytics-arrow tab-custon-ic"></span>Executive Dashboard</a>
        </li>
        <li>
            <a data-toggle="tab" href="#tabAssetDash"><span class="adminpro-icon adminpro-analytics-arrow tab-custon-ic"></span>Asset Dashboard</a>
        </li>
    </ul>
    <div class="tab-content">
        <div id="tabActionCenter" class="tab-pane in active animated flipInX custon-tab-style1">
            <iframe id="iFrameActionCneter" frameborder="0" style="width:100%;"></iframe>
        </div>
        <div id="tabDocumentLog" class="tab-pane animated flipInX custon-tab-style1">
            <iframe id="iFrameDocumentLog" frameborder="0" style="width:100%;"></iframe>
        </div>
        <div id="tabExecDash" class="tab-pane animated flipInX custon-tab-style1">
            <iframe id="iFrameExecDash" frameborder="0" style="width:100%;"></iframe>
        </div>
        <div id="tabAssetDash" class="tab-pane animated flipInX custon-tab-style1">
            <iframe id="iFrameAssetDash" frameborder="0" style="width:100%;"></iframe>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var height = ($(document).height() - 250);
        $(".tab-content").css({ "height": height + 'px' });
        height = (height - 25) + 'px'

        iframeAC = $('#iFrameActionCneter');
        $("#pleaseWaitDialog").show();
        iframeAC.hide();
        iframeAC.attr({
            width: '100%',
            height: height,
            src: '@Url.Action("Index", "ActionCenter")'
        });
        iframeAC.on("load", function () {
            iframeAC.show();
            $("#pleaseWaitDialog").hide();
        });

        iframeDL = $('#iFrameDocumentLog');
        $("#pleaseWaitDialog").show();
        iframeDL.hide();
        iframeDL.attr({
            width: '100%',
            height: height,
            src: '@Url.Action("Index", "DocumentLog")'
        });
        iframeDL.on("load", function () {
            iframeDL.show();
            $("#pleaseWaitDialog").hide();
        });

        iframeED = $('#iFrameExecDash');
        $("#pleaseWaitDialog").show();
        iframeED.hide();
        iframeED.attr({
            width: '100%',
            height: height,
            src: 'execdashboard'
        });
        iframeED.on("load", function () {
            iframeED.show();
            $("#pleaseWaitDialog").hide();
        });

        iframeAD = $('#iFrameAssetDash');
        $("#pleaseWaitDialog").show();
        iframeAD.hide();
        iframeAD.attr({
            width: '100%',
            height: height,
            src: 'assetdashboard/'
        });
        iframeAD.on("load", function () {
            iframeAD.show();
            $("#pleaseWaitDialog").hide();
        });
    });
</script>
