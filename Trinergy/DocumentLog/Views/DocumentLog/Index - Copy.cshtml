@model IEnumerable<Trinergy.Model.DocumentLogModel>
@{
    Layout = null;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Document Log</title>
    <style>
        .multiselect-selected-text {
            display: inline-grid;
            width: 180px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
    </style>
    <link href="/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="~/Scripts/tree/themes/proton/style.css" />
    <style>
        .attachments {
            font-size: 12px !important;
        }

            .attachments .panel-heading {
                padding: 2px 15px !important;
            }

                .attachments .panel-heading h4 {
                    margin-top: 2px;
                    margin-bottom: 2px;
                }

            .attachments .col-md-6 {
                padding: 2px;
            }

            .attachments ul {
                padding: 0px;
                list-style: none;
            }

            .attachments .panel-body {
                padding: 5px 5px 5px 15px;
            }

                .attachments .panel-body .panel-body {
                    padding-left: 5px;
                }

            .attachments a {
                color: blue;
                text-decoration: underline;
            }
    </style>
    <style class="cp-pen-styles">
        ul.css-treeview {
            /*margin: 0px 0px 0px 20px;*/
            list-style: none;
            line-height: 2em;
            font-family: Arial;
        }

            ul.css-treeview li {
                font-size: 16px;
                position: relative;
            }

                ul.css-treeview li:before {
                    position: absolute;
                    left: -15px;
                    top: 0px;
                    content: '';
                    display: block;
                    border-left: 1px solid #ccc;
                    height: 1em;
                    border-bottom: 1px solid #ccc;
                    width: 10px;
                }

                ul.css-treeview li:after {
                    position: absolute;
                    left: -15px;
                    bottom: -7px;
                    content: '';
                    display: block;
                    border-left: 1px solid #ccc;
                    height: 100%;
                }

                ul.css-treeview li.root {
                    margin: 0px 0px 0px -20px;
                }

                    ul.css-treeview li.root:before {
                        display: none;
                    }

                    ul.css-treeview li.root:after {
                        display: none;
                    }

                ul.css-treeview li:last-child:after {
                    display: none;
                }

        .folder {
            margin-left: 0px !important;
            background-color: lightgrey;
            border: 1px solid #ffffff;
        }

        .dataTables_length {
            padding-left: 25px !important;
        }

        /*.SearchLeftPanel {
            height:500px;
            overflow-y: scroll;
        }*/
    </style>
</head>
<body>
    <div style="padding-left:30px; padding-top:15px;width: 98.9%;">
        <div class="row">
            <div id="panelsearch" class="col-xs-12 col-sm-12 col-md-2 col-lg-2 collapse in">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">Document Filter </h3>
                    </div>
                    <div class="panel-body SearchLeftPanel">

                        <div class="form-group ">
                            <div class="col-md-12 ">
                                <label class="lblpanel">From Date</label>
                                @Html.TextBox("txtfromdate", new DateTime(DateTime.Now.Year, 1, 1), "{0:yyyy-MM-dd}", new { @class = "form-control formdate", type = "date" })
                                @*  @Html.Editor("FromDate", new { htmlAttributes = new { @class = "form-control formdate", @id = "txtfromdate", @type = "date" , @value= new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd") } })*@
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">To Date</label>
                                    @Html.TextBox("txttodate", DateTime.Today, "{0:yyyy-MM-dd}", new { @class = "form-control formdate", type = "date" })

                                </div>
                            </div>
                            <div class="form-group " style="overflow:inherit">
                                <div class="col-md-12">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Delivery Manager</label>

                                    @Html.ListBox("Client", new SelectList(ViewBag.Clients, "Id", "CompanyName"), new { @id = "listboxclient", @class = "form-control listbox" })

                                </div>
                            </div>
                            <div class="form-group " style="overflow:inherit">
                                <div class="col-md-12">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Projects</label>

                                    @Html.ListBox("Projects", new SelectList(ViewBag.Userprojects, "Id", "Name"), new { @id = "listboxproj", @class = "form-control listbox" })

                                </div>
                            </div>
                            <div class="form-group " style="overflow:inherit">
                                <div class="col-md-12">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Gateway</label>

                                    @Html.ListBox("Projects", new SelectList(ViewBag.Gateway, "Val", "Name"), new { @id = "listboxgateway", @class = "form-control listbox" })

                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 " style="max-width:100px">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Forms</label>
                                    @Html.ListBox("Forms", new SelectList(ViewBag.UserForms, "Id", "Name"), new { @id = "listboxforms", @class = "form-control listbox" })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Document Type</label>
                                    @Html.ListBox("DocType", new SelectList(ViewBag.DocType, "Val", "Name"), new { @id = "listboxdoctype", @class = "form-control listbox" })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Discipline</label>
                                    @Html.ListBox("Discipline", new SelectList(ViewBag.Disciplines, "Val", "Name"), new { @id = "listboxdisc", @class = "form-control listbox" })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Workflow Status</label>
                                    @Html.ListBox("WorkflowStatus", new SelectList(ViewBag.DocumentsStatus, "Id", "Name"), new { @id = "listboxws", @class = "form-control listbox" })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Departments</label>
                                    @Html.ListBox("Departments", new SelectList(ViewBag.Departments, "Name", "Name"), new { @id = "listboxdepartments", @class = "form-control listbox" })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">Pending With</label>
                                    @Html.Editor("PendingWith", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtPendingWith" } })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">Subject</label>
                                    @Html.Editor("Subject", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtsubject" } })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">Originator Reference</label>
                                    @Html.Editor("Reference", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtoref" } })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">Category</label>
                                    @Html.Editor("Doc Category", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtcategory" } })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">From</label>
                                    @Html.Editor("From", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtfrom" } })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">To</label>
                                    @Html.Editor("To", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtto" } })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">File Name</label>
                                    @Html.Editor("To", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtFileName" } })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 ">
                                    <label class="lblpanel">Created By</label>
                                    @Html.Editor("CreatedBy", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtCreatedBy" } })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="form-group ">
                            <button type="button" id="btngetreport" class="btn btn-primary">Get Report</button>
                            <button type="button" id="btnclear" class="btn btn-primary">Clear</button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="panelgrid" class="col-md-10">
                <div id="worklist">

                </div>


            </div>
        </div>
    </div>
    <div id="pleaseWaitDialog" class="modal" style="display: none;">
        <div class="center">
            <img src="~/Content/Images/hamadwait.gif" alt="Loading, please wait" />
        </div>
    </div>
</body>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/formstyles.css" rel="stylesheet" />
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />

<link href="~/Content/jquery.dataTables.css" rel="stylesheet" />
<link href="~/Content/buttons.dataTables.css" rel="stylesheet" />

<link href="~/Content/Documents.css" rel="stylesheet" />
<link href="~/Content/bootstrap-multiselect.css" rel="stylesheet" />
<script src="~/Scripts/bootstrap-multiselect.js"></script>

<link rel="stylesheet" type="text/css" href="~/Content/datatables.min.css" />

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script src="/Scripts/tree/jstree.min.js"></script>

<script type="text/javascript" src="~/Scripts/datatables.min.js"></script>




@*<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.32/pdfmake.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.32/vfs_fonts.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/1.5.1/js/buttons.html5.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/1.5.1/js/buttons.print.min.js"></script>*@





<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.32/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.32/vfs_fonts.js"></script>
<script src="~/Scripts/buttons.html5.min.js"></script>

<script type="text/javascript">

    $(document).ready(function () {
        //var pHeight = $(window).height() * 0.75;
        //$(".SearchLeftPanel").css("height", pHeight + "px");
        $('#panelsearch').toggle();
        $("#panelgrid").toggleClass("col-md-10 col-md-12");

        $('#panelsearch').on('hide.bs.collapse', function () {
            $('#panelgrid').addClass('col-md-12 col-lg-12').removeClass('col-md-10 col-lg-10');
            $('#btnShow').html('<span class="glyphicon glyphicon-chevron-left"></span> Show');

        })
        $('#panelsearch').on('show.bs.collapse', function () {
            $('#btnShow').html('<span class="glyphicon glyphicon-chevron-right"></span> Hide');
            $('#panelgrid').addClass('col-md-10 col-lg-10').removeClass('col-md-12 col-lg-12');

        })


        $('.listbox').multiselect({
            includeSelectAllOption: true
        });

        //var clicker = 0;
        //$('.listbox').change(function () {
        //    var assID = $(this).val();
        //    var clicker = 0;
        //    if(assID == 0)
        //    {
        //        alert("");
        //        $(this).find("li").remove();
        //    }



        //});
        //$(".listbox option[value=0]").click(function (e) {
        //    alert();
        //    //clicker++;
        //    //$(this).prop('selected', false);
        //    //if (clicker % 2 != 0) {


        //    //    $(".listbox option[value!=0]").prop('selected', true);
        //    //}
        //    //else
        //    //    $(".listbox option[value!=0]").prop('selected', false);

        //});
        $("#btnclear").click(function (e) {
            var _fromDate = $('#txtfromdate').val('2018-01-01');
            var _toDate = $('#txttodate').val('@DateTime.Today.ToString("yyyy-MM-dd")');

            var _subject = $('#txtsubject').val('');
            var _originReg = $('#txtoref').val('');
            var _subjectmatter = '';
            var _category = $('#txtcategory').val('');
            var _from = $('#txtfrom').val('');
            var _to = $('#txtto').val('');
            var _fileName = $('#txtFileName').val('');

            var _createdBy = $('#txtCreatedBy').val('');

            $('.listbox').multiselect('selectAll', false);
            $('.listbox').multiselect('updateButtonText');

            $("#btngetreport").click();
        });

        $("#btngetreport").click(function (e) {
            console.log("btngetreport Start");
            console.log(new Date());
            var _fromDate = $('#txtfromdate').val();
            var _toDate = $('#txttodate').val();

            var _projects = $('#listboxproj').val();
            var _forms = $('#listboxforms').val();
            var _discipline = $('#listboxdisc').val();
            var _workflowstatus = $('#listboxws').val();

            var _subject = $('#txtsubject').val();
            var _originReg = $('#txtoref').val();
            var _subjectmatter = '';
            var _category = $('#txtcategory').val();
            var _from = $('#txtfrom').val();
            var _to = $('#txtto').val();
            var _docType = $('#listboxdoctype').val();
            var _fileName = $('#txtFileName').val();

            var _createdBy = $('#txtCreatedBy').val();

            var _gateway = $('#listboxgateway').val();

            var _pendingWith = $("#txtPendingWith").val();

            var _listboxdepartments = $("#listboxdepartments").val();
            // Add errors highlight
            $.ajax({
                url: '@Url.Action("GetReport", "DocumentLog")',
                dataType: "html",

                ContentType: "application/json;charset=utf-8",
                type: "POST",
                data: {
                    fromDate: _fromDate, toDate: _toDate, projects: _projects, forms: _forms, discipline: _discipline, workflowstatus: _workflowstatus,
                    subject: _subject, originReg: _originReg, subjectmatter: _subjectmatter, category: _category, from: _from, to: _to, docType: _docType,
                    fileName: _fileName, createdBy: _createdBy, Gateway: _gateway, pendingWith: _pendingWith, listboxdepartments: _listboxdepartments
                },
                cache: false,
                async: true,
                beforeSend: function () {
                    console.log("btngetreport Ajax start");
                    console.log(new Date());
                    $('#pleaseWaitDialog').modal('show');
                },
                complete: function () {
                    console.log("btngetreport Ajax end");
                    console.log(new Date());
                    $('#pleaseWaitDialog').modal('hide');
                },
                success: function (data) {
                    $('#worklist').html(data);

                },
                failure: function (response) {
                    alert("Get Failed");
                },
            });
            console.log("btngetreport End");
            console.log(new Date());
        });

        $('.listbox').multiselect('selectAll', false);
        $('.listbox').multiselect('updateButtonText');
        $("#btngetreport").click();

        $("#listboxclient").change(function () {
            // Add errors highlight
            var clients = $(this).val();
            var sel = $('#listboxproj');
            sel.empty();
            if (clients && clients.length > 0) {
                $.ajax({
                    url: '@Url.Action("GetProjects", "DocumentLog")',
                    dataType: "html",

                    ContentType: "application/json;charset=utf-8",
                    type: "POST",
                    data: { clients: clients },
                    cache: false,
                    async: true,
                    beforeSend: function () {
                        $('#pleaseWaitDialog').modal('show');
                    },
                    complete: function () {
                        $('#pleaseWaitDialog').modal('hide');
                    },
                    success: function (data) {
                        data = JSON.parse(data);
                        console.log(data);

                        $.each(data, function (i) {
                            sel.append('<option value="' + data[i].Id + '">' + data[i].Name + '</option>');
                        });
                        sel.multiselect('rebuild');
                        sel.multiselect('selectAll', false);
                        sel.multiselect('updateButtonText');

                    },
                    failure: function (response) {
                        alert("Get Failed");
                    },
                });
            }
        });
    });
</script>
</html>