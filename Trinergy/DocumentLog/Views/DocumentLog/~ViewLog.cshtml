<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.32/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.32/vfs_fonts.js"></script>
<script src="~/Scripts/buttons.html5.min.js"></script>

<script type="text/javascript">

    $(document).ready(function () {
        //$('#panelsearch').toggle();
        //$("#panelgrid").toggleClass("col-md-10 col-md-12");

        $('#panelsearch').on('hide.bs.collapse', function () {
            $('#panelgrid').addClass('col-md-12 col-lg-12').removeClass('col-md-10 col-lg-10');
            $('#btnShow').html('<span class="glyphicon glyphicon-chevron-left"></span> Show');

        })
        $('#panelsearch').on('show.bs.collapse', function () {
            $('#btnShow').html('<span class="glyphicon glyphicon-chevron-right"></span> Hide');
            $('#panelgrid').addClass('col-md-10 col-lg-10').removeClass('col-md-12 col-lg-12');

        })


        $('.listboxuser').multiselect({
            includeSelectAllOption: true
        });


        //var clicker = 0;
        //$('.listbox').change(function () {
        //    var assID = $(this).val();
        //    var clicker = 0;
        //    if(assID == 0)
        //    {
        //        alert("");
        //        $(this).find("li").remove();
        //    }



        //});
        //$(".listbox option[value=0]").click(function (e) {
        //    alert();
        //    //clicker++;
        //    //$(this).prop('selected', false);
        //    //if (clicker % 2 != 0) {


        //    //    $(".listbox option[value!=0]").prop('selected', true);
        //    //}
        //    //else
        //    //    $(".listbox option[value!=0]").prop('selected', false);

        //});
        $("#btnclear").click(function (e) {

            $('.formtext').val('');
        });

        function ParamCallBack() {
            $('.listbox').multiselect({
                includeSelectAllOption: true
            });
            $('.listbox').multiselect('selectAll', false);
            $('.listbox').multiselect('updateButtonText');
            $("#btngetreport").click(function (e) {
                GetReport();
            });
            GetReport();
        }

        $("#btngetparams").click(function (e) {
            GetParam();
        });


        $(document).ready(function (e) {
            GetParam();
        });

        function GetParam()
        {
            var _user = $('#listboxuser').val();
            // Add errors highlight
            $.ajax({
                url: '@Html.TextBox("txttodate", DateTime.Today, "{0:yyyy-MM-dd}", new { @class = "form-control formdate", type = "date" })',
                dataType: "html",

                ContentType: "application/json;charset=utf-8",
                type: "POST",
                data: { userName: _user },
                cache: false,
                async: true,
                beforeSend: function () {
                    $('#pleaseWaitDialog').modal('show');
                },
                complete: function () {
                    //$('#pleaseWaitDialog').modal('hide');
                },
                success: function (data) {
                    $('#divParameters').html(data);
                    ParamCallBack();
                },
                failure: function (response) {
                    alert("Get Failed");
                },
            });
        }

        function GetReport()
        {
            var _user = $('#listboxuser').val();

            var _fromDate = $('#txtfromdate').val();
            var _toDate = $('#txttodate').val();

            var _projects = $('#listboxproj').val();
            var _forms = $('#listboxforms').val();
            var _discipline = $('#listboxdisc').val();
            var _workflowstatus = $('#listboxws').val();

            var _subject = $('#txtsubject').val();
            var _originReg = $('#txtoref').val();
            var _subjectmatter = '';
            var _category = $('#txtcategory').val();
            var _from = $('#txtfrom').val();
            var _to = $('#txtto').val();
            var _docType = $('#listboxdoctype').val();
            var _fileName = $('#txtFileName').val();

            // Add errors highlight
            $.ajax({
                url: '@Html.ListBox("Projects", new SelectList(ViewBag.Userprojects, "Id", "Name"), new { @id = "listboxproj", @class = "form-control listbox" })',
                dataType: "html",

                ContentType: "application/json;charset=utf-8",
                type: "POST",
                data: { username: _user, fromDate: _fromDate, toDate: _toDate, projects: _projects, forms: _forms, discipline: _discipline, workflowstatus: _workflowstatus, subject: _subject, originReg: _originReg, subjectmatter: _subjectmatter, category: _category, from: _from, to: _to, docType: _docType, fileName: _fileName },
                cache: false,
                async: true,
                beforeSend: function () {
                    $('#pleaseWaitDialog').modal('show');
                },
                complete: function () {
                    $('#pleaseWaitDialog').modal('hide');
                },
                success: function (data) {
                    $('#worklist').html(data);

                },
                failure: function (response) {
                    alert("Get Failed");
                },
            });
        }

        $('.listboxuser').multiselect('selectAll', false);
        $('.listboxuser').multiselect('updateButtonText');
    });
</script>
</html>