@model IEnumerable<Trinergy.Model.DocumentLogModel>
@{
    Layout = null;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Document Log</title>
    <style>
        .multiselect-selected-text {
            display: inline-grid;
            width: 180px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
    </style>
    <link href="/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="~/Scripts/tree/themes/proton/style.css" />
    <style>
        .attachments {
            font-size: 12px !important;
        }

            .attachments .panel-heading {
                padding: 2px 15px !important;
            }

                .attachments .panel-heading h4 {
                    margin-top: 2px;
                    margin-bottom: 2px;
                }

            .attachments .col-md-6 {
                padding: 2px;
            }

            .attachments ul {
                padding: 0px;
                list-style: none;
            }

            .attachments .panel-body {
                padding: 5px 5px 5px 15px;
            }

                .attachments .panel-body .panel-body {
                    padding-left: 5px;
                }

            .attachments a {
                color: blue;
                text-decoration: underline;
            }
    </style>
    <style class="cp-pen-styles">
        ul.css-treeview {
            /*margin: 0px 0px 0px 20px;*/
            list-style: none;
            line-height: 2em;
            font-family: Arial;
        }

            ul.css-treeview li {
                font-size: 16px;
                position: relative;
            }

                ul.css-treeview li:before {
                    position: absolute;
                    left: -15px;
                    top: 0px;
                    content: '';
                    display: block;
                    border-left: 1px solid #ccc;
                    height: 1em;
                    border-bottom: 1px solid #ccc;
                    width: 10px;
                }

                ul.css-treeview li:after {
                    position: absolute;
                    left: -15px;
                    bottom: -7px;
                    content: '';
                    display: block;
                    border-left: 1px solid #ccc;
                    height: 100%;
                }

                ul.css-treeview li.root {
                    margin: 0px 0px 0px -20px;
                }

                    ul.css-treeview li.root:before {
                        display: none;
                    }

                    ul.css-treeview li.root:after {
                        display: none;
                    }

                ul.css-treeview li:last-child:after {
                    display: none;
                }

        .folder {
            margin-left: 0px !important;
            background-color: lightgrey;
            border: 1px solid #ffffff;
        }

        .dataTables_length {
            padding-left: 25px !important;
        }
        .multiselect-container{
            max-height:500px;
            overflow:auto;
        }
        ::-webkit-scrollbar {
            width: 12px;
        }

        ::-webkit-scrollbar-track {
            -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            border-radius: 10px;
            -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.5);
        }

    </style>
</head>
<body>
    <div style="padding-left:30px; padding-top:15px;width: 98.9%;">
        <div class="row">
            <div id="panelsearch" class="col-xs-12 col-sm-12 col-md-2 col-lg-2 collapse in">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">Document Filter </h3>
                    </div>
                    <div class="panel-body SearchLeftPanel">
                        <div class="form-group ">
                            <div class="form-group " style="overflow:inherit">
                                <div class="col-md-12">
                                    <label class="lblpanel" style="text-align:left;width:inherit">Users</label>
                                    @Html.TextBox("txtfromdate", new DateTime(DateTime.Now.Year, 1, 1), "{0:yyyy-MM-dd}", new { @class = "form-control formdate", type = "date" })
                                </div>
                            </div>
                            <div class="form-group ">
                                <div class="col-md-12 marginTop10">
                                    <button type="button" id="btngetparams" class="btn btn-primary">Get Parameters</button>
                                </div>
                            </div>
                        </div>
                        <div class="form-group " id="divParameters">
                        </div>

                    </div>
                </div>
            </div>

            <div id="panelgrid" class="col-md-10">
                <div id="worklist">

                </div>


            </div>
        </div>
    </div>
    <div id="pleaseWaitDialog" class="modal" style="display: none;">
        <div class="center">
            <img src="~/Content/Images/hamadwait.gif" alt="Loading, please wait" />
        </div>
    </div>
</body>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<link href="~/Content/formstyles.css" rel="stylesheet" />
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />

<link href="~/Content/jquery.dataTables.css" rel="stylesheet" />
<link href="~/Content/buttons.dataTables.css" rel="stylesheet" />

<link href="~/Content/Documents.css" rel="stylesheet" />
<link href="~/Content/bootstrap-multiselect.css" rel="stylesheet" />
<script src="~/Scripts/bootstrap-multiselect.js"></script>

<link rel="stylesheet" type="text/css" href="~/Content/datatables.min.css" />

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script src="/Scripts/tree/jstree.min.js"></script>

<script type="text/javascript" src="~/Scripts/datatables.min.js"></script>




