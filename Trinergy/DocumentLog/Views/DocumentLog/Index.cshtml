    <script type="text/javascript">

        function SelectProjects() {
            @if(Request.QueryString["pid"] != null && Request.QueryString["pid"].ToString() != "")
        {
            <text>
            var projectIdArr = [];
            </text>
            string[] pids = Request.QueryString["pid"].ToString().Split(new string[] { "," }, StringSplitOptions.RemoveEmptyEntries);
            foreach(string pid in pids)
            {
                <text>
            projectIdArr.push('@pid');
            </text>
            }
            <text>
            var multiselect = $('#Projects').data('kendoMultiSelect');
            multiselect.value(projectIdArr);
            multiselect.trigger("change");
            </text>
        }
        }
        $(document).ready(function () {
            @if((bool)ViewBag.IsUserVisited == false)
            {
                <text>
            
            var _modal = $('#documentLogModal');
            _modal.modal();
            
            $("#panelsearch").hide();
            $("#documentLogModal").on('hidden.bs.modal', function () {
                $("#panelsearch").show();
                $(".pyro").remove();
                $("body").css({ "background-color": "#FFF" });
                SetCustomApplicateViewer(@Session["PMWebUserId"].ToString(), 'Document Log');
            });
            </text>
            }
            setHeight($("#grid_DocumentLog"));
            SelectProjects();
            $("#panelgrid").hide();
        })

        /* Telerik */
        var dataLoadingCompleted = false;
        function OnGridDataBound(e) {
            $("#btnCollapseExpand").val("Collapse All");
            var grid = e.sender;
            CheckSessionForGrid(grid);
            $('.comments').each(function (index) {
                var td = $(this).closest('td');
                var tr = $(td).closest('tr');
                var data = grid.dataItem(tr);
                $('a', td).remove();
                $('<a />', {
                    href: '#'
                })
                .text('More')
                .click(function (e) {
                    GetRecord(data.WorkflowBIUrl);
                })
                .appendTo(td);
            });
            setTimeout(ChangePedningDaysCellColor(this, 15, 'PendingDays'), 10);
            setTimeout(BindActionRightClick(e), 10);
        }
        function OnGroupExpand(e) {
            setTimeout(function () {
                var grid = e.sender;
                $('.comments').each(function (index) {
                    var td = $(this).closest('td');
                    var tr = $(td).closest('tr');
                    var data = grid.dataItem(tr);
                    $('a', td).remove();
                    $('<a />', {
                        href: '#'
                    })
                    .text('More')
                    .click(function (e) {
                        //GetWorkflowStatus(data.DocumentId, this)
                        GetRecord(data.WorkflowBIUrl);
                    })
                    .appendTo(td);
                });
            }, 0);

            //$('.k-header-column-menu').removeClass('k-state-active');
        }
        var exportFlag = false;
        function onDocumentLogExcelExport(e) {
            if (!exportFlag) {

                e.sender.showColumn(0);
                e.sender.showColumn(1);

                e.sender.hideColumn(10);
                e.sender.hideColumn(11);
                e.sender.hideColumn(14);

                //e.sender.showColumn(15);
                //e.sender.showColumn(16);
                //e.sender.showColumn(17);
                //e.sender.showColumn(18);
                //e.sender.showColumn(19);
                //e.sender.showColumn(20);

                e.sender.showColumn(23);

                e.sender.dataSource.group([]);
                e.preventDefault();
                exportFlag = true;
                setTimeout(function () {
                    e.sender.saveAsExcel();
                });
            } else {
                setTimeout(function () {
                    e.sender.dataSource.group([{ field: "ProjectName" }, { field: "FormName" }]);

                    e.sender.hideColumn(0);
                    e.sender.hideColumn(1);

                    e.sender.showColumn(10);
                    e.sender.showColumn(11);
                    e.sender.showColumn(14);

                    //e.sender.hideColumn(15);
                    //e.sender.hideColumn(16);
                    //e.sender.hideColumn(17);
                    //e.sender.hideColumn(18);
                    //e.sender.hideColumn(19);
                    //e.sender.hideColumn(20);

                    e.sender.hideColumn(23);

                }, 10);
                exportFlag = false;
            }
        }
        function GetIsCancelled(e) {
            return {
                IsCancelled: IsCancelledDocumentLogRequest
            }
        }
        $(".k-pager-refresh").click(function () {
            $('#grid_DocumentLog').data('kendoGrid').dataSource.read();
        });
        /* End Telerik */
