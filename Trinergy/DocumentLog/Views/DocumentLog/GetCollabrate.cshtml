@model IEnumerable<Trinergy.Model.Collabrate>
@{
    Layout = null;
    int rowNum = 0;
}
<div style="width:50%">
    <div class="text-right"><a href="javascript:void(0)" title="Close" onclick="CloseSubReport()" style="color:red"><span class="glyphicon glyphicon-remove"></span></a></div>
    <table class="table table-bordered table-striped grid">
        <thead>
            <tr class="subReportHeader">
                <th>S.No.</th>
                <th>Action By</th>
                <th>Action Type</th>
                <th>Action Date</th>
                <th>Comments</th>
                <th>Pending With</th>
                <th>Due Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                rowNum = rowNum + 1;
                <tr>
                    <td>@rowNum</td>
                    <td>@log.ActionBy</td>
                    <td>@log.ActionType</td>
                    <td>@log.ActionDate.ToString("dd-MMM-yy")</td>
                    <td>@log.Comments</td>
                    <td>@log.PendingWidth</td>
                    <td>@log.DueDate.ToString("dd-MMM-yy")</td>
                </tr>
            }
            @if (Model.Count() == 0)
            {
                <tr>
                    <td colspan="7">No Records Found</td>
                </tr>
            }
        </tbody>
    </table>
</div>
