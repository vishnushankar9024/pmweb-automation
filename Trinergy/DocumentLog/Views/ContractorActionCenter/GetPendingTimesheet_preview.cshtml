@model IEnumerable<Trinergy.Model.TimesheetModel>

@{
    Layout = null;
}

<!DOCTYPE html>



<head>
    <style>
        
        html, body {
            font-family: Calibri !important;
            font-size: 13px !important;
        }

        #tableTimeSheets thead th {
            /*width: 150px;*/
            vertical-align: middle;
        }

        #tableTimeSheets * {
            font-size: 14px !important;
        }

        .subReportHeader {
            background-color: cadetblue !important;
            color: #ffffff;
        }



        
    </style>


</head>

<body>
    <table class="table table-bordered table-striped grid" id="tableTimeSheets" >
        <thead>
            <tr class="subReportHeader">
                <th>Resource</th>
                <th>Timesheet From</th>
                <th>Timesheet To</th>
                <th>Submitted Date</th>
                <th>Due Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var document in Model)
            {
                <tr>
                    <td>@string.Concat(document.FirstName, " ", document.LastName)</td>
                    <td>@document.FromDate.ToString("dd-MMM-yy")</td>
                    <td>@document.ToDate.ToString("dd-MMM-yy")</td>
                    <td>@document.Submiteddate.ToString("dd-MMM-yy")</td>
                    @{
                        string cssClasstrd;
                        if ((document.DueDate - DateTime.Today).TotalDays < 0)
                        {
                            cssClasstrd = "tdRed";
                        }
                        else if ((document.DueDate - DateTime.Today).TotalDays >= 0 && (document.DueDate - DateTime.Today).TotalDays <= 5)
                        {
                            cssClasstrd = "tdYellow";
                        }
                        else
                        {
                            cssClasstrd = "tdGreen";
                        }

                    }
                    <td class="@cssClasstrd">@document.DueDate.ToString("dd-MMM-yy")</td>
                    <td><a class="actionhead" href="@document.TimesheetURL" target="_top">Action</a></td>
                </tr>
                        }
        </tbody>
    </table>
  
</body>


<script src="~/Scripts/shorten.js"></script>

<script>

    $(document).ready(function () {
        if(@Model.Count() == 0)
        {            
            $('#divmainTS').hide();
        }
        //$(".comment").shorten({
        //    showChars: 100,
        //});
