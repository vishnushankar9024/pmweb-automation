            //dom: "<'row'<'col-sm-3'<'row'<'text-center'l><'text-center'B>>><'col-sm-6 text-center toolbarTS'T><'col-sm-3'f>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
            dom: "<'row'<'col-sm-6'<'text-center'l><'text-center'B>><'col-sm-6'f>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>>",
            //"sDom": '<"toolbar">frtip',
            buttons: [

