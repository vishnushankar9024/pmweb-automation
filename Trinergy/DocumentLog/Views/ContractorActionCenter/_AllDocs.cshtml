    var user = '';
    function handleClick(evt)
    {
        $("#chart_delegate").hide();
        chart_delegate.data.labels = []
        chart_delegate.data.datasets = [];


        var activeElement = chart.getElementAtEvent(evt);

        user = activeElement[0]._model.label;
        var filteredData = $.grep(modelData, function(g) {
            return g.curstepOwner1.indexOf(user) >= 0
        });

        var delegatedData = $.grep(filteredData, function(g) {
            return (g.IsDelegate == "True" && g.DelStepOwner == user);
        });
        if(delegatedData.length > 0)
        {
            var chartDataObj = {
                datasets : [{
                    label:"Pending",
                    backgroundColor: [],
                    data: []
                },
                {
                    label:"Pending Team Input",
                    backgroundColor: [],
                    data: []
                },
                {
                    label:"Overdue",
                    backgroundColor: [],
                    data: []
                },
                {
                    label:"Overdue Team Input",
                    backgroundColor: [],
                    data: []
                }
                ]
            }
            var UniqueNames= $.unique(filteredData.map(function (d) {
                return d.ActStepOwner;
            }));
            UniqueNames = $.unique(UniqueNames);
            console.log(UniqueNames);
            //UniqueNames = UniqueNames[0].split(",");
            var pendingwith ="";
            UniqueNames = $.grep(UniqueNames, function(u){
                return u != user;
            });
            for(var i = 0; i < UniqueNames.length; i++)
            {
                if(pendingwith == "")
                {
                    pendingwith = UniqueNames[i];
                }
                else if( UniqueNames.length == i + 1)
                {
                    pendingwith = pendingwith + " and " + UniqueNames[i];
                }
                else
                {
                    pendingwith = pendingwith + ", " + UniqueNames[i];
                }
                chart_delegate.data.labels.push(UniqueNames[i]);

                var records = $.grep(filteredData, function(g){
                    return g.ActStepOwner.indexOf(UniqueNames[i]) >= 0;
                });

                var pendingRecords = $.grep(records, function(r){
                    return (r.IsPending == "True" || r.IsPendingDelegate == "True");
                });

                chartDataObj.datasets[0].backgroundColor.push("#0178BA");
                chartDataObj.datasets[0].data.push(pendingRecords.length);

                var pendingTIRecords = $.grep(records, function(r){
                    return r.IsPendingTeamInput == "True";
                });

                chartDataObj.datasets[1].backgroundColor.push("#98FB98");
                chartDataObj.datasets[1].data.push(pendingTIRecords.length);

                var overdueRecords = $.grep(records, function(r){
                    return (r.IsOverdue == "True" || r.IsOverdueDelegate == "True");
                });

                chartDataObj.datasets[2].backgroundColor.push("#FF0000");
                chartDataObj.datasets[2].data.push(overdueRecords.length);

                var overdueTIRecords = $.grep(records, function(r){
                    return r.IsOverdueTeamInput == "True";
                });

                chartDataObj.datasets[3].backgroundColor.push("#800000");
                chartDataObj.datasets[3].data.push(overdueTIRecords.length);
            }
            $("#pendingwith").empty();
            $("#delegatedBy").empty();
            $("#pendingwith").html(user);
            $("#delegatedBy").html(pendingwith);
            chartDataObj.datasets.forEach(function(dataset){
                chart_delegate.data.datasets.push(dataset);
            });
            chart_delegate.update();
            $("#chart_delegate").show();
        }

        $(".toolbarAD", "#tableuserdocs_wrapper").html("<h3>Documents Pending With \"" + user + "\"</h3>");
        console.log(filteredData);
        PrepareData(filteredData);
    }

    function delegate_handleClick(evt)
    {
        debugger;
        var activeElement = chart_delegate.getElementAtEvent(evt);

        var act_user = activeElement[0]._model.label;
        var filteredData = $.grep(modelData, function(g) {
            return (g.curstepOwner1.indexOf(user) >= 0 && g.ActStepOwner.indexOf(act_user) >= 0);
        });
        console.log(filteredData);
        $(".toolbarAD", "#tableuserdocs_wrapper").html("<h3>Documents Pending With \"" + act_user + "\"</h3>");
        PrepareData(filteredData);
    }

    function PrepareData(filteredData)
    {
        var dataSet = [];
        filteredData.forEach(function(d, i){
            var data =
                [
                    d.Project,
                    d.RecordType,
                    d.FileNames,
                    d.RecordNumber,
                    d.DocumentDate,
                    d.Description,
                    d.IssueDate,
                    d.ReviewDays,
                    d.Attachments,
                    d.Workflow,
                    d.DueDate,
                    d.Due,
                    d.StepNumber,
                    d.curstepOwner1,
                    d.WorkflowComments,
                    d.dt,
                    d.Overdue,
                    d.curstepOwner2
                ];

            dataSet.push(data);
        });

        uTable.clear();
        uTable.rows.add(dataSet);
        uTable.draw();

    }
</script>
