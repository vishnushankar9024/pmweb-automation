        $.ajax({
            url: '@Url.Action("GetAttachments", "ContractorActionCenter")',
            dataType: "html",
            type: "GET",
            contentType: 'application/json;charset=utf-8',
            data: { DocId: DocId },
            beforeSend: function () {

            },
            complete: function () {

            },
            async: true,
