            "pageLength": 10,
            "order": [[0, 'asc'], [1, 'asc']],
            "displayLength": 10,
            "drawCallback": function (settings) {
                var api = this.api();
                var rows = api.rows({ page: 'current' }).nodes();
                var last = null;
                var lastsub = null;
                api.rows({ page: 'current' }).data().each(function (row, i) {
                    group = row[0];
                    subgroup = row[1];
                    if (last !== group) {
                        $(rows).eq(i).before(
                            '<tr class="group-header group-header-form projectname"><td colspan="17" class="group-header-td"><span class="glyphicon glyphicon-chevron-up" style="color:white"></span><span class="h4 headspan">&nbsp;&nbsp;<strong>' + group + '</strong></span></td></tr>'
                        );
                        last = group;
                        lastsub = null;
                    }

                    if (lastsub !== subgroup) {
                        $(rows).eq(i).before(
                            '<tr class="group-header-form formname"><td colspan="17" class="group-header-form-td"><span class="glyphicon glyphicon-chevron-up" style="color:white"></span><span class="h4">&nbsp;&nbsp;<strong>' + subgroup + '</strong></span></td></tr>'
                        );
                        lastsub = subgroup;
                    }
                });
            }
        });

