    function GetWorkflowStatus(RecordId, Obj) {
        $(".tempRow").remove();
        $.ajax({
            url: '@Url.Action("GetWorkflowStatus", "ContractorDocumentLog")',
            dataType: "html",
            type: "GET",
            contentType: 'application/json;charset=utf-8',
            data: { RecordId: RecordId, "_": Math.random() },
            //beforeSend: function () {
            //    $('#pleaseWaitDialog').modal();
            //},
            //complete: function () {
            //    $('#pleaseWaitDialog').modal('hide');
            //},
            async: true,
            cache: false,
            success: function (data) {
                var tr = '<tr class="tempRow"><td colspan="16">' + data + '</td></tr>'
                $(Obj).closest("tr").after(tr);
            },
            error: function (xhr) {
                //alert("failed");
            }
        });
    }
    function GetAttachments(DocId, Obj) {

