@model IEnumerable<Trinergy.Model.ActiveWFDocumentModel>
@using Trinergy.Model
@{
    Layout = null;
    var docStatus = ((IEnumerable<DocumentStatus>)Session["DocumentStatus"]).ToList();
}

<!DOCTYPE html>



<head>
    <style>
        .group-header-td {
            background-color: #007FC9;
            cursor: pointer;
        }

        .group-header-form-td {
            /*background-color: #357fbe;*/
            background-color: LightBlue;
            cursor: pointer;
            color: #000000 !important;
        }



        .headspan {
            color: white !important;
        }

        html, body {
            font-family: Calibri !important;
            font-size: 13px !important;
        }

        #tableaalldocs thead th {
            width: 200px;
            vertical-align: top !important;
        }

        .table > thead > tr > th {
            vertical-align: middle !important;
        }

        #tableaalldocs * {
            font-size: 14px !important;
        }

        #tableuserdocs * {
            font-size: 14px !important;
        }

        .subReportHeader {
            background-color: cadetblue !important;
            color: #ffffff;
        }

        .subReportHeader1 {
            background-color: #63b7a2 !important;
            color: #ffffff;
        }

        table.dataTable {
            margin: 0 auto;
            width: 100%;
            clear: both;
            border-collapse: collapse;
            table-layout: fixed !important;
            word-wrap: break-word;
        }

        .top {
            vertical-align: top;
        }

        .leg-cont {
            margin-left: auto;
            margin-right: auto;
            width: 600px;
            margin-bottom: 75px;
        }

        .leg-box {
            height: 15px;
            width: 40px;
            float: left;
            margin-right: 5px;
            margin-top: 2px;
        }

        .leg_title {
            text-align: left;
            min-width: 120px;
            margin-right: 20px;
            float: left;
        }
    </style>
    <script type="text/javascript">
        var modelData = [];
    </script>
    @foreach (var document in Model)
    {
        string status = "";
        if (docStatus.Any())
        {
            if (document.StatusId == 2)
            {
                status = "Submitted";
            }
            else if (document.StatusId == 3)
            {
                status = "Returned";
            }
            else if (document.StatusId == 4)
            {
                status = "Resubmitted";
            }
            else
            {
                status = docStatus.Find(x => x.Id == document.StatusId).Name;
            }
            if (status == "Submitted") { status = "In Progress"; }
        }
        string cssClasstrd = "";
        double dys = 0;
        if (!String.IsNullOrEmpty(document.ReviewDays))
        {
            dys = (document.DocumentDate.AddDays(Convert.ToDouble(document.ReviewDays)) - DateTime.Today).TotalDays;
            if (dys < 0)
            {
                cssClasstrd = "tdRed";
            }
            else if (dys >= 0 && dys <= 5)
            {
                cssClasstrd = "tdYellow";
            }
            else
            {
                cssClasstrd = "tdGreen";
            }
        }

        string status2 = "";

        if (docStatus.Any())
        {
            if (document.StatusId == 2)
            {
                status2 = "Submitted";
            }
            else if (document.StatusId == 3)
            {
                status2 = "Returned";
            }
            else if (document.StatusId == 4)
            {
                status2 = "Resubmitted";
            }
            else
            {
                status2 = docStatus.Find(x => x.Id == document.StatusId).Name;
            }
        }


        string prelbl = string.Empty;
        if (status2 != "Withdrawn" || status != "Approved" || status != "Rejected") { prelbl = "STEP "; }

        string curstepOwner1 = string.Empty;
        string curstepOwnerTemp = document.CurrStepOwner.Trim();
        if (curstepOwnerTemp != string.Empty)
        {
            if (curstepOwnerTemp[0] == ',')
            {
                curstepOwnerTemp.Remove(0, 1);

            }
            //curstepOwner1 = curstepOwnerTemp.Remove(curstepOwnerTemp.IndexOf(","), (",").ToString().Length);
            curstepOwner1 = curstepOwnerTemp;
        }
        else
        {
            curstepOwner1 = "";
        }
        string dt = "";
        if (!string.IsNullOrEmpty(document.CalcDueDate))
        {
            dt = (DateTime.Parse(document.CalcDueDate).ToString("dd-MMM-yy"));
        }

        string cssClass = string.Empty;
        if (!string.IsNullOrEmpty(document.CalcDueDate))
        {
            if (Convert.ToDecimal(document.RemainingDays) < 0)
            {
                cssClass = "tdRed";
            }
            else if (Convert.ToDecimal(document.RemainingDays) >= 0 && Convert.ToDecimal(document.RemainingDays) <= 5)
            {
                cssClass = "tdYellow";
            }
            else
            {
                cssClass = "tdGreen";
            }

        }
        else
        {
            cssClasstrd = "tdTransparent";
        }

        string curstepOwner2 = string.Empty;
        string curstepOwnerTemp2 = document.CurrStepOwner.Trim();
        string userStepTemp2 = document.UserStep.Trim();
        if (curstepOwnerTemp2 != string.Empty)
        {
            if (curstepOwnerTemp2[0] == ',')
            {
                curstepOwnerTemp2.Remove(0, 1);

            }
            if (userStepTemp2 != "" && userStepTemp2[0] == ',')
            {
                userStepTemp2 = userStepTemp2.Remove(0, 1);

            }

            curstepOwner2 = userStepTemp2 + " of " + document.NumberOfSteps;
        }
        else
        {
            curstepOwner2 = "";
        }

        <text>
            <script type="text/javascript">
                var data = {
                    Project : '@document.Project',
                    RecordType: '@document.RecordType',
                    FileNames: '@document.FileNames',
                    RecordNumber: '@document.RecordNumber',
                    DocumentDate:'@document.DocumentDate.ToString("dd-MMM-yy")',
                    Description: '<a href="@document.Recordurl" target="_top">@document.Description</a>',
                    IssueDate:'@document.IssueDate.ToString("dd-MMM-yy")',
                    ReviewDays:'@document.ReviewDays',
                    Attachments:'<a href="javascript:void(0)" onclick="GetAttachments(@document.DocumentId, this)">Attachments</a>',
                    Workflow : '<a href="javascript:void(0)" onclick="GetWorkflowStatus(@document.DocumentId, this)">@status</a>',
                    DueDate: '@((document.DocumentDate.AddDays(String.IsNullOrEmpty(document.ReviewDays) == true ? 0 : Convert.ToDouble(document.ReviewDays))).ToString("dd-MMM-yy"))',
                    Due : "<div class='@cssClasstrd'>@(Math.Abs(dys) + " Day(s) " + (dys < 0 ? "Overdue" : "Remaining"))</div>",
                    StepNumber : '@(prelbl + document.StepNumber + " of " + document.NumberOfSteps)',
                    curstepOwner1 : '@curstepOwner1',
                    DelStepOwner : '@document.DelStepOwner',
                    WorkflowComments : "@Html.Raw(document.WorkflowComments.Replace("\"", "\\\""))",
                    dt: '@dt',
                    Overdue:"<div class='@cssClass'>@(Math.Abs(Convert.ToDecimal(document.RemainingDays)) + " Day(s) " + (Convert.ToDecimal(document.RemainingDays) < 0 ? "Overdue" : "Remaining"))</div>",
                    curstepOwner2: '@curstepOwner2',
                    ActStepOwner : '@document.ActStepOwner',

                    IsDelegate : '@document.IsDelegate',

                    IsPending : '@document.IsPending',
                    IsPendingTeamInput:'@document.IsPendingTeamInput',
                    IsPendingDelegate:'@document.IsPendingDelegate',

                    IsOverdue:'@document.IsOverdue',
                    IsOverdueTeamInput:'@document.IsOverdueTeamInput',
                    IsOverdueDelegate:'@document.IsOverdueDelegate'
                };
                modelData.push(data);
            </script>
        </text>
    }
</head>

<body>
    <table class="table table-bordered table-striped grid" id="tableaalldocs">
        <thead>
            @*<tr class="subReportHeader1">
                    <th colspan="2"></th>
                    <th colspan="10" style="text-align:center">DOCUMENT STATUS FROM AN <strong><u>OVERALL WORKFLOW</u></strong> PERSPECTIVE </th>
                    <th colspan="5" style="text-align:center">LOOKING CLOSER AT THE <strong><u>CURRENT STEP</u></strong>….</th>
                </tr>*@
            <tr class="subReportHeader">
                <th></th>
                <th></th>
                <th></th>
                <th class="text-center">Doc ID</th>
                <th class="text-center">HFD Received Date (Stamped)</th>
                <th style="text-align:center;">Subject</th>
                <th class="text-center">Entered Into Workflow</th>
                <th class="text-center">Total Days Allowed</th>
                <th class="text-center">Attachments</th>
                <th class="text-center">Workflow Status</th>
                <th class="text-center">HFD Due Date</th>
                <th class="text-center">Overall Status Time</th>
                <th class="text-center">Current Workflow Step</th>
                <th style="text-align:center;">Who is the "Action" Pending With</th>
                <th class="text-center">Previous Step Workflow Comments</th>
                <th class="text-center">Current Step Due Date</th>
                <th class="text-center">Current Step Status (Time)</th>
                <th class="text-center">My Action Required in Steps</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var document in Model)
            {
                <tr>
                    <td>@document.Project</td>
                    <td>@document.RecordType</td>
                    <td>@document.FileNames</td>
                    <td>@document.RecordNumber</td>
                    <td>@document.DocumentDate.ToString("dd-MMM-yy")</td>
                    <td><a href="@document.Recordurl" target="_top">@document.Description</a></td>
                    <td>@document.IssueDate.ToString("dd-MMM-yy")</td>
                    <td>@document.ReviewDays</td>
                    <td><a href="javascript:void(0)" onclick="GetAttachments(@document.DocumentId, this)">Attachments</a></td>
                    <td>
                        @{

                            string status = "";
                            if (docStatus.Any())
                            {
                                if (document.StatusId == 2)
                                {
                                    status = "Submitted";
                                }
                                else if (document.StatusId == 3)
                                {
                                    status = "Returned";
                                }
                                else if (document.StatusId == 4)
                                {
                                    status = "Resubmitted";
                                }
                                else
                                {
                                    status = docStatus.Find(x => x.Id == document.StatusId).Name;
                                }
                                if (status == "Submitted") { status = "In Progress"; }
                            }
                        }

                        <a href="javascript:void(0)" onclick="GetWorkflowStatus(@document.DocumentId, this)">@status</a>
                    </td>
                    <td>@((document.DocumentDate.AddDays(String.IsNullOrEmpty(document.ReviewDays) == true ? 0 : Convert.ToDouble(document.ReviewDays))).ToString("dd-MMM-yy"))</td>

                    @{
                        string cssClasstrd = "";
                        double dys = 0;
                        if (!String.IsNullOrEmpty(document.ReviewDays))
                        {
                            dys = (document.DocumentDate.AddDays(Convert.ToDouble(document.ReviewDays)) - DateTime.Today).TotalDays;
                            if (dys < 0)
                            {
                                cssClasstrd = "tdRed";
                            }
                            else if (dys >= 0 && dys <= 5)
                            {
                                cssClasstrd = "tdYellow";
                            }
                            else
                            {
                                cssClasstrd = "tdGreen";
                            }
                        }
                        //double trd = (DateTime.Today - document.DocumentDate.AddDays(String.IsNullOrEmpty(document.ReviewDays) == true ? 0 : Convert.ToDouble(document.ReviewDays))).TotalDays;
                    }
                    <td class="@cssClasstrd">
                        @(Math.Abs(dys) + " Day(s) " + (dys < 0 ? "Overdue" : "Remaining")
                        )
                    </td>
                    @{
                        string status2 = "";

                        if (docStatus.Any())
                        {
                            if (document.StatusId == 2)
                            {
                                status2 = "Submitted";
                            }
                            else if (document.StatusId == 3)
                            {
                                status2 = "Returned";
                            }
                            else if (document.StatusId == 4)
                            {
                                status2 = "Resubmitted";
                            }
                            else
                            {
                                status2 = docStatus.Find(x => x.Id == document.StatusId).Name;
                            }
                        }


                        string prelbl = string.Empty;
                        if (status2 != "Withdrawn" || status != "Approved" || status != "Rejected") { prelbl = "STEP "; }
                    }
                    <td>@(prelbl + document.StepNumber + " of " + document.NumberOfSteps)</td>
                    @{
                        string curstepOwner1 = string.Empty;
                        string curstepOwnerTemp = document.CurrStepOwner.Trim();
                        if (curstepOwnerTemp != string.Empty)
                        {
                            if (curstepOwnerTemp[0] == ',')
                            {
                                curstepOwnerTemp.Remove(0, 1);

                            }
                            //curstepOwner1 = curstepOwnerTemp.Remove(curstepOwnerTemp.IndexOf(","), (",").ToString().Length);
                            curstepOwner1 = curstepOwnerTemp;
                        }
                        else
                        {
                            curstepOwner1 = "";
                        }
                    }
                    <td>@curstepOwner1</td>
                    <td style="text-align:left">@Html.Raw(document.WorkflowComments)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(document.CalcDueDate))
                        {
                            @(DateTime.Parse(document.CalcDueDate).ToString("dd-MMM-yy"));
                        }
                    </td>
                    @{
                        string cssClass = string.Empty;
                        if (!string.IsNullOrEmpty(document.CalcDueDate))
                        {
                            if (Convert.ToDecimal(document.RemainingDays) < 0)
                            {
                                cssClass = "tdRed";
                            }
                            else if (Convert.ToDecimal(document.RemainingDays) >= 0 && Convert.ToDecimal(document.RemainingDays) <= 5)
                            {
                                cssClass = "tdYellow";
                            }
                            else
                            {
                                cssClass = "tdGreen";
                            }

                        }
                        else
                        {
                            cssClasstrd = "tdTransparent";
                        }
                    }
                    <td class="@cssClass">

                        @(Math.Abs(Convert.ToDecimal(document.RemainingDays)) + " Day(s) " + (Convert.ToDecimal(document.RemainingDays) < 0 ? "Overdue" : "Remaining")
                        )

                    </td>
                    @{
                        string curstepOwner2 = string.Empty;
                        string curstepOwnerTemp2 = document.CurrStepOwner.Trim();
                        string userStepTemp2 = document.UserStep.Trim();
                        if (curstepOwnerTemp2 != string.Empty)
                        {
                            if (curstepOwnerTemp2[0] == ',')
                            {
                                curstepOwnerTemp2.Remove(0, 1);

                            }
                            if (userStepTemp2 != "" && userStepTemp2[0] == ',')
                            {
                                userStepTemp2 = userStepTemp2.Remove(0, 1);

                            }

                            curstepOwner2 = userStepTemp2 + " of " + document.NumberOfSteps;
                        }
                        else
                        {
                            curstepOwner2 = "";
                        }
                    }
                    <td>@curstepOwner2</td>
                </tr>
                        }
        </tbody>
    </table>
    <div class="row">
        <div class="col-md-12">
            <!-- BAR CHART -->
            <div class="box box-success">
                <div class="box-header with-border">
                    <h3 class="box-title">Documents Pending With</h3>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="leg-cont">
                            <div class="row">
                                <div class="col-md-4"><div class="leg-box" style="background-color:#0178BA;"></div> Pending</div>
                                <div class="col-md-4"><div class="leg-box" style="background-color:#98FB98;"></div> Pending Team Input</div>
                                <div class="col-md-4"><div class="leg-box" style="background-color:#FFFF00;"></div> Pending Delegate</div>
                            </div>
                            <div class="row">
                                <div class="col-md-4"><div class="leg-box" style="background-color:#FF0000;"></div> Overdue</div>
                                <div class="col-md-4"><div class="leg-box" style="background-color:#800000;"></div> Overdue Team Input</div>
                                <div class="col-md-4"><div class="leg-box" style="background-color:#FF7F50;"></div> Overdue Delegate</div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="chart">
                            <canvas id="bar-chart" height="600"></canvas>
                        </div>
                    </div>
                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
    </div>

    <div class="row" id="chart_delegate">
        <div class="col-md-12">
            <!-- BAR CHART -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <div class="box-header with-border">
                        <h3 class="box-title">Documents Pending With "<span id="pendingwith"></span>" delegated by "<span id="delegatedBy"></span>"</h3>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="box box-success">
                        <div class="box-body">
                            <div class="row">
                                <div class="leg-cont">
                                    <div class="row">
                                        <div class="col-md-4"><div class="leg-box" style="background-color:#0178BA;"></div> Pending</div>
                                        <div class="col-md-4"><div class="leg-box" style="background-color:#98FB98;"></div> Pending Team Input</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4"><div class="leg-box" style="background-color:#FF0000;"></div> Overdue</div>
                                        <div class="col-md-4"><div class="leg-box" style="background-color:#800000;"></div> Overdue Team Input</div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="chart" style="height:350px;">
                                    <canvas id="bar-chart-delegate" height="350"></canvas>
                                </div>
                            </div>
                        </div>
                        <!-- /.box-body -->
                    </div>
                    <!-- /.box -->
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-striped grid" id="tableuserdocs">
        <thead>
            @*<tr class="subReportHeader1">
                    <th colspan="2"></th>
                    <th colspan="10" style="text-align:center">DOCUMENT STATUS FROM AN <strong><u>OVERALL WORKFLOW</u></strong> PERSPECTIVE </th>
                    <th colspan="5" style="text-align:center">LOOKING CLOSER AT THE <strong><u>CURRENT STEP</u></strong>….</th>
                </tr>*@
            <tr class="subReportHeader">
                <th></th>
                <th></th>
                <th></th>
                <th class="text-center">Doc ID</th>
                <th class="text-center">HFD Received Date (Stamped)</th>
                <th style="text-align:center;">Subject</th>
                <th class="text-center">Entered Into Workflow</th>
                <th class="text-center">Total Days Allowed</th>
                <th class="text-center">Attachments</th>
                <th class="text-center">Workflow Status</th>
                <th class="text-center">HFD Due Date</th>
                <th class="text-center">Overall Status Time</th>
                <th class="text-center">Current Workflow Step</th>
                <th style="text-align:center;">Who is the "Action" Pending With</th>
                <th class="text-center">Previous Step Workflow Comments</th>
                <th class="text-center">Current Step Due Date</th>
                <th class="text-center">Current Step Status (Time)</th>
                <th class="text-center">My Action Required in Steps</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>No data</td></tr>
        </tbody>
    </table>
</body>
