@model IEnumerable<Trinergy.Model.TimesheetDetail>
@{
    Layout = null;
}
<div>
    <table class="table table-bordered table-striped grid">
        <thead>
            <tr>
                <th>Type</th>
                <th>Sun</th>
                <th>Mon</th>
                <th>Tue</th>
                <th>Wed</th>
                <th>Thu</th>
                <th>Fri</th>
                <th>Sat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tsd in Model)
            {
            <tr>
                <td>@tsd.Description</td>
                <td>@tsd.Su</td>
                <td>@tsd.M</td>
                <td>@tsd.T</td>
                <td>@tsd.W</td>
                <td>@tsd.Th</td>
                <td>@tsd.F</td>
                <td>@tsd.Sa</td>
            </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th>Total</th>
                <th>@Model.Sum(s => Convert.ToDouble(s.Su))</th>
                <th>@Model.Sum(s => Convert.ToDouble(s.M))</th>
                <th>@Model.Sum(s => Convert.ToDouble(s.T))</th>
                <th>@Model.Sum(s => Convert.ToDouble(s.W))</th>
                <th>@Model.Sum(s => Convert.ToDouble(s.Th))</th>
                <th>@Model.Sum(s => Convert.ToDouble(s.F))</th>
                <th>@Model.Sum(s => Convert.ToDouble(s.Sa))</th>
            </tr>
        </tfoot>
    </table>
</div>
<script type="text/javascript">
    function CloseSubReport() {
        $(".tempRow").remove();
    }
</script>

