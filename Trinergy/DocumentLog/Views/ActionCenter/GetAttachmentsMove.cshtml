@model IEnumerable<Trinergy.Model.FileManagerFolders>
@(Html.Kendo().TreeView()
                      .Name("attachmentsTreeview")
                      .BindTo(Model, mappings =>
                      {
                          mappings.For<Trinergy.Model.FileManagerFolders>(binding => binding.ItemDataBound((item, folder) =>
                          {
                              item.Text = folder.FolderName;
                              item.Id = folder.FolderId.ToString();
                              //if (tier.Level == 1)
                              //{
                              //    item.SpriteCssClasses = "root";
                              //}
                          })
                              .Children(folder => folder.SubFolders));
                      })

                      )
