    <table class="table table-bordered table-striped grid" id="tableTimeSheets1">
        <thead>
            <tr class="subReportHeader">
                <th>Resource</th>
                <th>Details</th>
                <th>Timesheet From</th>
                <th>Timesheet To</th>
                <th>Submitted Date</th>
                <th>Due Date</th>
                <th>Action</th>
                <th><input type="checkbox" id="chkTimeSheetAll" onclick="ClickAllTimeSheet()">&nbsp;<input type="button" id="btnApprove" value="Approve" class="btn btn-default" /></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var document in Model)
            {
                <tr>
                    <td>@string.Concat(document.FirstName, " ", document.LastName)</td>
                    <td><a href="javascript:void(0)" onclick="GetTimeSheetDetails(@document.Id, this)">View</a></td>
                    <td>@document.FromDate.ToString("dd-MMM-yy")</td>
                    <td>@document.ToDate.ToString("dd-MMM-yy")</td>
                    <td>@document.Submiteddate.ToString("dd-MMM-yy")</td>
                    @{
                        string cssClasstrd;
                        if ((document.DueDate - DateTime.Today).TotalDays < 0)
                        {
                            cssClasstrd = "tdRed";
                        }
                        else if ((document.DueDate - DateTime.Today).TotalDays >= 0 && (document.DueDate - DateTime.Today).TotalDays <= 5)
                        {
                            cssClasstrd = "tdYellow";
                        }
                        else
                        {
                            cssClasstrd = "tdGreen";
                        }

                    }
                    <td class="@cssClasstrd">@document.DueDate.ToString("dd-MMM-yy")</td>
                    <td><a class="actionhead" href="@document.TimesheetURL" target="_top">Action</a></td>
                    <td><input type="checkbox" name="chkTimeSheet" value="@document.Id"></td>
                </tr>
                        }
        </tbody>
    </table>

</body>


<script src="~/Scripts/shorten.js"></script>

<script>
    function ClickAllTimeSheet()
    {
        if($("#chkTimeSheetAll").is(":checked"))
        {
            $("input[name='chkTimeSheet']").each(function(i, e){
                $(this).prop('checked', true);
            });
        }
        else
        {
            $("input[name='chkTimeSheet']").each(function(i, e){
                $(this).prop('checked', false);
            });
        }
    }
