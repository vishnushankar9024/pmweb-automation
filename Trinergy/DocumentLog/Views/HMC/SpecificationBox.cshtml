@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Specification Box</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            @if (ViewBag.Notification.ToString().Trim() == "")
                {
                <text>
                 $("#lblNotification").hide();
            </text>
                }
            $("#txtSpecification").keyup(function () {
                $("#lblNotification").hide();
            });
        });
    </script>
</head>
<body>
    <div style="padding:10px;">
        <form class="form-horizontal" action="@Url.Action("SpecificationBox", "HMC", routeValues:new { EntityTypeId=Request.QueryString["EntityTypeId"].ToString(), EntityId=Request.QueryString["EntityId"].ToString(), SpecificationTemplateId=Request.QueryString["SpecificationTemplateId"].ToString()})" method="post">
            <div class="row" style="margin-bottom:10px;">
                <div class="col-md-12">
                    <input type="submit" value="Save" class="btn btn-default" />&nbsp;
                    <input type="button" value="Close" class="btn btn-default" onclick="window.close();self.close()" />
                    <span id="lblNotification" class="alert alert-success">@ViewBag.Notification</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <textarea name="txtSpecification" id="txtSpecification" style="width:100%; height:auto; min-height:250px;" class="form-control">@ViewBag.Specification</textarea>
                </div>
            </div>
        </form>
    </div>
</body>
</html>
