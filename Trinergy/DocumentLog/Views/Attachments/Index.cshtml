@model PMWebHelper.ViewModel.DocumentAttachmentViewModel
@{
    Layout = null;
    Trinergy.Wrapper.Tree tree = new Trinergy.Wrapper.Tree();
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>HMC HFD - Attachments</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Scripts/tree/themes/proton/style.css" />
    <script src="~/Scripts/jquery-1.10.2.js"></script>
    <script src="~/Scripts/tree/jstree.min.js"></script>
    <style>
        .alert {
            display: none;
        }
    </style>
</head>
<body>
    @*<div class="container">
    <h1>Please use the desktop tool.</h1>
    </div>*@
    <div class="container">
        <div class="row">
            <div class="col-md-6"><h1 style="margin-top: 35px;">Document Attachments</h1></div>
            <div class="col-md-6 text-right"><img src="~/Content/Images/PMWebLogo.gif" style="width:350px;" /></div>

        </div>
        <div class="row">
            <div class="col-md-6">

                <div class="panel panel-default">
                    <div class="panel-heading"><h4>Forms</h4></div>
                    <div class="panel-body">
                        <div id="formTree" style="width:100%; height:300px; overflow:auto">
                            <ul>
                                @{
                                    foreach (var form in Model.Forms)
                                    {
                                        <li id="@form.Id" data-jstree='{ "icon" : "glyphicon glyphicon-list-alt" }'>
                                            @form.Name
                                            @{
                                                var projects = Model.Projects.Where(w => w.FormTypeId == form.Id);
                                            }
                                            @if (projects.Any())
                                            {
                                                <ul>
                                                    @foreach (var project in projects)
                                                    {
                                                        <li id="@project.FormId" project-id="@project.Id" data-jstree='{ "icon" : "glyphicon glyphicon-book" }'>
                                                            @(project.Name + " \\ " + project.RecordNumber)
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                                }
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="panel panel-default">
                    <div class="panel-heading"><h4>Project Folders</h4></div>
                    <div class="panel-body" id="divFolder" style="height:330px;">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="panel panel-info">
                    <div class="panel-heading"><h4>Pre-Requisites</h4></div>
                    <div class="panel-body" style="height:135px;">
                        <ul style="padding-left: 5px;">
                            <li>Do not refresh the page while processing the attachment.</li>
                            <li>Page will automatically reload after the processing the attachment.</li>
                            <li>Select the right project.</li>
                            <li>Select the right folders and/or files.</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="panel panel-default">
                    <div class="panel-heading"><h4>Document Uploader</h4></div>
                    <div class="panel-body">
                        <div class="form-group">
                            <div class="alert alert-info alert-dismissible fade show in" id="uploadFolder"><strong>Selected Folder:</strong><br /><span></span></div>
                            <label>Document: <small>(Please select a file to upload.)</small></label>
                            <input type="file" id="fileInput" class="btn btn-primary" accept="" multiple />
                        </div>
                        <div class="form-group">
                            <input type="button" id="btnUpload" value="Upload & Attach Documents" class="btn btn-success" />
                        </div>
                        <div id="alert_placeholder"></div>
                        <div id="progressbar_container" style="width: 100%; height: 30px; position: relative; background-color: grey; display: none">
                            <div id="progressbar" style="width: 0%; height: 100%; position: absolute; background-color: green"></div>
                            <span id="progressbar_label" style="position: absolute; left: 45%; top: 20%">Uploading...</span>
                        </div>
                    </div>
                </div>
                @*<div class="panel panel-default">
                    <div class="panel-heading"><h4>Attach Document</h4></div>
                    <div class="panel-body" style="height:135px;">
                        <div class="form-group">
                            <input type="button" id="btnUpload" value="Attach Documents" class="btn btn-success" />
                        </div>
                        <div id="alert_placeholder"></div>
                    </div>
                </div>*@
            </div>
        </div>
    </div>
    <script type="text/javascript">
        var selectedFolder = "";
        var selectedProjectId = "";
        var isCorrectLevelFolder = false;
        var formId = "";

        var $tree;

        $('#formTree').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });

        bootstrap_alert = function () { }
        bootstrap_alert.warning = function (message) {
            $('#alert_placeholder').html('<div class="alert alert-danger alert-dismissible fade show in"><a class="close" data-dismiss="alert" onclick="CloseAlert()">×</a><span>' + message + '</span></div>')
        }

        function CloseAlert() {
            $('#alert_placeholder').empty();
        }

        //$("#btnUpload").click(function () {
        //    CloseAlert();
        //    if (!$tree)
        //    {
        //        bootstrap_alert.warning("Please select a project under the forms");
        //        return;
        //    }
        //    var formId = $("#formTree").jstree("get_selected");
        //    var projectId = $("li#" + formId).attr('project-id');
        //    if (!projectId || projectId == '')
        //    {
        //        bootstrap_alert.warning("Please select a project under the forms");
        //        return;
        //    }
        //    var AttachmentInput = { "FormId": formId, "FileIds": [] };
        //    $tree.jstree("open_all");
        //    $('li[aria-selected="true"]', $tree).each
        //        (function () {
        //            if ($(this).attr("file-id")) {
        //                AttachmentInput.FileIds.push($(this).attr("file-id"));
        //            }
        //        });
        //    if (AttachmentInput.FileIds.length <= 0) {
        //        bootstrap_alert.warning("Please select one or more files to attach");
        //        return;
        //    }
        //    $.ajax({
        //        type: "POST",
        //        url: "/Attachments/AttachDocument",
        //        data: { "input": AttachmentInput },
        //        success: function () {
        //            alert("Documents attached successfully");
        //            location.reload();
        //        }
        //    });
        //});

        $("#formTree").on("select_node.jstree", function (evt, data) {
            CloseAlert();
            $("#divFolder").empty();
            $("#divFolder").html("<strong>Loading...</strong>");
            formId = $("#formTree").jstree("get_selected");
            var projectId = $("li#" + formId).attr("project-id");
            $.get("@Url.Action("GetFolders", "Attachments")?formId=" + formId, function (data, status) {
                $("#divFolder").html(data);
                $tree = $("#tree");
                $tree.jstree({
                    'core': {
                        'themes': {
                            'name': 'proton',
                            'responsive': true
                        }
                    },
                    "checkbox": {
                        "keep_selected_style": false
                    },
                    //"plugins": ["checkbox", "wholerow"]
                }).on('ready.jstree', function () {
                    $tree.jstree('open_all');
                });
                $tree.on("select_node.jstree", function (evt, data) {
                    CloseAlert();
                    debugger;
                    $('#alert_placeholder').empty();
                    var folderId = $("#tree").jstree("get_selected");
                    selectedFolder = folderId;
                    var folders = data.node.text;
                    var parentId = $("li#" + folderId).attr("parent-id");
                    var parent;
                    var i = 0;
                    while (parentId != 0) {
                        parent = $("li#" + parentId);
                        folders = ($("a:eq(0)", parent).text() + " => " + folders);
                        parentId = parent.attr("parent-id");
                        i++;
                    }
                    isCorrectLevelFolder = false;
                    selectedProjectId = '';

                    if (i == 2) {
                        isCorrectLevelFolder = true;
                        selectedProjectId = parent.attr("project-id");
                    }
                    $("#uploadFolder span").html(folders);
                });
            });
        });


        var timeStampInMs = "";
        var progressBarStart = function () {
            $("#progressbar_container").show();
        }

        var progressBarUpdate = function (percentage) {
            percentage = parseFloat(Math.round(percentage * 100) / 100).toFixed(2);
            $('#progressbar_label').html(percentage + "%");
            $("#progressbar").width(percentage + "%");
        }

        var progressBarComplete = function () {
            $("#progressbar_container").fadeOut(500);
        }
        var file;

        $('#fileInput').change(function (e) {
            file = e.target.files;
        });
        var uploadCompleted = function () {
            var formData = new FormData();
            formData.append('fileName', file.name);
            formData.append('completed', true);

            var xhr2 = new XMLHttpRequest();
            xhr2.onload = function () {
                progressBarUpdate(100);
                progressBarComplete();
                //location.reload(true)
            }
            xhr2.open("POST", "@Url.Action("UploadComplete", "Attachments")?fileName=" + file.name + "&complete=" + 1 + "&folderName=" + timeStampInMs + "&parentId=" + selectedFolder + "&projectId=" + selectedProjectId + "&formId=" + formId, true);
            xhr2.send(formData);
        }

        var multiUpload = function (count, counter, blob, completed, start, end, bytesPerChunk) {
            counter = counter + 1;
            if (counter <= count) {
                var chunk = blob.slice(start, end);
                var xhr = new XMLHttpRequest();
                xhr.onload = function () {
                    start = end;
                    end = start + bytesPerChunk;
                    if (count == counter) {
                        uploadCompleted();
                        $('#progressbar_label').css("left", "30%");
                        $('#progressbar_label').html("Please wait while extracting files...");
                    } else {
                        var percentage = (counter / count) * 100;
                        progressBarUpdate(percentage);
                        multiUpload(count, counter, blob, completed, start, end, bytesPerChunk);
                    }
                }
                xhr.open("POST", "@Url.Action("MultiUpload", "Attachments")?id=" + counter.toString() + "&fileName=" + file.name + "&folderName=" + timeStampInMs, true);
                xhr.send(chunk);
            }
        }

        $("#btnUpload").click(function () {
            debugger;
            $('#alert_placeholder').empty();
            if (selectedFolder == "") {
                bootstrap_alert.warning('<strong>Folder</strong> Kindly select a folder to upload.');
                return;
            }
            if (isCorrectLevelFolder == false) {
                bootstrap_alert.warning('<strong>Folder</strong> <br />Only 3rd level folders are allowed to upload.<br />Other level folders are not allowed.');
                return;
            }
            CloseAlert();
            //var re = /(\.zip)$/i;
            //if (!re.exec(file.name)) {
            //    bootstrap_alert.warning('<strong>Document Type!</strong> <br /> Kindly upload the zip files.');
            //    return;
            //}
            var formData = new FormData();
            if (file && file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append(file[i].name, file[i]);
                }
            }
            else
            {
                bootstrap_alert.warning('<strong>Document</strong> <br /> Kindly select a document to upload.');
                return;
            }
            $.ajax({
                url: "@Url.Action("UploadComplete", "Attachments")?fileName=" + file.name + "&complete=" + 1 + "&folderName=" + timeStampInMs + "&parentId=" + selectedFolder + "&projectId=" + selectedProjectId + "&formId=" + formId, //URL to upload files
                type: "POST", //as we will be posting files and other method POST is used
                processData: false, //remember to set processData and ContentType to false, otherwise you may get an error
                contentType: false,
                data: formData,
                success: function (result) {
                    $('#divChat').html(result);

                },
                error: function (err) {
                    //alert(err.statusText);
                }
            });

        });
    </script>
</body>
</html>
