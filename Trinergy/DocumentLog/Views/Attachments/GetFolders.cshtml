@{
    Trinergy.Wrapper.Tree tree = new Trinergy.Wrapper.Tree();
    var project = new Trinergy.Data.ProjectDbContext().GetProject((int)ViewData["formId"]);
}
<div id="tree" style="width:100%; height:300px; overflow:auto">
    <ul>
        <li id="@project.FolderId" project-id="@project.Id" parent-id="0" data-jstree='{ "icon" : "glyphicon glyphicon-book" }'>
            @project.Name
            @Html.Raw(tree.GetTreeNode(project.FolderId))
        </li>
    </ul>
</div>

