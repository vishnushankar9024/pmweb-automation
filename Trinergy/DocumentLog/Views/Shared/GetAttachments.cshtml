@model Trinergy.Wrapper.AttachmentOutput
@{
    Layout = null;
    Trinergy.Wrapper.Tree tree = new Trinergy.Wrapper.Tree();
    var fileManager = Model.Folders;
}
<div style="width:100%">
    @*<input type="button" onclick="javascript: void (window.open('pmwebhelper/HMC/FilesLookup?EntityTypeId=1&DocumentType=PROJECT&DocumentId=@ViewBag.RecordId&EntityId=@ViewBag.ProjectId', 'blank', 'scrollbars=yes,toolbar=no,width=1600,height=650,top=200,left=300'));" value="Upload" />*@
    <div id="accordion">
        @{
            var folders = fileManager.Where(w => w.FolderType.ToLower() == "incoming").ToList();
            var folder = folders.Where(w => w.ParentFolder == null || w.ParentFolder == "").FirstOrDefault();
            int fileCount = 0;
            if (folder != null)
            {
                fileCount = tree.GetFileCountByFolder(fileManager.ToList(), folder.Id);
            }
        }
        @if (fileCount > 0)
        {
            <h3>Incoming (@fileCount)</h3>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        @if (folders.Any())
                        {
                            <input type="button" value="++" title="Expand All" onclick="$('#tree').jstree('open_all');">
                            <input type="button" value="--" title="Collapse All" onclick="$('#tree').jstree('close_all');">
                            <br />
                            <div style="width:100%;" id="tree">
                                @if (folder != null)
                                {
                                    <ul>
                                        <li style="font-size: 12px !important;">
                                            <a href="javascript:void(0)" onclick="DownloadFolder(@folder.Id, @folder.ObjectId)" title="Download">@folder.FolderName &nbsp;&nbsp;<span class="glyphicon glyphicon-download-alt"></span></a>
                                            @Html.Raw(tree.GetAttachmentTreeNode(folders, folder.Id, "incoming"))
                                        </li>
                                    </ul>
                                }
                            </div>
                        }
                        else
                        {
                            <div>No Incoming</div>
                        }
                    </div>
                </div>
            </div>
        }
        @{
            folders = fileManager.Where(w => w.FolderType.ToLower() == "draft").ToList();
            folder = folders.Where(w => w.FolderName.ToLower() == "hfd - users").FirstOrDefault();
            fileCount = 0;
            if (folder != null)
            {
                fileCount = tree.GetFileCountByFolder(fileManager.ToList(), folder.Id);
            }
        }
        @if (fileCount > 0)
        {
            <h3>Draft (@fileCount)</h3>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        @if (folder != null)
                        {
                            <input type="button" value="++" title="Expand All" onclick="$('#tree_draft').jstree('open_all');">
                            <input type="button" value="--" title="Collapse All" onclick="$('#tree_draft').jstree('close_all');">
                            <br />
                            <div style="width:100%;" id="tree_draft">
                                <ul>
                                    <li style="font-size: 12px !important;">
                                        <a href="javascript:void(0)" onclick="DownloadFolder(@folder.Id, @folder.ObjectId)" title="Download">@folder.FolderName &nbsp;&nbsp;<span class="glyphicon glyphicon-download-alt"></span></a>
                                        @Html.Raw(tree.GetAttachmentTreeNode(folders, folder.Id))
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div>No Draft</div>
                        }
                    </div>
                </div>
            </div>
        }
        @{
            folders = fileManager.Where(w => w.FolderType.ToLower() == "outgoing").ToList();
            folder = folders.Where(w => w.ParentFolder == null || w.ParentFolder == "").FirstOrDefault();
            fileCount = 0;
            if (folder != null)
            {
                fileCount = tree.GetFileCountByFolder(fileManager.ToList(), folder.Id);
            }
        }
        @if (fileCount > 0)
        {
            <h3>Outgoing (@fileCount)</h3>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        @if (folder != null)
                        {
                            <input type="button" value="++" title="Expand All" onclick="$('#tree_outgoing').jstree('open_all');">
                            <input type="button" value="--" title="Collapse All" onclick="$('#tree_outgoing').jstree('close_all');">
                            <br />
                            <div style="width:100%;" id="tree_outgoing">
                                <ul>
                                    <li style="font-size: 12px !important;">
                                        <a href="javascript:void(0)" onclick="DownloadFolder(@folder.Id, @folder.ObjectId)" title="Download">@folder.FolderName &nbsp;&nbsp;<span class="glyphicon glyphicon-download-alt"></span></a>
                                        @Html.Raw(tree.GetAttachmentTreeNode(folders, folder.Id))
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div>No Outgoing</div>
                        }
                    </div>
                </div>
            </div>
        }
        @{
            folders = fileManager.Where(w => w.FolderType.ToLower() == "acknowledgement").ToList();
            folder = folders.Where(w => w.FolderName.ToLower() == "acknowledgement").FirstOrDefault();
            fileCount = 0;
            if (folder != null)
            {
                fileCount = tree.GetFileCountByFolder(fileManager.ToList(), folder.Id);
            }
        }
        @if (fileCount > 0)
        {
            <h3>Acknowledgement (@fileCount)</h3>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        @if (folder != null)
                        {
                            <input type="button" value="++" title="Expand All" onclick="$('#tree_ack').jstree('open_all');">
                            <input type="button" value="--" title="Collapse All" onclick="$('#tree_ack').jstree('close_all');">
                            <br />
                            <div style="width:100%;" id="tree_ack">
                                <ul>
                                    <li style="font-size: 12px !important;">
                                        <a href="javascript:void(0)" onclick="DownloadFolder(@folder.Id, @folder.ObjectId)" title="Download">@folder.FolderName &nbsp;&nbsp;<span class="glyphicon glyphicon-download-alt"></span></a>
                                        @Html.Raw(tree.GetAttachmentTreeNode(folders, folder.Id))
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div>No Acknowledgement</div>
                        }
                    </div>
                </div>
            </div>
        }
        @{
            folders = fileManager.Where(w => (w.FolderType == null || w.FolderType.Trim() == "") && (w.ParentFolder == null || w.ParentFolder == "")).ToList();
            fileCount = 0;
            foreach (var _folder in folders)
            {
                if (_folder != null)
                {
                    fileCount = fileCount + tree.GetFileCountByFolder(fileManager.ToList(), _folder.Id);
                }
            }
        }
        @if (fileCount > 0)
        {
            <h3>Attached Folders (@fileCount)</h3>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <input type="button" value="++" title="Expand All" onclick="$('#tree_atmt').jstree('open_all');">
                        <input type="button" value="--" title="Collapse All" onclick="$('#tree_atmt').jstree('close_all');">
                        <br />
                        <div style="width:100%;" id="tree_atmt">
                            <ul>
                                @foreach (var _folder in folders)
                                {
                                    <li style="font-size: 12px !important;">
                                        @*<a href="javascript:void(0)" onclick="DownloadFolder(@_folder.Id, @_folder.ObjectId)" title="Download">@_folder.FolderName &nbsp;&nbsp;<span class="glyphicon glyphicon-download-alt"></span></a>
                                            @Html.Raw(tree.GetAttachmentTreeNode(fileManager, _folder.Id))*@
                                        <a href="javascript:void(0)" onclick="DownloadFolderByFolder(@_folder.Id, @_folder.ObjectTypeId, @_folder.RecordId, @_folder.DocumentId)" title="Download">@_folder.FolderName &nbsp;<span class="glyphicon glyphicon-download-alt"></span></a>
                                        @Html.Raw(tree.GetAttachmentTreeNode(fileManager, _folder.Id))
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }

        @{
			var attachedFiles = Model.AttachedFiles
				.Where(doc => doc.FileOption == "FILEMANAGER" || doc.FileOption == "UPLOAD")
				.ToList();
		}
		@if (attachedFiles.Count > 0)
		{
			<h3>Attached Files (@attachedFiles.Count)</h3>
			<div>
				<div class="panel panel-primary">
					<div class="panel-body">
						@if (@attachedFiles.Count > 0)
						{
							<div style="width:100%;">
								<ul>
									@foreach (var doc in attachedFiles)
									{
										if (doc.FileOption == "FILEMANAGER" || doc.FileOption == "UPLOAD")
										{
											@*@Html.ActionLink(doc.Name, "GetFile", "Task", routeValues: null, htmlAttributes: new { Id = new Trinergy.Helper.EncryptionHelper().Encrypt(doc.Id.ToString()) })*@
											var idToEncrypt = doc.Id.ToString();
											var encryptedId = idToEncrypt != null ? new Trinergy.Helper.EncryptionHelper().Encrypt(idToEncrypt) : null;
											<li style="font-size: 12px !important;">
												@*@Html.ActionLink(doc.FullFileName, "GetFile", "Task",
													routeValues: new { id = encryptedId },
													  htmlAttributes: null
													   )*@
												@{
													var fileUrl = Url.Action("GetFile", "Task") + "?id=" + HttpUtility.UrlEncode(encryptedId);
												}

												<a href="@fileUrl">@doc.FullFileName</a>

											</li>
										}
									}
								</ul>
							</div>
						}
						else
						{
							<div>No Linked Documents</div>
						}
					</div>
				</div>
			</div>
		}

		@{
			var linkedDocs = Model.AttachedFiles.Where(doc => doc.FileOption == "LinkToPMWebRecord").ToList();
		}
		@if (linkedDocs.Count > 0)
		{
			<h3>Attached PMWeb Document Links (@linkedDocs.Count)</h3>
			<div>
				<div class="panel panel-primary">
					<div class="panel-body">
						@if (@linkedDocs.Count > 0)
						{
							<div style="width:100%;">
								<ul>
									@foreach (var doc in linkedDocs)
									{
										if (doc.FileOption == "LinkToPMWebRecord")
										{
											<li style="font-size: 12px !important;">
												@*<a href="PMWeb/CustomForms.aspx?TypeId=@doc.LinkedRecordTypeId&Id=@doc.LinkedRecordId&ModuleId=2&PageId=80" title="@doc.Description" target="_blank">@doc.Description</a>*@
												<a href=@doc.DownloadLink title="@doc.DocType" target="_blank">@doc.DocType</a>
											</li>
										}
									}
								</ul>
							</div>
						}
						else
						{
							<div>No Linked Documents</div>
						}
					</div>
				</div>
			</div>
		}


		@{
			var wssFiles = Model.AttachedFiles
				.Where(doc => doc.FileOption == "WSS" || doc.FileOption == "URL")
				.ToList();
		}
		@if (wssFiles.Count > 0)
		{
			<h3>Other Document Links (@wssFiles.Count)</h3>
			<div>
				<div class="panel panel-primary">
					<div class="panel-body">
						@if (@wssFiles.Count > 0)
						{
							<div style="width:100%;">
								<ul>
									@foreach (var doc in wssFiles)
									{
										if (doc.FileOption == "WSS" || doc.FileOption == "URL")
										{
											<li style="font-size: 12px !important;">

												<a href=@doc.URLv title="@doc.Name" target="_blank">@doc.Name</a>
											</li>
										}
									}
								</ul>
							</div>
						}
						else
						{
							<div>No Linked Documents</div>
						}
					</div>
				</div>
			</div>
		}

        <p style="font-weight: bold;margin-top: 10px;font-size: 11px;">
            Note: The folders will appear once the documents are uploaded in the respective folder and also based on the folder security.
        </p>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#accordion").accordion({
            header: "h3",
            collapsible: true,
            autoHeight: false,
            navigation: true,
            heightStyle: "content"
        });
        $('#tree').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });
        $('#tree_draft').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });
        $('#tree_outgoing').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });
        $('#tree_ack').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });
        $('#tree_atmt').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });
    });
</script>