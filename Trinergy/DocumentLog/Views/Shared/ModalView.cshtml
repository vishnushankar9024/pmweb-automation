@if ((bool)ViewBag.IsUserVisited == false)
{
<div id="documentLogModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" style="min-width:50%;">
        <!-- Modal content-->
        <div class="modal-content" style="width:100%;">
            <div class="modal-header">
                <button type="button" class="btn btn-danger modal-close" data-dismiss="modal">Close</button>
                <h4 class="modal-title text-center" style="font-size:24px;">Document Log (new version)</h4>
            </div>
            <div class="modal-body" style="max-height:400px; overflow:auto;font-size:20px;">
                Dear @ViewBag.UserName,<br /><br />
                We are happy to announce the new release of the Document Log version 2.0 with additional features.<br /><br />
                Kindly click <a href="@Url.Action("GetUserGuide", "Task", new { folderName = "Document Log" })" target="_blank" class="k-button btn btn-primary badge-active">Help&nbsp;&nbsp;<i class="fa fa-question-circle" aria-hidden="true"></i></a> to view the new features and capabilities of the new Document Log.<br /><br />
                Thank you<br />
                PMWeb Team
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div id="actionCenterModal" class="modal fade" role="dialog">
