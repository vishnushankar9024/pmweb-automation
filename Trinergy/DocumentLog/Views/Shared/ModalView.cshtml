<div id="attachmentModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" style="min-width:80%">
        <!-- Modal content-->
        <div class="modal-content" style="width:100%;">
            <div class="modal-header">
                <button type="button" class="btn btn-danger modal-close" data-dismiss="modal">Close</button>
                <h4 class="modal-title">Attachments</h4>
            </div>
            <div class="modal-body" style="max-height:400px; overflow:auto;">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>
<div id="pmwebModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg" style="min-width:95%; height:750px;">
        <!-- Modal content-->
        <div class="modal-content" style="width:100%;">
            <div class="modal-header">
                <button type="button" class="btn btn-danger modal-close" data-dismiss="modal">Close</button>
                <h4 class="modal-title">&nbsp;</h4>
                <h4 class="modal-title" style="font-weight:bold;display:none;"></h4>
                <div id="projectDetails" style="margin-top:10px;display:none;">
                    <div class="row">
                        <div class="col-md-2">
                            <strong>Record #:</strong> <span id="modalRecordNo"></span>
                        </div>
                        <div class="col-md-3">
                            <strong>Incoming Reference:</strong> <span id="modalReferenceNo"></span>
</div>
                        <div class="col-md-6">
                            <strong>Subject:</strong> <span id="modalSubject"></span>
</div>
                    </div>
                </div>
            </div>
            <div class="modal-body" style="overflow:auto">
                <div class="lds-ring"><div></div><div></div><div></div><div></div></div>
            </div>
            @*<div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>*@
        </div>

    </div>
</div>
