    <style>
        #pleaseWaitDialog .center {
            position: absolute;
            top: 50%;
            left: 50%;
            margin: -50px 0px 0px -50px;
        }
    </style>
    <script type="text/javascript">
        var tab = 'RE';
        @if (Model.FieldSecurity.Where(w => w.FieldName == "Real_Estate").Any())
         {
             <text>
            tab = 'RE'
        </text>
        }
        else if(Model.FieldSecurity.Where(w => w.FieldName == "Engineering").Any())
        {
        <text>
        tab = 'AB'
        </text>
        }
        function SwitchTab(param) {
            tab = param;
            if (param == 'RE') {
                $('#reportFramePanel').hide();
                $('#RealEstate').show();
                $('#map').show();
                $('#mapReport').show();
                $('#mapReportFrame').show();
            }
            else {
                $('#reportFramePanel').show();
                $('#RealEstate').hide();
                $('#map').hide();
                $('#mapReport').hide();
                $('#mapReportFrame').hide();
            }
        }
    </script>
</head>
<body class="materialdesign">
    <!--[if lt IE 8]>
            <p class="browserupgrade">You are using an <strong>outdated</strong> browser. Please <a href="http://browsehappy.com/">upgrade your browser</a> to improve your experience.</p>
        <![endif]-->
    <!-- Header top area start-->
    <div class="wrapper-pro">
        <div class="left-sidebar-pro">
            <nav id="sidebar">
                <div class="left-custom-menu-adp-wrap">
                    <div class="search">
                        <input type="text" placeholder="Search..." class="form-control">
                        <a href="javascript:void(0)"><i class="fa fa-search"></i></a>
                        <a href="javascript:void(0)" id="btnAssetClearAll" style="left:215px;"><i class="fa fa-refresh"></i></a>
                    </div>
                    <div id='cssmenu' class="asset-cssmenu">
                        <ul>
                            @foreach (var property in Model.Asset_Properties.OrderBy(o => o.Code))
                            {
                                var buildings = Model.Asset_Buildings.Where(w => w.PropertyId == property.Id).OrderBy(o => o.Code);
                                <li>
                                    <a href='#' onclick="LoadReport('PROPERTY', @property.Id, '@property.Name', @property.Id)"><span>@property.Name</span><span class="cnt">@buildings.Count()</span></a>

                                    @if (buildings.Any())
                                    {
                                        <ul>
                                            @foreach (var building in buildings)
                                            {
                                                var floors = Model.Asset_Floors.Where(w => w.BuildingId == building.Id).OrderBy(o => o.Code);
                                                <li class="asset-inner">
                                                    <a href='#' onclick="LoadReport('BUILDING', @building.Id, '@(property.Name + " - " + building.Name)', @property.Id)"><span>@building.Name</span><span class="cnt">@floors.Count()</span></a>
                                                    @if (floors.Any())
                                                    {
                                                        <ul>
                                                            @foreach (var floor in floors)
                                                            {
                                                                <li>
                                                                    <a href='#' onclick="LoadReport('FLOOR', @floor.Id, '@(property.Name + " - " + building.Name + " - " + floor.Name)', @property.Id, @building.Id)"><span>@floor.Name</span></a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </li>

                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
        <!-- Header top area start-->
        <div class="content-inner-all">
            <div class="header-top-area">
                <div class="fixed-header-top">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-9">
                                <div class="header-top-menu tabl-d-n">
                                    <ul class="nav navbar-nav mai-top-nav nav-asset">
                                        @if (Model.FieldSecurity.Where(w => w.FieldName == "Real_Estate").Any())
                                        {
                                            <li class="nav-item active">
                                                <a href="javascript:void(0)" data-tab="Home" onclick="SwitchTab('RE')" class="nav-link">Real Estate</a>
                                            </li>
                                        }
                                        @if (Model.FieldSecurity.Where(w => w.FieldName == "Engineering").Any())
                                        {
                                            <li class="nav-item">
                                                <a href="javascript:void(0)" data-tab="Home" onclick="SwitchTab('AB')" class="nav-link">Engineering</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-3 welcome-note">
                                Welcome, @Session["PMWebUserFullName"].ToString() &nbsp;&nbsp; <a href="@Url.Action("Logout")"><i class="fa fa-power-off"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="admintab-area">
                <div class="container-fluid">
                    <div id="realEstate">
                        <div class="row">
                            <div style="float:left;width:calc(100% - 580px);margin-left:20px;">
                                <div id="map" style="height: 800px; width:100%"></div>
                            </div>
                            <div class="mapReport" style="width:550px; float:right">
                                <iframe id="mapReportFrame" frameborder="0" style="width:100%;margin-top:-8px;"></iframe>
                            </div>
                        </div>
                        <div class="row" id="reportFramePanel">
                            <div class="col-lg-12">
                                <iframe id="reportFrame" frameborder="0" style="width:100%;"></iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer Start-->
    <div class="footer-copyright-area">
        <div class="container-fluid">
            <div class="row">
