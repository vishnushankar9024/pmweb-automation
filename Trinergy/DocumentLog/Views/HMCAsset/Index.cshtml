    <!-- main JS
        ============================================ -->
    <script src="~/Content/admin-pro/js/main.js?_@(new Random().Next())"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#reportFramePanel').hide();
            var height = ($(document).height() - 150) + "px";
            $("#reportFramePanel").css({ "height": height });
            $("#cssmenu > ul > li > a:eq(0)").click();
            $(".nav-asset .nav-link:eq(0)").click();
        });
        function LoadReport(type, id, name, propertyId, floorId = 0) {
            if(tab == 'RE')
            {
                var mapCenterData = mapCenter["mapcenter_"+ type.toLowerCase() + "_" +id];
                if(mapCenterData && markers["marker_"+type.toLowerCase() + "_" +id])
                {
                    for(var window in infoWindows){
                        infoWindows[window].close();
                    }
                    map.setZoom(9);
                    map.panTo(markers["marker_"+type.toLowerCase() + "_" +id].getPosition());
                    map.setZoom(parseInt(mapCenterData.ZoomLevel));
                    infoWindows["infowindow_" + type.toLowerCase() + "_" + id].open(map,  markers["marker_"+type.toLowerCase() + "_" +id]);
                }
            }
            $("#pleaseWaitDialog").show();
            iframe = $("#reportFrame");
            //iframe.hide();
            var height = ($(document).height() - 250) + "px";
            $("#reportFramePanel").css({ "height": height });
            iframe.attr({
                width: '80%',
                height: height,
                src: '@Url.Content("~/WebForms/AssetReportViewer.aspx")?_=@(new Random().Next())&DocType=' + type + '&DocId=' + id + '&Name=' + name + '&propertyId=' + propertyId
            });
            iframe.on("load", function () {
                //iframe.show();
                $("#pleaseWaitDialog").hide();
            });

            //Map Report
            var mType = 0;
            iframe = $("#mapReportFrame");
            iframe.hide();
            if(type == 'PROPERTY')
            {
                mType = 1;
            }
            else if(type == 'BUILDING')
            {
                mType = 2;
            }
            else if(type == 'FLOOR')
            {
                mType = 3;
            }
            if(mType != 0 && tab == 'RE')
            {
                var campusIdxId = mType == 3 ? floorId : id;

                iframe.attr({
                    width: '100%',
                    height: height,
                    src: '@Url.Content("~/WebForms/AssetMapReportViewer.aspx")?_=@(new Random().Next())&Type=' + mType + '&Campus=' + (mType == 1 ? id : campusId[campusIdxId]) + '&Building=' + campusIdxId + '&Floor=' + (mType == 3 ? id : 0)
                });
                iframe.on("load", function () {
                    iframe.show();
                    $("#pleaseWaitDialog").hide();
                });
            }
        }
        var markers = [];
        var mapCenter = [];
        var infoWindows = [];
        var campusId = [];
        function initMap() {
            var myLatLng = { lat: 25.2841478, lng: 51.441957 };
            map = new google.maps.Map(document.getElementById('map'), {
                zoom: 9,
                center: myLatLng,
                mapTypeId: google.maps.MapTypeId.SATELLITE
            });
            @foreach(var property in Model.Asset_Properties)
            {
                if (!string.IsNullOrEmpty(property.Latitude) && !string.IsNullOrEmpty(property.Longitude))
                {
                    <text>
            var pos = {lat:@property.Latitude, lng:@property.Longitude};
            mapCenter["@("mapcenter_property_" + property.Id)"] = {
                center: '@property.MapCenter',
                ZoomLevel: '@property.ZoomLevel'
            }
            markers["@("marker_property_" + property.Id)"] = new google.maps.Marker({
                position: pos,
                map: map,
                title: '@property.Name',
                icon : '@Url.Content("~/Content/Images/GMarker.png")',
            });
            var contentString = '<div style="font-family: sans-serif;"><div style="font-weight: bold;color:#0178ba;">Name: @property.Name </div><br />Area: @property.LinearArea</div>';

            infoWindows["@("infowindow_property_" + property.Id)"] = new google.maps.InfoWindow({
                content: contentString
            });
            markers["@("marker_property_" + property.Id)"].addListener('click', function() {
                LoadReport('PROPERTY', '@property.Id', '@property.Name');
                @*for(var window in infoWindows){
                    infoWindows[window].close();
                }
                map.panTo( markers["@("marker_property_" + property.Id)"].getPosition());
                map.setZoom(parseInt('@property.ZoomLevel'));
                infoWindows["@("infowindow_property_" + property.Id)"].open(map,  markers["@("marker_property_" + property.Id)"]);

                iframe = $("#mapReportFrame");
                iframe.attr({
                    width: '100%',
                    src: '@Url.Content("~/WebForms/AssetMapReportViewer.aspx")?_=@(new Random().Next())&Type=' + 1 + '&Campus=@(property.Id)&Building=0'
                });
                iframe.on("load", function () {
                    $("#pleaseWaitDialog").hide();
                });*@
            });
            </text>
                }
                foreach(var building in Model.Asset_Buildings.Where(w => w.PropertyId == property.Id))
                {
                    <text>
            campusId[@building.Id] = @property.Id;
            </text>
                }
            }
            @foreach(var building in Model.Asset_Buildings)
            {
                if (!string.IsNullOrEmpty(building.Latitude) && !string.IsNullOrEmpty(building.Longitude))
                {
                    <text>
            mapCenter["@("mapcenter_building_" + building.Id)"] = {
                center: '@building.MapCenter',
                ZoomLevel: '@building.ZoomLevel'
            }
            var pos = {lat:@building.Latitude, lng:@building.Longitude};
            markers["@("marker_building_" + building.Id)"] = new google.maps.Marker({
                position: pos,
                map: map,
                title: '@building.Name',
                icon : '@Url.Content("~/Content/Images/GMarker.png")',
            });
            var contentString = '<div style="font-family: sans-serif;"><div style="font-weight: bold;color:#0178ba;">Name: @building.Name</div>Area: @building.LinearArea</div>';

            infoWindows["@("infowindow_building_" + building.Id)"] = new google.maps.InfoWindow({
                content: contentString
            });
            markers["@("marker_building_" + building.Id)"].addListener('click', function() {
                LoadReport('BUILDING', '@building.Id', '@building.Name');
                @*for(var window in infoWindows){
                infoWindows[window].close();
            }
            map.panTo( markers["@("marker_building_" + building.Id)"].getPosition());
            map.setZoom(parseInt('@building.ZoomLevel'));
            infoWindows["@("infowindow_building_" + building.Id)"].open(map,  markers["@("marker_building_" + building.Id)"]);
            iframe = $("#mapReportFrame");
            iframe.attr({
                width: '100%',
                height: height,
                src: '@Url.Content("~/WebForms/AssetMapReportViewer.aspx")?_=@(new Random().Next())&Type=' + 2 + '&Campus=' + campusId[@building.Id] + '&Building=@(building.Id)'
            });
            iframe.on("load", function () {
                $("#pleaseWaitDialog").hide();
            });*@

            });
            </text>
                    foreach(var floor in Model.Asset_Floors.Where(w => w.BuildingId == building.Id))
                    {
                        <text>
            mapCenter["@("mapcenter_floor_" + floor.Id)"] = {
                center: '@building.MapCenter',
                ZoomLevel: '@building.ZoomLevel'
            }
            </text>
                    }
                }
            }
        }
    </script>
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA7tmyt19teo5g7yxeCLKL-8_AtcPjfyEE&libraries=drawing&callback=initMap">
    </script>
</body>

