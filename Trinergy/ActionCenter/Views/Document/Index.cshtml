        <div class="container">
            <div class="row">
                <div class="col-md-6"><h1 style="margin-top: 35px;">Document Uploader</h1></div>
                <div class="col-md-6 text-right"><img src="~/Content/Images/PMWebLogo.gif" style="width:350px;" /></div>

            </div>
            <div class="row">
                <div class="col-md-8">
                    <div class="panel panel-default">
                        <div class="panel-heading"><h4>Forms</h4></div>
                        <div class="panel-body">
                            <div id="treeFrom" style="width:100%; height:250px; overflow:auto">
                                @Html.Raw(tree.GetFormsTreeNode(Session["PMWebUser"].ToString()))
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading"><h4>Project Folders</h4></div>
                        <div class="panel-body">
                            <div id="tree" style="width:100%; height:250px; overflow:auto">
                                @*<ul>
                                    @{
                                        foreach (var project in new Trinergy.Data.ProjectDbContext().GetProjectsByUser("contdc"))
