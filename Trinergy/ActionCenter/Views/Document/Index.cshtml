                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="panel panel-default">
                        <div class="panel-heading"><h4>Document Uploader</h4></div>
                        <div class="panel-body">
                            <div class="form-group">
                                <div class="alert alert-info alert-dismissible fade show in" id="uploadFolder"><strong>Selected Folder:</strong><br /><span></span></div>
                                <label>Document: <small>(Please select a zip file to upload.)</small></label>
                                <input type="file" id="fileInput" class="btn btn-primary" accept="" />
                            </div>
                            <div class="form-group">
                                <input type="button" id="btnUpload" value="Upload Documents" class="btn btn-success" />
                            </div>
                            <div id="alert_placeholder"></div>
                            <div id="progressbar_container" style="width: 100%; height: 30px; position: relative; background-color: grey; display: none">
                                <div id="progressbar" style="width: 0%; height: 100%; position: absolute; background-color: green"></div>
                                <span id="progressbar_label" style="position: absolute; left: 45%; top: 20%">Uploading...</span>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div class="panel-heading"><h4>Pre-Requisites</h4></div>
                        <div class="panel-body">
                            <ul style="padding-left: 5px;">
                                <li>Do not refresh the page while processing the upload.</li>
                                <li>Page will automatically reload after the processing the upload.</li>
                                <li>Only zip files of folders and attachments can  be uploaded.</li>
                                <li>Select the right folder.</li>
                                <li>Only 2nd level folders are allowed to upload.</li>
                                <li>Other level folders are not allowed.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <div id="pleaseWaitDialog" class="modal" style="display: none">
        <div class="center">

            <img src="~/Content/Images/hamadwait.gif" alt="Loading, please wait" />
        </div>
    </div>
        <script type="text/javascript">
            var selectedFolder = "";
            var selectedForm = "";
            var selectedProjectId = "";
            var formTypeName = "";
            var isCorrectLevelFolder = false;
            var isCorrectLevelForm = false;


            $('#tree').jstree({
                'core': {
                    'themes': {
                        'name': 'proton',
                        'responsive': true
                    }
                }
            });
            $('#treeFrom').jstree({
                'core': {
                    'themes': {
                        'name': 'proton',
                        'responsive': true
                    }
                }
            });

            bootstrap_alert = function () { }
            bootstrap_alert.warning = function (message) {
                $('#alert_placeholder').html('<div class="alert alert-danger alert-dismissible fade show in"><a class="close" data-dismiss="alert" onclick="CloseAlert()">×</a><span>' + message + '</span></div>')
            }

            function CloseAlert() {
                $('#alert_placeholder').empty();
            }
            var timeStampInMs = "";
            var progressBarStart = function () {
                $("#progressbar_container").show();
            }

            var progressBarUpdate = function (percentage) {
                percentage = parseFloat(Math.round(percentage * 100) / 100).toFixed(2);
                $('#progressbar_label').html(percentage + "%");
                $("#progressbar").width(percentage + "%");
            }

            var progressBarComplete = function () {
                $("#progressbar_container").fadeOut(500);
            }

            var file;

            $('#fileInput').change(function (e) {
                file = e.target.files[0];
            });

            var uploadCompleted = function () {
                var formData = new FormData();
                formData.append('fileName', file.name);
                formData.append('completed', true);

                var xhr2 = new XMLHttpRequest();
                xhr2.onload = function () {
                    progressBarUpdate(100);
                    progressBarComplete();
                    location.reload(true)
                }
                xhr2.open("POST", '@Url.Action("UploadComplete", "Document")' + "?fileName=" + file.name + "&complete=" + 1 + "&folderName=" + timeStampInMs + "&parentId=" + selectedFolder + "&projectId=" + selectedProjectId + "&formId=" + selectedForm, true);
                xhr2.send(formData);
            }

            var multiUpload = function (count, counter, blob, completed, start, end, bytesPerChunk) {
                counter = counter + 1;
                if (counter <= count) {
                    var chunk = blob.slice(start, end);
                    var xhr = new XMLHttpRequest();
                    xhr.onload = function () {
                        start = end;
                        end = start + bytesPerChunk;
                        if (count == counter) {
                            uploadCompleted();
                            $('#progressbar_label').css("left", "30%");
                            $('#progressbar_label').html("Please wait while extracting files...");
                        } else {
                            var percentage = (counter / count) * 100;
                            progressBarUpdate(percentage);
                            multiUpload(count, counter, blob, completed, start, end, bytesPerChunk);
                        }
                    }
                    xhr.open("POST", '@Url.Action("MultiUpload", "Document")' + "?id=" + counter.toString() + "&fileName=" + file.name + "&folderName=" + timeStampInMs + "&_=" + Math.random(), true);
                    xhr.send(chunk);
                }
            }

            $("#btnUpload").click(function () {
                $('#alert_placeholder').empty();
                if (selectedFolder == "") {
                    bootstrap_alert.warning('<strong>Folder</strong> Kindly select a folder to upload.');
                    return;
                }
                if (isCorrectLevelForm == false)
                {
                    bootstrap_alert.warning('<strong>Form</strong> <br />Only forms are allowed to select.');
                    return;
                }
                if (isCorrectLevelFolder == false) {
                    bootstrap_alert.warning('<strong>Folder</strong> <br />Only 2nd level folders are allowed to upload.<br />Other level folders are not allowed.');
                    return;
                }
                CloseAlert();
                if (!file || !file.name) {
                    bootstrap_alert.warning('<strong>Document</strong> <br /> Kindly select a document to upload.');
                    return;
                }
                //var re = /(\.zip)$/i;
                //if (!re.exec(file.name)) {
                //    bootstrap_alert.warning('<strong>Document Type!</strong> <br /> Kindly upload the zip files.');
                //    return;
                //}
                timeStampInMs = window.performance && window.performance.now && window.performance.timing && window.performance.timing.navigationStart ? window.performance.now() + window.performance.timing.navigationStart : Date.now();
                timeStampInMs = Math.floor(timeStampInMs);
                var blob = file;
                var bytesPerChunk = 3750000;
                var size = blob.size;

                var start = 0;
                var end = bytesPerChunk;
                var completed = 0;
                var count = size % bytesPerChunk == 0 ? size / bytesPerChunk : Math.floor(size / bytesPerChunk) + 1;
                var counter = 0;
                $('#progressbar_label').css("left", "45%");
                progressBarStart();
                multiUpload(count, counter, blob, completed, start, end, bytesPerChunk);
            });

            //$("#tree").on("select_node.jstree", function (evt, data) {
            //    debugger;
            //    $('#alert_placeholder').empty();
            //    var folderId = $("#tree").jstree("get_selected");
            //    selectedFolder = folderId;
            //    var folders = data.node.text;
            //    var parentId = $("li#" + folderId).attr("parent-id");
            //    var parent;
            //    var i = 0;
            //    while (parentId != 0) {
            //        parent = $("li#" + parentId);
            //        folders = ($("a:eq(0)", parent).text() + " => " + folders);
            //        parentId = parent.attr("parent-id");
            //        i++;
            //    }
            //    isCorrectLevelFolder = false;
            //    selectedProjectId = '';

            //    if (i == 2) {
            //        isCorrectLevelFolder = true;
            //        selectedProjectId = parent.attr("project-id");
            //    }
            //    $("#uploadFolder span").html(folders);
            //});


            $("#treeFrom").on("select_node.jstree", function (evt, data) {
                debugger;
                //$('#alert_placeholder').empty();
                var formId = $("#treeFrom").jstree("get_selected");
                selectedForm = formId;
                var folders = data.node.text;
                formTypeName = folders;
                var parentId = $("li#" + formId).attr("parent-id");
                var parent;
                var i = 0;
                while (parentId != 0) {
                    parent = $("li#" + parentId);
                    parentId = parent.attr("parent-id");
                    i++;
                }
                isCorrectLevelForm = false;

                if (i == 1) {
                    isCorrectLevelForm = true;
                    selectedProjectId = $("li#" + formId).attr("project-id");
                    var url = '@Url.Action("GetProjectFolders", "Document")'
                    $("#tree").html('');
                    $.ajax({
                        url: url,
                        dataType: "html",
                        type: "GET",
                        contentType: 'application/json;charset=utf-8',
                        data: { projectId: selectedProjectId},
                        beforeSend: function () {
                            $('#pleaseWaitDialog').modal();
                        },
                        complete: function () {
                            $('#pleaseWaitDialog').modal('hide');
                        },
                        async: true,
                        cache: false,
                        success: function (data) {
                            debugger;
                            $('#tree').jstree('destroy');
                            $("#tree").html(data);
                            $('#tree').jstree({
                                'core': {
                                    'themes': {
                                        'name': 'proton',
                                        'responsive': true
                                    }
                                }
                            });
                            $("#tree").on("select_node.jstree", function (evt, data) {
                                debugger;
                                $('#alert_placeholder').empty();
                                var folderId = $("#tree").jstree("get_selected");
                                selectedFolder = folderId;
                                var folders = data.node.text;
                                var parentId = $("li#" + folderId).attr("parent-id");
                                var parent1;
                                var j = 0;
                                while (parentId != 0) {
                                    parent1 = $("li#" + parentId);
                                    folders = ($("a:eq(0)", parent1).text() + " => " + folders);
                                    parentId = parent1.attr("parent-id");
                                    j++;
                                }
                                isCorrectLevelFolder = false;
                                
                                if (j == 2) {
                                    isCorrectLevelFolder = true;
                                }
                                isCorrectLevelFolder = true;
                                $("#uploadFolder span").html(folders);
                            });
                        },
                        error: function (xhr) {
                            //alert("failed");
                        }
                    });
                }
                //$("#uploadFolder span").html(folders);
            });
        </script>
</body>
</html>
