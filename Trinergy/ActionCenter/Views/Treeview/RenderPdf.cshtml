    <style type="text/css">
        #pdfbox {
            width: 100%;
            height: 800px;
            border: 5px solid #ccc;
        }
    </style>

    <object id='pdfbox' type="application/pdf" data="@Url.Action("GetFile",routeValues:new { guid = ViewData["Guid"].ToString()})">
        Click @Html.ActionLink("here", "GetFile", routeValues: new { guid = ViewData["Guid"].ToString() }, htmlAttributes: new { }) to view the file.
    </object>
