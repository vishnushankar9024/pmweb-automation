<script type="text/javascript">

    $(document).ready(function () {
        LoadActiveDocs();
    });

    function LoadActiveDocs() {
        $.ajax({
            url: '@Url.Action("PendingDocsByRole", "Task")?role=@ViewBag.Role',
            dataType: "html",
            type: "GET",
            contentType: 'application/json;charset=utf-8',
            //data: { statusID: 1 },
            beforeSend: function () {
                $('#pleaseWaitDialog').modal();
            },
            complete: function () {
                $('#pleaseWaitDialog').modal('hide');
            },
            async: true,
            cache: false,
            success: function (data) {
                $('#divListAD').html(data);
            },
            error: function (xhr) {

            }
        });


    }
    function DownloadFolder(FolderId, DocId) {
        debugger;
        $.ajax({
            url: '@Url.Action("DownloadFolder", "DocumentLog")',
            dataType: "html",
            type: "GET",
            contentType: 'application/json;charset=utf-8',
            data: { FolderId: FolderId, DocId: DocId },
            beforeSend: function () {
                $('#pleaseWaitDialog').modal();
            },
            complete: function () {
                $('#pleaseWaitDialog').modal('hide');
            },
            async: true,
            cache: false,
            success: function (data) {
                debugger;
                var json = JSON.parse(data)
                var newWin = window.open(json.downloadLink, "_blank");
                if (!newWin || newWin.closed || typeof newWin.closed == 'undefined') {
                    alert('Disable popup blocker to download.');
                }
            },
            error: function (xhr) {
                //alert("failed");
            }
        });
    }

    function CloseSubReport() {
        $(".tempRow").remove();
    }
</script>