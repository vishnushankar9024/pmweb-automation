@model IEnumerable<Trinergy.Model.WorkflowStatus>
@{
    Layout = null;
}
<div style="width:50%">
    <div class="text-right"><a href="javascript:void(0)" title="Close" onclick="CloseSubReport();" style="color:red"><span class="glyphicon glyphicon-remove"></span></a></div>
    <table class="table table-bordered table-striped grid">
        <thead>
            <tr class="subReportHeader">
                <th>Step #</th>
                <th>Role Name</th>
                <th>Action Date</th>
                <th>Action Time</th>
                <th>Action By</th>
                <th>Action Type</th>
                <th>Comments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var workflow in Model)
            {
                string bckclr = "";
                if (workflow.PendingStatus == true)
                {
                    bckclr = "background-color:orange";
                }
                <tr style="@bckclr">
                    <td>@workflow.StepNumber</td>
                    <td>@workflow.RoleName</td>
                    <td>@workflow.ActionDate.ToString("dd-MMM-yy")</td>
                    <td>@workflow.ActionTime.ToString("hh:mm tt")</td>
                    <td>@workflow.ActionBy</td>
                    <td>@workflow.ActionType</td>
                    <td>@workflow.Comments</td>
                </tr>
            }
            @if (Model.Count() == 0)
            {
                <tr>
                    <td colspan="7">No Records Found</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script type="text/javascript">
    function CloseSubReport() {
        $(".tempRow").remove();
    }
</script>