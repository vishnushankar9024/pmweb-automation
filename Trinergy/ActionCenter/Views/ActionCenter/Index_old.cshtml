    function LoadTimeSheets() {
        $.ajax({
            url: '@Url.Action("GetPendingTimesheet", "ActionCenter")',
            dataType: "html",
            type: "GET",
            contentType: 'application/json;charset=utf-8',
            //data: { statusID: 1 },
            //beforeSend: function () {
            //    $('#pleaseWaitDialog').modal();
            //},
            //complete: function () {
            //    $('#pleaseWaitDialog').modal('hide');
            //},
            async: true,
            cache: false,
            success: function (data) {
                $('#divListTS').html(data);
            },
            error: function (xhr) {

            }
        });
    }

    function LoadPendingDocs() {
        $.ajax({
            url: '@Url.Action("GetPendingDocs", "ActionCenter")',
            dataType: "html",
            type: "GET",
            contentType: 'application/json;charset=utf-8',
            //data: { statusID: 1 },
            beforeSend: function () {
                $('#pleaseWaitDialog').modal('show');
            },
            complete: function () {
                $('#pleaseWaitDialog').modal('hide');
            },
