@model PMWebHelper.ViewModel.ActionCenterViewModel
@{
    Layout = null;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Action Center</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="~/Scripts/tree/themes/proton/style.css" />
    <style>
        * {
            font-size: 14px;
        }

        .attachments {
            font-size: 12px !important;
        }

            .attachments .panel-heading {
                padding: 2px 15px !important;
            }

                .attachments .panel-heading h4 {
                    margin-top: 2px;
                    margin-bottom: 2px;
                }

            .attachments .col-md-6 {
                padding: 2px;
            }

            .attachments ul {
                padding: 0px;
                list-style: none;
            }

            .attachments .panel-body {
                padding: 5px 5px 5px 15px;
            }

                .attachments .panel-body .panel-body {
                    padding-left: 5px;
                }

            .attachments a {
                color: blue;
                text-decoration: underline;
            }

        .tdRed {
            background-color: red;
        }

        .tdGreen {
            background-color: green;
        }

        .tdTransparent {
            background-color: transparent;
        }

        .tdYellow {
            background-color: #e7b416;
        }

        .panel-heading {
            cursor: pointer;
        }

        .panel-title:after {
            /* symbol for "opening" panels */
            font-family: 'Glyphicons Halflings'; /* essential for enabling glyphicon */
            content: "\e113"; /* adjust as needed, taken from bootstrap.css */
            float: right; /* adjust as needed */
            color: grey; /* adjust as needed */
        }

        .panel-title.collapsed:after {
            /* symbol for "collapsed" panels */
            content: "\e114"; /* adjust as needed, taken from bootstrap.css */
        }
        .dt-buttons {
            padding-left:10px;
        }
        .panel-body {
            padding: 0px !important;
            padding-top:10px !important;
        }
        .header-strip {
            background-color: #FFF;
            padding: 5px;
        }
    </style>
    <style class="cp-pen-styles">
        ul.css-treeview {
            /*margin: 0px 0px 0px 20px;*/
            list-style: none;
            line-height: 2em;
            font-family: Arial;
        }

            ul.css-treeview li {
                font-size: 16px;
                position: relative;
            }

                ul.css-treeview li:before {
                    position: absolute;
                    left: -15px;
                    top: 0px;
                    content: '';
                    display: block;
                    border-left: 1px solid #ccc;
                    height: 1em;
                    border-bottom: 1px solid #ccc;
                    width: 10px;
                }

                ul.css-treeview li:after {
                    position: absolute;
                    left: -15px;
                    bottom: -7px;
                    content: '';
                    display: block;
                    border-left: 1px solid #ccc;
                    height: 100%;
                }

                ul.css-treeview li.root {
                    margin: 0px 0px 0px -20px;
                }

                    ul.css-treeview li.root:before {
                        display: none;
                    }

                    ul.css-treeview li.root:after {
                        display: none;
                    }

                ul.css-treeview li:last-child:after {
                    display: none;
                }

        .folder {
            margin-left: 0px !important;
            background-color: lightgrey;
            border: 1px solid #ffffff;
        }

        .actionhead {
            color: red;
            font-weight: bold;
        }

        button.dt-button, div.dt-button, a.dt-button {
            margin-right: 0px !important;
            margin-left: 5px !important;
            height: 25px;
        }

        .blink {
            animation: blink-animation 1s steps(5, start) infinite;
            -webkit-animation: blink-animation 1s steps(5, start) infinite;
        }
    </style>
</head>

<body>
    <div style="margin-top:10px;">
        <ul class="nav nav-tabs">
            <li class="active"><a href="#pendingdocuments">My pending documents</a></li>
            @if (Model.ShowTimesheet == true)
            {
                <li><a href="#timesheet">Time Sheet</a></li>
            }
            <li><a href="#documentstatus">Status of All documents</a></li>
            <li><a href="#actionedDocs">My Actioned Documents</a></li>
        </ul>
        <div class="tab-content">
            <div id="pendingdocuments" class="tab-pane fade in active">
                <div class="panel panel-default">
                    <div class="panel-body" id="divListPD"></div>
                </div>
            </div>
            @if (Model.ShowTimesheet == true)
            {
                <div id="timesheet" class="tab-pane fade">
                    <div class="panel panel-default">
                        <div class="panel-body" id="divListTS"></div>
                    </div>
                </div>
            }
            <div id="actionedDocs" class="tab-pane fade in active">
                <div class="panel panel-default">
                    <div class="panel-body" id="divListActionedDocs"></div>
                </div>
            </div>
        </div>
    </div>
    <div id="pleaseWaitDialog" class="modal" style="display: none">
        <div class="center">

            <img src="~/Content/Images/hamadwait.gif" alt="Loading, please wait" />
        </div>
    </div>
</body>
</html>
