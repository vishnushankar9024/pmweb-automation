        /* Style for the main overlay */
       

        /* Header row styling */
        .header-row {
            border-bottom: 2px solid #808080;
            margin-bottom: 10px;
            margin-left: -25px;
            margin-right: -25px;
            padding: 10px;
        }

        /* Close button styling */
        .close-button a {
            font-size: 20px;
            color: black;
            text-decoration: none;
        }

            .close-button a:hover {
                color: #ccc;
            }

        /* Category header styling */
        .category-header {
            margin-top: 2px;
            padding: 2px;
            background-color: #ecf9ec; 
            border-radius: 1px;
            font-family: InterVariable, "Work Sans", sans-serif; !important;
        }

            .category-header a {
                font-weight: bold;
                color: #fff;
                text-decoration: none;
            }

                .category-header a:hover {
                    color: #ffd700; /* Gold color on hover */
                }

        /* Collapsible content section styling */
        .collapsible-content {
            display: none; /* Hidden by default */
            margin-top: 1px;
            padding: 1px;
            background-color: #f8f9fa; /* Light grey background for collapsible content */
            border-radius: 1px;
        }

        /* Individual form row styling */
        .form-row {
            margin-bottom: 1px;
            padding: 2px;
            background-color: white; /* Very light grey background for each form row */
            /*border-bottom: 1px solid #ccc;*/
            border-radius: 1px;
            font-family: InterVariable, "Work Sans", sans-serif; !important;
        }

        /* Styling for form name text */
        .form-name {
            /*font-weight: bold;*/
            font-size: 12px;
            color: #333;
        }

        /* Create button styling */
        .badge-active {
            color: #fff;
            background-color: #04AA6D !important;
            font-family: InterVariable, "Work Sans", sans-serif; !important;
            border: none;
            padding: 4px 7px;
            font-size: 12px;
            border-radius: 3px;
            text-decoration: none;
        }

            .badge-active:hover {
                background-color: #218838; /* Darker green on hover */
                color: #fff;
            }

    </style>
</head>

<body>
    @if (ViewBag.ControlCenter != null)
    {
        <div id="myNav" class="overlay">
            <div class="overlay-content">
                <!-- Header and Close Button -->
                <div class="row header-row">
                    <div class="col-9"><h3>Create New</h3></div>
                    <div class="col-3 text-right close-button">
                        <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">×</a>
                    </div>
                </div>

                <!-- Search Box for Filtering Form Names -->
                <div class="row">
                    <div class="col-12">
                        <input type="text" id="formSearch" onkeyup="searchForms()" placeholder="Search for forms..." class="form-control">
                    </div>
                </div>

                <!-- Collapsible Categories and Forms -->
                @foreach (var group in ((List<Trinergy.Model.ListForms>)ViewBag.ControlCenter).GroupBy(f => f.FormCategory))
                {
                    var collapseId = $"collapse-{group.Key.Replace(" ", "-")}";

                    <div class="row category-header" id="category-@collapseId">
                        <div class="col-12">
                            <a href="javascript:void(0);"
                               onclick="toggleCollapse('@collapseId')"
                               style="font-weight:100; color:#2d2d2d; text-decoration:none;">
                                @group.Key
                            </a>
                        </div>
                    </div>

                    <div id="@collapseId" class="collapsible-content" style="display: none;">
                        @foreach (var listForm in group)
                        {
                            <div class="row form-row" data-form-name="@listForm.DisplayName">
                                <div class="col-md-9 form-name">
                                    &plus; &nbsp; @listForm.DisplayName
                                </div>
                                <div class="col-md-3 text-right">
                                    <a href="@listForm.CreateLink" target="_top" class="btn btn-primary badge-active">Create</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }


