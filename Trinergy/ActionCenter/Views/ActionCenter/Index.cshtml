    @helper pendingDocumentsGrid()
    {
        @(Html.Kendo().Grid<Trinergy.Model.ActiveWFDocumentModel>()
            .Name("grid_PendingDocuments")
            .Columns(columns =>
            {
                //columns.Bound(c => c.Project).ClientGroupHeaderTemplate("<span class=\"group-header-project\">#: value # - (#:count#)</span>").Hidden(true).IncludeInMenu(false);
                columns.Bound(c => c.Project).ClientGroupHeaderTemplate("#: value # - (#:count#)").Hidden(true).IncludeInMenu(false);
                //columns.Bound(c => c.RecordType).ClientGroupHeaderTemplate("<span class=\"group-header-form\">#: value # - (#:count#)</span>").Hidden(true).IncludeInMenu(false);
                columns.Bound(c => c.RecordType).ClientGroupHeaderTemplate("#: value # - (#:count#)").Hidden(true).IncludeInMenu(false).HtmlAttributes(new { projectid = "#:ProjectId#" });
                columns.Bound(c => c.FileNames).Hidden(true).IncludeInMenu(false);
                columns.Bound(c => c.RecordNumber).Title("Record No.").HeaderTemplate("Record<br />No.").Width(150).Hidden(true).IncludeInMenu(true);
                columns.Bound(c => c.Reference).Title("Incoming Reference").HeaderTemplate("Incoming<br />Reference").Width(125);
                //columns.Bound(c => c.Description).Title("Subject")
                //            .ClientTemplate("<a href='javascript: void(0)' onclick=\"GetWorkflowStatus(#:DocumentId#, this)\">#:Description#</a>")
                //            .Width(225);
                columns.Bound(c => c.ProjectPhase).Title("Project Package").HeaderTemplate("Project<br/>Package")
                .Width(100);
                columns.Bound(c => c.Description).Title("Subject")
                           .Width(225);
                columns.Bound(c => c.ReceivedDate).Format("{0:dd-MMM-yy}").Title("Recipient Received Date").HeaderTemplate("Recipient<br/>Received<br/>Date").HtmlAttributes(new { @class = "text-center" }).Width(100);
                columns.Bound(c => c.DueDate).Format("{0:dd-MMM-yy}").Title("Recipient Due Date").HeaderTemplate("Recipient<br/>Due<br/>Date").HtmlAttributes(new { @class = "text-center" }).Width(100);
                columns.Bound(c => c.RemainingDays).Title("Remaining / Pending Days").HeaderTemplate("Remaining / <br/>Pending <br/>Days").HtmlAttributes(new { @class = "text-center" }).Width(120);
                columns.Bound(c => c.DocumentId).Title("Action").HtmlAttributes(new { @class = "text-center" })
                .ClientTemplate("<a href='javascript:void(0)' data-url='#:Recordurl#' class=\"action-link\" onclick=\"GetRecord('#:Recordurl#')\">Action</a>")
                    .Width(100);
                columns.Bound(c => c.OCSLink).Title("Links").HtmlAttributes(new { @class = "text-center" })
                    .ClientTemplate(
                        "#if(OCSLink != null) {#<a href='javascript:void(0)' data-url='#:OCSLink#' onclick=\"GetRecord('#:OCSLink#', true)\">OCS</a><div class=\"link-splitter\">&nbsp;</div>#}" +
