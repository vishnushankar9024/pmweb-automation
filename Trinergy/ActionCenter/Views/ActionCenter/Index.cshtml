    {
    tabs.Add().Text("My Pending Documents").Selected(true)
        .Content(@<text>@pendingDocumentsGrid()</text>);
    if (Model.ShowTimesheet == true)
    {
        tabs.Add().Text("Time Sheet").Content(@<text>@TimeSheet()</text>);
    }
    //tabs.Add().Text("Status of All Documents");
    tabs.Add().Text("My Actioned Documents").Content(@<text>@ActionedDocumentsGrid()</text>);
        if(((List<Trinergy.Model.ListForms>)ViewBag.ControlCenter).Count() > 0)
        {
            tabs.Add().Text("New Correspondence");
        }
        else
        {
            tabs.Add().Text("Create").HtmlAttributes(new { disabled="disabled"});
        }
    })
    .Events(e =>
    {
        e.Select("onTabSelect");
    })

    )
