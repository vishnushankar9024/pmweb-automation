    <script type="text/javascript">

        // Function to close (collapse) the entire overlay
        function closeNav() {
            var overlay = document.getElementById("myNav");
            overlay.style.display = "none"; // Hides the overlay                    
            document.getElementById("formSearch").value = '';
            searchForms();
            $("#myNav").animate({ height: "0%", opacity: "0" }, 100);
        }

        // Optional: Function to open (expand) the overlay if needed
        function openNav() {
            var overlay = document.getElementById("myNav");
            overlay.style.display = "block"; // Shows the overlay
            $("#myNav").animate({ height: "100%", opacity: "1" }, 10);
        }
        function searchForms() {
            var input = document.getElementById("formSearch").value.toLowerCase(); // Get search input
            var formRows = document.getElementsByClassName("form-row");
            var categories = document.getElementsByClassName("category-header");

            // Loop through all categories
            for (var i = 0; i < categories.length; i++) {
                var categoryId = categories[i].id.replace('category-', ''); // Get the category collapseId
                var formsInCategory = document.getElementById(categoryId).getElementsByClassName("form-row");
                var categoryHasMatchingForms = false;

                // Loop through all forms in the category
                for (var j = 0; j < formsInCategory.length; j++) {
                    var formName = formsInCategory[j].getAttribute("data-form-name").toLowerCase(); // Get form name from data attribute

                    // Check if the form name matches the search query
                    if (formName.includes(input)) {
                        formsInCategory[j].style.display = "flex"; // Show the matching form row
                        categoryHasMatchingForms = true; // Flag that this category has matching forms
                    } else {
                        formsInCategory[j].style.display = "none"; // Hide non-matching form row
                    }
                }

                // Show or hide the category header based on whether there are matching forms
                if (categoryHasMatchingForms) {
                    document.getElementById(categoryId).style.display = "block";
                } else {
                    document.getElementById(categoryId).style.display = "none";
                }
            }
        }
        function toggleCollapse(collapseId) {
            var element = document.getElementById(collapseId);
            if (element.style.display === "none") {
                element.style.display = "block";
            } else {
                element.style.display = "none";
            }
        }

        /*********************** Pending Documents Grid ********************************/
        var _dataId = 0;
        function GetPendingDocumentsData() {
            return {
                dataId: _dataId
            };
        }
        function onPendingDocumentsDataBound(e) {
            $("#btnCollapseExpand").val("Collapse All");
            var grid = e.sender;
            CheckSessionForGrid(grid);
            $('.comments').each(function (index) {
                var td = $(this).closest('td');
                var tr = $(td).closest('tr');
                var data = grid.dataItem(tr);
                $('a', td).remove();
                $('<a />', {
                    href: '#'
                })
                .text('More')
                .click(function (e) {
                    //GetWorkflowStatus(data.DocumentId, this)
                    GetRecord(data.WorkflowBIUrl)
                })
                .appendTo(td);
            });
            AddActionCenterBadge(e.sender.dataSource.data());
            $(".group-header-project").each(function () {
                $(this).closest("td").addClass("group-header-project");
            });
            $(".group-header-form").each(function () {
                $(this).closest("td").addClass("group-header-form");
            });

            setTimeout(InitDocumentCollapsedRows(e), 0);
            setTimeout(ChangePedningDaysCellColor(this, 11, 'RemainingDays'), 10);
            setTimeout(BindActionRightClick(e), 10);
        }
        function GetPendingDocuments(obj, __dataId) {

            $(".btn-badge").removeClass("badge-active");
            $(obj).addClass("badge-active");

            _dataId = __dataId;
            $("#grid_PendingDocuments").data("kendoGrid").dataSource.read();
        }

        var exportFlag = false;
        function onPendingDocumentExcelExport(e) {
            if (!exportFlag) {
                e.sender.showColumn(0);
                e.sender.showColumn(1);

                e.sender.hideColumn(10);
                e.sender.hideColumn(11);
                e.sender.hideColumn(12);
                e.sender.hideColumn(13);
                e.sender.hideColumn(14);

                e.sender.showColumn(15);
                e.sender.showColumn(16);
                e.sender.hideColumn(17);

                e.sender.dataSource.group([]);
                e.preventDefault();
                exportFlag = true;
                setTimeout(function () {
                    e.sender.saveAsExcel();
                });
            } else {
                setTimeout(function () {
                    e.sender.dataSource.group([{ field: "Project" }, { field: "RecordType" }]);

                    e.sender.hideColumn(0);
                    e.sender.hideColumn(1);

                    e.sender.showColumn(10);
                    e.sender.showColumn(11);
                    e.sender.showColumn(12);
                    e.sender.showColumn(13);
                    e.sender.showColumn(14);

                    e.sender.hideColumn(15);
                    e.sender.hideColumn(16);
                    e.sender.showColumn(17);

                }, 10);
                exportFlag = false;
            }
        }
        var exportActionedFlag = false;
        function onActionedDocumentExcelExport(e) {
            if (!exportActionedFlag) {
                e.sender.hideColumn(5);
                e.sender.showColumn(7);
                e.sender.hideColumn(9);

                e.preventDefault();
                exportActionedFlag = true;
                setTimeout(function () {
                    e.sender.saveAsExcel();
                });
            } else {
                setTimeout(function () {
                    //e.sender.dataSource.group({ field: "Project" });
                    e.sender.showColumn(5);
                    e.sender.hideColumn(7);
                    e.sender.showColumn(9);
                });
                exportActionedFlag = false;
            }
        }
