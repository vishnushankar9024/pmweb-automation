            {
                columns.Bound(c => c.Project).Title("Project Name").ClientGroupHeaderTemplate("<span class=\"group-header-project\">#: value #</span>").Width(150);
                columns.Bound(c => c.FileNames).Hidden(true).IncludeInMenu(false);
                columns.Bound(c => c.RecordNumber).Title("Record No.").HeaderTemplate("Record<br />No.").Hidden(false).IncludeInMenu(true).Width(100);
                columns.Bound(c => c.Reference).Title("Incoming Reference").HeaderTemplate("Incoming<br />Reference").Hidden(true).IncludeInMenu(false)
                .Width(125);
                columns.Bound(c => c.ProjectPhase).Title("Project Package").HeaderTemplate("Project<br/>Package")
               .Width(100);
                //columns.Bound(c => c.Description).Title("Subject")
                //            .ClientTemplate("<a href='javascript: void(0)' onclick=\"GetWorkflowStatus(#:DocumentId#, this)\">#:Description#</a>");
                columns.Bound(c => c.Description).Title("Subject");
                columns.Bound(c => c.OCSLink).Title("Links").HtmlAttributes(new { @class = "text-center" })
                    .ClientTemplate("#if(OCSLink != null) " +
                    "{#<a href='javascript:void(0)' data-url='#:OCSLink#' class\"actionhead\" " +
                    "onclick=\"GetRecord('#:OCSLink#', true)\">OCS</a><div class=\"link-splitter\">&nbsp;</div>#} " +
                    "if(HasBI == true) {# <a href=\"javascript: void(0)\" onclick=\"GetRecord('#:BIUrl#')\">" +
                    "BI Report</a>#}#")
                    .Width(80);
                columns.Bound(c => c.ActionType).Title("My Action").HtmlAttributes(new { @class = "no-wrap" })
                .ClientTemplate("#:ActionType#<br />on #:ActionedDateFormated#")
                    .Width(120);
                columns.Bound(c => c.ActionedDateFormated).Title("My Action Date").Width(100).Hidden(true).IncludeInMenu(false);
                columns.Bound(c => c.CurrStepOwner).Title("Current Status")
                .ClientTemplate("#:CurrStepOwner#-<br /><a href='javascript:void(0)' data-url='#:Recordurl#' class\"actionhead\" onclick=\"GetRecord('#:Recordurl#')\">#:Status#</a>")
                    .Width(150);
                columns.Bound(c => c.DocumentId).Title("Attachments").HtmlAttributes(new { @class = "text-center" })
               .ClientTemplate("<a href='javascript: void(0)' onclick=\"GetAttachments(#:DocumentId#, this)\">Attachments</a>")
