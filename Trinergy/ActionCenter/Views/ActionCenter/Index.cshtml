                        "if(BusinessCaseSummaryLink != null && BusinessCaseSummaryLink != '') {#<br /><a href='javascript:void(0)' data-url='#:BusinessCaseSummaryLink#' onclick=\"GetRecord('#:BusinessCaseSummaryLink#', true)\">Business Case Summary</a><div class=\"link-splitter\">&nbsp;</div>#}" +
                        "if(ProjectCharterLink != null && ProjectCharterLink != '') {#<a href='javascript:void(0)' data-url='#:ProjectCharterLink#' onclick=\"GetRecord('#:ProjectCharterLink#', true)\">Project Charter</a><div class=\"link-splitter\">&nbsp;</div>#}" +
                        "if(FacilitiesEvaluationReportLink != null && FacilitiesEvaluationReportLink != '') {#<a href='javascript:void(0)' data-url='#:FacilitiesEvaluationReportLink#' onclick=\"GetRecord('#:FacilitiesEvaluationReportLink#', true)\">Facilities Evaluation Report</a><div class=\"link-splitter\">&nbsp;</div>#}" +
                        "if(ScopeOfWorkLink != null && ScopeOfWorkLink != '') {#<a href='javascript:void(0)' data-url='#:ScopeOfWorkLink#' onclick=\"GetRecord('#:ScopeOfWorkLink#', true)\">Scope Of Work</a><div class=\"link-splitter\">&nbsp;</div>#}#"
                        )
                    .Width(100);
                columns.Bound(c => c.DocumentId).Title("Attachments").HtmlAttributes(new { @class = "text-center" })
                .ClientTemplate("<a href='javascript: void(0)' onclick=\"GetAttachments(#:DocumentId#, this)\">Attachments</a>")
                    .Width(120);
                columns.Bound(c => c.TeamInputRequestedTo).Encoded(false).Title("Team Input Request Pending With").HeaderTemplate("Team Input <br />Request<br />Pending With").Width(150);
                columns.Bound(c => c.TeamInputRepliedBy).Encoded(false).Title("Team Input Reply Received From").HeaderTemplate("Team Input <br />Reply Received<br />From").Width(150);
                columns.Bound(c => c.TeamInputRequestedToRaw).Encoded(false).Title("Team Input Request Pending With").Hidden(true).IncludeInMenu(false);
                columns.Bound(c => c.TeamInputRepliedByRaw).Encoded(false).Title("Team Input Reply Received From").Hidden(true).IncludeInMenu(false);
                columns.Bound(c => c.WorkflowComments).Title("Previous step workflow comments")
                .HeaderTemplate("Previous step workflow<br />comments").Encoded(false).Width(250);
                columns.Bound(c => c.ReplyStatus).Title("Document Status").HeaderTemplate("Document <br /> Status").Width(150).Hidden(false).IncludeInMenu(true);
            })
            .HtmlAttributes(new { style = "height: 700px;" })
            .Scrollable()
            .Groupable()
            .Sortable()
    //        .Filterable(filter =>
    //                filter.Mode(GridFilterMode.Menu)
    //                .Operators(ops => ops
    //                .ForString(str => str.Clear()
    //                    .Contains("Contains")
    //                    .StartsWith("Starts with")
    //                    )
    //                    .ForDate(dt => dt.Clear()
    //                    .IsGreaterThanOrEqualTo("is after or equal to")
    //                    .IsLessThanOrEqualTo("is before or equal to")
    //                    )
    //        )
    //)
    .Filterable()
    //.Pageable(p => p.Numeric(false).PreviousNext(false))
    .Pageable(p => p.Refresh(true))
    .AutoBind(true)
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(read => read.Action("GetPendingDocuments", "ActionCenter").Data("GetPendingDocumentsData"))
        .PageSize(100)
        .Batch(true)
        .Group(g =>
        {
            g.Add(c => c.Project);
            g.Add(c => c.RecordType);
        })
        .Aggregates(a =>
        {
            a.Add(c => c.Project).Count();
            a.Add(c => c.RecordType).Count();
        })
        .ServerOperation(true)
    )
    .Groupable(g =>
    {
        g.Enabled(false);
    })
    .Excel(e =>
    {
        e.FileName("Pending Document.xlsx");
        e.AllPages(true);
        e.Collapsible(true);
        e.Filterable(true);
    })
    .Events(e =>
    {
        e.DataBound("onPendingDocumentsDataBound");
        e.ExcelExport("onPendingDocumentExcelExport");
        e.GroupExpand("onPendingDocumentGroupExpand");
        e.GroupCollapse("onPendingDocumentGroupCollapse");
    })
