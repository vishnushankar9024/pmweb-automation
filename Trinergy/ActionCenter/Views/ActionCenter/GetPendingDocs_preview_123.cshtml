@{
    Layout = null;
}

<style>
    .group-header-td {
        background-color: #007FC9;
        cursor: pointer;
    }

    .group-header-form-td {
        /*background-color: #357fbe;*/
        background-color: LightBlue;
        cursor: pointer;
        color: #000000 !important;
    }

    .collalldiv {
        background-color: #286090;
        cursor: pointer;
    }


    .headspan {
        color: white !important;
    }

    html, body {
        font-family: Calibri !important;
        font-size: 13px !important;
    }

    #tableDocs thead th {
        width: 200px;
        vertical-align: middle;
    }

    #tableDocs * {
        font-size: 14px !important;
    }

    .subReportHeader {
        background-color: cadetblue !important;
        color: #ffffff;
    }

    table.dataTable thead th, table.dataTable thead td {
        padding-left: 5px !important;
        padding-right: 5px !important;
        vertical-align: middle !important;
        word-break: normal;
        word-wrap: normal;
    }

    table.dataTable tbody td {
        padding-left: 5px !important;
        padding-right: 5px !important;
        vertical-align: middle !important;
    }

    table.dataTable {
        margin: 0 auto;
        width: 100%;
        clear: both;
        border-collapse: collapse;
        table-layout: fixed !important;
        word-wrap: break-word;
    }

    .dataTables_scrollBody {
        /*margin-left:-26px;*/
    }

    .filter-content {
        width: 130px;
        height: 75px;
        background-color: #fff !important;
        position: absolute;
        z-index: 1;
        margin-top: 5px;
        margin-left: 5px;
        display: none;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        border-radius: .25rem !important;
        padding: 10px;
        text-align: left;
    }

    .btn-primary-custum {
        color: #fff !important;
        background-color: #337ab7 !important;
        border-color: #2e6da4 !important;
        margin-left: 5px;
    }
</style>


@(Html.Kendo().Grid<Astad.Model.ActiveWFDocumentModel>()
                                        .Name("grid_PendingDocuments")
                                        .Columns(columns =>
                                        {
                                            //columns.Bound(c => c.InitiativeNo).Filterable(filter => filter.Cell(cell => cell.Operator("contains").ShowOperators(true).Delay(100)))
                                            //.ClientTemplate(Html.ActionLink("#: InitiativeNo #", "Details", "NI", new { id = "#: Id #" }, new { target = "_blank" }).ToHtmlString())
                                            //  .Width(120);
                                            columns.Bound(c => c.Project).ClientGroupHeaderTemplate("<span class=\"group-header-project\">#: value #</span>").Hidden(true).IncludeInMenu(false);
                                            columns.Bound(c => c.RecordType).ClientGroupHeaderTemplate("<span class=\"group-header-form\">#: value #</span>").Hidden(true).IncludeInMenu(false);
                                            columns.Bound(c => c.FileNames).Hidden(true).IncludeInMenu(false);
                                            columns.Bound(c => c.RecordNumber).Title("Record No.").HeaderTemplate("Record<br />No.").Width(100);
                                            columns.Bound(c => c.Reference).Title("Incoming Reference").HeaderTemplate("Incoming<br />Reference").Width(125);
                                            //columns.Bound(c => c.FormDate).Title("Date").Width(80);
                                            columns.Bound(c => c.Description).Title("Subject")
                                         .ClientTemplate("<a href='javascript: void(0)' onclick=\"GetWorkflowStatus(#:DocumentId#, this)\">#:Description#</a>")
                                           .Width(225);
                                            columns.Bound(c => c.ReceivedDate).Format("{0:dd-MMM-yy}").Title("Recipient Received Date").HeaderTemplate("Recipient Received Date").Width(80);
                                            columns.Bound(c => c.DueDate).Format("{0:dd-MMM-yy}").Title("Recipient Due Date").HeaderTemplate("Recipient Due Date").Width(80);
                                            columns.Bound(c => c.RemainingDays).Title("Remaining / Pending Days").HeaderTemplate("Remaining / Pending Days").Width(80);
                                            columns.Bound(c => c.DocumentId)
                                            .ClientTemplate("<a href='javascript:void(0)' class\"actionhead\" onclick=\"GetRecord('#:RecURL#', '#:ProjectName#' , '#:FormName#', '#:Reference#', '#:RecordNumber#', '#:Description#')\">Action</a>")
                                              .Width(100);
                                            columns.Bound(c => c.OCSLink).Title("Links")
                                            .ClientTemplate("<a href='javascript:void(0)' class\"actionhead\" onclick=\"GetRecord('#:RecURL#', '#:ProjectName#' , '#:FormName#', '#:Reference#', '#:RecordNumber#', '#:Description#')\">Action</a>")
                                              .Width(100);
                                            columns.Bound(c => c.DocumentId).Title("Attachments")
                                           .ClientTemplate("<a href='javascript: void(0)' onclick=\"GetAttachments(#:DocumentId#, this)\">Attachments</a>")
                                             .Width(120);
                                            columns.Bound(c => c.TeamInputRequestedTo).Title("Team Input Request Pending With").HeaderTemplate("Team Input <br />Request<br />Pending With").Width(150);
                                            columns.Bound(c => c.TeamInputRepliedBy).Title("Team Input Reply Received From").HeaderTemplate("Team Input <br />Reply Received<br />From").Width(150);
                                            columns.Bound(c => c.WorkflowComments).Title("Previous step workflow comments").HeaderTemplate("Previous step workflow<br />comments").Encoded(false).Width(250);
                                        })
                                        .HtmlAttributes(new { style = "height: 700px;" })
                                        .Scrollable()
                                        .Groupable()
                                        .Sortable()
                                        .Filterable(filter =>
                                                filter.Mode(GridFilterMode.Menu)
                                                .Operators(ops => ops
                                                .ForString(str => str.Clear()
                                                    .Contains("Contains")
                                                    .StartsWith("Starts with")
                                                    )
                                                    .ForDate(dt => dt.Clear()
                                                    .IsGreaterThanOrEqualTo("is after or equal to")
                                                    .IsLessThanOrEqualTo("is before or equal to")
                                                    )
                                        )
                                )
                                //.Pageable(p => p.Numeric(false).PreviousNext(false))
                                .Pageable()
                                .AutoBind(false)
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Read(read => read.Action("GetPendingDocuments", "ActionCenter"))
                                    .PageSize(100)
                                    .Batch(true)
                                    .Group(g =>
                                    {
                                        g.Add(c => c.Project);
                                        g.Add(c => c.RecordType);
                                    })
                                    .ServerOperation(true)
                                )
                                .Groupable(g =>
                                {
                                    g.Enabled(false);
                                })
                                .ColumnMenu()
                            )

