@model IEnumerable<Trinergy.Model.TabMenu>
@{
    Layout = null;
    int tabCount = 0;
}

<div class="admintab-wrap mg-b-40">
    <ul class="nav nav-tabs custom-menu-wrap custon-tab-menu-style1">
        @foreach (var menu in Model)
        {
            if (tabCount == 0)
            {
                <li class="active">
                    <a data-toggle="tab" href="#@menu.Menu.ToTabMenu()" data-frame="@menu.Menu.ToTabMenu()" data-menu="@menu.Menu">@*<span class="adminpro-icon adminpro-analytics-arrow tab-custon-ic"></span>*@@menu.Name</a>
                </li>
            }
            else
            {
                <li>
                    <a data-toggle="tab" href="#@menu.Menu.ToTabMenu()" data-frame="@menu.Menu.ToTabMenu()" data-menu="@menu.Menu">@*<span class="adminpro-icon adminpro-analytics-arrow tab-custon-ic"></span>*@@menu.Name</a>
                </li>
            }
            tabCount++;
        }
    </ul>
    <div class="tab-content">
        @{
            tabCount = 0;
        }
        @foreach (var menu in Model)
        {
            if (tabCount == 0)
            {
                <div id="@menu.Menu.ToTabMenu()" class="tab-pane in active animated flipInX custon-tab-style1"></div>
            }
            else
            {
                <div id="@menu.Menu.ToTabMenu().Replace(" ", "_")" class="tab-pane animated flipInX custon-tab-style1"></div>
            }
            tabCount++;
        }
    </div>
</div>
<script type="text/javascript">
    globalParams.frameId = 'reportFrame_@Model.First().Menu.ToTabMenu()';
    globalParams.target = '@(Model.First().Menu)';
    function GetViewInit() {
        var height = ($(document).height() - 150);
        $(".tab-content").css({ "height": height + 'px' });
        height = (height - 25) + 'px'
        @if (Model.Any())
            {
                <text>
        globalParams.frameId = 'reportFrame_@Model.First().Menu.ToTabMenu()';
        globalParams.target = '@(Model.First().Menu)';
        $("#pleaseWaitDialog").show();
        $('<iframe>', {
            src: globalParams.dashBoardReport + "?tabKey=@(Model.First().Menu)&pid=" + globalParams.GetProjectIds() + "&width=" + $(document).width() + "&_=" + Math.random(),
            id: globalParams.frameId,
            frameborder: 0,
            scrolling: 'yes',
            css: {
                width: '100%',
                height: height
            }
        }).load(function () {
            $("#pleaseWaitDialog").hide();
        }).appendTo($('#@Model.First().Menu.ToTabMenu()'));
        </text>
            }
        //rptViewer1_ctl04
    }
    $(document).ready(function () {
        var height = ($(document).height() - 150);
        $(".tab-content").css({ "height": height + 'px' });
        height = (height - 25) + 'px'
        $('.nav-tabs>li>a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var divId = $(e.target).attr('href');
            target = $(e.target).attr("data-menu");
            frameId = "reportFrame_" + $(e.target).attr("data-frame");
            
            $(divId).empty();

            globalParams.frameId = frameId;
            globalParams.target = target;

            $("#pleaseWaitDialog").show();
            $('<iframe>', {
                src: globalParams.dashBoardReport + "?tabKey=" + target + "&pid=" + globalParams.GetProjectIds() + "&width=" + $(document).width() + "&_=" + Math.random(),
                id: frameId,
                frameborder: 0,
                scrolling: 'yes',
                css: {
                    width: '100%',
                    height: height
                }
            }).load(function () {
                $("#pleaseWaitDialog").hide();
            }).appendTo($(divId));

            //iframe.attr({
            //    width: '100%',
            //    height: height,
            //    src: globalParams.dashBoardReport + "?tabKey=" + target + "&pid=" + globalParams.GetProjectIds() + "&width=" + $(document).width() + "&_=" + Math.random()
            //});
            //iframe.on("load", function () {
            //    iframe.show();
            //    $("#pleaseWaitDialog").hide();
            //});
        });
    });
</script>