@model Trinergy.ViewModel.DashboardViewModel
<ul id="menu_program">
    @foreach (var program in Model.Programs)
    {
        var projects = Model.Projects.Where(w => w.ProgramId == program.Id);
        <li>
            <a href='#'><span>@program.Name</span><span class="cnt">@projects.Count()</span></a>
            <ul>
                @foreach (var project in projects)
                {
                    <li>
                        <div><a href="javascript:void(0)" data-pid="@project.Id" class="dashboard projectLinks">@project.Name</a></div>
                    </li>
                }
            </ul>
        </li>
    }
</ul>
<ul id="menu_properties">
    @foreach (var property in Model.Properties)
    {
        var projects = Model.Projects.Where(w => w.LocationId == property.Id);
        <li>
            <a href='#'><span>@property.Name</span><span class="cnt">@projects.Count()</span></a>
            <ul>
