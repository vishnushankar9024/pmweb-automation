<ul id="menu_pm">
    @{ 
        var pms = Model.Projects.Select(s => s.Project_Manager).Distinct().OrderBy(o => o);
    }
    @foreach (var pm in pms)
    {
        var projects = Model.Projects.Where(w => w.Project_Manager == pm);
        <li>
