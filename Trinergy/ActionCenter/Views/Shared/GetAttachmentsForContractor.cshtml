@model Trinergy.Wrapper.AttachmentOutput
@{
    Layout = null;
    Trinergy.Wrapper.Tree tree = new Trinergy.Wrapper.Tree();
    int treeCount = 0;
    var user = new Trinergy.Data.UserDbContext().GetUser(Convert.ToInt32(Session["PMWebUserId"].ToString()));
}
<div style="width:100%">
    @*<input type="button" onclick="javascript: void (window.open('pmwebhelper/HMC/FilesLookup?EntityTypeId=1&DocumentType=PROJECT&DocumentId=@ViewBag.RecordId&EntityId=@ViewBag.ProjectId', 'blank', 'scrollbars=yes,toolbar=no,width=1600,height=650,top=200,left=300'));" value="Upload" />*@
    <div id="accordion">
        @foreach (string folderName in Model.ParentFolders)
        {
            var folders = Model.Folders.Where(w => w.FolderType.ToLower() == folderName.ToLower()).ToList();
            var folder = folders.Where(w => w.FolderName.ToLower() == folderName.ToLower()).FirstOrDefault();
            int fileCount = 0;

            string treeId = "tree" + treeCount;
            treeCount++;
            if (folder != null)
            {
                fileCount = tree.GetFileCountByFolder(Model.Folders, folder.Id);
            }
            if (fileCount > 0)
            {
                <h3>@folderName (@fileCount)</h3>
                <div>
                    <div class="panel panel-primary">
                        <div class="panel-body">
                            @if (folders.Any())
                            {
                                <input type="button" value="++" title="Expand All" onclick="$('#@treeId').jstree('open_all');">
                                <input type="button" value="--" title="Collapse All" onclick="$('#@treeId').jstree('close_all');">
                                <br />
                                <div style="width:100%;" id="@treeId">
                                    @if (folder != null)
                                    {
                                        @Html.Raw(tree.GetAttachmentTreeNode(folder.SubFolders, folder.ParentId))
                                    }
                                </div>
                            }
                            else
                            {
                                <div>No @folderName</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        @if (user.Email.ToLower().EndsWith("hamad.qa"))
        {
            var foldersDraft = Model.Folders.Where(w => w.FolderName.ToLower() == "hfd - users").ToList();
            var folderDraft = foldersDraft.FirstOrDefault();
            string treeIdDraft = "tree_Draft";
            if (foldersDraft.Count > 0)
            {
                <h3>Drafts (@foldersDraft.Count)</h3>
                <div>
                    <div class="panel panel-primary">
                        <div class="panel-body">
                            @if (foldersDraft.Any())
                            {
                                <input type="button" value="++" title="Expand All" onclick="$('#@treeIdDraft').jstree('open_all');">
                                <input type="button" value="--" title="Collapse All" onclick="$('#@treeIdDraft').jstree('close_all');">
                                <br />
                                <div style="width:100%;" id="@treeIdDraft">
                                    @if (folderDraft != null)
                                    {
                                        @Html.Raw(tree.GetAttachmentTreeNode(Model.Folders, folderDraft.ParentId))
                                    }
                                </div>
                            }
                            else
                            {
                                <div>No Drafts</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        @if (Model.LinkedDoc.Count > 0)
        {
            <h3>Links (@Model.LinkedDoc.Count)</h3>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        @if (Model.LinkedDoc.Count > 0)
                        {
                            <div style="width:100%;">
                                <ul>
                                    @foreach (var doc in Model.LinkedDoc)
                                    {
                                        <li style="font-size: 12px !important;">
                                            <a href="PMWeb/CustomForms.aspx?TypeId=@doc.LinkedRecordTypeId&Id=@doc.LinkedRecordId&ModuleId=2&PageId=80" title="@doc.Description" target="_blank">@doc.Description</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div>No Linked Documents</div>
                        }
                    </div>
                </div>
            </div>
        }
        @if (Model.Transmittals.Count > 0)
        {
            <h3>Transmittals (@Model.Transmittals.Count)</h3>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        @if (Model.Transmittals.Count > 0)
                        {
                            <div style="width:100%;">
                                <ul>
                                    @foreach (var doc in Model.Transmittals)
                                    {
										var idToEncrypt = doc.Id.ToString();
										var encryptedId = idToEncrypt != null ? new Trinergy.Helper.EncryptionHelper().Encrypt(idToEncrypt) : null;

										//Console.log(idToEncrypt);
										<li style="font-size: 12px !important;">
											@Html.ActionLink(doc.Name, "GetFile", "Task",
											 routeValues: new { id = encryptedId },
											 htmlAttributes: null
										  )
										</li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div>No Linked Documents</div>
                        }
                    </div>
                </div>
            </div>
        }
        <p style="font-weight: bold;margin-top: 10px;font-size: 11px;">
            Note: The folders will appear once the documents are uploaded in the respective folder and also based on the folder security.
        </p>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="actionModal" tabindex="-1" role="dialog" aria-labelledby="actionModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document" style="width:500px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">Action</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <a href="javascript:void(0)" class="btn btn-primary" id="btnAttachmentDownload">Download Folder</a>
                <br />
                <br />
                <hr />
                <br />
                <input type="file" multiple id="AttachmentFile" /><br />
                <a href="javascript:void(0)" class="btn btn-primary" id="btnAttachmentUpload">Upload</a>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#accordion").accordion({
            header: "h3",
            collapsible: true,
            autoHeight: false,
            navigation: true,
            heightStyle: "content"
        });
        @for (treeCount = 0; treeCount < Model.ParentFolders.Count(); treeCount++)
        {
            string treeId = "tree" + treeCount;
                <text>
        $('#@treeId').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });
        </text>
            }
        @if (user.Email.ToLower().EndsWith("hamad.qa"))
            {
                <text>
        $('#tree_Draft').jstree({
            'core': {
                'themes': {
                    'name': 'proton',
                    'responsive': true
                }
            }
        });

        </text>
            }
        var Attachment = {
            FolderId: '',
            DocId: ''
        }
        $(".jstree-action").click(function (e) {
            Attachment.FolderId = $(this).attr('id');
            Attachment.DocId = $(this).attr('docId');
            $("#actionModal").modal('show');
        });

        $("#btnAttachmentDownload").click(function () {
            DownloadFolder(Attachment.FolderId, Attachment.DocId);
        });

        var files = null;
        $('#AttachmentFile').change(function (e) {
            files = e.target.files;
        });


        $("#btnAttachmentUpload").click(function () {
            var formData = new FormData();
            if (files && files.length > 0) {
                for (var i = 0; i < files.length; i++) {
                    formData.append(files[i].name, files[i]);
                }

                $.ajax({
                    url: '@Url.Action("MultiUpload", "ContractorActionCenter")?folderId=' + Attachment.FolderId + "&docId=" + Attachment.DocId,
                    type: "POST", //as we will be posting files and other method POST is used
                    processData: false, //remember to set processData and ContentType to false, otherwise you may get an error
                    contentType: false,
                    data: formData,
                    success: function (data) {
                        $("#actionModal").modal('hide');
                    },
                    error: function (xhr) {
                        alert("failed");
                    },
                    error: function (err) {
                        //alert(err.statusText);
                    }
                });
            }
        });
    });

</script>