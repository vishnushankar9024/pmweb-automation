@model Trinergy.Wrapper.AttachmentOutput
@{
    Layout = null;
    Trinergy.Wrapper.Tree tree = new Trinergy.Wrapper.Tree();
    var fileManager = Model.Folders;
    var folders = fileManager.Where(w => (w.FolderType == null || w.FolderType.Trim() == "") && (w.ParentFolder == null || w.ParentFolder == "")).ToList();
    int fileCount = 0;
    foreach (var _folder in folders)
    {
        if (_folder != null)
        {
            fileCount = fileCount + tree.GetFileCountByFolder(fileManager.ToList(), _folder.Id);
        }
    }
}
<div class="k-widget k-upload k-header k-upload-sync k-upload-empty" style="margin-left:20px;">
    @if (fileCount > 0)
    {
        <div class="panel panel-primary">
            <div class="panel-body">
                <input type="button" value="++" title="Expand All" onclick="$('#tree_atmt').jstree('open_all');">
                <input type="button" value="--" title="Collapse All" onclick="$('#tree_atmt').jstree('close_all');">
                <br />
                <div style="width:100%;" id="tree_atmt">
                    <ul>
                        @foreach (var _folder in fileManager)
                        {
                            <li style="font-size: 12px !important;">
                                <a href="javascript:void(0)" onclick="DownloadFolder(@_folder.Id, @_folder.ObjectId)" title="Download">@_folder.FolderName &nbsp;&nbsp;<span class="glyphicon glyphicon-download-alt"></span></a>
                                @Html.Raw(tree.GetAttachmentTreeNode(fileManager, _folder.Id, ViewBag.UserId))
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
    <p style="font-weight: bold;margin-top: 10px;font-size: 11px;">
        Note: The folders will appear once the documents are uploaded in the respective folder and also based on the folder security.
    </p>
