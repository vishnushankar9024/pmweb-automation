@model IEnumerable<Trinergy.Model.WorkflowStatus>
@{
    Layout = null;
}
<div style="width:100%">
    <table class="table table-bordered table-striped grid">
        <thead>
            <tr class="subReportHeader">
                <th style="width:50px;text-align:center">Step #</th>
                <th style="text-align:center">Role Name</th>
                <th style="width:75px;text-align:center">Action Date</th>
                <th style="width:75px;text-align:center">Action Time</th>
                <th style="text-align:center">Step Owner</th>
                <th style="text-align:center">Delegate</th>
                <th style="width:100px;text-align:center">Action Type</th>
                <th style="text-align:center">Team Input Names</th>
                <th style="text-align:center">Comments</th>
                <th style="text-align:center">Pending Team Input From</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var workflow in Model)
            {
                string bckclr = "";
                if (workflow.PendingStatus == true)
                {
                    bckclr = "background-color:orange";
                }
                <tr style="@bckclr">
                    <td style="text-align:center">@workflow.StepNumber</td>
                    <td>@workflow.RoleName</td>
                    <td style="text-align:center" class="text-nowrap">@workflow.ActionDate.ToString("dd-MMM-yy")</td>
                    <td style="text-align:center" class="text-nowrap">@workflow.ActionTime.ToString("hh:mm tt")</td>
                    <td>@workflow.StepOwner</td>
                    <td>@Html.Raw(workflow.ActionBy)</td>
                    <td>@workflow.ActionType</td>
                    <td>@workflow.TeamInputNames</td>
                    <td>@workflow.Comments</td>
                    <td>@workflow.TeamInputPending</td>
                </tr>
            }
            @if (Model.Count() == 0)
            {
                <tr>
                    <td colspan="7">No Records Found</td>
                </tr>
            }
        </tbody>
    </table>
</div>