@model IEnumerable<Trinergy.Model.NotificationLog>
@{
    Layout = null;
}
<div style="width:50%">
    <div class="text-right"><a href="javascript:void(0)" title="Close" onclick="CloseSubReport()" style="color:red"><span class="glyphicon glyphicon-remove"></span></a></div>
    <table class="table table-bordered table-striped grid">
        <thead>
            <tr class="subReportHeader">
                <th>Sent Date</th>
                <th>Sent Time</th>
                <th>Sent By</th>
                <th>To Contact</th>
                <th>Subject</th>
                </trclass="subReportHeader">
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.SendDate.ToString("dd-MMM-yy")</td>
                    <td>@log.SentTime.ToString("hh:mm tt")</td>
                    <td>@log.SentBy</td>
                    <td>@log.ToContact</td>
                    <td>@log.Subject</td>
                </tr>
            }
            @if (Model.Count() == 0)
            {
                <tr>
                    <td colspan="5">No Records Found</td>
                </tr>
            }
        </tbody>
    </table>
</div>