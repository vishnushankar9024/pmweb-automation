@model IEnumerable<Trinergy.Model.Program>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Corresponce Log</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="~/Scripts/tree/themes/proton/style.css" />


    <link href="https://kendo.cdn.telerik.com/2018.3.911/styles/kendo.common-material.min.css" rel="stylesheet" type="text/css" />
    <link href="https://kendo.cdn.telerik.com/2018.3.911/styles/kendo.mobile.all.min.css" rel="stylesheet" type="text/css" />
    <link href="https://kendo.cdn.telerik.com/2018.3.911/styles/kendo.material.min.css" rel="stylesheet" type="text/css" />
    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/jquery.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/jszip.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/kendo.all.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/kendo.aspnetmvc.min.js"></script>
    <script src="@Url.Content("~/Scripts/kendo.modernizr.custom.js")"></script>
    <style>
        html, body {
            font-size: 14px;
            font-family: Calibri;
        }

        #panelsearch {
            /*display: none;*/
            width: 98.9%;
            z-index: 999;
            position: absolute;
        }

        #panelbar {
            width: 100%;
            margin: 0 auto;
        }

        .teamMate:after {
            content: ".";
            display: block;
            height: 0;
            line-height: 0;
            clear: both;
            visibility: hidden;
        }

        .teamMate h2 {
            font-size: 1.4em;
            font-weight: normal;
            padding-top: 20px;
        }

        .teamMate p {
            margin: 0;
        }

        .teamMate img {
            float: left;
            margin: 5px 15px 5px 5px;
            border: 1px solid #ccc;
            border-radius: 50%;
        }

        .k-grid td {
            padding: 5px;
        }
    </style>
</head>
<body>
    <div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-xs-18 col-md-12">
                    @(Html.Kendo().Grid(Model)
                            .Name("grid_Properties")
                            .Columns(columns =>
                            {
                                columns.Bound(d => d.Name).HeaderTemplate("Campus");
                            })
                            .Pageable()
                            .Sortable()
                            .Scrollable(scr => scr.Height(1000))
                            .Filterable()
                            .Groupable(g => g.Enabled(false))
                            .ColumnMenu()
                            .ClientDetailTemplateId("template_projects")
                            .HtmlAttributes(new { style = "height:auto" })
                            .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(20)
                            .ServerOperation(false)
                        )
                        .Events(events => events.DataBound("dataBound"))
                    )
                </div>
            </div>
        </div>
    </div>
    @(Html.Kendo().Window()
        .Name("winProject")
        .Title("Project")
        .Content(() =>
            Html.Kendo().Grid<Trinergy.Model.DocumentLogModel>()
            .Name("grid_projects_log")
             .Columns(columns =>
                    {
                        columns.Bound(d => d.ProjectName).HeaderTemplate("Project").Hidden(true);
                        columns.Bound(d => d.FormName).HeaderTemplate("Form").Hidden(true);
                        columns.Bound(d => d.RecordNumber).HeaderTemplate("Record No.").Width(150);
                        columns.Bound(d => d.Reference).HeaderTemplate("Incoming Reference");
                        columns.Bound(d => d.FormDate).HeaderTemplate("Date");
                        columns.Bound(d => d.Subject).Encoded(false);
                        columns.Bound(d => d.DocStatus).HeaderTemplate("Workflow").Encoded(false);
                        //columns.Bound(d => d.Attachment).HeaderTemplate("Workflow").Encoded(false);
                        columns.Bound(d => d.PendingUser).HeaderTemplate("Pending With");
                        columns.Bound(d => d.From);
                        columns.Bound(d => d.To);

                    }
            )
            .Filterable()
            .HtmlAttributes(new { style = "height:auto" })
            .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(50)
            .ServerOperation(false)
            .Read(read => read.Action("Log_Read", "CorrespondenceLog").Data("GetProjectId"))
            )
        )
    )
