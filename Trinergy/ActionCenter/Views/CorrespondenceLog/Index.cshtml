@model IEnumerable<Trinergy.Model.Projects>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Corresponce Log</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="~/Scripts/tree/themes/proton/style.css" />


    <link href="https://kendo.cdn.telerik.com/2018.3.911/styles/kendo.common-material.min.css" rel="stylesheet" type="text/css" />
    <link href="https://kendo.cdn.telerik.com/2018.3.911/styles/kendo.mobile.all.min.css" rel="stylesheet" type="text/css" />
    <link href="https://kendo.cdn.telerik.com/2018.3.911/styles/kendo.material.min.css" rel="stylesheet" type="text/css" />

    <link rel="stylesheet" href="~/Content/web/kendo.common.min.css" />
    <link rel="stylesheet" href="~/Content/web/kendo.bootstrap.min.css" />

    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/jquery.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/jszip.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/kendo.all.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2018.3.911/js/kendo.aspnetmvc.min.js"></script>
    <script src="@Url.Content("~/Scripts/kendo.modernizr.custom.js")"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/jszip/2.4.0/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pako/1.0.7/pako.min.js"></script>

    <script src="https://code.jquery.com/jquery-1.12.4.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

    <style>
        html, body {
            font-size: 14px;
            font-family: Calibri;
        }

        #panelsearch {
            /*display: none;*/
            width: 98.9%;
            z-index: 999;
            position: absolute;
        }

        #panelbar {
            width: 100%;
            margin: 0 auto;
        }

        .teamMate:after {
            content: ".";
            display: block;
            height: 0;
            line-height: 0;
            clear: both;
            visibility: hidden;
        }

        .teamMate h2 {
            font-size: 1.4em;
            font-weight: normal;
            padding-top: 20px;
        }

        .teamMate p {
            margin: 0;
        }

        .teamMate img {
            float: left;
            margin: 5px 15px 5px 5px;
            border: 1px solid #ccc;
            border-radius: 50%;
        }

        /*.k-grid td {
            padding: 5px;
        }*/

        .gridTabel * {
            font: normal 12px "Segoe UI",Arial,Helvetica,sans-serif;
            line-height: 16px;
        }

        .k-grid {
            font-size: 13px;
        }

            .k-grid td {
                line-height: 2em;
            }

        /* Page Template for the exported PDF */
        .page-template {
            font-family: "DejaVu Sans", "Arial", sans-serif;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
        }

            .page-template .header {
                position: absolute;
                top: 30px;
                left: 30px;
                right: 30px;
                border-bottom: 1px solid #888;
                color: #888;
            }

            .page-template .footer {
                position: absolute;
                bottom: 30px;
                left: 30px;
                right: 30px;
                border-top: 1px solid #888;
                text-align: center;
                color: #888;
            }

            .page-template .watermark {
                font-weight: bold;
                font-size: 400%;
                text-align: center;
                margin-top: 30%;
                color: #aaaaaa;
                opacity: 0.1;
                transform: rotate(-35deg) scale(1.7, 1.5);
            }
    </style>
</head>
<body>
    <div>
        <div class="container-fluid box">
            <div class="row">
                <div id="panelsearch" class="col-md-12">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <h3 class="panel-title" style="color:#fff !important;">Document Filter <small>Please select project and/or form.</small></h3>
                        </div>
                        <div class="panel-body SearchLeftPanel bg-info">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group ">
                                        <label class="lblpanel">From Date</label>
                                        @Html.Kendo().DatePicker().Name("txtfromdate").DateInput().Value(DateTime.Today.AddDays(-60)).Format("yyyy-MM-dd").HtmlAttributes(new { style = "width:100%" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="lblpanel">To Date</label>
                                        @Html.Kendo().DatePicker().Name("txttodate").DateInput().Value(DateTime.Today).Format("yyyy-MM-dd").HtmlAttributes(new { style = "width:100%" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group " style="overflow:inherit">
                                        <label class="lblpanel" style="text-align:left;width:inherit">Projects</label><br />
                                        @Html.Kendo().MultiSelect().Name("Projects").Placeholder("Select Project").BindTo(new SelectList(ViewBag.Userprojects, "Id", "Name")).HtmlAttributes(new { id = "listboxproj", style = "width:100%" }).Events(e => e.Change("onProjectChange"))
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group ">
                                        <label class="lblpanel" style="text-align:left;width:inherit">Forms</label><br />
                                        @Html.Kendo().MultiSelect().Name("Forms").Placeholder("Select Form").BindTo(new SelectList(ViewBag.UserForms, "Id", "Name")).HtmlAttributes(new { id = "listboxforms", style = "width:100%" })
                                        @*@Html.ListBox("Forms", new SelectList(ViewBag.UserForms, "Id", "Name"), new { @id = "listboxforms", @class = "form-control listbox" })*@
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel" style="text-align:left;width:inherit">Workflow Status</label><br />
                                        @(Html.Kendo().ComboBox()
                                          .Name("WorkflowStatus")
                                          .HtmlAttributes(new { id = "listboxws", style = "width:100%" })
                                          .Filter("contains")
                                          .Placeholder("Select Workflow")
                                         .BindTo(new SelectList(ViewBag.DocumentsStatus, "Id", "Name"))
                                         .Value("0")
                                        )
                                        @*@Html.Kendo().MultiSelect().Name("WorkflowStatus").Placeholder("Select Workflow").Value("0").MaxSelectedItems(1).BindTo(new SelectList(ViewBag.DocumentsStatus, "Id", "Name")).HtmlAttributes(new { id = "listboxws", style = "width:100%" })*@
                                    </div>
                                </div>
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">Pending With</label><br />
                                        @(Html.Kendo().ComboBox()
                                          .Name("PendingWith")
                                          .HtmlAttributes(new { id = "txtPendingWith", style = "width:100%" })
                                          .Filter("contains")
                                          .Placeholder("Select Pending With")
                                          .DataTextField("Name")
                                          .DataValueField("Name")
                                          .DataSource(source => source
                                              .Read(read =>
                                              {
                                                  read.Action("GetUsers", "CorrespondenceLog")
                                                      .Data("filterProjects").Type(HttpVerbs.Post);
                                              })
                                              .ServerFiltering(false)
                                          )
                                        )
                                    </div>
                                </div>
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">Subject</label>
                                        @Html.Editor("Subject", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtsubject", value = "Test" } })
                                    </div>
                                </div>
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">Incoming Reference</label>
                                        @Html.Editor("Reference", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtoref" } })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">Outgoing Reference</label>
                                        @Html.Editor("ReplyReference", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtrepref" } })
                                    </div>
                                </div>
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">Record No.</label>
                                        @Html.Editor("RecordNo", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtrecno" } })
                                    </div>
                                </div>
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">From</label>
                                        @(Html.Kendo().ComboBox()
                                          .Name("From")
                                          .HtmlAttributes(new { id = "txtfrom", style = "width:100%" })
                                          .Filter("contains")
                                          .Placeholder("Select From")
                                          .DataTextField("Name")
                                          .DataValueField("Name")
                                          .DataSource(source => source
                                              .Read(read =>
                                              {
                                                  read.Action("GetUsers", "CorrespondenceLog")
                                                      .Data("filterProjects").Type(HttpVerbs.Post);
                                              })
                                              .ServerFiltering(false)
                                          )
                                        )
                                    </div>
                                </div>
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">To</label>
                                        @(Html.Kendo().ComboBox()
                                          .Name("To")
                                          .HtmlAttributes(new { id = "txtto", style = "width:100%" })
                                          .Filter("contains")
                                          .Placeholder("Select To")
                                          .DataTextField("Name")
                                          .DataValueField("Name")
                                          .DataSource(source => source
                                              .Read(read =>
                                              {
                                                  read.Action("GetUsers", "CorrespondenceLog")
                                                      .Data("filterProjects").Type(HttpVerbs.Post);
                                              })
                                              .ServerFiltering(false)
                                          )
                                        )
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 ">
                                    <div class="form-group ">
                                        <label class="lblpanel">File Name</label>
                                        @Html.Editor("To", new { htmlAttributes = new { @class = "form-control formtext", @id = "txtFileName" } })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group ">
                                        <label class="lblpanel">Created By</label>
                                        @(Html.Kendo().ComboBox()
                                          .Name("CreatedBy")
                                          .HtmlAttributes(new { id = "txtCreatedBy", style = "width:100%" })
                                          .Filter("contains")
                                          .Placeholder("Select To")
                                          .DataTextField("Name")
                                          .DataValueField("Name")
                                          .DataSource(source => source
                                              .Read(read =>
                                              {
                                                  read.Action("GetUsers", "CorrespondenceLog")
                                                      .Data("filterProjects").Type(HttpVerbs.Post);
                                              })
                                              .ServerFiltering(false)
                                          )
                                        )
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group text-center" style="margin-top:20px;">
                                        <button type="button" id="btngetreport" class="btn btn-primary">Get Report</button>
                                        @*<button type="button" id="btnclear" class="btn btn-primary">Clear</button>*@
                                        <button type="button" id="btnClose" class="btn btn-primary" onclick="CloseSearch()">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-xs-18 col-md-12">
                    @(Html.Kendo().Grid<Trinergy.Model.DocumentLogModel>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(d => d.ProjectName).ClientGroupHeaderTemplate("#=value#").Hidden();
                        columns.Bound(d => d.FormName).ClientGroupHeaderTemplate("#=value#").Hidden();
                        columns.Bound(d => d.RecordNumber).HeaderTemplate("Record No.").Width(75);
                        columns.Bound(d => d.Reference).HeaderTemplate("Incoming Reference").Width(150);
                        columns.Bound(d => d.FormDate).HeaderTemplate("Date").Width(75);
                        //columns.Bound(d => d.Subject).Encoded(false).Width(200).ClientTemplate();
                        columns.Bound(d => d.Subject).ClientTemplate("<a href='#:RecURL#' target='_parent'>#:Subject#</a>").HeaderTemplate("Subject").Width(200);
                        columns.Bound(d => d.DocStatus).ClientTemplate("<a href='javascript:void(0)' onclick='GetWorkflowStatus(#:DocumentId#)'>#:DocStatus#</a>").HeaderTemplate("Workflow").Width(75);
                        columns.Bound(d => d.Attachment).ClientTemplate("<a href='javascript:void(0)' onclick='GetAttachments(#:FormId#)' class='attachments'>Attachments</a>").HeaderTemplate("Attachments").Width(75);
                        columns.Bound(d => d.PendingUser).HeaderTemplate("Pending With").Width(150);
                        columns.Bound(d => d.From).Width(150);
                        columns.Bound(d => d.To).Width(150);

                    })
                   .ToolBar(toolbar =>
                   {
                   toolbar.Custom()
                    .HtmlAttributes(new { onclick = "toggleFilter(); return false;", style = "width: 150px;" })
                    .Name("btnShowFilter")
                        .Text("Show / Hide Filter")
                        .Url("javascript:void(0)");
                   toolbar.Excel();
                   toolbar.Pdf();
                    @*toolbar.Template(@<text>
                                <div class="toolbar">
                                    @(Html.Kendo().Button()
                                                        .Name("btnShowFilter")
                                                        .Content("Show / Hide Filter")
                                                        .Events(e => e.Click("toggleFilter"))
                                                        .HtmlAttributes(new { style = "width: 150px;" })
                                    );
                                    @toolbar.Excel();
                                </div>
                        </text>);*@
                   })
                    .Sortable()
                    .Pageable()
                    .Scrollable(scr => scr.Height(1000))
                    //.Pageable(p => p.Numeric(false).PreviousNext(false))
                    //.Scrollable(scr => scr.Endless(true))
                    .Filterable()
                    .Groupable(g => g.Enabled(false))
                    .ColumnMenu()
                    .HtmlAttributes(new { style = "height:800px" })
                    .AutoBind(false)
                    .DataSource(dataSource => dataSource
                    .Ajax()
                    .PageSize(500)
                    .ServerOperation(true)
                    .Read(read => read
                        .Action("Log_Read_Search", "CorrespondenceLog")
                        .Data("GetFilterData"))
                        .Group(g => g.Add(p => p.ProjectName))
                        .Group(g => g.Add(p => p.FormName))
                    )
                    .Excel(excel => excel
                        .FileName("Document_Log.xlsx")
                        .Filterable(true)
                        .ProxyURL(Url.Action("Export_Save", "CorrespondenceLog"))
                        .AllPages(true)
                    )
                    .Pdf(pdf => pdf
                        .AllPages()
                        .AvoidLinks()
                        .PaperSize("A4")
                        .Scale(0.5)
                        .Margin("2cm", "1cm", "1cm", "1cm")
                        .RepeatHeaders()
                        .TemplateId("page-template")
                        .FileName("Document_Log.pdf")
                        .ProxyURL(Url.Action("Export_Save", "CorrespondenceLog"))
                    )
                    )
                </div>
            </div>
        </div>
    </div>
    <script type="x/kendo-template" id="page-template">
        <div class="page-template">
            <div class="header">
                Document Log
            </div>
            <div class="watermark">HFD</div>
            <div class="footer">
                Page #: pageNum # of #: totalPages #
            </div>
        </div>
    </script>
    <script type="text/javascript">
        function dataBound() {
            this.expandRow(this.tbody.find("tr.k-master-row").first());
        }
        function OnSelect(e) {
            var dataItemValue = e.dataItem.Value;
            var values = e.sender.value()

            if (dataItemValue !== "-1" && values.includes(dataItemValue)) {
                return;
            }

            if (dataItemValue === "-1") {
                values = [];
            } else if (values.indexOf("-1") !== -1) {
                values = $.grep(values, function (value) {
                    return value !== "-1";
                });
            }

            values.push(dataItemValue);
            this.value(values);
            this.trigger("change"); //notify others for the updated values

            e.preventDefault();
        }
        function GetFilterData() {
            var _fromDate = $('#txtfromdate').val();
            var _toDate = $('#txttodate').val();

            var _projects = $('#listboxproj').val();
            var _forms = $('#listboxforms').val();
            var _discipline = '';
            var _workflowstatus = $('#listboxws').val();

            var _subject = $('#txtsubject').val();
            var _originReg = $('#txtoref').val();
            var _outref = $('#txtrepref').val();
            var _recno = $('#txtrecno').val();
            var _subjectmatter = '';
            var _category = '';
            var _from = $('#txtfrom').val();
            var _to = $('#txtto').val();
            var _docType = '';
            var _fileName = $('#txtFileName').val();

            var _createdBy = $('#txtCreatedBy').val();

            var _gateway = '';

            var _pendingWith = $("#txtPendingWith").val();

            var _listboxdepartments = '';
            return {
                FromDate: _fromDate, ToDate: _toDate, ProjectId: _projects, FormId: _forms, WorkFlowStatus: _workflowstatus,
                Subject: _subject, IncomingRefNo: _originReg, From: _from, To: _to,
                FileName: _fileName, CreatedBy: _createdBy, PendingWith: _pendingWith,
                OutgoingRefNo: _outref, RecordNo: _recno, _: Math.random()
            };
        }
        function CloseSearch() {
            $("#panelsearch").slideUp();
        }
        function toggleFilter() {
            $("#panelsearch").slideToggle();
        }
        $(document).ready(function () {
            //$("#panelsearch").slideUp();
            $("#btngetreport").click(function (e) {
                //var _projects = $('#listboxproj').val();
                //var _forms = $('#listboxforms').val();
                //if (!_projects && !_forms) {
                //    alert("Please select the project or forms");
                //    return;
                //}

                $("#panelsearch").slideUp();
                $("#grid").data("kendoGrid").dataSource.data([]);
                $("#grid").data("kendoGrid").dataSource.page(1)
                $("#grid").data("kendoGrid").dataSource.read();
                //$("#grid").data("kendoGrid").refresh();
                e.preventDefault();
            });
        });
        function GetWorkflowStatus(recordId) {
            $(document.body).append('<div id="Window"></div>');
            $('#Window').kendoWindow({
                title: "Workflow",
                modal: true,
                resizable: false,
                width: '80%',
                content: '@Url.Action("GetWorkflowStatus", "CorrespondenceLog")?RecordId=' + recordId,
                visible: false,
                maxHeight: 500,
                animation: {
                    open: {
                        effects: "expandVertical",
                        duration: 200
                    },
                },
                close: function () {
                    setTimeout(function () {
                        $('#Window').kendoWindow('destroy');
                    }, 200);
                }
            }).html('').data('kendoWindow').open().element.closest(".k-window").css({
                top: 55,
                left: 100
            });
        }

        function GetAttachments(DocId) {
            $(document.body).append('<div id="Window"></div>');
            $('#Window').kendoWindow({
                title: "Attachments",
                modal: true,
                resizable: false,
                width: '80%',
                content: '@Url.Action("GetAttachments", "CorrespondenceLog")?DocId=' + DocId,
                visible: false,
                maxHeight: 500,
                animation: {
                    open: {
                        effects: "expandVertical",
                        duration: 1000
                    },
                },
                close: function () {
                    setTimeout(function () {
                        $('#Window').kendoWindow('destroy');
                    }, 200);
                }
            }).html('').data('kendoWindow').open().element.closest(".k-window").css({
                top: 55,
                left: 100
            });
        }
        function filterProjects() {
            var _projects = $('#listboxproj').val();
            return {
                projectIds: _projects
            };
        }

        function onProjectChange() {
            $("#txtPendingWith").data("kendoComboBox").dataSource.data([]);
            $("#txtPendingWith").data("kendoComboBox").dataSource.read();

            $("#txtfrom").data("kendoComboBox").dataSource.data([]);
            $("#txtfrom").data("kendoComboBox").dataSource.read();

            $("#txtto").data("kendoComboBox").dataSource.data([]);
            $("#txtto").data("kendoComboBox").dataSource.read();

            $("#txtCreatedBy").data("kendoComboBox").dataSource.data([]);
            $("#txtCreatedBy").data("kendoComboBox").dataSource.read();
        }
    </script>
</body>
</html>
