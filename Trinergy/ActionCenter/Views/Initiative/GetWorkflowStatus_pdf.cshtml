
@model IEnumerable<WorkOrderForm.Models.IntermediateModels.WorkflowStatus>
@using WorkOrderForm.Constants
@{
    Layout = null;
    int i = 0;
}
<style>
    
        .subReportHeader {
            background-color: cadetblue !important;
            color: #ffffff !important;
            font-size: 16px;
            text-align: center !important;
        }
</style>
<div style="width:100%">
    <table cellpadding="5" cellspacing="5" border="0" width="100%">
        <thead>
            <tr class="subReportHeader">               
                <th style="width:200px;text-align:center">Action By</th>
                <th style="width:100px;text-align:center">Role</th>
                <th style="width:100px;text-align:center">Assigned Date</th>
                <th style="width:100px;text-align:center">Action Type</th> 
                <th style="width:250px;text-align:center">Comments</th>                
            </tr>
        </thead>
        <tbody>
            @foreach (var workflow in Model)
            {
                string bckclr = "";
                if (i % 2 == 0)
                {
                    bckclr = "background-color:#f9f9f9";
                }
                i++;
                if (workflow.ActiontypeID == Common.ActionTypePending)
                {
                    bckclr = "background-color:orange";
                }
                <tr style="@bckclr">
                    <td style="text-align:left">@workflow.Actionee</td>
                    <td tyle="text-align:left">@workflow.ActioneeRole</td>
                    <td style="text-align:center">@workflow.ActionDate.ToString("dd-MMM-yy")</td>
                    <td tyle="text-align:left">@workflow.ActionType</td>
                    <td>@workflow.Comments</td>
                </tr>
            }
            @if (Model.Count() == 0)
            {
                <tr>
                    <td colspan="7">No Records Found</td>
                </tr>
            }
        </tbody>
    </table>
</div>